<%- include('partials/header', { title: 'About ChefNest - Our Story, Mission & Team' }) %>

<link rel="stylesheet" href="/css/about.css">

<main class="about-page">

  <!-- ============================================================ -->
  <!--  HERO BANNER                                                  -->
  <!-- ============================================================ -->
  <section class="about-hero">
    <div class="about-hero-overlay"></div>
    <div class="about-hero-content">
      <span class="about-section-subtitle">Our Story</span>
      <h1 class="about-hero-title">The Kitchen Revolution<br><span class="about-hero-highlight">Started Here</span></h1>
      <p class="about-hero-tagline">ChefNest was born from a simple belief — everyone deserves a restaurant-quality meal in the comfort of their own home, prepared by a trusted culinary professional.</p>
      <div class="about-hero-cta">
        <a href="/chefs" class="about-btn-primary" id="about-browse-chefs-btn">Browse Our Chefs</a>
        <a href="/signup" class="about-btn-outline" id="about-join-btn">Join ChefNest</a>
      </div>
    </div>
    <div class="about-hero-stats">
      <div class="hero-stat-card">
        <span class="hero-stat-num">500+</span>
        <span class="hero-stat-label">Verified Chefs</span>
      </div>
      <div class="hero-stat-card">
        <span class="hero-stat-num">12K+</span>
        <span class="hero-stat-label">Bookings Done</span>
      </div>
      <div class="hero-stat-card">
        <span class="hero-stat-num">40+</span>
        <span class="hero-stat-label">Cuisines Covered</span>
      </div>
      <div class="hero-stat-card">
        <span class="hero-stat-num">4.9★</span>
        <span class="hero-stat-label">Average Rating</span>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  OUR STORY                                                    -->
  <!-- ============================================================ -->
  <section class="our-story-section">
    <div class="about-section-container">
      <div class="story-grid">
        <div class="story-visual">
          <div class="story-image-stack">
            <div class="story-img-back"></div>
            <div class="story-img-front">
              <img src="/images/about_story_chef.png" alt="ChefNest Chef" class="story-chef-img">
              <div class="glass-card-overlay">
                <div class="glass-card-badge">ChefNest</div>
                <div class="glass-card-title">Culinary Art</div>
                <div class="glass-card-dots"><span></span><span></span><span></span></div>
              </div>
            </div>
          </div>
          <div class="story-founding-badge">
            <span class="founding-year">2026</span>
            <span class="founding-label">Founded</span>
          </div>
        </div>

        <div class="story-text">
          <span class="about-section-subtitle">Our Story</span>
          <h2 class="about-section-title">Why ChefNest Was Created</h2>
          <div class="about-title-underline"></div>
          <p class="story-paragraph">
            ChefNest was born out of a frustrating reality: talented, professional chefs were left without flexible opportunities, while food-loving households craved restaurant-quality meals but couldn't access them.
          </p>
          <p class="story-paragraph">
            In 2026, our founders — passionate about both food and technology — set out to change this. They built a platform that bridges the gap: a curated marketplace where verified, background-checked chefs can offer private dining services directly in clients' homes.
          </p>
          <p class="story-paragraph">
            From anniversary dinners to corporate brunches, from everyday family meals to cultural celebrations, ChefNest brings the fine dining experience to your kitchen — on your schedule, your terms, and your taste.
          </p>
          <div class="story-problem-card">
            <div>
              <h4>The Problem We Solve</h4>
              <p>Finding a trustworthy, skilled private chef used to mean expensive agencies, zero transparency, and zero convenience. We changed that forever.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  MISSION & VISION                                             -->
  <!-- ============================================================ -->
  <section class="mission-vision-section">
    <div class="about-section-container">
      <div class="about-section-header">
        <span class="about-section-subtitle">Our North Star</span>
        <h2 class="about-section-title">Mission &amp; Vision</h2>
        <div class="about-title-underline"></div>
      </div>
      <div class="mv-grid">
        <div class="mv-card mission-card">
          <h3>Our Mission</h3>
          <p>To democratize fine dining by connecting food-passionate households with rigorously verified, professional chefs — making extraordinary culinary experiences accessible, safe, and effortless for everyone.</p>
          <ul class="mv-list">
            <li>✦ Empower independent chefs to build thriving businesses</li>
            <li>✦ Deliver 5-star dining experiences at home</li>
            <li>✦ Uphold uncompromising food safety and trust standards</li>
          </ul>
        </div>

        <div class="mv-card vision-card">
          <h3>Our Vision</h3>
          <p>To become South Asia's most trusted private chef platform — a place where culinary artistry meets household convenience, and where every meal tells a story worth sharing.</p>
          <ul class="mv-list">
            <li>✦ Be the #1 platform for private chef bookings in South Asia</li>
            <li>✦ Support 10,000+ chefs by 2028</li>
            <li>✦ Make personalized home dining the new standard</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  HOW CHEFS ARE VERIFIED                                       -->
  <!-- ============================================================ -->
  <section class="verification-section">
    <div class="about-section-container">
      <div class="about-section-header">
        <span class="about-section-subtitle">Trust &amp; Safety</span>
        <h2 class="about-section-title">How We Verify Every Chef</h2>
        <div class="about-title-underline"></div>
        <p class="about-section-desc">We leave nothing to chance. Every chef on ChefNest passes a comprehensive, multi-stage verification process before they can accept a single booking.</p>
      </div>

      <div class="verification-timeline">

        <div class="vt-step">
          <div class="vt-step-num">01</div>
          <div class="vt-step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
          </div>
          <div class="vt-step-content">
            <h3>NIC Verification</h3>
            <p>Every chef submits their National Identity Card (NIC) during registration. Our admin team manually validates the document against government databases to confirm real identity before any approval is granted.</p>
            <span class="vt-badge">Identity Verified</span>
          </div>
        </div>

        <div class="vt-connector"></div>

        <div class="vt-step">
          <div class="vt-step-num">02</div>
          <div class="vt-step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div class="vt-step-content">
            <h3>Police Clearance Certificate</h3>
            <p>All chefs must upload a valid Police Clearance Certificate — issued within the last 6 months. This ensures chefs entering your home have a clean background with no criminal record. No exceptions.</p>
            <span class="vt-badge vt-badge-blue">Background Cleared</span>
          </div>
        </div>

        <div class="vt-connector"></div>

        <div class="vt-step">
          <div class="vt-step-num">03</div>
          <div class="vt-step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <div class="vt-step-content">
            <h3>Culinary Certifications Review</h3>
            <p>Chefs submit professional certificates, diplomas, and credentials — from culinary institutes, hotels, or recognized bodies. Our team reviews and validates each document to ensure quality and authenticity.</p>
            <span class="vt-badge vt-badge-gold">Credentials Confirmed</span>
          </div>
        </div>

        <div class="vt-connector"></div>

        <div class="vt-step">
          <div class="vt-step-num">04</div>
          <div class="vt-step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <div class="vt-step-content">
            <h3>Admin Manual Approval</h3>
            <p>After documents are submitted, our admin team manually reviews the complete chef profile — photos, bio, experience, and all documents. Only upon full admin approval can a chef go live and accept bookings on ChefNest.</p>
            <span class="vt-badge vt-badge-green">&#10003; Admin Approved</span>
          </div>
        </div>

      </div>

      <div class="trust-guarantee">
        <div class="tg-text">
          <h4>The ChefNest Safety Guarantee</h4>
          <p>If a chef does not meet our safety standards at any stage — they are not allowed on our platform. Period. Your safety and peace of mind comes before anything else.</p>
        </div>
        <a href="/signup" class="tg-cta" id="about-safety-cta">Book with Confidence &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  COOKING INGREDIENTS                                         -->
  <!-- ============================================================ -->
  <section class="groceries-section">
    <div class="about-section-container">
      <div class="about-section-header">
        <span class="about-section-subtitle">What Goes Into Every Dish</span>
        <h2 class="about-section-title">Cooking Ingredients We Use</h2>
        <div class="about-title-underline" style="margin: 1rem auto 0;"></div>
        <p class="about-section-desc">Every meal prepared by a ChefNest chef is built on fresh, quality ingredients. Here's a look at the core ingredient categories our chefs work with to craft authentic, flavorful recipes.</p>
      </div>

      <%
        const allIngs = (typeof ingredients !== 'undefined' && ingredients) ? ingredients : [];
        const catMap = {};
        allIngs.forEach(ing => {
          if (!catMap[ing.category]) {
            catMap[ing.category] = [];
          }
          catMap[ing.category].push(ing.name);
        });
        const categoriesList = Object.keys(catMap);
      %>

      <% if (categoriesList.length > 0) { %>
        <!-- Dynamic Ingredient category cards from Database -->
        <div class="ingredient-categories-grid">
          <% categoriesList.forEach((catName, idx) => { %>
            <div class="ingredient-cat-card">
              <div class="ingredient-cat-header">
                <h3><%= catName %></h3>
              </div>
              <div class="ingredient-tags-wrap">
                <% catMap[catName].forEach(ingName => { %>
                  <span class="ing-tag"><%= ingName %></span>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="ingredient-empty-state" style="text-align:center; padding: 3.5rem 2rem; background: rgba(255,255,255,0.7); border-radius: 20px; border: 1.5px dashed rgba(44,95,45,0.2); max-width: 600px; margin: 0 auto 3.5rem;">
          <h3 style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--forest-green); margin-bottom: 0.5rem;">Fresh Ingredients Catalog</h3>
          <p style="color: #6a7a6a; font-size: 0.95rem; line-height: 1.6; margin: 0;">Our ingredient list is actively curated and managed through the ChefNest administration system.</p>
        </div>
      <% } %>

      <!-- Note banner -->
      <div class="ingredient-note-banner">
        <div>
          <strong>Chef's Recipe Ingredient Lists</strong>
          <p>Before each booking, your ChefNest chef provides a complete ingredient list tailored to your chosen menu — so you always know exactly what goes into your meal.</p>
        </div>
      </div>

    </div>
  </section>


  <!-- ============================================================ -->
  <!--  IMPACT / STATS                                               -->
  <!-- ============================================================ -->
  <section class="impact-section">
    <div class="about-section-container">
      <div class="about-section-header">
        <span class="about-section-subtitle">Our Impact</span>
        <h2 class="about-section-title">ChefNest by the Numbers</h2>
        <div class="about-title-underline"></div>
        <p class="about-section-desc">Since launching in 2026, ChefNest has grown rapidly — driven by our community of passionate chefs and food-loving families.</p>
      </div>

      <div class="impact-stats-grid">
        <div class="impact-stat-card">
          <div class="impact-stat-number">500+</div>
          <div class="impact-stat-label">Verified Chefs</div>
          <div class="impact-stat-sub">Across Sri Lanka, India &amp; Malaysia</div>
        </div>
        <div class="impact-stat-card">
          <div class="impact-stat-number">12,000+</div>
          <div class="impact-stat-label">Successful Bookings</div>
          <div class="impact-stat-sub">And growing every single day</div>
        </div>
        <div class="impact-stat-card">
          <div class="impact-stat-number">40+</div>
          <div class="impact-stat-label">Cuisines Covered</div>
          <div class="impact-stat-sub">From Sri Lankan to French Fusion</div>
        </div>
        <div class="impact-stat-card">
          <div class="impact-stat-number">4.9/5</div>
          <div class="impact-stat-label">Average Customer Rating</div>
          <div class="impact-stat-sub">Based on 3,200+ verified reviews</div>
        </div>
        <div class="impact-stat-card">
          <div class="impact-stat-number">15+</div>
          <div class="impact-stat-label">Cities Served</div>
          <div class="impact-stat-sub">Colombo, Chennai, KL &amp; more</div>
        </div>
        <div class="impact-stat-card">
          <div class="impact-stat-number">LKR 600M+</div>
          <div class="impact-stat-label">Chef Earnings Facilitated</div>
          <div class="impact-stat-sub">Putting chefs first, always</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  TEAM / FOUNDERS                                              -->
  <!-- ============================================================ -->
  <section class="team-section">
    <div class="about-section-container">
      <div class="about-section-header">
        <span class="about-section-subtitle">The People Behind It</span>
        <h2 class="about-section-title">Meet Our Team</h2>
        <div class="about-title-underline"></div>
        <p class="about-section-desc">ChefNest was built by a passionate final-year project team with a shared vision — to use technology to make exceptional home dining accessible to all.</p>
      </div>

      <div class="team-grid">
        <% if (typeof admin !== 'undefined' && admin) { %>
        <div class="team-card">
          <div class="team-avatar-wrap">
            <% if (admin.profilePhoto) { %>
              <img src="<%= admin.profilePhoto %>" alt="<%= admin.firstName %>" class="team-avatar" style="object-fit:cover;">
            <% } else { %>
              <div class="team-avatar team-avatar-1"><%= admin.firstName.charAt(0) %></div>
            <% } %>
            <div class="team-role-badge">Lead Administrator</div>
          </div>
          <div class="team-info">
            <h3><%= admin.firstName %> <%= admin.lastName %></h3>
            <p class="team-role-title">Platform Administrator</p>
            <p class="team-bio"><%= admin.bio || 'Oversees the ChefNest platform operations, reviews chef applications, and manages support systems to ensure top service.' %></p>
          </div>
        </div>
        <% } %>

        <% if (typeof topChefs !== 'undefined' && topChefs && topChefs.length > 0) { %>
          <% topChefs.forEach((chef, index) => { %>
            <div class="team-card">
              <div class="team-avatar-wrap">
                <% if (chef.profilePhoto) { %>
                  <img src="<%= chef.profilePhoto %>" alt="<%= chef.firstName %>" class="team-avatar" style="object-fit:cover;">
                <% } else { %>
                  <div class="team-avatar <%= index % 2 === 0 ? 'team-avatar-2' : 'team-avatar-3' %>"><%= chef.firstName.charAt(0) %></div>
                <% } %>
                <div class="team-role-badge">Top Verified Chef</div>
              </div>
              <div class="team-info">
                <h3>Chef <%= chef.firstName %> <%= chef.lastName %></h3>
                <p class="team-role-title"><%= chef.chefType ? chef.chefType.replace('_', ' ').toUpperCase() : 'PROFESSIONAL' %></p>
                <p class="team-bio"><%= chef.bio || 'Specializes in premium culinary preparations and personalized home dining experiences.' %></p>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

    </div>
  </section>


  <!-- ============================================================ -->
  <!--  JOIN US CTA                                                  -->
  <!-- ============================================================ -->
  <section class="about-cta-section">
    <div class="about-cta-inner">
      <span class="about-section-subtitle" style="color: #EC9A52;">Ready to Experience ChefNest?</span>
      <h2 class="about-cta-title">Your Kitchen. Our Chefs.<br>Your Extraordinary Meal.</h2>
      <p class="about-cta-desc">Whether you're booking a chef for a special occasion or joining our platform as a culinary professional — ChefNest is your home.</p>
      <div class="about-cta-buttons">
        <a href="/chefs" class="about-cta-btn-primary" id="about-cta-find-chef">Find a Chef</a>
        <a href="/signup" class="about-cta-btn-secondary" id="about-cta-join-chef">Join as a Chef</a>
        <a href="/contact" class="about-cta-btn-outline" id="about-cta-contact">Contact Us</a>
      </div>
    </div>
  </section>

</main>

<script>
  // Intersection Observer for scroll animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.mv-card, .impact-stat-card, .team-card, .vt-step, .hero-stat-card, .story-grid'
  ).forEach(el => observer.observe(el));
</script>

<%- include('partials/footer') %>
