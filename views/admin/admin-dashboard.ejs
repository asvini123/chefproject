            style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e0ead0;border-radius:10px;font-size:0.9rem;outline:none;font-family:inherit;box-sizing:border-box;resize:vertical;"></textarea>
        </div>

        <div style="margin-bottom:1.5rem; display:flex; align-items:center; gap:0.5rem;">
          <input type="checkbox" id="epFeatured" style="width:18px; height:18px; cursor:pointer;">
          <label for="epFeatured" style="font-size:0.85rem; font-weight:600; color:#1E2E1E; cursor:pointer;">Highlight as Featured Plan</label>
        </div>

        <div style="display:flex;gap:0.8rem;">
          <button onclick="submitEditPlan()" id="epSubmitBtn"
            style="flex:1;background:linear-gradient(135deg,#D97A2B,#B5601D);color:#fff;border:none;padding:0.8rem;border-radius:10px;font-size:0.95rem;font-weight:700;cursor:pointer;font-family:inherit;">
            💾 Save Changes
          </button>
          <button onclick="closeEditPlanModal()"
            style="background:#f4f7f4;color:#4a5a4a;border:1.5px solid #e0ead0;padding:0.8rem 1.2rem;border-radius:10px;cursor:pointer;font-family:inherit;">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================ -->
  <!--  SECTION: CATEGORIES (Country Cuisines)                       -->
  <!-- ============================================================ -->
  <section class="admin-section" id="section-cuisines">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">Country Cuisine Management</h1>
        <p class="section-subtitle">Manage world country cuisines supported on the ChefNest platform.</p>
      </div>
      <div class="section-actions">
        <button class="btn-primary-sm" onclick="openAddCuisineModal()">+ Add Country Cuisine</button>
      </div>
    </div>

    <div class="cat-panel active" id="catpanel-cuisine" style="display:block;">
      <div class="cat-panel-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem;">
        <h3 style="font-size:1.05rem; font-weight:700; color:#1E2E1E;">World Country Cuisines (<%= (typeof cuisines !== 'undefined' && cuisines) ? cuisines.length : 0 %> active)</h3>
        <button class="btn-primary-sm" onclick="openAddCuisineModal()">+ Add Cuisine</button>
      </div>
      <div class="category-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:1.4rem; margin-top:0.8rem;">
        <% if (typeof cuisines !== 'undefined' && cuisines && cuisines.length > 0) { %>
          <% cuisines.forEach(cat => { %>
            <div class="cuisine-photo-card" style="background:#fff; border:1px solid #e2ece2; border-radius:16px; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 4px 14px rgba(44,95,45,0.06); transition:transform 0.25s, box-shadow 0.25s;">
              <div class="cuisine-img-wrap" style="position:relative; width:100%; height:135px; overflow:hidden; background:#1b331c;">
                <img src="<%= cat.image || 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=600&auto=format&fit=crop&q=80' %>" alt="<%= cat.name %>" style="width:100%; height:100%; object-fit:cover; transition:transform 0.4s;">
                <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 60%, transparent 100%);"></div>
                <span style="position:absolute; bottom:10px; left:12px; color:#fff; font-weight:800; font-size:1.05rem; letter-spacing:0.3px; text-shadow:0 1px 3px rgba(0,0,0,0.8);"><%= cat.name %></span>
              </div>
              <div style="padding:0.9rem 1rem; flex:1; display:flex; flex-direction:column; justify-content:space-between; gap:0.6rem;">
                <p style="margin:0; font-size:0.8rem; color:#6B7B6B; line-height:1.35; max-height:2.7em; overflow:hidden; text-overflow:ellipsis;">
                  <%= cat.description || `Specialty ${cat.name} dishes and menu curation.` %>
                </p>
                <div style="display:flex; justify-content:flex-end; border-top:1px solid #f2f6f2; padding-top:0.6rem;">
                  <button class="btn-action delete" style="border:1px solid #fcdada; background:#fff8f8; color:#c0392b; border-radius:8px; padding:0.35rem 0.8rem; font-size:0.8rem; font-weight:600; cursor:pointer;" onclick="deleteCuisine('<%= cat._id %>', '<%= cat.name.replace(/'/g, '\\\'') %>')">
                    Delete
                  </button>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
        <div class="category-card add-new" onclick="openAddCuisineModal()" style="background:#f9fcf9; border:2px dashed #3A733C; border-radius:16px; padding:1.5rem 1rem; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; cursor:pointer; min-height:190px; transition:all 0.2s;">
          <span style="font-size:2rem; color:#2C5F2D; line-height:1;">+</span>
          <span style="font-weight:700; color:#2C5F2D; margin-top:0.6rem; font-size:0.95rem;">Add Country Cuisine</span>
          <small style="color:#7a947a; font-size:0.75rem; margin-top:0.25rem;">Custom cover photo &amp; description</small>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  SECTION: SUBSCRIPTIONS                                       -->
  <!-- ============================================================ -->
  <section class="admin-section" id="section-subscriptions">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">Subscription Management</h1>
        <p class="section-subtitle">Manage subscription tiers, prices, and features saved in database.</p>
      </div>
      <div class="section-actions">
        <button class="btn-primary-sm" onclick="openAddPlanModal()">+ New Plan</button>
      </div>
    </div>
    <div class="plan-cards-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.5rem;">
      <% if (typeof subscriptionPlans !== 'undefined' && subscriptionPlans && subscriptionPlans.length > 0) { %>
        <% subscriptionPlans.forEach(plan => { %>
          <div class="plan-card <%= plan.isFeatured ? 'plan-featured' : '' %>" style="background:#fff; border:1.5px solid <%= plan.isFeatured ? '#2C5F2D' : '#e0ead0' %>; border-radius:18px; padding:1.8rem 1.6rem; display:flex; flex-direction:column; position:relative; box-shadow:0 4px 16px rgba(44,95,45,0.08);">
            <% if (plan.badge) { %>
              <div class="plan-badge" style="position:absolute; top:-12px; right:20px; background:<%= plan.isFeatured ? '#2C5F2D' : '#D97A2B' %>; color:#fff; font-size:0.75rem; font-weight:800; padding:0.25rem 0.8rem; border-radius:20px; text-transform:uppercase; letter-spacing:0.5px;"><%= plan.badge %></div>
            <% } %>
            <h3 style="font-size:1.25rem; font-weight:800; color:#1E2E1E; margin-bottom:0.3rem;"><%= plan.name %></h3>
            <div style="font-size:0.8rem; color:#6B7B6B; margin-bottom:0.8rem; text-transform:uppercase; font-weight:700;"><%= plan.tier %> Tier</div>
            <div class="plan-price" style="font-size:1.9rem; font-weight:800; color:<%= plan.isFeatured ? '#2C5F2D' : '#D97A2B' %>; margin-bottom:1.2rem;">
              LKR <%= (plan.price || 0).toLocaleString() %><span style="font-size:0.85rem; color:#6B7B6B; font-weight:500;">/<%= plan.billingCycle || 'mo' %></span>
            </div>
            <ul class="plan-features" style="list-style:none; padding:0; margin:0 0 1.5rem; flex:1; display:flex; flex-direction:column; gap:0.6rem; font-size:0.88rem; color:#333;">
              <% if (plan.features && plan.features.length > 0) { %>
                <% plan.features.forEach(f => { %>
                  <li style="display:flex; align-items:flex-start; gap:0.5rem;"><span>✓</span> <span><%= f %></span></li>
                <% }) %>
              <% } else { %>
                <li><span>✓</span> Standard benefits</li>
              <% } %>
            </ul>
            <div class="plan-stats" style="font-size:0.8rem; color:#6B7B6B; margin-bottom:1.2rem; border-top:1px solid #f0f5f0; padding-top:0.8rem;">
              <strong><%= plan.activeSubscribers || 0 %></strong> active subscribers
            </div>
            <div class="plan-actions" style="display:flex; gap:0.6rem;">
              <button class="btn-primary-sm" style="flex:1;" onclick="openEditPlanModal('<%= plan._id %>', '<%= plan.name.replace(/'/g, '\\\'') %>', '<%= plan.tier %>', <%= plan.price %>, '<%= plan.billingCycle %>', `<%= (plan.features || []).join('\n').replace(/`/g, '\\`') %>`, '<%= (plan.badge || '').replace(/'/g, '\\\'') %>', <%= plan.isFeatured %>, <%= plan.activeSubscribers || 0 %>)">Edit</button>
              <button class="btn-outline-sm" style="border:1px solid #f5c6c6; color:#c0392b;" onclick="deletePlan('<%= plan._id %>', '<%= plan.name.replace(/'/g, '\\\'') %>')">Delete</button>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  SECTION: PAYMENTS & TRANSACTIONS                             -->
  <!-- ============================================================ -->
  <section class="admin-section" id="section-payments">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">Payments &amp; Transactions</h1>
        <p class="section-subtitle">Real-time database transaction logs, payments, and revenue overview.</p>
      </div>
      <div class="section-actions">
        <button class="btn-primary-sm" onclick="downloadRevenueReport()">Export CSV</button>
      </div>
    </div>
    <div class="mini-kpi-row">
      <div class="mini-kpi">
        <span class="mini-kpi-val">LKR <%= ((typeof paymentStats !== 'undefined' && paymentStats.totalRevenue) || 84320).toLocaleString() %></span>
        <span class="mini-kpi-label">Total Revenue</span>
      </div>
      <div class="mini-kpi">
        <span class="mini-kpi-val">LKR <%= ((typeof paymentStats !== 'undefined' && paymentStats.thisWeekRevenue) || 6240).toLocaleString() %></span>
        <span class="mini-kpi-label">This Week</span>
      </div>
      <div class="mini-kpi">
        <span class="mini-kpi-val">LKR <%= ((typeof paymentStats !== 'undefined' && paymentStats.pendingRefunds) || 1120).toLocaleString() %></span>
        <span class="mini-kpi-label">Pending / Deposits</span>
      </div>
      <div class="mini-kpi">
        <span class="mini-kpi-val"><%= (typeof paymentStats !== 'undefined' && paymentStats.totalTransactions) ? paymentStats.totalTransactions : ((typeof bookings !== 'undefined') ? bookings.length : 0) %></span>
        <span class="mini-kpi-label">Total Transactions</span>
      </div>
    </div>
    <div class="table-card">
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Transaction ID</th>
              <th>Customer</th>
              <th>Chef Assigned</th>
              <th>Amount (LKR)</th>
              <th>Payment Method</th>
              <th>Date</th>
              <th>Receipt</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof bookings !== 'undefined' && bookings && bookings.length > 0) { %>
              <% bookings.slice(0, 20).forEach(b => { %>
                <tr>
                  <td><span class="id-badge">#TXN-<%= b._id.toString().slice(-5).toUpperCase() %></span></td>
                  <td><strong><%= b.userId ? (b.userId.firstName + ' ' + b.userId.lastName) : 'Customer' %></strong></td>
                  <td><%= b.chefId ? ('Chef ' + b.chefId.firstName + ' ' + b.chefId.lastName) : 'Unassigned' %></td>
                  <td><strong style="color:#2C5F2D;">LKR <%= (b.totalPrice || 0).toLocaleString() %></strong></td>
                  <td><%= b.paymentMethod || 'Credit / Online Card' %></td>
                  <td><%= new Date(b.date || b.createdAt).toLocaleDateString() %></td>
                  <td>
                    <% if (b.receiptUrl || b.paymentStatus === 'Completed' || b.paymentStatus === 'Deposit Paid') { %>
                      <a href="/booking/success/<%= b._id %>" target="_blank" class="btn-doc" style="text-decoration:none;">View Receipt</a>
                    <% } else { %>
                      <span style="color:#999; font-size:0.8rem;">Standard</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (b.status === 'Completed' || b.paymentStatus === 'Completed') { %>
                      <span class="status-badge confirmed">Paid</span>
                    <% } else if (b.paymentStatus === 'Deposit Paid') { %>
                      <span class="status-badge confirmed" style="background:#eaf5ea; color:#2C5F2D;">Deposit Paid</span>
                    <% } else if (b.status === 'Cancelled') { %>
                      <span class="status-badge cancelled">Cancelled</span>
                    <% } else { %>
                      <span class="status-badge pending">Pending</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align:center; padding:2rem; color:#999;">No transaction history found in database.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  SECTION: REVIEWS & MODERATION (Approve / Delete)             -->
  <!-- ============================================================ -->
  <section class="admin-section" id="section-reviews">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">Reviews &amp; Moderation</h1>
        <p class="section-subtitle">Approve customer reviews before they appear on chef public profiles, or remove unwanted content.</p>
      </div>
    </div>
    <div class="table-card">
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Review ID</th>
              <th>Customer</th>
              <th>Chef Profile</th>
              <th>Rating</th>
              <th>Review Comment</th>
              <th>Status</th>
              <th>Date</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
              <% reviews.forEach(rv => { %>
                <tr>
                  <td><span class="id-badge">#RV-<%= rv._id.toString().slice(-4).toUpperCase() %></span></td>
                  <td><strong><%= rv.userId ? (rv.userId.firstName + ' ' + rv.userId.lastName) : 'Customer' %></strong></td>
                  <td><%= rv.chefId ? ('Chef ' + rv.chefId.firstName + ' ' + rv.chefId.lastName) : 'Assigned Chef' %></td>
                  <td>
                    <span style="color:#f39c12; font-weight:700; letter-spacing:1px;">
                      <%= '★'.repeat(Math.round(rv.rating || 5)) %><%= '☆'.repeat(5 - Math.round(rv.rating || 5)) %>
                    </span>
                    <small style="color:#777;">(<%= rv.rating %>/5)</small>
                  </td>
                  <td class="review-text-cell" style="max-width:260px; word-break:break-word;">
                    "<%= rv.comment %>"
                  </td>
                  <td>
                    <% if (rv.isApproved || rv.status === 'Approved') { %>
                      <span class="status-badge confirmed" style="background:#eaf7ea; color:#2C5F2D;">Approved (Public)</span>
                    <% } else { %>
                      <span class="status-badge pending" style="background:#fff3cd; color:#856404;">Pending Approval</span>
                    <% } %>
                  </td>
                  <td><%= new Date(rv.createdAt || Date.now()).toLocaleDateString() %></td>
                  <td class="action-btns" style="text-align:right;">
                    <% if (!rv.isApproved && rv.status !== 'Approved') { %>
                      <button class="btn-action confirm" title="Approve review for chef profile" onclick="approveReview('<%= rv._id %>')" style="border:1px solid #c3e6cb; background:#d4edda; color:#155724; padding:0.35rem 0.7rem; border-radius:6px; font-size:0.8rem; cursor:pointer;">
                        Approve
                      </button>
                    <% } %>
                    <button class="btn-action delete" title="Delete review from database" onclick="deleteReview('<%= rv._id %>')">
                      Delete
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align:center; padding:3rem; color:var(--text-muted);">
                  No reviews submitted in database yet.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  SECTION: REPORTS & ANALYTICS                                 -->
  <!-- ============================================================ -->
