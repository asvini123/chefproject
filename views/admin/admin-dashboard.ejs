  async function submitAddDiscount() {
    const code = document.getElementById('adCode').value.trim().toUpperCase();
    const discountPercentage = document.getElementById('adPercent').value;
    const title = document.getElementById('adTitle').value.trim();
    const type = document.getElementById('adType').value;
    const validTill = document.getElementById('adValidTill').value;
    const minOrderAmount = document.getElementById('adMinOrder').value || 0;
    const description = document.getElementById('adDesc').value.trim();
    const errEl = document.getElementById('adError');
    const btn = document.getElementById('adSubmitBtn');

    if (!code || !title || !discountPercentage || !validTill) {
      errEl.textContent = 'Please fill in Code, Title, Discount %, and Valid Till date.';
      errEl.style.display = 'block';
      return;
    }

    // Validate that validity date cannot be in the past
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const chosenDate = new Date(validTill);
    chosenDate.setHours(0, 0, 0, 0);
    if (chosenDate < today) {
      errEl.textContent = 'Validity date cannot be in the past. Please select today or a future date.';
      errEl.style.display = 'block';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Saving...';

    try {
      const res = await fetch('/admin/discounts/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ code, discountPercentage, title, type, validTill, minOrderAmount, description })
      });
      const data = await res.json().catch(() => ({ success: false, message: 'Server returned HTTP ' + res.status }));
      if (data.success) {
        showToast('Discount offer "' + code + '" created successfully!');
        closeAddDiscountModal();
        setTimeout(() => window.location.reload(), 600);
      } else {
        errEl.textContent = data.message || 'Error saving discount.';
        errEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Save Offer';
      }
    } catch (err) {
      errEl.textContent = 'Network error (' + err.message + ').';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Save Offer';
    }
  }

