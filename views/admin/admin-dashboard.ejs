          <button onclick="closeAddCourseModal()"
            style="background:#f4f7f4;color:#4a5a4a;border:1.5px solid #e0ead0;padding:0.85rem 1.2rem;border-radius:12px;cursor:pointer;font-family:inherit;">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

