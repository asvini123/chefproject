  <section class="admin-section" id="section-discounts">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">Discounts &amp; Offers</h1>
        <p class="section-subtitle">Manage promotional offers, festival discounts, and promo codes active across user &amp; chef dashboards.</p>
      </div>
      <div class="section-actions">
        <button class="btn-primary-sm" onclick="openAddDiscountModal()">+ Create Offer</button>
      </div>
