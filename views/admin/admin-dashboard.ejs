  function filterIngredientsTable() {
    const filter = document.getElementById('ingCatFilter').value;
    const rows = document.querySelectorAll('.ing-row');
    let visibleCount = 0;
    rows.forEach(row => {
      const cat = row.getAttribute('data-category');
      if (filter === 'ALL' || cat === filter) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });
    const emptyRow = document.getElementById('emptyIngRow');
    if (emptyRow) {
      emptyRow.style.display = (visibleCount === 0) ? '' : 'none';
    }
  }

