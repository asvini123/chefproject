  async function submitAddCourse() {
    const title = document.getElementById('acTitle').value.trim();
    const description = document.getElementById('acDesc').value.trim();
    const category = document.getElementById('acCategory').value;
    const chefId = document.getElementById('acChef').value;
    const duration = document.getElementById('acDuration').value.trim() || '2 hours';
    const price = document.getElementById('acPrice').value;
