<script>
// ── Section Navigation ──────────────────────────────────────────
function showSection(sectionId, clickedLink) {
  document.querySelectorAll('.admin-section').forEach(s => s.classList.remove('active'));
  const target = document.getElementById('section-' + sectionId);
  if (target) target.classList.add('active');

  document.querySelectorAll('.nav-item').forEach(li => li.classList.remove('active'));
  const parentLi = clickedLink?.closest('.nav-item') || document.querySelector(`[data-section="${sectionId}"]`);
  if (parentLi) parentLi.classList.add('active');

  const label = clickedLink?.querySelector('.nav-label')?.textContent || parentLi?.querySelector('.nav-label')?.textContent || sectionId;
  document.getElementById('breadcrumbCurrent').textContent = label;

  // Automatically clear active warnings when viewed
  if (sectionId === 'notifications') {
    const notifBadge = document.getElementById('adminBadgeNotifs');
    if (notifBadge) {
      notifBadge.textContent = '0';
      notifBadge.classList.remove('warn');
    }
    const dot = document.getElementById('topbarNotifDot');
    if (dot) dot.style.display = 'none';

    // Persist mark all read in DB
    fetch('/notifications/read-all', { method: 'POST' }).catch(() => {});
  } else if (sectionId === 'grocery') {
    const grocBadge = document.getElementById('adminBadgeGrocery');
    if (grocBadge) grocBadge.classList.remove('warn');
  } else if (sectionId === 'bookings') {
    const bookBadge = document.getElementById('adminBadgeBookings');
    if (bookBadge) bookBadge.classList.remove('warn');
  } else if (sectionId === 'chefs') {
    const chefBadge = document.getElementById('adminBadgeChefs');
    if (chefBadge) chefBadge.classList.remove('warn');
  }

  if (window.innerWidth < 900) closeSidebar();
  return false;
}

// ── Sidebar Toggle ───────────────────────────────────────────────
const sidebar = document.getElementById('adminSidebar');
const overlay = document.getElementById('sidebarOverlay');
const hamburger = document.getElementById('hamburgerBtn');
const sidebarCloseBtn = document.getElementById('sidebarClose');

hamburger.addEventListener('click', () => {
  sidebar.classList.toggle('open');
  overlay.classList.toggle('active');
});
overlay.addEventListener('click', closeSidebar);
sidebarCloseBtn.addEventListener('click', closeSidebar);
function closeSidebar() {
  sidebar.classList.remove('open');
  overlay.classList.remove('active');
}

// ── Cuisine Tabs ───────────────────────────────────────────────
function switchCatTab(btn, panel) {
  const section = btn.closest('.admin-section');
  section.querySelectorAll('.cat-tabs-row .cat-tab').forEach(b => b.classList.remove('active'));
  section.querySelectorAll('.cat-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('catpanel-' + panel)?.classList.add('active');
}

// ── Discount Tabs ───────────────────────────────────────────────
function switchDiscountTab(btn, panel) {
  document.querySelectorAll('.discount-tabs-row .cat-tab').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.discount-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('discpanel-' + panel)?.classList.add('active');
}

// ── Grocery Actions ─────────────────────────────────────────────
async function respondGroceryRequest(bookingId, action) {
  if (!confirm(`Are you sure you want to ${action} this grocery support request?`)) return;
  try {
    const response = await fetch(`/admin/bookings/${bookingId}/grocery/${action}`, {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    });
    const result = await response.json().catch(() => ({ success: false, message: 'Server returned HTTP ' + response.status }));
    if (result.success) {
      showToast(`✅ Grocery request successfully ${action === 'approve' ? 'approved' : 'rejected'}!`);
      setTimeout(() => location.reload(), 1000);
    } else {
      showToast('❌ Error: ' + (result.message || 'Action failed'));
    }
  } catch (err) {
    console.error(err);
    showToast('❌ Network error responding to grocery request.');
  }
}
function toggleGroceryItems(id) {
  const el = document.getElementById(id);
  if (el) el.classList.toggle('hidden');
}

// ── Toast ───────────────────────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toastMsg');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3500);
}

function updateChefStatus(chefId, action, btn) {
  let reason = '';
  if (action === 'reject') {
    const userInput = prompt('Enter an optional reason for Suspending/Rejecting this Chef (or click OK to proceed):', 'Compliance Review');
    if (userInput === null) return; // User clicked Cancel
    reason = userInput.trim();
  }

  if (btn) btn.disabled = true;

  fetch(`/admin/chefs/${chefId}/${action}`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ reason })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      showToast('✅ ' + data.message);
      // Reload page to reflect changes
      setTimeout(() => window.location.reload(), 1000);
    } else {
      if (btn) btn.disabled = false;
      alert('Error updating status: ' + data.message);
    }
  })
  .catch(err => {
    console.error('Error:', err);
    if (btn) btn.disabled = false;
    alert('A server error occurred.');
  });
}

// ── Notifications ───────────────────────────────────────────────
function sendNotif(e, type) {
  e.preventDefault();
  showToast(type === 'email' ? '📧 Email sent successfully!' : '📢 Broadcast notification sent!');
  e.target.reset();
}

// ── Charts (Chart.js) ───────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  const green = '#2C5F2D', orange = '#D97A2B';
  const greenA = 'rgba(44,95,45,0.15)', orangeA = 'rgba(217,122,43,0.20)';
  const font = { family: 'Outfit', size: 12 };

  const gridOpts = {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: { y: { grid: { color: '#f0ede8' }, ticks: { font } }, x: { grid: { display: false }, ticks: { font } } }
  };

  // Booking + Revenue Combined Chart
  new Chart(document.getElementById('bookingRevenueChart'), {
    type: 'bar',
    data: {
      labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
      datasets: [
        { label: 'Bookings', data: [120,180,210,290,340,480,520,460,390,310,420,580], backgroundColor: greenA, borderColor: green, borderWidth: 2, borderRadius: 6 },
        { label: 'Revenue ×LKR 100', data: [84,122,148,196,230,318,345,304,262,208,280,390], backgroundColor: orangeA, borderColor: orange, borderWidth: 2, type: 'line', fill: true, tension: 0.4, pointBackgroundColor: orange, pointRadius: 4 }
      ]
    },
    options: { ...gridOpts, plugins: { legend: { display: false } } }
  });

  // Cuisine Doughnut
  new Chart(document.getElementById('cuisineChart'), {
    type: 'doughnut',
    data: {
      labels: ['Indian','Italian','Chinese','Sri Lankan','Malaysian','Others'],
      datasets: [{ data: [28,21,18,14,12,7], backgroundColor: [green,'#D97A2B','#4A804D','#D4A373','#EC9A52','#B5601D'], borderWidth: 3, borderColor: '#fff' }]
    },
    options: { responsive: true, cutout: '62%', plugins: { legend: { position: 'bottom', labels: { font, padding: 14 } } } }
  });

  // New Users Line
  new Chart(document.getElementById('usersChart'), {
    type: 'line',
    data: {
      labels: ['Jan','Feb','Mar','Apr','May','Jun'],
      datasets: [{ label: 'New Users', data: [85,112,138,165,200,248], backgroundColor: greenA, borderColor: green, borderWidth: 2.5, fill: true, tension: 0.45, pointBackgroundColor: green, pointRadius: 5 }]
    },
    options: { ...gridOpts }
  });

  // Chef Status Pie
  new Chart(document.getElementById('chefStatusChart'), {
    type: 'pie',
    data: {
      labels: ['Active','Pending','Suspended','Rejected'],
      datasets: [{ data: [280,12,8,47], backgroundColor: [green,orange,'#B5601D','#9e9e9e'], borderWidth: 3, borderColor: '#fff' }]
    },
    options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { font, padding: 14 } } } }
  });
});
</script>
</body>
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  socket.on('new-notification', (notif) => {
    const dot = document.querySelector('.notif-dot');
    if (dot) dot.style.display = 'block';
    showToast('🔔 ' + notif.message);
  });

  async function deleteCourse(id) {
    if (!confirm('Are you sure you want to delete this course from the database? This cannot be undone.')) return;
    try {
      const res = await fetch('/admin/courses/' + id + '/delete', { 
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });
      const d = await res.json().catch(() => ({ success: false, message: 'Server returned HTTP ' + res.status }));
      showToast(d.success ? '✅ Course deleted from database!' : '❌ Error: ' + (d.message || 'Failed')); 
      if (d.success) setTimeout(() => window.location.reload(), 800);
