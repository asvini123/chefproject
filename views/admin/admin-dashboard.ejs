            <input id="acTitle" type="text" placeholder="e.g. Sri Lankan Cuisine Masterclass"
              style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e0ead0;border-radius:10px;font-size:0.9rem;outline:none;font-family:inherit;"
              onfocus="this.style.borderColor='#2C5F2D'" onblur="this.style.borderColor='#e0ead0'">
          </div>
          <div style="grid-column:1/-1;">
            <label style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#4a5a4a;display:block;margin-bottom:0.4rem;">Description</label>
            <textarea id="acDesc" rows="2" placeholder="Brief course description..."
              style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e0ead0;border-radius:10px;font-size:0.9rem;outline:none;font-family:inherit;resize:none;"
              onfocus="this.style.borderColor='#2C5F2D'" onblur="this.style.borderColor='#e0ead0'"></textarea>
          </div>
          <div>
            <label style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#4a5a4a;display:block;margin-bottom:0.4rem;">Category *</label>
            <select id="acCategory" style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e0ead0;border-radius:10px;font-size:0.9rem;outline:none;font-family:inherit;background:#fff;"
              onfocus="this.style.borderColor='#2C5F2D'" onblur="this.style.borderColor='#e0ead0'">
              <option value="cuisine">🍜 Cuisine-Based</option>
              <option value="skill">📊 Skill Level</option>
              <option value="health">💚 Health & Diet</option>
              <option value="occasion">🎉 Occasion</option>
              <option value="certification">🏅 Certification</option>
            </select>
          </div>
          <div>
            <label style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#4a5a4a;display:block;margin-bottom:0.4rem;">Chef *</label>
            <select id="acChef" style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e0ead0;border-radius:10px;font-size:0.9rem;outline:none;font-family:inherit;background:#fff;"
              onfocus="this.style.borderColor='#2C5F2D'" onblur="this.style.borderColor='#e0ead0'">
              <option value="">Select a chef...</option>
              <% chefs.forEach(chef => { %>
                <option value="<%= chef._id %>">Chef <%= chef.firstName %> <%= chef.lastName %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#4a5a4a;display:block;margin-bottom:0.4rem;">Duration</label>
            <input id="acDuration" type="text" placeholder="e.g. 2 hours 30 mins"
              style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e0ead0;border-radius:10px;font-size:0.9rem;outline:none;font-family:inherit;"
              onfocus="this.style.borderColor='#2C5F2D'" onblur="this.style.borderColor='#e0ead0'">
          </div>
          <div>
            <label style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#4a5a4a;display:block;margin-bottom:0.4rem;">Price (LKR) *</label>
            <input id="acPrice" type="number" min="0" placeholder="0 for free"
              style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e0ead0;border-radius:10px;font-size:0.9rem;outline:none;font-family:inherit;"
              onfocus="this.style.borderColor='#2C5F2D'" onblur="this.style.borderColor='#e0ead0'">
          </div>
          <div>
            <label style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#4a5a4a;display:block;margin-bottom:0.4rem;">Status</label>
            <select id="acStatus" style="width:100%;padding:0.7rem 1rem;border:1.5px solid #e0ead0;border-radius:10px;font-size:0.9rem;outline:none;font-family:inherit;background:#fff;"
              onfocus="this.style.borderColor='#2C5F2D'" onblur="this.style.borderColor='#e0ead0'">
              <option value="Live">🟢 Live (visible to users)</option>
              <option value="Pending">🟡 Pending</option>
            </select>
          </div>
        </div>

        <div style="display:flex;gap:0.8rem;">
          <button onclick="submitAddCourse()" id="acSubmitBtn"
            style="flex:1;background:linear-gradient(135deg,#2C5F2D,#4A804D);color:#fff;border:none;padding:0.85rem;border-radius:12px;font-size:0.95rem;font-weight:700;cursor:pointer;font-family:inherit;">
            ✅ Save Course
