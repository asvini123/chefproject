          preview.style.display = 'block';
        }
        if (placeholder) placeholder.style.display = 'none';
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  function togglePwdVisibility() {
    const input = document.getElementById('editPassword');
    const btn = document.getElementById('pwdToggleBtn');
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🙈';
    } else {
      input.type = 'password';
      btn.textContent = '👁️';
    }
  }

  async function saveProfile(e) {
    e.preventDefault();
    const btn = document.getElementById('saveProfileBtn');
    btn.disabled = true;
    btn.textContent = '⏳ Saving...';

    const firstName = document.getElementById('editFirstName').value.trim();
    const lastName  = document.getElementById('editLastName').value.trim();
    const email     = document.getElementById('editEmail').value.trim();
    const phone     = document.getElementById('editPhone').value.trim();
    const password  = document.getElementById('editPassword').value;
    const photoFile = document.getElementById('photoInput').files[0];

    // Use FormData to support file upload
    const formData = new FormData();
    formData.append('firstName', firstName);
    formData.append('lastName', lastName);
    formData.append('email', email);
    formData.append('phone', phone);
    if (password) formData.append('password', password);
    if (photoFile) formData.append('profilePhoto', photoFile);

    try {
      const res = await fetch('/admin/profile/update', {
        method: 'POST',
        body: formData   // No Content-Type header — browser sets it with boundary for multipart
      });
      const data = await res.json();
      if (data.success) {
        showToast('✅ Profile updated successfully!');
        document.getElementById('profileModal').classList.remove('active');
        setTimeout(() => window.location.reload(), 1200);
      } else {
        showToast('❌ Error: ' + data.message);
        btn.disabled = false;
        btn.textContent = '💾 Save Changes';
      }
    } catch(err) {
      showToast('❌ Network error. Try again.');
      btn.disabled = false;
      btn.textContent = '💾 Save Changes';
    }
  }

  // ── Admin 1-on-1 Chat Engine ──────────────────────────────────
  const currentAdminId = "<%= user ? user._id : '' %>";
  const adminSocket = typeof io !== 'undefined' ? io() : null;
  let activeAdminChatContactId = null;

  const serverChefsList = <%- JSON.stringify((chefs || []).map(c => ({ _id: c._id, firstName: c.firstName, lastName: c.lastName, email: c.email || '', role: 'chef', unread: 0, lastMessage: '' }))) %>;
  const serverUsersList = <%- JSON.stringify((users || []).map(u => ({ _id: u._id, firstName: u.firstName, lastName: u.lastName, email: u.email || '', role: 'user', unread: 0, lastMessage: '' }))) %>;

  let adminChatData = { 
    chefs: serverChefsList, 
    users: serverUsersList 
  };

  if (adminSocket && currentAdminId) {
    adminSocket.emit('join-user', currentAdminId);

    adminSocket.on('new-private-message', (msg) => {
      const otherId = (msg.senderId._id || msg.senderId).toString() === currentAdminId.toString()
        ? (msg.receiverId._id || msg.receiverId).toString()
        : (msg.senderId._id || msg.senderId).toString();

      // 1. Move to top of sidebar
      const listEl = document.getElementById('adminChatSidebarList');
      const item = document.getElementById(`admin-contact-${otherId}`);
      if (item && listEl) {
        listEl.prepend(item);
      }

      // 2. Bold text and unread dot
      if (item) {
        const nameEl = item.querySelector('.chat-name');
        if (nameEl) nameEl.style.fontWeight = '800';
        const snippetEl = item.querySelector('.chat-snippet');
        if (snippetEl) {
          snippetEl.textContent = msg.content;
          snippetEl.style.fontWeight = '700';
          snippetEl.style.color = '#111';
        }
        const dot = item.querySelector('.unread-dot');
        if (dot && (!activeAdminChatContactId || activeAdminChatContactId.toString() !== otherId)) {
          dot.style.display = 'inline-block';
        }
      }

      // 3. Update Admin Chat sidebar badge
      const navBadge = document.getElementById('adminChatNavBadge');
      if (navBadge && (!activeAdminChatContactId || activeAdminChatContactId.toString() !== otherId)) {
        const count = parseInt(navBadge.textContent || '0') + 1;
        navBadge.textContent = count;
        navBadge.style.display = 'inline-block';
      }

      // 4. Append to message stream
      if (activeAdminChatContactId && activeAdminChatContactId.toString() === otherId) {
        appendAdminChatMessage(msg);
      }
    });
  }

  async function initAdminChat() {
    handleAdminChatRoleChange('chef');
    renderAdminChatContacts();

    try {
      const res = await fetch('/api/chat/contacts');
      const data = await res.json();
      if (data.success) {
        // Update nav badge with total unread
        const navBadge = document.getElementById('adminChatNavBadge');
        if (navBadge) {
          if (data.totalUnread > 0) {
            navBadge.textContent = data.totalUnread;
            navBadge.style.display = 'inline-block';
          } else {
            navBadge.style.display = 'none';
          }
        }

        if (data.contacts && data.contacts.length > 0) {
          adminChatData.chefs = data.contacts.filter(c => c.role === 'chef');
          adminChatData.users = data.contacts.filter(c => c.role === 'user');

          const currentRole = document.getElementById('adminChatRoleSelect')?.value || 'chef';
          handleAdminChatRoleChange(currentRole);
          renderAdminChatContacts();
        }
      }
    } catch (err) {
      console.warn('Using pre-populated server contacts list');
    }
  }

  function handleAdminChatRoleChange(role) {
    const select = document.getElementById('adminChatPersonSelect');
    if (!select) return;
    select.innerHTML = '<option value="">-- Choose a person --</option>';

    const list = role === 'chef' ? adminChatData.chefs : adminChatData.users;
    list.forEach(p => {
      const opt = document.createElement('option');
      opt.value = p._id;
      opt.textContent = `${role === 'chef' ? '👨‍🍳 Chef' : '👤'} ${p.firstName} ${p.lastName} (${p.email})`;
      opt.setAttribute('data-name', `${role === 'chef' ? 'Chef ' : ''}${p.firstName} ${p.lastName}`);
      opt.setAttribute('data-role', role);
      select.appendChild(opt);
    });
  }

  function handleAdminChatPersonSelect(personId) {
    if (personId) {
      startChatFromDropdown();
    }
  }

  function startChatFromDropdown() {
    const select = document.getElementById('adminChatPersonSelect');
    if (!select || !select.value) {
      showToast('⚠️ Please select a person from the dropdown.');
      return;
    }
    const opt = select.options[select.selectedIndex];
    const name = opt.getAttribute('data-name') || 'Contact';
    const role = opt.getAttribute('data-role') || 'user';
    openAdminChat(select.value, name, role);
  }

  function renderAdminChatContacts() {
    const listEl = document.getElementById('adminChatSidebarList');
    if (!listEl) return;

    let html = '';
    // Group: Chefs
    if (adminChatData.chefs.length > 0) {
      html += `<div style="padding:0.4rem 0.8rem; font-size:0.7rem; font-weight:800; text-transform:uppercase; color:#2C5F2D; background:rgba(44,95,45,0.08);">Chefs (${adminChatData.chefs.length})</div>`;
      adminChatData.chefs.forEach(c => {
        const hasUnread = c.unreadCount > 0;
        html += `
          <div class="chat-user-item" id="admin-contact-${c._id}" onclick="openAdminChat('${c._id}', 'Chef ${c.firstName} ${c.lastName}', 'chef')" style="display:flex; align-items:center; gap:0.6rem; padding:0.65rem 0.8rem; cursor:pointer; border-bottom:1px solid #f0f0f0;">
            <div style="width:32px; height:32px; border-radius:50%; background:#2C5F2D; color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:700;">👨‍🍳</div>
            <div style="flex:1; overflow:hidden;">
              <strong class="chat-name" style="font-size:0.82rem; font-weight:${hasUnread ? '800' : '600'}; color:#1f2937; display:block; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">
                ${c.firstName} ${c.lastName} 
                <span class="unread-dot" style="display:${hasUnread ? 'inline-block' : 'none'}; color:#e74c3c; font-size:0.75rem; margin-left:4px;">● New</span>
              </strong>
              <span class="chat-snippet" style="font-size:0.72rem; color:${hasUnread ? '#111' : '#888'}; font-weight:${hasUnread ? '700' : '400'}; white-space:nowrap; text-overflow:ellipsis; overflow:hidden; display:block;">
                ${escapeAdminHtml(c.lastMessage || c.chefType || 'Chef')}
              </span>
            </div>
          </div>
        `;
      });
    }

    // Group: Users
    if (adminChatData.users.length > 0) {
      html += `<div style="padding:0.4rem 0.8rem; font-size:0.7rem; font-weight:800; text-transform:uppercase; color:#D97A2B; background:rgba(217,122,43,0.08); margin-top:0.3rem;">Users (${adminChatData.users.length})</div>`;
      adminChatData.users.forEach(u => {
        const hasUnread = u.unreadCount > 0;
        html += `
          <div class="chat-user-item" id="admin-contact-${u._id}" onclick="openAdminChat('${u._id}', '${u.firstName} ${u.lastName}', 'user')" style="display:flex; align-items:center; gap:0.6rem; padding:0.65rem 0.8rem; cursor:pointer; border-bottom:1px solid #f0f0f0;">
            <div style="width:32px; height:32px; border-radius:50%; background:#D97A2B; color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:700;">${u.firstName.charAt(0)}</div>
            <div style="flex:1; overflow:hidden;">
              <strong class="chat-name" style="font-size:0.82rem; font-weight:${hasUnread ? '800' : '600'}; color:#1f2937; display:block; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">
                ${u.firstName} ${u.lastName} 
                <span class="unread-dot" style="display:${hasUnread ? 'inline-block' : 'none'}; color:#e74c3c; font-size:0.75rem; margin-left:4px;">● New</span>
              </strong>
              <span class="chat-snippet" style="font-size:0.72rem; color:${hasUnread ? '#111' : '#888'}; font-weight:${hasUnread ? '700' : '400'}; white-space:nowrap; text-overflow:ellipsis; overflow:hidden; display:block;">
                ${escapeAdminHtml(u.lastMessage || u.memberId || 'Client')}
              </span>
            </div>
          </div>
        `;
      });
    }

    listEl.innerHTML = html;
  }

  async function openAdminChat(contactId, contactName, role) {
    activeAdminChatContactId = contactId;

    // Highlight sidebar
    document.querySelectorAll('#adminChatSidebarList .chat-user-item').forEach(el => el.style.background = '');
    const activeEl = document.getElementById(`admin-contact-${contactId}`);
    if (activeEl) {
      activeEl.style.background = '#eef8ee';
      activeEl.style.fontWeight = 'normal';
      const dot = activeEl.querySelector('.unread-dot');
      if (dot) dot.style.display = 'none';
    }

    // Update header
    const header = document.getElementById('adminChatHeader');
    if (header) {
      header.innerHTML = `<strong>${contactName}</strong> <span>${role === 'chef' ? '👨‍🍳 Verified Chef' : '👤 Client User'}</span>`;
    }

    // Enable input & send button
    const input = document.getElementById('adminChatInput');
    const btn = document.getElementById('adminChatSendBtn');
    if (input) { input.disabled = false; input.placeholder = `Message ${contactName}...`; input.focus(); }
    if (btn) { btn.disabled = false; }

    // Fetch messages
    const msgsBox = document.getElementById('adminChatMessages');
    msgsBox.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#999;font-size:0.85rem;">⏳ Loading conversation...</div>';

    try {
      const res = await fetch(`/api/chat/messages/${contactId}`);
      const data = await res.json();
      if (data.success && data.messages) {
        if (data.messages.length === 0) {
          msgsBox.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#999;font-size:0.85rem;">👋 No message history with ${contactName}. Type below to start!</div>`;
        } else {
          msgsBox.innerHTML = '';
          data.messages.forEach(m => appendAdminChatMessage(m));
        }
      }
    } catch (err) {
      console.error('Error fetching messages:', err);
      msgsBox.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#c0392b;font-size:0.85rem;">❌ Failed to load messages.</div>';
    }
  }

  function appendAdminChatMessage(msg) {
    const msgsBox = document.getElementById('adminChatMessages');
    if (!msgsBox) return;

    const msgId = msg._id ? msg._id.toString() : '';
    if (msgId && document.getElementById(`admin-msg-${msgId}`)) {
      return; // Prevent duplicate display
    }

    if (msgsBox.innerText.includes('Choose a person') || msgsBox.innerText.includes('No message history') || msgsBox.innerText.includes('Loading conversation')) {
      msgsBox.innerHTML = '';
    }

    const sId = (msg.senderId._id || msg.senderId).toString();
    const isMine = sId === currentAdminId.toString();

    const div = document.createElement('div');
    if (msgId) div.id = `admin-msg-${msgId}`;
    div.style.maxWidth = '70%';
    div.style.padding = '0.6rem 0.9rem';
    div.style.borderRadius = '8px';
    div.style.fontSize = '0.84rem';
    div.style.display = 'flex';
    div.style.flexDirection = 'column';
    div.style.gap = '0.2rem';
    div.style.alignSelf = isMine ? 'flex-end' : 'flex-start';
    div.style.background = isMine ? '#2C5F2D' : '#f0ede8';
    div.style.color = isMine ? '#ffffff' : '#1f2937';

    div.innerHTML = `
      <div>${escapeAdminHtml(msg.content)}</div>
      <span style="font-size:0.65rem; opacity:0.75; text-align:right;">${new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
    `;
    msgsBox.appendChild(div);
    msgsBox.scrollTop = msgsBox.scrollHeight;
  }

  async function sendAdminChatMessage(e) {
    e.preventDefault();
    const input = document.getElementById('adminChatInput');
    const text = input ? input.value.trim() : '';
    if (!text || !activeAdminChatContactId) return;

    input.value = '';

    try {
      const res = await fetch('/api/chat/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ receiverId: activeAdminChatContactId, content: text })
      });
      const data = await res.json();
      if (data.success && data.message) {
        appendAdminChatMessage(data.message);
      }
    } catch (err) {
      console.error('Error sending admin chat message:', err);
    }
  }

  function escapeAdminHtml(str) {
    return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
  }

  // Load chat on startup
  document.addEventListener('DOMContentLoaded', () => {
    initAdminChat();
  });
</script>
<script src="/socket.io/socket.io.js"></script>
</html>
