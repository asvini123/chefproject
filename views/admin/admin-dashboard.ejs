  // ── DYNAMIC PAGINATION ENGINES (Users, Chefs, Bookings) ───
  const PAGE_SIZE = 6;
  const paginationState = {
    users: { page: 1 },
    chefs: { page: 1 },
    bookings: { page: 1 }
  };

  function setupTablePagination(type, rows, infoElId, btnsElId) {
    const activeRows = rows.filter(r => r.getAttribute('data-hidden-by-filter') !== 'true');
    const totalVisible = activeRows.length;
    const totalPages = Math.max(1, Math.ceil(totalVisible / PAGE_SIZE));
    let currentPage = Math.min(paginationState[type].page || 1, totalPages);
    if (currentPage < 1) currentPage = 1;
    paginationState[type].page = currentPage;

    // Show only the slice for currentPage
    activeRows.forEach((r, idx) => {
      if (idx >= (currentPage - 1) * PAGE_SIZE && idx < currentPage * PAGE_SIZE) {
        r.style.display = '';
      } else {
        r.style.display = 'none';
      }
    });

    // Hide filtered-out rows
    rows.forEach(r => {
      if (r.getAttribute('data-hidden-by-filter') === 'true') {
        r.style.display = 'none';
      }
    });

    const start = totalVisible === 0 ? 0 : (currentPage - 1) * PAGE_SIZE + 1;
    const end = Math.min(currentPage * PAGE_SIZE, totalVisible);
    const infoEl = document.getElementById(infoElId);
    if (infoEl) {
      infoEl.textContent = `Showing ${start}–${end} of ${totalVisible} ${type}`;
    }

    const btnsEl = document.getElementById(btnsElId);
    if (!btnsEl) return;
    btnsEl.innerHTML = '';

    if (totalPages > 1) {
      // Prev btn
      const prevBtn = document.createElement('button');
      prevBtn.className = 'pg-btn';
      prevBtn.textContent = '‹ Prev';
      prevBtn.disabled = (currentPage === 1);
      prevBtn.onclick = (e) => { 
        e.preventDefault();
        paginationState[type].page = currentPage - 1; 
        setupTablePagination(type, rows, infoElId, btnsElId); 
      };
      btnsEl.appendChild(prevBtn);

      for (let p = 1; p <= totalPages; p++) {
        const pageBtn = document.createElement('button');
        pageBtn.className = 'pg-btn' + (p === currentPage ? ' active' : '');
        pageBtn.textContent = p;
        pageBtn.onclick = ((pageNum) => (e) => { 
          e.preventDefault();
          paginationState[type].page = pageNum; 
          setupTablePagination(type, rows, infoElId, btnsElId); 
        })(p);
        btnsEl.appendChild(pageBtn);
      }

      // Next btn
      const nextBtn = document.createElement('button');
      nextBtn.className = 'pg-btn';
      nextBtn.textContent = 'Next ›';
      nextBtn.disabled = (currentPage === totalPages);
      nextBtn.onclick = (e) => { 
        e.preventDefault();
        paginationState[type].page = currentPage + 1; 
        setupTablePagination(type, rows, infoElId, btnsElId); 
      };
      btnsEl.appendChild(nextBtn);
    }
  }

  // Users Filter & Pagination
  function filterUsersTable() {
    const q = (document.getElementById('userSearchInput')?.value || '').toLowerCase().trim();
    const rows = Array.from(document.querySelectorAll('.user-row'));
    let matched = 0;
    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const email = row.getAttribute('data-email') || '';
      if (!q || name.includes(q) || email.includes(q)) {
        row.removeAttribute('data-hidden-by-filter');
        matched++;
      } else {
        row.setAttribute('data-hidden-by-filter', 'true');
      }
    });
    const empty = document.getElementById('emptyUserRow');
    if (empty) empty.style.display = (matched === 0) ? '' : 'none';
    setupTablePagination('users', rows, 'userPaginationInfo', 'userPaginationBtns');
  }

  // Chefs Filter & Pagination
  function filterChefsTable() {
    const q = (document.getElementById('chefSearchInput')?.value || '').toLowerCase().trim();
    const status = (document.getElementById('chefStatusFilter')?.value || 'ALL');
    const rows = Array.from(document.querySelectorAll('.chef-row'));
    let matched = 0;
    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const rowStatus = row.getAttribute('data-status') || '';
      const matchQ = !q || name.includes(q);
      const matchStatus = (status === 'ALL') || (rowStatus === status);
      if (matchQ && matchStatus) {
        row.removeAttribute('data-hidden-by-filter');
        matched++;
      } else {
        row.setAttribute('data-hidden-by-filter', 'true');
      }
    });
    const empty = document.getElementById('emptyChefRow');
    if (empty) empty.style.display = (matched === 0) ? '' : 'none';
    setupTablePagination('chefs', rows, 'chefPaginationInfo', 'chefPaginationBtns');
  }

  // Bookings Filter & Pagination
  function filterBookingsTable() {
    const q = (document.getElementById('bookingSearchInput')?.value || '').toLowerCase().trim();
    const status = (document.getElementById('bookingStatusFilter')?.value || 'ALL');
    const rows = Array.from(document.querySelectorAll('.booking-row'));
    let matched = 0;
    rows.forEach(row => {
      const searchData = row.getAttribute('data-search') || '';
      const rowStatus = row.getAttribute('data-status') || '';
