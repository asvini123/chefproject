<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard — ChefNest</title>
  <meta name="description" content="ChefNest Admin Control Panel — Manage users, chefs, bookings, payments, grocery approvals, and platform settings.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin-dashboard.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="admin-body">

<!-- ============================================================ -->
<!--  SIDEBAR                                                      -->
<!-- ============================================================ -->
<aside class="admin-sidebar" id="adminSidebar">
  <div class="sidebar-brand">
    <img src="/images/logo2.png" alt="ChefNest Logo" style="height:32px; width:auto; margin-right:8px;">
    <div class="brand-text">
      <span class="brand-name">ChefNest</span>
      <span class="brand-sub">Admin Panel</span>
    </div>
    <button class="sidebar-toggle-close" id="sidebarClose" aria-label="Close sidebar">✕</button>
  </div>

  <nav class="sidebar-nav" aria-label="Admin Navigation">
    <ul class="nav-list">

      <li class="nav-item active" data-section="dashboard">
        <a href="#" class="nav-link" onclick="return showSection('dashboard', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg></span>
          <span class="nav-label">Dashboard</span>
        </a>
      </li>

      <li class="nav-section-title">Platform</li>

      <li class="nav-item" data-section="users">
        <a href="#" class="nav-link" onclick="return showSection('users', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></span>
          <span class="nav-label">Users</span>
          <span class="nav-badge"><%= typeof users !== 'undefined' ? users.length : 0 %></span>
        </a>
      </li>

      <li class="nav-item" data-section="chefs">
        <a href="#" class="nav-link" onclick="return showSection('chefs', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7zm-3 18h6v-2H9v2z"/></svg></span>
          <span class="nav-label">Chefs</span>
          <% const _pendingChefsCount = (typeof chefs !== 'undefined' ? chefs.filter(c => !c.isApproved).length : 0); %>
          <span class="nav-badge <%= _pendingChefsCount > 0 ? 'warn' : '' %>" id="adminBadgeChefs" title="<%= _pendingChefsCount %> pending approvals">
            <%= typeof chefs !== 'undefined' ? chefs.length : 0 %>
          </span>
        </a>
      </li>

      <li class="nav-item" data-section="bookings">
        <a href="#" class="nav-link" onclick="return showSection('bookings', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg></span>
          <span class="nav-label">Bookings</span>
          <% const _pendingBookingsCount = (typeof bookings !== 'undefined' ? bookings.filter(b => b.status === 'Pending').length : 0); %>
          <span class="nav-badge <%= _pendingBookingsCount > 0 ? 'warn' : '' %>" id="adminBadgeBookings" title="<%= _pendingBookingsCount %> pending bookings">
            <%= typeof bookings !== 'undefined' ? bookings.length : 0 %>
          </span>
        </a>
      </li>

      <li class="nav-item" data-section="grocery">
        <a href="#" class="nav-link" onclick="return showSection('grocery', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg></span>
          <span class="nav-label">Grocery</span>
          <% const _groceryOrdersCount = (typeof bookings !== 'undefined' ? bookings.filter(b => b.grocerySupport).length : 0); %>
          <% const _pendingGroceryCount = (typeof bookings !== 'undefined' ? bookings.filter(b => b.grocerySupport && b.groceryApprovalStatus === 'Pending').length : 0); %>
          <span class="nav-badge <%= _pendingGroceryCount > 0 ? 'warn' : '' %>" id="adminBadgeGrocery" title="<%= _pendingGroceryCount %> pending grocery approvals">
            <%= _groceryOrdersCount %>
          </span>
        </a>
      </li>

      <li class="nav-section-title">Content</li>

      <li class="nav-item" data-section="courses">
        <a href="#" class="nav-link" onclick="return showSection('courses', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg></span>
          <span class="nav-label">Courses</span>
          <span class="nav-badge"><%= typeof courses !== 'undefined' ? courses.length : 0 %></span>
        </a>
      </li>

      <li class="nav-item" data-section="cuisines">
        <a href="#" class="nav-link" onclick="return showSection('cuisines', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg></span>
          <span class="nav-label">Cuisines</span>
          <span class="nav-badge"><%= typeof cuisines !== 'undefined' ? cuisines.length : 0 %></span>
        </a>
      </li>

      <li class="nav-item" data-section="reviews">
        <a href="#" class="nav-link" onclick="return showSection('reviews', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></span>
          <span class="nav-label">Reviews</span>
          <span class="nav-badge"><%= typeof reviews !== 'undefined' ? reviews.length : 0 %></span>
        </a>
      </li>

      <li class="nav-section-title">Finance</li>

      <li class="nav-item" data-section="subscriptions">
        <a href="#" class="nav-link" onclick="return showSection('subscriptions', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg></span>
          <span class="nav-label">Subscriptions</span>
          <span class="nav-badge"><%= typeof subscriptionPlans !== 'undefined' ? subscriptionPlans.length : 0 %></span>
        </a>
      </li>

      <li class="nav-item" data-section="payments">
        <a href="#" class="nav-link" onclick="return showSection('payments', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg></span>
          <span class="nav-label">Payments</span>
          <% const _completedPaymentsCount = (typeof receipts !== 'undefined' ? receipts.length : (typeof bookings !== 'undefined' ? bookings.filter(b => b.paymentStatus === 'Completed').length : 0)); %>
          <span class="nav-badge"><%= _completedPaymentsCount %></span>
        </a>
      </li>

      <li class="nav-item" data-section="discounts">
        <a href="#" class="nav-link" onclick="return showSection('discounts', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M22 10V6c0-1.11-.9-2-2-2H4c-1.1 0-1.99.89-1.99 2v4c1.1 0 1.99.9 1.99 2s-.89 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-6h2v6z"/></svg></span>
          <span class="nav-label">Discounts</span>
          <span class="nav-badge"><%= typeof discounts !== 'undefined' ? discounts.length : 0 %></span>
        </a>
      </li>

      <li class="nav-section-title">Analytics &amp; Tools</li>

      <li class="nav-item" data-section="reports">
        <a href="#" class="nav-link" onclick="return showSection('reports', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg></span>
          <span class="nav-label">Reports</span>
        </a>
      </li>

      <li class="nav-item" data-section="notifications">
        <a href="#" class="nav-link" onclick="return showSection('notifications', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg></span>
          <span class="nav-label">Notifications</span>
          <% const _unreadAdminNotifs = (typeof notifications !== 'undefined' ? notifications.filter(n => !n.isRead).length : 0); %>
          <span class="nav-badge <%= _unreadAdminNotifs > 0 ? 'warn' : '' %>" id="adminBadgeNotifs"><%= _unreadAdminNotifs %></span>
        </a>
      </li>

      <li class="nav-item" data-section="chat">
        <a href="#" class="nav-link" onclick="return showSection('chat', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg></span>
          <span class="nav-label">Live Chat</span>
          <span class="nav-badge" id="adminChatNavBadge" style="display:none; background:#e74c3c; color:#fff; font-weight:800; border-radius:10px; padding:0.15rem 0.5rem; font-size:0.75rem; margin-left:auto;">0</span>
        </a>
      </li>

      <li class="nav-item" data-section="settings">
        <a href="#" class="nav-link" onclick="return showSection('settings', this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg></span>
          <span class="nav-label">Settings</span>
        </a>
      </li>

      <li class="nav-divider"></li>

      <li class="nav-item">
        <a href="/" class="nav-link" style="color:#d5f5d5 !important; font-weight:700; background:rgba(255,255,255,0.12); border-radius:8px; margin:0.3rem 0.8rem; padding:0.6rem 1rem; border-left:none; display:flex; align-items:center; gap:0.75rem;">
          <span class="nav-icon" style="font-size:1.1rem;"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg></span>
          <span class="nav-label" style="color:#d5f5d5 !important;">Back to Home</span>
        </a>
      </li>

      <li class="nav-item logout-item">
        <a href="/admin/logout" class="nav-link logout-link">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.89-2-2-2z"/></svg></span>
          <span class="nav-label">Logout</span>
        </a>
      </li>
    </ul>
  </nav>
</aside>

<!-- ============================================================ -->
<!--  MAIN CONTENT                                                 -->
<!-- ============================================================ -->
<div class="admin-main" id="adminMain">

  <!-- TOP BAR -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn" aria-label="Toggle navigation">☰</button>
      <div class="topbar-breadcrumb">
        <span class="breadcrumb-root">Admin</span>
        <span class="breadcrumb-sep">›</span>
        <span class="breadcrumb-current" id="breadcrumbCurrent">Dashboard</span>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/" style="display:inline-flex; align-items:center; gap:0.4rem; font-size:0.8rem; font-weight:600; padding:0.35rem 0.85rem; border-radius:20px; background:#f4f8f4; color:#6b876c; text-decoration:none; border:1px solid #dce8dc; transition:all 0.2s; margin-right:0.5rem;" title="Back to ChefNest Home" onmouseover="this.style.color='#2C5F2D';this.style.background='#ffffff'" onmouseout="this.style.color='#6b876c';this.style.background='#f4f8f4'">
        <svg style="width:15px;height:15px;fill:currentColor;" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        <span style="color:#789479; font-weight:600;">Back to Home</span>
      </a>
      <div class="topbar-search">
        <input type="text" placeholder="Quick search..." id="adminSearch" aria-label="Admin search">
        <span class="search-icon-topbar"><svg style="width:14px;height:14px;fill:#6b876c;" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg></span>
      </div>
      <% const _topbarUnreadCount = (typeof notifications !== 'undefined' ? notifications.filter(n => !n.isRead).length : 0); %>
      <button class="topbar-notif" aria-label="Notifications" onclick="showSection('notifications', document.querySelector('[data-section=notifications] a'))" style="cursor:pointer;" title="Notifications">
        <svg style="width:18px;height:18px;fill:#4a5a4a;" viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
        <% if (_topbarUnreadCount > 0) { %>
          <span class="notif-dot" id="topbarNotifDot"></span>
        <% } %>
      </button>
      <div class="topbar-admin" onclick="document.getElementById('profileModal').classList.add('active')" style="cursor:pointer;" title="Edit Profile">
        <% if (user && user.profilePhoto) { %>
          <div class="admin-avatar" style="padding:0;overflow:hidden;">
            <img src="<%= user.profilePhoto %>" alt="Profile" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
          </div>
        <% } else { %>
          <div class="admin-avatar"><%= user ? user.firstName.charAt(0) : 'A' %></div>
        <% } %>
        <div class="admin-meta">
          <span class="admin-name"><%= user ? user.firstName + ' ' + user.lastName : 'Admin' %></span>
          <span class="admin-role">Administrator</span>
        </div>
      </div>
    </div>
  </header>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- ============================================================ -->
  <!--  SECTION: DASHBOARD                                           -->
  <!-- ============================================================ -->
  <section class="admin-section active" id="section-dashboard">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">Dashboard Overview</h1>
        <p class="section-subtitle">Welcome back, Admin. Here's what's happening today.</p>
      </div>
      <div class="section-actions">
        <select class="select-period" id="periodSelect" aria-label="Select period">
          <option>Last 7 Days</option>
          <option>Last 30 Days</option>
          <option>This Month</option>
          <option>This Year</option>
        </select>
      </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
      <div class="kpi-card kpi-users">
        <div class="kpi-icon-wrap">👤</div>
        <div class="kpi-body">
          <span class="kpi-label">Total Users</span>
          <span class="kpi-value"><%= users.length %></span>
          <span class="kpi-change up">+12.4% this month</span>
        </div>
      </div>
      <div class="kpi-card kpi-chefs">
        <div class="kpi-icon-wrap">👨‍🍳</div>
        <div class="kpi-body">
          <span class="kpi-label">Total Chefs</span>
          <span class="kpi-value"><%= chefs.length %></span>
          <span class="kpi-change up">+5.1% this month</span>
        </div>
      </div>
      <div class="kpi-card kpi-bookings">
        <div class="kpi-icon-wrap">📅</div>
        <div class="kpi-body">
          <span class="kpi-label">Total Bookings</span>
          <span class="kpi-value"><%= bookings.length %></span>
          <span class="kpi-change up">+8.7% this month</span>
        </div>
      </div>
      <div class="kpi-card kpi-revenue">
        <div class="kpi-icon-wrap">💰</div>
        <div class="kpi-body">
          <span class="kpi-label">Total Revenue</span>
          <span class="kpi-value">LKR <%= bookings.reduce((sum, b) => sum + (b.totalAmount || 0), 0).toLocaleString() %></span>
          <span class="kpi-change up">+18.2% this month</span>
        </div>
      </div>
      <div class="kpi-card kpi-pending">
        <div class="kpi-icon-wrap">⏳</div>
        <div class="kpi-body">
          <span class="kpi-label">Pending Chef Approvals</span>
          <span class="kpi-value"><%= chefs.filter(c => !c.isApproved).length %></span>
          <span class="kpi-change down">Needs action</span>
        </div>
      </div>
      <div class="kpi-card kpi-grocery">
        <div class="kpi-icon-wrap">🛒</div>
        <div class="kpi-body">
          <span class="kpi-label">Grocery Pending Approvals</span>
          <span class="kpi-value">8</span>
          <span class="kpi-change down">Needs action</span>
        </div>
      </div>
    </div>

    <!-- CHARTS -->
    <div class="charts-grid">
      <div class="chart-card chart-wide">
        <div class="chart-card-header">
          <h3>Monthly Bookings &amp; Revenue</h3>
          <div class="chart-legend">
            <span class="legend-dot green"></span> Bookings
            <span class="legend-dot orange"></span> Revenue (×LKR 100)
          </div>
        </div>
        <canvas id="bookingRevenueChart" height="100"></canvas>
      </div>
      <div class="chart-card">
        <div class="chart-card-header">
          <h3>Popular Cuisines</h3>
        </div>
        <canvas id="cuisineChart" height="200"></canvas>
      </div>
    </div>

    <div class="charts-grid">
      <div class="chart-card">
        <div class="chart-card-header">
          <h3>New Users / Month</h3>
        </div>
        <canvas id="usersChart" height="200"></canvas>
      </div>
      <div class="chart-card">
        <div class="chart-card-header">
          <h3>Chef Approval Status</h3>
        </div>
        <canvas id="chefStatusChart" height="200"></canvas>
      </div>
    </div>

    <!-- RECENT BOOKINGS TABLE -->
    <div class="table-card">
      <div class="table-card-header">
        <h3>Recent Bookings</h3>
        <button class="btn-table-action" onclick="showSection('bookings', document.querySelector('[data-section=bookings] .nav-link'))">View All →</button>
      </div>
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Booking ID</th>
              <th>Customer</th>
              <th>Chef</th>
              <th>Date</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (bookings && bookings.length > 0) { %>
              <% bookings.forEach(b => { %>
                <tr>
                  <td><span class="id-badge">#<%= b._id.toString().slice(-4).toUpperCase() %></span></td>
                  <td><%= b.userId ? b.userId.firstName + ' ' + b.userId.lastName : 'Unknown' %></td>
                  <td><%= b.chefId ? 'Chef ' + b.chefId.firstName : 'Unknown' %></td>
                  <td><%= new Date(b.date).toLocaleDateString() %></td>
                  <td>LKR <%= b.totalAmount %></td>
                  <td><span class="status-badge <%= b.status === 'Accepted' ? 'confirmed' : 'pending' %>"><%= b.status %></span></td>
                  <td><button class="btn-mini" onclick="viewBookingDetails('<%= b._id %>')" style="cursor:pointer;">👁️ View</button></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="7" style="text-align:center;">No bookings found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  SECTION: USERS                                               -->
  <!-- ============================================================ -->
  <section class="admin-section" id="section-users">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">User Management</h1>
        <p class="section-subtitle">Real database users list (<%= typeof users !== 'undefined' ? users.length : 0 %> registered).</p>
      </div>
      <div class="section-actions">
        <input type="text" id="userSearchInput" oninput="filterUsersTable()" class="search-input" placeholder="Search users by name or email..." aria-label="Search users">
      </div>
    </div>
    <div class="table-card">
      <div class="table-responsive">
        <table class="admin-table" id="usersAdminTable">
          <thead>
            <tr>
              <th>ID</th><th>User Name</th><th>Email</th><th>Phone</th><th>Joined Date</th><th>Role</th><th>Status</th>
            </tr>
          </thead>
          <tbody id="userTableBody">
            <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
              <% users.forEach(u => { %>
                <tr class="user-row" data-name="<%= (u.firstName + ' ' + u.lastName).toLowerCase() %>" data-email="<%= (u.email || '').toLowerCase() %>">
                  <td><span class="id-badge">#<%= u._id.toString().slice(-4).toUpperCase() %></span></td>
                  <td><strong><%= u.firstName %> <%= u.lastName %></strong></td>
                  <td><%= u.email %></td>
                  <td><%= u.phone || 'N/A' %></td>
                  <td><%= new Date(u.createdAt || Date.now()).toLocaleDateString() %></td>
                  <td><span style="background:rgba(44,95,45,0.08);color:#2C5F2D;padding:2px 8px;border-radius:12px;font-size:0.75rem;font-weight:700;"><%= u.role.toUpperCase() %></span></td>
                  <td><span class="status-badge confirmed">Active</span></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr id="emptyUserRow"><td colspan="7" style="text-align:center; padding:2.5rem; color:var(--text-muted);">No users registered in database yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="pagination-row" id="userPaginationRow">
        <span class="pagination-info" id="userPaginationInfo">Showing 1–<%= Math.min(typeof users !== 'undefined' ? users.length : 0, 8) %> of <%= typeof users !== 'undefined' ? users.length : 0 %> users</span>
        <div class="pagination-btns" id="userPaginationBtns">
          <!-- Populated by JavaScript -->
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  SECTION: CHEFS                                               -->
  <!-- ============================================================ -->
  <section class="admin-section" id="section-chefs">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">Chef Management</h1>
        <p class="section-subtitle">Real database chefs (<%= typeof chefs !== 'undefined' ? chefs.length : 0 %> total, approve or suspend accounts).</p>
      </div>
      <div class="section-actions">
        <select id="chefStatusFilter" onchange="filterChefsTable()" class="select-period" aria-label="Filter chefs">
          <option value="ALL">All Chefs</option>
          <option value="pending">Pending Approval</option>
          <option value="active">Active</option>
        </select>
        <input type="text" id="chefSearchInput" oninput="filterChefsTable()" class="search-input" placeholder="Search chefs by name or city..." aria-label="Search chefs">
      </div>
    </div>
    <% const pendingChefCount = (typeof chefs !== 'undefined') ? chefs.filter(c => !c.isApproved).length : 0; %>
    <% if (pendingChefCount > 0) { %>
    <div class="alert-banner warn">
      <svg class="svg-icon" viewBox="0 0 24 24" style="width:18px;height:18px;fill:#b45309;vertical-align:middle;"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
      <strong><%= pendingChefCount %> chef<%= pendingChefCount > 1 ? 's' : '' %></strong> awaiting approval. Review their submitted documents.
    </div>
    <% } %>
    <div class="table-card">
      <div class="table-responsive">
        <table class="admin-table" id="chefsAdminTable">
          <thead>
            <tr>
              <th>ID</th><th>Chef Name</th><th>Specialty</th><th>Location</th><th>Hourly Rate</th><th>Status</th><th>Documents</th><th>Actions</th>
            </tr>
          </thead>
          <tbody id="chefTableBody">
            <% if (typeof chefs !== 'undefined' && chefs && chefs.length > 0) { %>
              <% chefs.forEach((chef, index) => { %>
                <tr class="chef-row" data-id="<%= chef._id %>" data-name="<%= (chef.firstName + ' ' + chef.lastName + ' ' + (chef.city || '')).toLowerCase() %>" data-status="<%= chef.isApproved ? 'active' : 'pending' %>">
                  <td><span class="id-badge">#<%= chef._id.toString().slice(-4).toUpperCase() %></span></td>
                  <td><strong><%= chef.firstName %> <%= chef.lastName %></strong></td>
                  <td><%= chef.chefType ? chef.chefType.replace('_', ' ').toUpperCase() : 'PROFESSIONAL' %></td>
                  <td><%= chef.city || 'N/A' %></td>
                  <td>LKR <%= chef.hourlyRate || 0 %>/hr</td>
                  <td>
                    <span class="status-badge <%= chef.isApproved ? 'confirmed' : 'pending' %>">
                      <%= chef.isApproved ? 'Active' : 'Pending' %>
                    </span>
                  </td>
                  <td>
                    <div style="display:flex; flex-wrap:wrap; gap:0.35rem;">
                      <% if (chef.nicFront) { %>
                        <a href="<%= chef.nicFront %>" target="_blank" class="btn-doc" style="text-decoration:none; font-size:0.75rem;">🪪 Front</a>
                      <% } else if (chef.nic) { %>
                        <a href="<%= chef.nic %>" target="_blank" class="btn-doc" style="text-decoration:none; font-size:0.75rem;">🪪 NIC</a>
                      <% } %>
                      <% if (chef.nicBack) { %>
                        <a href="<%= chef.nicBack %>" target="_blank" class="btn-doc" style="text-decoration:none; font-size:0.75rem;">🪪 Back</a>
                      <% } %>
                      <% if (chef.policeClearance) { %>
                        <a href="<%= chef.policeClearance %>" target="_blank" class="btn-doc" style="text-decoration:none; font-size:0.75rem;">🚔 Police</a>
                      <% } %>
                    </div>
                  </td>
                  <td class="action-btns">
                    <% if (!chef.isApproved) { %>
                      <button type="button" onclick="updateChefStatus('<%= chef._id %>', 'approve', this)" title="Approve Chef" style="background:#dcfce7; color:#166534; border:1px solid #86efac; padding:5px 10px; border-radius:6px; font-weight:700; font-size:0.78rem; cursor:pointer; display:inline-flex; align-items:center; gap:4px; white-space:nowrap;">✅ Approve</button>
                      <button type="button" onclick="updateChefStatus('<%= chef._id %>', 'reject', this)" title="Reject Chef" style="background:#fee2e2; color:#dc2626; border:1px solid #fca5a5; padding:5px 10px; border-radius:6px; font-weight:700; font-size:0.78rem; cursor:pointer; display:inline-flex; align-items:center; gap:4px; white-space:nowrap;">❌ Reject</button>
                    <% } else { %>
                      <button type="button" onclick="updateChefStatus('<%= chef._id %>', 'reject', this)" title="Suspend Chef" style="background:#fee2e2; color:#dc2626; border:1px solid #fca5a5; padding:5px 12px; border-radius:6px; font-weight:700; font-size:0.78rem; cursor:pointer; display:inline-flex; align-items:center; gap:4px; white-space:nowrap;">⏸️ Suspend</button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr id="emptyChefRow"><td colspan="8" style="text-align:center; padding:2.5rem; color:var(--text-muted);">No chefs registered yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="pagination-row" id="chefPaginationRow">
        <span class="pagination-info" id="chefPaginationInfo">Showing 1–<%= Math.min(typeof chefs !== 'undefined' ? chefs.length : 0, 8) %> of <%= typeof chefs !== 'undefined' ? chefs.length : 0 %> chefs</span>
        <div class="pagination-btns" id="chefPaginationBtns">
          <!-- Populated by JavaScript -->
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  SECTION: BOOKINGS (Real Database Bookings)                    -->
  <!-- ============================================================ -->
  <section class="admin-section" id="section-bookings">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">All Bookings Management</h1>
        <p class="section-subtitle">Real database bookings (<%= typeof bookings !== 'undefined' ? bookings.length : 0 %> total reservations).</p>
      </div>
      <div class="section-actions">
        <select id="bookingStatusFilter" onchange="filterBookingsTable()" class="select-period" aria-label="Filter bookings">
          <option value="ALL">All Bookings</option>
          <option value="Pending">Pending</option>
          <option value="Accepted">Accepted</option>
          <option value="Confirmed">Confirmed</option>
          <option value="Completed">Completed</option>
          <option value="Cancelled">Cancelled</option>
        </select>
        <input type="text" id="bookingSearchInput" oninput="filterBookingsTable()" class="search-input" placeholder="Search by customer, chef or ref..." aria-label="Search bookings">
      </div>
    </div>
    <div class="table-card">
      <div class="table-responsive">
        <table class="admin-table" id="bookingsAdminTable">
          <thead>
            <tr>
              <th>Booking Ref</th>
              <th>Customer</th>
              <th>Assigned Chef</th>
              <th>Date &amp; Time</th>
              <th>Guests</th>
              <th>Amount</th>
              <th>Grocery</th>
              <th>Status</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody id="bookingTableBody">
            <% if (typeof bookings !== 'undefined' && bookings && bookings.length > 0) { %>
              <% bookings.forEach((b, idx) => { %>
                <% const bookingRef = b._id.toString().slice(-6).toUpperCase(); %>
                <% const custName = b.userId ? (b.userId.firstName + ' ' + b.userId.lastName) : 'Guest User'; %>
                <% const chefName = b.chefId ? ('Chef ' + b.chefId.firstName + ' ' + b.chefId.lastName) : 'Unassigned'; %>
                <tr class="booking-row" 
                    data-id="<%= b._id %>" 
                    data-status="<%= b.status %>"
                    data-search="<%= (bookingRef + ' ' + custName + ' ' + chefName + ' ' + (b.location || '')).toLowerCase() %>">
                  <td><span class="id-badge">#BK-<%= bookingRef %></span></td>
                  <td>
                    <strong><%= custName %></strong>
                    <% if (b.userId && b.userId.phone) { %><br><small style="color:#777;"><%= b.userId.phone %></small><% } %>
                  </td>
                  <td><%= chefName %></td>
                  <td>
                    <%= b.date ? new Date(b.date).toLocaleDateString() : 'N/A' %><br>
                    <small style="color:#777;"><%= b.time || 'Flexible' %> (<%= b.duration || 3 %> hrs)</small>
                  </td>
                  <td><%= (parseInt(b.adults) || 1) + (parseInt(b.children) || 0) %> Guests</td>
                  <td><strong>LKR <%= (b.totalAmount || 0).toLocaleString() %></strong></td>
                  <td>
                    <% if (b.grocerySupport) { %>
                      <span class="status-badge confirmed" style="font-size:0.72rem;">🛒 <%= b.groceryApprovalStatus || 'Requested' %></span>
                    <% } else { %>
                      <span style="color:#999;font-size:0.75rem;">None</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="status-badge <%= (b.status === 'Accepted' || b.status === 'Confirmed' || b.status === 'Completed') ? 'confirmed' : (b.status === 'Cancelled' ? 'cancelled' : 'pending') %>">
                      <%= b.status %>
                    </span>
                  </td>
                  <td class="action-btns">
                    <button class="btn-action view" title="View Full Details" onclick="viewBookingDetails('<%= b._id %>')">👁️ View</button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr id="emptyBookingRow">
                <td colspan="9" style="text-align:center; padding:3rem; color:var(--text-muted);">
                  📅 No bookings found in database.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="pagination-row" id="bookingPaginationRow">
        <span class="pagination-info" id="bookingPaginationInfo">Showing 1–<%= Math.min(typeof bookings !== 'undefined' ? bookings.length : 0, 8) %> of <%= typeof bookings !== 'undefined' ? bookings.length : 0 %> bookings</span>
        <div class="pagination-btns" id="bookingPaginationBtns">
          <!-- Populated by JavaScript -->
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  SECTION: GROCERY (Admin Approval Workflow)                  -->
  <!-- ============================================================ -->
  <section class="admin-section" id="section-grocery">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">Grocery &amp; Ingredients Management</h1>
        <p class="section-subtitle">Manage platform ingredients, custom categories, and approve/reject chef grocery support requests.</p>
      </div>
      <div class="section-actions">
        <button class="btn-primary-sm" onclick="openAddIngredientCategoryModal()" style="background:#B5601D; color:#fff; padding:0.6rem 1.2rem; border-radius:8px; border:none; font-weight:700; cursor:pointer; font-size:0.9rem; display:inline-flex; align-items:center; gap:0.4rem;">
          🏷️ Add Category
        </button>
        <button class="btn-primary-sm" onclick="openAddIngredientModal()" style="background:#2C5F2D; color:#fff; padding:0.6rem 1.2rem; border-radius:8px; border:none; font-weight:700; cursor:pointer; font-size:0.9rem; display:inline-flex; align-items:center; gap:0.4rem;">
          ➕ Add Ingredient
        </button>
      </div>
    </div>

    <div class="alert-banner info">
      🛒 <strong>Grocery Support System:</strong> Chefs submit grocery requests per booking. Each request requires <strong>Admin approval</strong> before processing. Rejected items are notified to the chef.
    </div>

    <div class="mini-kpi-row">
      <div class="mini-kpi">
        <span class="mini-kpi-val">8</span>
        <span class="mini-kpi-label">Pending Requests</span>
      </div>
      <div class="mini-kpi">
        <span class="mini-kpi-val">42</span>
        <span class="mini-kpi-label">Approved This Month</span>
      </div>
      <div class="mini-kpi">
        <span class="mini-kpi-val">3</span>
        <span class="mini-kpi-label">Rejected</span>
      </div>
      <div class="mini-kpi">
        <span class="mini-kpi-val">LKR 3,820</span>
        <span class="mini-kpi-label">Total Grocery Spend</span>
      </div>
    </div>

    <!-- INGREDIENTS DATABASE MANAGEMENT TABLE CARD -->
    <div class="table-card" style="margin-top:1.5rem;">
      <div style="padding:1.2rem 1.5rem 0.5rem; border-bottom:1px solid #eef2ee;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.8rem;">
          <div>
            <h3 style="margin:0; font-size:1.2rem; color:#1a3a1b; display:flex; align-items:center; gap:0.4rem;">
              🌿 Ingredients Database Catalog
            </h3>
            <p style="margin:0.25rem 0 0; font-size:0.85rem; color:var(--text-muted);">
              Add, edit, or remove ingredients and custom categories. All additions save directly to the database.
            </p>
          </div>
          <div style="display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap;">
            <select id="ingCatFilter" onchange="filterIngredientsTable()" class="select-period" style="padding:0.5rem 0.9rem; font-size:0.88rem; border-radius:8px;" aria-label="Filter category">
              <option value="ALL">All Categories</option>
              <% if (typeof ingredientCategories !== 'undefined' && ingredientCategories && ingredientCategories.length > 0) { %>
                <% ingredientCategories.forEach(c => { %>
                  <option value="<%= c.name %>"><%= c.name %></option>
                <% }) %>
              <% } else { %>
                <option value="Vegetables & Produce">Vegetables & Produce</option>
                <option value="Spices & Condiments">Spices & Condiments</option>
                <option value="Proteins">Proteins</option>
                <option value="Rice, Grains & Flour">Rice, Grains & Flour</option>
                <option value="Dairy & Coconut">Dairy & Coconut</option>
                <option value="Fresh Herbs & Aromatics">Fresh Herbs & Aromatics</option>
                <option value="Oils & Sauces">Oils & Sauces</option>
                <option value="Fruits & Sweet Ingredients">Fruits & Sweet Ingredients</option>
              <% } %>
            </select>
            <button type="button" onclick="openAddIngredientCategoryModal()" style="background:#B5601D; color:#fff; padding:0.55rem 1rem; border-radius:8px; border:none; font-weight:700; cursor:pointer; font-size:0.88rem; display:inline-flex; align-items:center; gap:0.3rem;">
              🏷️ Add Category
            </button>
            <button type="button" onclick="openAddIngredientModal()" style="background:#2C5F2D; color:#fff; padding:0.55rem 1.1rem; border-radius:8px; border:none; font-weight:700; cursor:pointer; font-size:0.88rem; display:inline-flex; align-items:center; gap:0.3rem;">
              ➕ Add Ingredient
            </button>
          </div>
        </div>

        <!-- QUICK ADD INLINE BAR -->
        <div style="background:#f4f9f4; border:1.5px solid #cbe4cb; border-radius:12px; padding:0.9rem 1.2rem; margin:1rem 0 0.5rem; display:flex; gap:0.8rem; align-items:flex-end; flex-wrap:wrap;">
          <div style="flex:2; min-width:200px;">
            <label style="font-size:0.75rem; font-weight:700; color:#2C5F2D; text-transform:uppercase; display:block; margin-bottom:0.3rem;">Ingredient Name</label>
            <input id="quickIngName" type="text" placeholder="Type ingredient name (e.g. Cardamom, Lemongrass)..." 
                   style="width:100%; padding:0.6rem 0.9rem; border:1.5px solid #cbe4cb; border-radius:8px; font-size:0.9rem; outline:none; background:#fff; box-sizing:border-box;"
                   onkeydown="if(event.key==='Enter'){event.preventDefault();submitQuickAddIngredient();}">
          </div>
          <div style="flex:1.5; min-width:180px;">
            <label style="font-size:0.75rem; font-weight:700; color:#2C5F2D; text-transform:uppercase; display:block; margin-bottom:0.3rem;">Category</label>
            <select id="quickIngCategory" style="width:100%; padding:0.6rem 0.9rem; border:1.5px solid #cbe4cb; border-radius:8px; font-size:0.9rem; outline:none; background:#fff; box-sizing:border-box;">
              <% if (typeof ingredientCategories !== 'undefined' && ingredientCategories && ingredientCategories.length > 0) { %>
                <% ingredientCategories.forEach(c => { %>
                  <option value="<%= c.name %>"><%= c.name %></option>
                <% }) %>
              <% } else { %>
                <option value="Vegetables & Produce">Vegetables & Produce</option>
                <option value="Spices & Condiments">Spices & Condiments</option>
                <option value="Proteins">Proteins</option>
                <option value="Rice, Grains & Flour">Rice, Grains & Flour</option>
                <option value="Dairy & Coconut">Dairy & Coconut</option>
                <option value="Fresh Herbs & Aromatics">Fresh Herbs & Aromatics</option>
                <option value="Oils & Sauces">Oils & Sauces</option>
                <option value="Fruits & Sweet Ingredients">Fruits & Sweet Ingredients</option>
              <% } %>
            </select>
          </div>
          <div>
            <button type="button" id="quickAddBtn" onclick="submitQuickAddIngredient()" 
                    style="background:#2C5F2D; color:#fff; padding:0.65rem 1.3rem; border-radius:8px; border:none; font-weight:700; cursor:pointer; font-size:0.9rem; white-space:nowrap; display:inline-flex; align-items:center; gap:0.4rem;">
              ➕ Add
            </button>
          </div>
        </div>
      </div>

      <div class="table-responsive" style="margin-top:0.5rem;">
        <table class="admin-table" id="ingredientsAdminTable">
          <thead>
            <tr>
              <th>Ingredient Name</th>
              <th>Category</th>
              <th>Date Added</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody id="ingTableBody">
            <% if (typeof ingredients !== 'undefined' && ingredients && ingredients.length > 0) { %>
              <% ingredients.forEach(ing => { %>
                <tr class="ing-row" data-id="<%= ing._id %>" data-category="<%= ing.category %>" data-name="<%= ing.name.toLowerCase() %>">
                  <td><strong><%= ing.name %></strong></td>
                  <td>
                    <span class="status-badge confirmed" style="font-size:0.75rem; padding:0.25rem 0.6rem; border-radius:12px;">
                      <%= ing.category %>
                    </span>
                  </td>
                  <td><%= new Date(ing.createdAt || Date.now()).toLocaleDateString() %></td>
                  <td class="action-btns" style="text-align:right;">
                    <button class="btn-action edit" title="Edit" onclick="openEditIngredientModal('<%= ing._id %>', '<%= ing.name.replace(/'/g, '\\\'') %>', '<%= ing.category.replace(/'/g, '\\\'') %>')">✏️ Edit</button>
                    <button class="btn-action delete" title="Delete" onclick="deleteIngredient('<%= ing._id %>', '<%= ing.name.replace(/'/g, '\\\'') %>')">🗑️ Delete</button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr id="emptyIngRow">
                <td colspan="4" style="text-align:center; padding:3rem 1.5rem; color:var(--text-muted);">
                  <div style="font-size:2.2rem; margin-bottom:0.5rem;">🌿</div>
                  <div style="font-size:1.1rem; font-weight:700; color:#2C5F2D; margin-bottom:0.3rem;">No ingredients found in database yet</div>
                  <p style="margin-bottom:1.2rem; font-size:0.9rem; color:#6a7a6a;">Type an ingredient name above or click the button below to add your first ingredient.</p>
                  <button type="button" onclick="openAddIngredientModal()" style="background:#2C5F2D; color:#fff; padding:0.7rem 1.6rem; border-radius:8px; border:none; font-weight:700; cursor:pointer; font-size:0.92rem; display:inline-flex; align-items:center; gap:0.4rem;">
                    ➕ Add Ingredient Now
                  </button>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- CHEF GROCERY SUPPORT APPROVAL QUEUE -->
    <div class="table-card" style="margin-top:2rem;">
      <div class="table-card-header">
        <h3>🛒 Grocery Approval Queue (Chef Requests)</h3>
        <select class="select-period" aria-label="Filter grocery">
          <option>All Requests</option>
          <option>Pending Approval</option>
          <option>Approved</option>
          <option>Rejected</option>
        </select>
      </div>
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Request ID</th><th>Chef</th><th>Booking</th><th>Items</th><th>Est. Cost</th><th>Submitted</th><th>Status</th><th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% const groceryBookings = bookings.filter(b => b.grocerySupport === true); %>
            <% if (groceryBookings.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align:center; padding:2rem; color:var(--text-muted);">
                  📭 No active grocery support requests found in database.
                </td>
              </tr>
            <% } else { %>
              <% groceryBookings.forEach(b => { %>
                <tr>
                  <td><span class="id-badge">#GR-<%= b._id.toString().slice(-4).toUpperCase() %></span></td>
                  <td>Chef <%= b.chefId ? `${b.chefId.firstName} ${b.chefId.lastName}` : 'Unassigned' %></td>
                  <td>#BK-<%= b._id.toString().slice(-4).toUpperCase() %></td>
                  <td>
                    <% const userItemsCount = b.groceryItemsNeeded ? b.groceryItemsNeeded.split(',').length : 0; %>
                    <% const chefItemsCount = b.extraIngredients ? b.extraIngredients.split(',').length : 0; %>
                    <button class="btn-doc" onclick="toggleGroceryItems('<%= b._id %>')">🧾 <%= userItemsCount + chefItemsCount %> items</button>
                    <div class="grocery-items-list hidden" id="<%= b._id %>" style="min-width: 220px; line-height: 1.4; padding: 0.8rem;">
                      <strong>👤 User requested:</strong><br>
                      <%= b.groceryItemsNeeded || 'None specified' %><br><br>
                      <strong>👨‍🍳 Chef extra items:</strong><br>
                      <%= b.extraIngredients || 'No extras added by chef yet' %>
                    </div>
                  </td>
                  <td>LKR <%= (b.groceryCharge || 500).toLocaleString() %></td>
                  <td><%= new Date(b.createdAt || Date.now()).toDateString() %></td>
                  <td>
                    <span class="status-badge <%= b.groceryApprovalStatus === 'Approved' ? 'confirmed' : (b.groceryApprovalStatus === 'Rejected' ? 'cancelled' : 'pending') %>">
                      <%= b.groceryApprovalStatus %>
                    </span>
                  </td>
                  <td class="action-btns">
                    <% if (b.groceryApprovalStatus === 'Pending') { %>
                      <button class="btn-action approve" onclick="respondGroceryRequest('<%= b._id %>', 'approve')">✅ Approve</button>
                      <button class="btn-action reject" onclick="respondGroceryRequest('<%= b._id %>', 'reject')">❌ Reject</button>
                    <% } else { %>
                      <button class="btn-action view" title="View details" onclick="alert('Request is already <%= b.groceryApprovalStatus %>')">👁️</button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  SECTION: COURSES                                             -->
  <!-- ============================================================ -->
  <section class="admin-section" id="section-courses">
    <div class="section-header-row">
      <div>
        <h1 class="section-title">Course Management</h1>
        <p class="section-subtitle">Add, approve or delete cooking courses.</p>
      </div>
      <div class="section-actions">
        <button class="btn-primary-sm" onclick="openAddCourseModal()">+ Add Course</button>
      </div>
    </div>
    <div class="table-card">
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr><th>Course</th><th>Category</th><th>Chef</th><th>Duration</th><th>Price</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% if (courses && courses.length > 0) { %>
              <% courses.forEach(c => { %>
                <tr>
                  <td style="max-width:200px;">
                    <div style="font-weight:600;"><%= c.title %></div>
                    <% if (c.description) { %><div style="font-size:0.75rem;color:#888;"><%= c.description.substring(0,60) %><%= c.description.length > 60 ? '…' : '' %></div><% } %>
                  </td>
                  <td><span style="background:#e8f5e9;color:#2C5F2D;padding:2px 8px;border-radius:12px;font-size:0.75rem;font-weight:600;text-transform:capitalize;"><%= c.category || 'cuisine' %></span></td>
                  <td><%= c.chefId ? 'Chef ' + c.chefId.firstName : 'Unknown' %></td>
                  <td><%= c.duration %></td>
                  <td>LKR <%= c.price %></td>
                  <td><span class="status-badge <%= c.status === 'Live' ? 'confirmed' : 'pending' %>"><%= c.status %></span></td>
                  <td class="action-btns">
                    <button class="btn-action view" title="Toggle Live/Pending" onclick="toggleCourseStatus('<%= c._id %>', '<%= c.status %>')">
                      <%= c.status === 'Live' ? '⏸️' : '▶️' %>
                    </button>
                    <button class="btn-action delete" title="Delete" onclick="deleteCourse('<%= c._id %>')">🗑️</button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="7" style="text-align:center;padding:2rem;color:#888;">No courses yet. Click "+ Add Course" to create one.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ADD COURSE MODAL -->
  <div id="addCourseModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(4px);"
    onclick="if(event.target===this)closeAddCourseModal()">
    <div style="background:#fff;border-radius:20px;padding:0;max-width:520px;width:93%;box-shadow:0 20px 60px rgba(0,0,0,0.3);overflow:hidden;font-family:inherit;max-height:90vh;overflow-y:auto;">
      <!-- Header -->
      <div style="background:linear-gradient(135deg,#1a3a1b,#2C5F2D);padding:1.5rem 2rem;position:relative;">
        <h3 style="color:#fff;margin:0;font-size:1.1rem;font-weight:800;">📚 Add New Course</h3>
        <p style="color:rgba(255,255,255,0.7);font-size:0.8rem;margin:0.3rem 0 0;">Course will be saved to database and shown in user dashboard.</p>
        <button onclick="closeAddCourseModal()" style="position:absolute;top:1rem;right:1.2rem;background:rgba(255,255,255,0.15);border:none;color:#fff;border-radius:50%;width:28px;height:28px;cursor:pointer;font-size:1rem;">✕</button>
      </div>
      <!-- Form -->
      <div style="padding:1.8rem 2rem;">
        <div id="acError" style="display:none;background:#ffeaea;border:1px solid #f5c6c6;border-radius:8px;padding:0.7rem 1rem;margin-bottom:1rem;color:#c0392b;font-size:0.85rem;"></div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
          <div style="grid-column:1/-1;">
