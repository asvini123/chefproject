<%- include('partials/header', { title: 'Booking Confirmed! - ChefNest' }) %>

<style>
  .success-page {
    min-height: 80vh;
    background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 5%;
    font-family: var(--font-family-sans);
  }
  .success-card {
    background: var(--white);
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
    padding: 4rem;
    max-width: 620px;
    width: 100%;
    text-align: center;
  }
  .success-icon {
    font-size: 5rem;
    margin-bottom: 1.5rem;
    animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes popIn {
    from { transform: scale(0); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .success-title {
    font-family: var(--font-family-serif);
    font-size: 2.5rem;
    color: var(--forest-green-dark);
    margin-bottom: 0.5rem;
  }
  .success-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 2.5rem;
  }
  .booking-summary-box {
    background: var(--bg-light);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    text-align: left;
  }
  .booking-summary-box h3 {
    font-family: var(--font-family-serif);
    font-size: 1.2rem;
    color: var(--forest-green);
    margin-bottom: 1rem;
  }
  .booking-detail-row {
    display: flex;
    justify-content: space-between;
    padding: 0.6rem 0;
    border-bottom: 1px dashed var(--border);
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .booking-detail-row:last-child { border: none; }
  .booking-detail-row span:last-child { font-weight: 600; color: var(--text-dark); }

  .booking-id-badge {
    background: var(--forest-green-dark);
    color: white;
    padding: 0.5rem 1.5rem;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 600;
    display: inline-block;
    margin-bottom: 2rem;
  }
  .status-pending {
    background: #fff8e1;
    border: 2px solid #ffe082;
    border-radius: 12px;
    padding: 1rem 1.5rem;
    color: #f57f17;
    font-weight: 600;
    margin-bottom: 2rem;
    font-size: 1rem;
  }
  .success-actions { display: flex; gap: 1rem; justify-content: center; }
  .btn-home {
    background: var(--forest-green);
    color: white;
    padding: 0.9rem 2rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.2s;
  }
  .btn-home:hover { background: var(--forest-green-dark); }
  .btn-dashboard {
    background: var(--bg-light);
    color: var(--forest-green);
    padding: 0.9rem 2rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    border: 2px solid var(--forest-green);
    transition: all 0.2s;
  }
  .btn-dashboard:hover { background: #e8f5e9; }
</style>

<main class="success-page">
  <div class="success-card">

    <div class="success-icon"><%= booking.paymentStatus === 'Completed' ? '🎉' : '📋' %></div>
    <h1 class="success-title"><%= booking.paymentStatus === 'Completed' ? 'Booking & Payment Confirmed!' : 'Booking Request Sent!' %></h1>
    <p class="success-subtitle">
      <%= booking.paymentStatus === 'Completed' ? 'Your booking and online payment have been successfully received & verified.' : 'Your booking is submitted. Chef & Admin will review shortly.' %>
    </p>

    <% const memberIdStr = (booking.userId && booking.userId.memberId) ? booking.userId.memberId : ((typeof user !== 'undefined' && user && user.memberId) ? user.memberId : ('CN-USR-' + (booking.userId ? booking.userId._id.toString().slice(-4).toUpperCase() : '2968'))); %>
    <% const memberNum = memberIdStr.replace('CN-USR-', ''); %>
    <% const bookingRefShort = '#BK-' + memberNum + '-' + booking._id.toString().slice(-4).toUpperCase(); %>
    <% const displayAmount = (booking.totalAmount && booking.totalAmount > 0) ? booking.totalAmount : (((booking.chefId && booking.chefId.hourlyRate ? booking.chefId.hourlyRate : 1500) * (booking.duration || 2)) + (booking.grocerySupport ? 500 : 0)); %>

    <div class="booking-id-badge" style="display:inline-flex; align-items:center; gap:0.6rem; padding:0.6rem 1.5rem; border-radius:30px; font-weight:700; margin-bottom:1.5rem; background:#1a5c2a; color:#fff;">
      <span>Booking ID: <strong><%= bookingRefShort %></strong></span>
      <span style="opacity:0.6;">|</span>
      <span>Member ID: <strong><%= memberIdStr %></strong></span>
    </div>

    <!-- Approval Steps -->
    <div style="display:flex; align-items:center; justify-content:center; gap:0; margin-bottom:1.5rem;">
      <div style="text-align:center; flex:1;">
        <div style="width:36px;height:36px;border-radius:50%;background:#1a5c2a;color:white;display:flex;align-items:center;justify-content:center;margin:0 auto 0.3rem;font-weight:700;">✓</div>
        <small style="font-size:0.7rem;font-weight:700;color:#1a5c2a;text-transform:uppercase;">Submitted</small>
      </div>
      <div style="flex:1;height:2px;background:#e5e7eb;margin-bottom:20px;"></div>
      <div style="text-align:center; flex:1;">
        <div style="width:36px;height:36px;border-radius:50%;background:<%= booking.paymentStatus === 'Completed' ? '#1a5c2a' : '#e5e7eb' %>;color:<%= booking.paymentStatus === 'Completed' ? 'white' : '#9ca3af' %>;display:flex;align-items:center;justify-content:center;margin:0 auto 0.3rem;font-weight:700;"><%= booking.paymentStatus === 'Completed' ? '✓' : '2' %></div>
        <small style="font-size:0.7rem;font-weight:700;color:<%= booking.paymentStatus === 'Completed' ? '#1a5c2a' : '#9ca3af' %>;text-transform:uppercase;">Payment</small>
      </div>
      <div style="flex:1;height:2px;background:#e5e7eb;margin-bottom:20px;"></div>
      <div style="text-align:center; flex:1;">
        <div style="width:36px;height:36px;border-radius:50%;background:#e5e7eb;color:#9ca3af;display:flex;align-items:center;justify-content:center;margin:0 auto 0.3rem;font-weight:700;">3</div>
        <small style="font-size:0.7rem;font-weight:700;color:#9ca3af;text-transform:uppercase;">Chef Confirms</small>
      </div>
    </div>

    <% if (booking.paymentStatus === 'Completed') { %>
      <div style="background:#f0fdf4;border:1.5px solid #86efac;border-radius:10px;padding:0.9rem 1.2rem;margin-bottom:1.5rem;text-align:left;">
        <p style="font-size:0.88rem;color:#166534;line-height:1.5;"><strong>✅ Payment Confirmed:</strong> LKR <strong><%= displayAmount.toLocaleString() %></strong> received via <strong><%= booking.paymentMethod %></strong>. Your booking receipt has been generated.</p>
      </div>
    <% } else { %>
      <div style="background:#fffbeb;border:1.5px solid #fde68a;border-radius:10px;padding:0.9rem 1.2rem;margin-bottom:1.5rem;text-align:left;">
        <p style="font-size:0.85rem;color:#78350f;line-height:1.5;"><strong>📢 Payment Info:</strong> Total Amount: <strong>LKR <%= displayAmount.toLocaleString() %></strong> (50% Advance Deposit of <strong>LKR <%= Math.round(displayAmount/2).toLocaleString() %></strong> will be due upon Chef &amp; Admin approval).</p>
      </div>
    <% } %>

    <div class="booking-summary-box">
      <h3>📋 Booking Details</h3>
      <div class="booking-detail-row">
        <span>Chef</span>
        <span>Chef <%= booking.chefId ? booking.chefId.firstName + ' ' + booking.chefId.lastName : 'N/A' %></span>
      </div>
      <div class="booking-detail-row">
        <span>Booking Type</span>
        <span><%= booking.bookingType %></span>
      </div>
      <div class="booking-detail-row">
        <span>Dish to Cook</span>
        <span style="color:#c2410c;font-weight:700;"><%= (booking.menu || []).join(', ') || 'N/A' %></span>
      </div>
      <div class="booking-detail-row">
        <span>Date &amp; Time</span>
        <span><%= new Date(booking.date).toDateString() %> at <%= booking.time %></span>
      </div>
      <div class="booking-detail-row">
        <span>Duration</span>
        <span><%= booking.duration %> hours</span>
      </div>
      <div class="booking-detail-row">
        <span>Guests</span>
        <span><%= (booking.guests && booking.guests.adults) || 1 %> Adults, <%= (booking.guests && booking.guests.children) || 0 %> Children</span>
      </div>
      <div class="booking-detail-row">
        <span>Location</span>
        <span><%= booking.location %></span>
      </div>
      <div class="booking-detail-row">
        <span>Grocery Support</span>
        <span><%= booking.grocerySupport ? 'Yes (+Rs.500)' : 'No (self-provided)' %></span>
      </div>
      <div class="booking-detail-row">
        <span>Payment Method</span>
        <span><strong><%= booking.paymentMethod %></strong></span>
      </div>
      <div class="booking-detail-row">
        <span>Payment Status</span>
        <span style="color:<%= booking.paymentStatus === 'Completed' ? '#16a34a' : '#d97706' %>;font-weight:700;">
          <%= booking.paymentStatus === 'Completed' ? '✅ Paid & Confirmed' : '⏳ Pending' %>
        </span>
      </div>
      <div class="booking-detail-row">
        <span>Total Amount</span>
        <span style="color:#1a5c2a;font-size:1.1rem;font-weight:800;">LKR <%= booking.totalAmount.toLocaleString() %></span>
      </div>
    </div>

    <div class="success-actions" style="margin-bottom: 1rem; flex-wrap: wrap; gap: 0.7rem;">
      <a href="/booking/receipt/<%= booking._id %>" target="_blank" style="background:#f57c00;color:white;border:none;padding:0.8rem 1.5rem;border-radius:10px;font-weight:700;text-decoration:none;font-size:0.92rem;">📄 Download Invoice</a>
      <button onclick="window.print()" style="background:white;color:#1a5c2a;border:2px solid #1a5c2a;padding:0.8rem 1.5rem;border-radius:10px;font-weight:700;cursor:pointer;font-size:0.92rem;font-family:inherit;">🖨️ Print</button>
      <a href="/user/dashboard" class="btn-home">📊 My Bookings</a>
      <a href="/chefs/<%= booking.chefId && booking.chefId._id ? booking.chefId._id : '' %>" class="btn-dashboard">← Back to Chef</a>
    </div>

  </div>
</main>

<style>
  @media print {
    body * { visibility: hidden; }
    .booking-summary-box, .booking-summary-box * { visibility: visible; }
    .booking-summary-box {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      border: 1px solid #000;
      padding: 20px;
    }
  }
</style>

<%- include('partials/footer') %>
