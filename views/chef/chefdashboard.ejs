    // ── Availability & Calendar Handlers ────────────────────────
    function toggleWeekdayStatus(el) {
      const current = el.getAttribute('data-status') || 'available';
      let nextStatus = 'available';
      if (current === 'available') nextStatus = 'unavailable';
      else if (current === 'unavailable') nextStatus = 'leave';
      else if (current === 'leave') nextStatus = 'available';

      el.classList.remove('available', 'unavailable', 'leave');
      el.classList.add(nextStatus);
      el.setAttribute('data-status', nextStatus);
      const span = el.querySelector('span');
      if (span) {
        span.textContent = nextStatus.charAt(0).toUpperCase() + nextStatus.slice(1);
      }
    }

