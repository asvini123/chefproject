    // ── Real-Time 1-on-1 Chat Handlers ─────────────────────────
    const currentChefId = "<%= chef._id %>";
    const socket = typeof io !== 'undefined' ? io() : null;
    let activeChatContactId = null;
    let chefChatData = { admin: null, chefs: [], clients: [] };

    if (socket) {
      socket.emit('join-user', currentChefId);

      socket.on('messages-read', (data) => {
        if (activeChatContactId && activeChatContactId.toString() === data.readerId.toString()) {
          document.querySelectorAll('#chatWindowMessages .msg-item.sent .time').forEach(el => {
            const timePart = el.innerText.split('·')[0].trim();
            el.innerHTML = `${timePart} <span style="color:#25D366; font-weight:800;"> · Seen ✓✓</span>`;
          });
        }
      });

      socket.on('new-private-message', (msg) => {
        if (!msg || !currentChefId) return;
        const sId = (msg.senderId && msg.senderId._id ? msg.senderId._id : msg.senderId).toString();
        const rId = (msg.receiverId && msg.receiverId._id ? msg.receiverId._id : msg.receiverId).toString();
        const myId = currentChefId.toString();
        const otherId = (sId === myId) ? rId : sId;

        // 1. Move contact item to the very TOP of the list
        const container = document.getElementById('chefChatContactList');
        const item = document.getElementById(`chat-contact-${otherId}`);
        if (item && container) {
          container.prepend(item);
        }

        // 2. Update snippet and bold highlight
        if (item) {
          const snippetEl = item.querySelector('.chat-snippet');
          if (snippetEl) {
            snippetEl.textContent = msg.content;
            snippetEl.style.fontWeight = '700';
            snippetEl.style.color = '#111';
          }
          const nameEl = item.querySelector('.chat-name');
          if (nameEl) nameEl.style.fontWeight = '800';
          const badge = item.querySelector('.unread-dot');
          if (badge && (!activeChatContactId || activeChatContactId.toString() !== otherId)) {
            badge.style.display = 'inline-block';
          }
        }

        // 3. Update Chat sidebar badge
        const navBadge = document.getElementById('chefChatNavBadge');
        if (navBadge && (!activeChatContactId || activeChatContactId.toString() !== otherId)) {
          const count = parseInt(navBadge.textContent || '0') + 1;
          navBadge.textContent = count;
          navBadge.style.display = 'inline-block';
        }

        // 4. Append to open window if currently chatting and message is from recipient
        if (activeChatContactId && activeChatContactId.toString() === otherId && sId !== myId) {
          appendChatMessage(msg);
        }
      });
    }

    async function loadChefChatContacts() {
      const container = document.getElementById('chefChatContactList');
      if (!container) return;
      try {
        const res = await fetch('/api/chat/contacts');
        const data = await res.json();
        if (!data.success) {
          container.innerHTML = '<div style="padding:1rem;color:#999;font-size:0.8rem;text-align:center;">Failed to load contacts.</div>';
          return;
        }

        // Update nav badge with total unread
        const navBadge = document.getElementById('chefChatNavBadge');
        if (navBadge) {
          if (data.totalUnread > 0) {
            navBadge.textContent = data.totalUnread;
            navBadge.style.display = 'inline-block';
          } else {
            navBadge.style.display = 'none';
          }
        }

        const contacts = data.contacts || [];
        chefChatData.admin = data.admin || contacts.find(c => c.role === 'admin') || null;
        chefChatData.chefs = data.chefs || contacts.filter(c => c.role === 'chef');
        chefChatData.clients = data.clients || data.users || contacts.filter(c => c.role === 'user');

        // Populate dropdown for initial role
        handleChefChatRoleChange('admin');

        let html = '';

        // Render all contacts sorted (recent/unread first from server)
        contacts.forEach(c => {
          const hasUnread = c.unread > 0;
          const isAdm = c.role === 'admin';
          const isChf = c.role === 'chef';
          const avatarBg = isAdm ? '#2C5F2D' : (isChf ? '#2C5F2D' : '#D97A2B');
          const avatarIcon = isAdm ? '🛡️' : (isChf ? '👨‍🍳' : (c.firstName ? c.firstName.charAt(0).toUpperCase() : '👤'));
          const displayName = isAdm ? `Support Admin (${c.firstName} ${c.lastName})` : (isChf ? `Chef ${c.firstName} ${c.lastName}` : `${c.firstName} ${c.lastName}`);
          const roleLabel = isAdm ? 'admin' : (isChf ? 'chef' : 'user');
          const subText = c.lastMessage || (isAdm ? '24/7 Platform Support' : (isChf ? (c.city || 'Verified Chef') : (c.memberId || 'Client User')));

          html += `
            <div class="chat-user-item" id="chat-contact-${c._id}" onclick="selectChatContact('${c._id}', '${displayName}', '${roleLabel}')" style="padding:0.75rem 0.9rem; border-bottom:1px solid #f0ede8; cursor:pointer; display:flex; align-items:center; gap:0.75rem; transition:all 0.2s;">
              <div class="avatar-circle" style="background:${avatarBg}; color:#fff; font-weight:700; width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:0.85rem;">${avatarIcon}</div>
              <div style="flex:1; overflow:hidden;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <strong class="chat-name" style="font-size:0.85rem; font-weight:${hasUnread ? '800' : '600'}; color:#1f2937; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">
                    ${displayName}
                  </strong>
                  <span class="unread-dot" style="display:${hasUnread ? 'inline-block' : 'none'}; background:#e74c3c; color:#fff; font-size:0.65rem; font-weight:800; padding:0.1rem 0.45rem; border-radius:10px; margin-left:4px;">${c.unread > 0 ? c.unread + ' NEW' : '●'}</span>
                </div>
                <p class="chat-snippet" style="font-size:0.75rem; color:${hasUnread ? '#111' : '#777'}; font-weight:${hasUnread ? '700' : '400'}; white-space:nowrap; text-overflow:ellipsis; overflow:hidden; margin-top:2px; line-height:1.3;">
                  ${escapeHtml(subText)}
                </p>
              </div>
            </div>
          `;
        });

        container.innerHTML = html || '<div style="padding:1.5rem; text-align:center; color:#999; font-size:0.85rem;">No contacts available.</div>';
      } catch (err) {
        console.error('Error loading chat contacts:', err);
        container.innerHTML = '<div style="padding:1rem;color:#999;font-size:0.8rem;text-align:center;">Error loading contacts.</div>';
      }
    }

    function handleChefChatRoleChange(role) {
      const select = document.getElementById('chefChatPersonSelect');
      if (!select) return;
      select.innerHTML = '<option value="">-- Choose a contact --</option>';

      if (role === 'admin' && chefChatData.admin) {
        const opt = document.createElement('option');
        opt.value = chefChatData.admin._id;
        opt.textContent = `🛡️ Support Admin (${chefChatData.admin.firstName} ${chefChatData.admin.lastName})`;
        opt.setAttribute('data-name', `Support Admin (${chefChatData.admin.firstName} ${chefChatData.admin.lastName})`);
        opt.setAttribute('data-role', 'admin');
        select.appendChild(opt);
      } else if (role === 'chefs' && chefChatData.chefs.length > 0) {
        chefChatData.chefs.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c._id;
          opt.textContent = `👨‍🍳 Chef ${c.firstName} ${c.lastName} (${c.city || 'Verified'})`;
          opt.setAttribute('data-name', `Chef ${c.firstName} ${c.lastName}`);
          opt.setAttribute('data-role', 'chef');
          select.appendChild(opt);
        });
      } else if (role === 'clients' && chefChatData.clients.length > 0) {
        chefChatData.clients.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c._id;
          opt.textContent = `👤 ${c.firstName} ${c.lastName} (${c.email || c.memberId || 'Client'})`;
          opt.setAttribute('data-name', `${c.firstName} ${c.lastName}`);
          opt.setAttribute('data-role', 'user');
          select.appendChild(opt);
        });
      }
    }

    function handleChefChatPersonSelect(personId) {
      if (personId) {
        startChefChatFromDropdown();
      }
    }

    function startChefChatFromDropdown() {
      const select = document.getElementById('chefChatPersonSelect');
      if (!select || !select.value) {
        showToast('⚠️ Please select a contact from the dropdown.');
        return;
      }
      const opt = select.options[select.selectedIndex];
      const name = opt.getAttribute('data-name') || 'Contact';
      const role = opt.getAttribute('data-role') || 'user';
      selectChatContact(select.value, name, role);
    }

    function openChatFromNotification(senderNameOrId) {
      showSection('chat', document.querySelector('[data-section="chat"] a'));
      setTimeout(() => {
        let matched = false;
        if (senderNameOrId) {
          const clean = senderNameOrId.toLowerCase().trim();
          document.querySelectorAll('#chefChatContactList .chat-user-item').forEach(item => {
            const nameEl = item.querySelector('.chat-name');
            if (nameEl && nameEl.innerText.toLowerCase().includes(clean)) {
              item.click();
              matched = true;
            }
          });
        }
        if (!matched) {
          const first = document.querySelector('#chefChatContactList .chat-user-item');
          if (first) first.click();
        }
      }, 350);
    }

    async function selectChatContact(contactId, contactName, role) {
      activeChatContactId = contactId;

      // Update sidebar active class
      document.querySelectorAll('#chefChatContactList .chat-user-item').forEach(el => el.classList.remove('active'));
      const activeEl = document.getElementById(`chat-contact-${contactId}`);
      if (activeEl) {
        activeEl.classList.add('active');
        activeEl.style.fontWeight = 'normal';
        const badge = activeEl.querySelector('.unread-dot');
        if (badge) badge.style.display = 'none';
      }

      // Update header
      const header = document.getElementById('chefChatHeader');
      if (header) {
        header.innerHTML = `<strong>${contactName}</strong> <span>${role === 'admin' ? '🛡️ Admin Support' : '👤 Client'}</span>`;
      }

      // Enable input
      const input = document.getElementById('chatInput');
      const btn = document.getElementById('chefChatSendBtn');
      if (input) { input.disabled = false; input.placeholder = `Type a message to ${contactName}...`; input.focus(); }
      if (btn) { btn.disabled = false; }

      // Fetch messages
      const msgsBox = document.getElementById('chatWindowMessages');
      msgsBox.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#999;font-size:0.85rem;">⏳ Loading conversation...</div>';

      try {
        const res = await fetch(`/api/chat/messages/${contactId}`);
        const data = await res.json();
        if (data.success && data.messages) {
          if (data.messages.length === 0) {
            msgsBox.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#999;font-size:0.85rem;">👋 Start the conversation! Send a message below.</div>';
          } else {
            msgsBox.innerHTML = '';
            data.messages.forEach(m => appendChatMessage(m));
          }
        }
      } catch (err) {
        console.error('Error fetching conversation:', err);
        msgsBox.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#c0392b;font-size:0.85rem;">❌ Failed to load messages.</div>';
      }
    }

    function appendChatMessage(msg) {
      const msgsBox = document.getElementById('chatWindowMessages');
      if (!msgsBox) return;

      const msgId = msg._id ? msg._id.toString() : '';
      if (msgId && document.getElementById(`chef-msg-${msgId}`)) {
        return; // Prevent duplicate display
      }

      if (msgsBox.innerText.includes('Select a contact') || msgsBox.innerText.includes('Start the conversation') || msgsBox.innerText.includes('Loading conversation')) {
        msgsBox.innerHTML = '';
      }

      const sId = (msg.senderId && (msg.senderId._id || msg.senderId.id || msg.senderId)).toString();
      const isMine = sId === currentChefId.toString();

      const div = document.createElement('div');
      if (msgId) div.id = `chef-msg-${msgId}`;
      div.className = `msg-item ${isMine ? 'sent' : 'received'}`;
      div.style.maxWidth = '78%';
      div.style.padding = '0.75rem 1rem';
      div.style.borderRadius = '14px';
      div.style.fontSize = '0.88rem';
      div.style.lineHeight = '1.5';
      div.style.display = 'flex';
      div.style.flexDirection = 'column';
      div.style.gap = '0.25rem';
      div.style.wordBreak = 'break-word';

      if (isMine) {
        div.style.alignSelf = 'flex-end';
        div.style.marginLeft = 'auto';
        div.style.marginRight = '0';
        div.style.background = '#2C5F2D';
        div.style.color = '#ffffff';
        div.style.borderBottomRightRadius = '2px';
        div.style.boxShadow = '0 3px 10px rgba(44,95,45,0.2)';
      } else {
        div.style.alignSelf = 'flex-start';
        div.style.marginRight = 'auto';
        div.style.marginLeft = '0';
        div.style.background = '#f0f4f0';
        div.style.color = '#1a3a1b';
        div.style.border = '1px solid #ddecdd';
        div.style.borderBottomLeftRadius = '2px';
      }

      const seenStatus = isMine ? (msg.isRead ? '<span style="color:#25D366; font-weight:800;"> · Seen ✓✓</span>' : '<span style="opacity:0.75;"> · Sent ✓</span>') : '';
      div.innerHTML = `
        <div style="color:${isMine ? '#ffffff' : '#1a3a1b'}; white-space:pre-wrap;">${escapeHtml(msg.content)}</div>
        <span class="time" style="font-size:0.7rem; color:${isMine ? 'rgba(255,255,255,0.85)' : '#6b7f6b'}; text-align:${isMine ? 'right' : 'left'};">${new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}${seenStatus}</span>
      `;
      msgsBox.appendChild(div);
      msgsBox.scrollTop = msgsBox.scrollHeight;
    }

    async function sendChatMessage(e) {
      e.preventDefault();
      const input = document.getElementById('chatInput');
      const text = input ? input.value.trim() : '';
      if (!text || !activeChatContactId) {
        showToast('⚠️ Please select a contact first.');
        return;
      }

      input.value = '';

      // 1. Instant optimistic bubble in UI (0ms latency)
      appendChatMessage({
        senderId: currentChefId,
        receiverId: activeChatContactId,
        content: text,
        createdAt: new Date().toISOString(),
        isRead: false
      });

      // 2. Persist via API
      try {
        const res = await fetch('/api/chat/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ receiverId: activeChatContactId, content: text })
        });
        const data = await res.json();
        if (!data.success) {
          showToast('❌ ' + (data.message || 'Failed to send message.'));
        }
      } catch (err) {
        console.error('Error sending chat message:', err);
        showToast('❌ Error sending message. Please check connection.');
      }
    }

    // ── Certificate Upload & Delete Handlers ──────────────────
    async function handleChefCertUpload(e) {
      e.preventDefault();
      const form = document.getElementById('chefCertUploadForm');
      const fileInput = document.getElementById('chefCertFileInput');
      const btn = document.getElementById('chefCertUploadBtn');

      if (!fileInput.files || fileInput.files.length === 0) {
        showToast('⚠️ Please choose a certificate file.');
        return;
      }

      btn.disabled = true;
      btn.textContent = '⏳ Uploading...';

      const formData = new FormData();
      formData.append('certificateFile', fileInput.files[0]);

      try {
        const res = await fetch('/chef/certificates/upload', {
          method: 'POST',
          headers: {
            'Accept': 'application/json'
          },
          body: formData
        });
        const data = await res.json().catch(() => ({ success: false, message: 'Server returned HTTP ' + res.status }));
        if (data && data.success) {
          showToast('✅ Certificate uploaded successfully!');
          renderChefCertificates(data.certificates);
          form.reset();
        } else {
          showToast('❌ ' + ((data && data.message) || 'Upload failed.'));
        }
      } catch (err) {
        console.error('Error uploading certificate:', err);
        showToast('❌ Failed to upload certificate: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Upload Certificate 📤';
      }
    }

    async function deleteChefCertificate(idx) {
      if (!confirm('Are you sure you want to remove this certificate?')) return;
      try {
        const res = await fetch('/chef/certificates/delete/' + idx, {
          method: 'POST',
          headers: {
            'Accept': 'application/json'
          }
        });
        const data = await res.json().catch(() => ({ success: false, message: 'Server error' }));
        if (data && data.success) {
          showToast('✅ Certificate removed.');
          renderChefCertificates(data.certificates);
        } else {
          showToast('❌ ' + ((data && data.message) || 'Error deleting'));
        }
      } catch (err) {
        console.error('Error deleting certificate:', err);
        showToast('❌ Failed to remove certificate.');
      }
    }

    function renderChefCertificates(certs) {
      const container = document.getElementById('chefCertificatesList');
      if (!container) return;
      if (!certs || certs.length === 0) {
        container.innerHTML = `
          <div id="emptyCertMsg" style="text-align:center; padding:1.2rem; color:var(--text-muted); font-size:0.82rem;">
            No certificates uploaded yet. Use the upload box above to add your credentials!
          </div>
        `;
        return;
      }

      container.innerHTML = certs.map((cert, idx) => `
        <div class="doc-upload-item" id="cert-item-${idx}" style="display:flex; justify-content:space-between; align-items:center; padding:0.6rem 0.8rem; background:#fff; border:1px solid #e0ead0; border-radius:6px;">
          <div style="display:flex; align-items:center; gap:0.6rem; overflow:hidden;">
            <span style="font-size:1.2rem;">📜</span>
            <div style="overflow:hidden;">
              <strong style="font-size:0.82rem; display:block; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">${cert.split('/').pop()}</strong>
              <span style="font-size:0.7rem; color:#888;">Professional Certificate</span>
            </div>
          </div>
          <div style="display:flex; gap:0.4rem; align-items:center;">
            <a href="${cert}" target="_blank" class="btn-outline-sm" style="padding:0.25rem 0.6rem; font-size:0.75rem; text-decoration:none;">View 📄</a>
            <button type="button" onclick="deleteChefCertificate(${idx})" class="btn-outline-sm" style="padding:0.25rem 0.6rem; font-size:0.75rem; color:#e74c3c; border-color:#e74c3c;">🗑️ Delete</button>
          </div>
        </div>
      `).join('');
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
  </script>

  <!-- ── Complete Booking & Cash Collection Modal ─────────────────── -->
  <div id="completeBookingModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:99999; backdrop-filter:blur(4px); align-items:center; justify-content:center;" onclick="if(event.target===this) closeCompleteBookingModal()">
    <div style="background:#fff; border-radius:18px; padding:1.8rem; max-width:440px; width:92%; box-shadow:0 20px 60px rgba(0,0,0,0.3); border:1.5px solid #ddecdd; animation:fadeInModal 0.2s ease;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.1rem; border-bottom:1px solid #edf2ed; padding-bottom:0.75rem;">
        <h3 style="margin:0; font-size:1.15rem; color:#1a3a1b; display:flex; align-items:center; gap:0.5rem;">
          <span>✅</span> Complete Dining &amp; Collect Cash
        </h3>
        <button type="button" onclick="closeCompleteBookingModal()" style="background:none; border:none; font-size:1.3rem; cursor:pointer; color:#888; line-height:1;">✕</button>
      </div>
      
      <form id="completeBookingForm" onsubmit="submitBookingCompletion(event)">
        <input type="hidden" id="completeBookingId" name="bookingId">
        
        <div style="background:#f0f9f0; border:1px solid #c8e6c9; border-radius:10px; padding:0.9rem 1rem; margin-bottom:1.2rem;">
          <div style="font-size:0.85rem; color:#555; margin-bottom:0.35rem;">Customer: <strong id="completeCustomerName" style="color:#111;">Customer</strong></div>
          <div style="font-size:0.85rem; color:#555;">Total Booking Bill: <strong id="completeTotalAmount" style="color:#2C5F2D; font-size:1.05rem;">LKR 0</strong></div>
        </div>

        <div style="margin-bottom:1.25rem;">
          <label style="font-size:0.88rem; font-weight:800; color:#1a3a1b; display:block; margin-bottom:0.4rem;">
            💵 Cash Amount Received from Customer (LKR)
          </label>
          <input type="number" id="completeCashReceived" name="cashCollectedAmount" required min="0" step="any" class="form-input" style="width:100%; padding:0.75rem 1rem; font-size:1.15rem; font-weight:800; border:2px solid #2C5F2D; border-radius:10px; color:#1a3a1b; outline:none; box-sizing:border-box;" placeholder="Enter cash amount handed over">
          <small style="font-size:0.76rem; color:#666; display:block; margin-top:0.4rem; line-height:1.4;">
            ℹ️ Enter the cash amount handed to you by the client upon completion. This will be recorded directly into the system.
          </small>
        </div>

        <div style="display:flex; gap:0.75rem; justify-content:flex-end;">
          <button type="button" onclick="closeCompleteBookingModal()" class="btn-outline-sm" style="padding:0.65rem 1.2rem; border-radius:8px; font-weight:600; cursor:pointer;">Cancel</button>
          <button type="submit" id="btnSubmitCompletion" class="btn-primary-sm" style="background:#2C5F2D; color:#fff; padding:0.65rem 1.4rem; border-radius:8px; font-weight:800; font-size:0.92rem; border:none; cursor:pointer;">
            💾 Confirm &amp; Save
          </button>
        </div>
      </form>
    </div>
  </div>
</body>

</html>