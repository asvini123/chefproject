    async function respondBookingWithDetails() {
      const id = currentBookingIdToAccept;
      const cookingTime = document.getElementById('cookingTimeInput').value.trim();
      const extraIngredients = document.getElementById('extraIngredientsInput').value.trim();

      document.getElementById('acceptBookingModal').style.display = 'none';

      try {
        const response = await fetch(`/chef/booking/${id}/respond`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'accept',
            cookingTimeEstimate: cookingTime,
            extraIngredients: extraIngredients
          })
        });
        const result = await response.json();
        if (result.success) {
          showToast('✅ Booking accepted successfully!');
          setTimeout(() => location.reload(), 1200);
        } else {
          showToast('❌ Error: ' + (result.message || 'Failed to accept booking.'));
        }
      } catch (err) {
        console.error(err);
        showToast('❌ Error responding to booking.');
      }
    }

    async function respondBooking(id, action) {
      if (action === 'reject') {
        if (!confirm('Are you sure you want to decline this booking request?')) return;
      }
      try {
        const response = await fetch(`/chef/booking/${id}/respond`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action })
        });
        const result = await response.json();
        if (result.success) {
          showToast(action === 'reject' ? '❌ Booking request declined.' : '✅ Action updated.');
          setTimeout(() => location.reload(), 1200);
        } else {
          showToast('❌ Error: ' + (result.message || 'Action failed'));
        }
      } catch (err) {
        console.error(err);
        showToast('❌ Error responding to booking.');
      }
    }

