<%- include('partials/header', { title: `Chef ${chef.firstName} ${chef.lastName} - ChefNest`, pageCss: 'chefprofile.css'
  }) %>

  <main class="chef-profile-page">
    <div class="profile-container">

      <!-- Profile Header Section -->
      <section class="profile-header-card">
        <div class="header-main-grid">
          <div class="chef-avatar-wrap">
            <% if (chef.profilePhoto) { %>
              <img src="<%= chef.profilePhoto %>" alt="<%= chef.firstName %>" class="chef-avatar-img">
            <% } else { %>
              <div class="avatar-placeholder">
                <%= chef.firstName.charAt(0) %><%= chef.lastName.charAt(0) %>
              </div>
            <% } %>
            <div class="verified-dot" title="Verified Chef">✓</div>
          </div>

          <div class="chef-info-col">
            <div class="chef-title-row">
              <h1 class="chef-name"><%= chef.firstName %> <%= chef.lastName %></h1>
              <div class="chef-badges-row">
                <span class="badge verified">✓ Verified Chef</span>
                <% if (chef.chefType === 'Pro chef' || chef.chefType === 'Professional') { %>
                  <span class="badge pro">⭐ Pro Chef</span>
                <% } %>
                <% if (chef.certificates && chef.certificates.length > 0) { %>
                  <span class="badge certified">📜 Certified</span>
                <% } %>
              </div>
            </div>

            <!-- Cuisines Pills -->
            <div class="chef-cuisine-pills">
              <% if (chef.cuisines && chef.cuisines.length > 0) { %>
                <% chef.cuisines.forEach(c => { %>
                  <span class="cuisine-pill"><%= c.replace(/_/g, ' ') %></span>
                <% }) %>
              <% } else { %>
                <span class="cuisine-pill">Multi-Cuisine</span>
              <% } %>
            </div>

            <!-- Meta details (Location, Experience, Role) -->
            <div class="chef-meta-bar">
              <span class="meta-item"><svg viewBox="0 0 24 24" width="13" height="13" fill="#2C5F2D" style="vertical-align:-1px; margin-right:2px;"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg><%= chef.city || 'Colombo' %><% if (chef.district && chef.district !== chef.city) { %>, <%= chef.district %><% } %></span>
              <span class="meta-dot">·</span>
              <span class="meta-item"><%= chef.experience || 3 %>+ Years Experience</span>
              <span class="meta-dot">·</span>
              <span class="meta-item" style="text-transform:capitalize;"><%= (chef.chefType || 'Personal Chef').replace(/_/g, ' ') %></span>
            </div>
          </div>
        </div>

        <!-- Sleek Professional KPI Stats Row -->
        <div class="chef-stats-grid">
          <div class="stat-card">
            <% const pRealAvg = (typeof reviews !== 'undefined' && reviews.length > 0) ? (Math.round((reviews.reduce((acc, r) => acc + (Number(r.rating) || 5), 0) / reviews.length) * 10) / 10).toFixed(1) : (chef.rating ? Number(chef.rating).toFixed(1) : '5.0'); %>
            <div class="stat-num"><%= pRealAvg %> <small style="font-size:0.75rem; color:#888; font-weight:600;">/ 5.0 (<%= typeof reviews !== 'undefined' ? reviews.length : 0 %>)</small></div>
            <div class="stat-lbl">Rating Score</div>
          </div>
          <div class="stat-card">
            <div class="stat-num"><%= chef.totalBookings || '24' %></div>
            <div class="stat-lbl">Bookings Completed</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">98%</div>
            <div class="stat-lbl">On-Time Arrival</div>
          </div>
          <div class="stat-card">
            <div class="stat-num" style="text-transform: capitalize;"><%= chef.cuisines && chef.cuisines.length > 0 ? chef.cuisines[0].replace(/_/g, ' ') : 'Specialty Chef' %></div>
            <div class="stat-lbl">Top Specialty</div>
          </div>
        </div>
      </section>

      <div class="profile-body">
        <div class="main-content">
          <!-- Dish Gallery -->
          <section class="dish-gallery">
            <h2>Dish Gallery / Signature Dishes</h2>
            <% if (typeof foods !== 'undefined' && foods.length > 0) { %>
              <div class="gallery-grid">
                <% foods.forEach(food => { %>
                  <div class="gallery-item-card">
                    <div class="gallery-item-img-wrap">
                      <% if (food.images && food.images.length > 0) { %>
                        <img src="<%= food.images[0] %>" alt="<%= food.name %>" class="gallery-food-img">
                      <% } else { %>
                        <div class="gallery-food-placeholder">🍽️</div>
                      <% } %>
                      <span class="gallery-item-cat"><%= food.category || 'Main' %></span>
                    </div>
                    <div class="gallery-item-info">
                      <h4><%= food.name %></h4>
                      <p><%= food.cuisine %> Cuisine &middot; <%= food.calories || '350 kcal' %></p>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="gallery-empty-state">
                <p>No dishes uploaded yet by this chef.</p>
              </div>
            <% } %>
          </section>

          <!-- About Section -->
          <section class="about-section">
            <h2>About</h2>
            <div class="about-box">
              <p>
                <%= chef.bio || `${chef.firstName} is a passionate chef specialized in creating amazing home-cooked
                  meals.` %>
              </p>
            </div>
          </section>

          <!-- Reviews Section with Sentiment Indicators -->
          <section class="reviews-section">
            <h2 style="display:flex; align-items:center; justify-content:space-between;">
              <span>Client Reviews &amp; Feedback</span>
              <span style="font-size:0.9rem; font-weight:600; color:var(--forest-green);"><%= reviews ? reviews.length : 0 %> Verified Reviews</span>
            </h2>
            <% if (reviews && reviews.length > 0) { %>
              <div class="reviews-list" style="display:flex; flex-direction:column; gap:1rem;">
                <% reviews.forEach(review => { %>
                  <div class="review-card" style="border:1px solid #e2ece2; border-radius:12px; padding:1.1rem; background:#fff; box-shadow:0 2px 8px rgba(0,0,0,0.03);">
                    <div class="review-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.6rem;">
                      <div>
                        <strong style="font-size:0.98rem; color:#1a3a1b;">
                          <%= review.userId ? (review.userId.firstName + ' ' + (review.userId.lastName ? review.userId.lastName.charAt(0) + '.' : '')) : 'Verified Client' %>
                        </strong>
                        <span style="color:#f59e0b; margin-left:0.5rem; font-weight:700;">
                          <%= '★'.repeat(review.rating || 5) %> (<%= review.rating %>/5)
                        </span>
                      </div>
                      
                      <!-- Sentiment Analysis Badge -->
                      <% 
                        const sent = review.sentiment || (review.rating >= 4 ? 'Positive' : (review.rating === 3 ? 'Neutral' : 'Negative'));
                        const sentColor = sent === 'Positive' ? '#16a34a' : (sent === 'Neutral' ? '#d97706' : '#dc2626');
                        const sentBg = sent === 'Positive' ? '#f0fdf4' : (sent === 'Neutral' ? '#fffbeb' : '#fef2f2');
                        const sentIcon = sent === 'Positive' ? '😊 Positive Sentiment' : (sent === 'Neutral' ? '😐 Neutral Sentiment' : '😞 Negative Sentiment');
                      %>
                      <span class="sentiment-badge" style="background:<%= sentBg %>; color:<%= sentColor %>; border:1px solid <%= sentColor %>40; padding:0.25rem 0.65rem; border-radius:20px; font-size:0.75rem; font-weight:700;">
                        <%= sentIcon %>
                      </span>
                    </div>
                    <p class="review-comment" style="color:#374151; font-size:0.92rem; line-height:1.5; margin:0;">
                      "<%= review.comment %>"
                    </p>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="review-card" style="padding:1.5rem; text-align:center; color:#6b7280;">
                <p>No reviews published yet for this chef.</p>
              </div>
            <% } %>
          </section>
        </div>

        <!-- Sidebar -->
        <aside class="profile-sidebar">
          <div class="pricing-card">
            <div class="price-wrap">
              <span class="price-value">Rs. <%= chef.hourlyRate || 1500 %></span>
              <span class="price-sub">/ session (2 hrs)</span>
            </div>
            
            <% const isLoggedInUser = typeof user !== 'undefined' && user && (user._id || user.id); %>
            <button class="btn-book full-width" onclick="openBookingModal()">Book this chef</button>
            <button class="btn-chat full-width outline" onclick="openChatWithChef()">Chat with chef</button>
            
            <% if (isLoggedInUser) { %>
              <button class="btn-save full-width <%= typeof isSaved !== 'undefined' && isSaved ? 'saved' : '' %>" onclick="toggleSaveChef('<%= chef._id %>')">
                <%= typeof isSaved !== 'undefined' && isSaved ? 'Saved ❤️' : 'Save this chef' %>
              </button>
            <% } else { %>
              <button class="btn-save full-width" onclick="window.location.href='/login?redirect=' + encodeURIComponent(window.location.pathname)">Save this chef</button>
            <% } %>
          </div>
        </aside>
      </div>

    </div>
  </main>

  <!-- ===================== BOOKING MODAL ===================== -->
  <div id="bookingModal" class="modal-overlay" onclick="handleOverlayClick(event)">
    <div class="modal-box">

      <!-- Step 1: Booking Form -->
      <div id="modalStep1">
        <div class="modal-header">
          <div>
            <h2 class="modal-title">Book Chef <%= chef.firstName %></h2>
            <p class="modal-subtitle">Fill in the details below to confirm your booking</p>
          </div>
          <button class="modal-close" onclick="closeBookingModal()">&#10005;</button>
        </div>

        <form id="inlineBookingForm">
          <input type="hidden" name="chefId" value="<%= chef._id %>">

          <% if (typeof user !== 'undefined' && user) { %>
            <div style="background:#f0f7f0; border:1px solid #cbe4cb; border-radius:10px; padding:0.75rem 1rem; margin-bottom:1.2rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
              <div style="font-size:0.88rem; color:#1a3a1b; font-weight:700;">
                👤 Customer: <%= user.firstName %> <%= user.lastName %>
              </div>
              <div style="font-size:0.8rem; background:#2C5F2D; color:#fff; padding:0.2rem 0.6rem; border-radius:12px; font-weight:700;">
                🆔 Member ID: <%= user.memberId || ('CN-USR-' + (user.id || user._id || '').toString().slice(-4).toUpperCase()) %>
              </div>
            </div>
          <% } %>

          <!-- Booking Type -->
          <div class="modal-section">
            <label class="modal-label">Booking Type</label>
            <div class="type-options">
              <label class="type-card">
                <input type="radio" name="bookingType" value="Daily" checked onchange="toggleEventType()">
                <div class="card-content"><strong>Daily</strong><small>Regular schedule</small></div>
              </label>
              <label class="type-card">
                <input type="radio" name="bookingType" value="Urgent" onchange="toggleEventType()">
                <div class="card-content"><strong>Urgent</strong><small>Within 1 hr</small></div>
              </label>
              <label class="type-card">
                <input type="radio" name="bookingType" value="Event" onchange="toggleEventType()">
                <div class="card-content"><strong>Event</strong><small>Party/Function</small></div>
              </label>
            </div>
          </div>

          <!-- Event Details Section (Dynamic for Event Booking) -->
          <div id="eventDetailsSection" class="modal-section" style="display:none; background:#f4fbf4; border:1.5px solid #c8e6c9; border-radius:10px; padding:1.1rem; margin-bottom:1rem;">
            <label class="modal-label" style="color:#1b5e20; display:flex; align-items:center; gap:0.4rem; margin-bottom:0.75rem;">
              🎉 Event / Party Information
            </label>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.85rem;">
              <div class="modal-input-group">
                <label style="font-size:0.8rem; font-weight:700; color:#333; margin-bottom:0.35rem; display:block;">Event Name / Occasion</label>
                <input type="text" name="eventName" id="eventNameInput" placeholder="e.g. Birthday Party, Anniversary Dinner" style="width:100%;">
              </div>
              <div class="modal-input-group">
                <label style="font-size:0.8rem; font-weight:700; color:#333; margin-bottom:0.35rem; display:block;">Venue / Place Type</label>
                <input type="text" name="eventVenue" id="eventVenueInput" placeholder="e.g. Banquet Hall, Private Villa, Lawn" style="width:100%;">
              </div>
            </div>
          </div>

          <!-- Date, Time, Duration -->
          <div class="modal-section">
            <label class="modal-label">Date & Time</label>
            <div class="form-grid-3">
              <div class="modal-input-group">
                <label>Date</label>
                <input type="date" name="date" required min="<%= new Date().toISOString().split('T')[0] %>">
              </div>
              <div class="modal-input-group">
                <label>Time</label>
                <input type="time" name="time" required>
              </div>
              <div class="modal-input-group">
                <label>Duration</label>
                <select name="duration" required>
                  <option value="2">2 hours</option>
                  <option value="3">3 hours</option>
                  <option value="4">4 hours</option>
                  <option value="5">5 hours</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Dish to Cook -->
          <div class="modal-section">
            <label class="modal-label">&#127859; Dish to Cook</label>
            <div class="modal-input-group">
              <input type="text" name="foodName" id="foodName" placeholder="e.g. Bistecca alla Fiorentina, Biryani, Pasta..." required>
            </div>
          </div>

          <!-- Home Address & Map Location -->
          <div class="modal-section">
            <label class="modal-label">&#127968; Address / Location <small style="font-weight:400; color:var(--text-muted);">(Chef will travel here to cook)</small></label>
            <div class="modal-input-group" style="margin-bottom:0.75rem;">
              <input type="text" name="location" id="bookingLocationInput" placeholder="e.g. 42, Main Street, Colombo 07" value="<%= (typeof user !== 'undefined' && user) ? (user.address || '') : '' %>" required oninput="checkDistrictMatch()">
            </div>

            <label class="modal-label" style="font-size:0.88rem; color:#2C5F2D; margin-top:0.6rem;">
              📞 Contact Phone Number <span style="color:#d9534f;">*</span>
            </label>
            <div class="modal-input-group" style="margin-bottom:0.75rem;">
              <input type="tel" name="phone" id="bookingPhoneInput" placeholder="e.g. 077 123 4567" value="<%= (typeof user !== 'undefined' && user) ? (user.phone || '') : '' %>" required>
            </div>

            <label class="modal-label" style="font-size:0.83rem; color:#2C5F2D; margin-top:0.6rem;">
              🗺️ Google Maps Link / Nearby Landmark <small style="font-weight:400; color:#666;">(Optional - For direct GPS navigation)</small>
            </label>
            <div class="modal-input-group">
              <input type="text" name="locationMapUrl" id="locationMapUrl" placeholder="e.g. https://maps.app.goo.gl/... or near Point Pedro Junction">
            </div>
            <p style="font-size:0.75rem; color:#406841; margin-top:0.35rem; line-height:1.4;">
              📍 <em>Privacy Notice: Providing your Google Maps link or nearby landmark allows the chef to navigate directly to your venue via Maps without needing to call for directions.</em>
            </p>

            <!-- District Travel Distance Warning Box -->
            <div id="districtWarningBox" style="display:none; margin-top:0.75rem; padding:0.85rem 1rem; border-radius:8px; font-size:0.84rem; line-height:1.45; background:#fffbe6; border:1.5px solid #ffe58f; border-left:4px solid #fa8c16; color:#873800;">
            </div>
          </div>

          <!-- Grocery Support -->
          <div class="modal-section">
            <label class="modal-label">&#128722; Grocery Support</label>
            <div style="display:flex; gap:1.5rem; flex-wrap:wrap; font-size:0.95rem; color:var(--text-dark); margin-bottom: 0.6rem;">
              <label style="cursor:pointer; display:flex; align-items:center; gap:0.4rem;"><input type="radio" name="grocerySupport" id="groceryYes" value="true" onchange="toggleGroceryInput(true)"> Yes, buy ingredients for me <strong>(+Rs.500)</strong></label>
              <label style="cursor:pointer; display:flex; align-items:center; gap:0.4rem;"><input type="radio" name="grocerySupport" id="groceryNo" value="false" checked onchange="toggleGroceryInput(false)"> No, I will provide the ingredients</label>
            </div>
            
            <div id="groceryTypeGroup" style="display:none; margin-top:0.8rem; padding: 0.8rem; background: #f9f9f9; border-radius: 8px; border: 1px solid #eee;">
              <label style="font-size:0.85rem; font-weight:600; color:#444; display:block; margin-bottom:0.5rem;">Do you need all ingredients for this dish, or only specific ingredients?</label>
              <div style="display:flex; gap:1.5rem; flex-wrap:wrap; font-size:0.9rem; color:var(--text-dark); margin-bottom: 0.5rem;">
                <label style="cursor:pointer; display:flex; align-items:center; gap:0.4rem;"><input type="radio" name="groceryType" id="groceryTypeAll" value="all" onchange="toggleSpecificGrocery(false)"> All ingredients</label>
                <label style="cursor:pointer; display:flex; align-items:center; gap:0.4rem;"><input type="radio" name="groceryType" id="groceryTypeSpecific" value="specific" onchange="toggleSpecificGrocery(true)"> Specific ingredients</label>
              </div>

              <div id="groceryItemsGroup" style="display:none; margin-top:0.8rem;">
                <label style="font-size:0.8rem; font-weight:700; color:#555; display:block; margin-bottom:0.3rem;">What specific items do you want the chef to buy?</label>
                <textarea name="groceryItemsNeeded" id="groceryItemsNeeded" rows="2" placeholder="e.g. Salt, Pepper, Chicken (1kg), Coconut Milk" style="width:100%; padding:0.6rem; border:1.5px solid #ccc; border-radius:8px; font-family:inherit; font-size:0.9rem; outline:none; resize:vertical;"></textarea>
              </div>
            </div>
          </div>

          <!-- Payment Method -->
          <div class="modal-section">
            <label class="modal-label">&#128179; Payment Method</label>
            <div class="modal-input-group">
              <select name="paymentMethod" id="paymentMethod" required onchange="togglePaymentNote()">
                <option value="Bank">Bank Transfer (50% Advance to Chef)</option>
              </select>
            </div>
            <div id="advancePaymentNote" style="background: #fff3e0; border: 1px solid #ffcc80; padding: 0.8rem; border-radius: 8px; margin-top: 0.5rem; font-size: 0.85rem; color: #d84315;">
              <strong>Note:</strong> A <strong>50% advance payment</strong> is required to confirm this booking. You will see the Chef's bank details in your dashboard after clicking confirm.
            </div>
          </div>

          <!-- Guests -->
          <div class="modal-section">
            <label class="modal-label">Guests</label>
            <div class="guest-row">
              <div class="guest-control">
                <span>Adults</span>
                <div class="counter">
                  <button type="button" onclick="changeCount('adults',-1)">-</button>
                  <input type="number" name="adults" id="adults" value="2" min="1" oninput="updatePriceTotal()">
                  <button type="button" onclick="changeCount('adults',1)">+</button>
                </div>
              </div>
              <div class="guest-control">
                <span>Children</span>
                <div class="counter">
                  <button type="button" onclick="changeCount('children',-1)">-</button>
                  <input type="number" name="children" id="children" value="0" min="0" oninput="updatePriceTotal()">
                  <button type="button" onclick="changeCount('children',1)">+</button>
                </div>
              </div>
          </div>

          <!-- Meals -->
          <div class="modal-section">
            <label class="modal-label">Meals Required</label>
            <div class="meal-check-row">
              <label><input type="checkbox" name="meals" value="Breakfast"> Breakfast</label>
              <label><input type="checkbox" name="meals" value="Lunch" checked> Lunch</label>
              <label><input type="checkbox" name="meals" value="Snacks"> Snacks</label>
              <label><input type="checkbox" name="meals" value="Dinner"> Dinner</label>
            </div>
          </div>

          <!-- Price Summary inside modal -->
          <div class="modal-price-summary">
            <div class="price-row"><span>Cooking rate (<span id="durationDisplay">2</span> hrs &times; Rs.<%= chef.hourlyRate || 1500 %>)</span><span id="basePrice">Rs.<%= (chef.hourlyRate || 1500) * 2 %></span></div>
            <div class="price-row"><span>Grocery support fee</span><span id="groceryFeeDisplay">Rs.0</span></div>
            <div class="price-row" id="guestFeeRow" style="display:none;"><span>Extra Guests Fee (above 2)</span><span id="guestFeeDisplay">Rs.0</span></div>
            <div class="price-row"><span>Admin Fee (10%)</span><span id="adminFee">Rs.<%= Math.round((chef.hourlyRate || 1500) * 2 * 0.10) %></span></div>
            <div class="price-row total"><span>Total Amount</span><span id="totalPrice">Rs.<%= (chef.hourlyRate || 1500) * 2 + Math.round((chef.hourlyRate || 1500) * 2 * 0.10) %></span></div>
          </div>

          <div id="bookingError" class="booking-error" style="display:none;"></div>

          <button type="button" class="btn-submit-booking" onclick="submitBooking()">
            &#128204; Confirm Booking
          </button>
        </form>
      </div>

      <!-- Step 2: Success Screen -->
      <div id="modalStep2" style="display:none; text-align:center; padding: 2rem 1rem;">
        <div style="font-size:3.5rem; margin-bottom:0.8rem; animation: popIn 0.5s ease;">🎉</div>
        <h2 style="font-family: var(--font-family-serif); font-size: 1.8rem; color: var(--forest-green-dark); margin-bottom: 0.5rem;">Booking Request Submitted!</h2>
        
        <!-- Professional notification banner -->
        <div style="background:#FFF9E6; border-left:4px solid #F5B041; color:#7D6608; font-size:0.88rem; padding:0.9rem; border-radius:6px; margin: 1rem 0 1.5rem; text-align:left; line-height:1.4;">
          <strong>📢 Next Steps:</strong> Your booking has been registered. You can make the payment <strong>after the Chef accepts</strong> and the <strong>Admin approves</strong> the booking request. We will notify you via email and notification dashboard.
        </div>

        <div id="bookingConfirmBox" style="background: var(--bg-light); border-radius:12px; padding:1.2rem; text-align:left; margin-bottom:1.5rem; font-size:0.92rem; border:1px solid var(--border);"></div>
        
        <div style="display:flex; gap:0.6rem; justify-content:center; flex-wrap:wrap;">
          <a id="receiptDownloadLink" href="#" target="_blank" class="btn-primary" style="padding:0.7rem 1.2rem; border-radius:8px; font-size:0.9rem; text-decoration:none; background:#d87c24;">📄 Save Invoice (PDF)</a>
          <button onclick="printBookingDetails()" class="btn-outline" style="padding:0.7rem 1.2rem; border-radius:8px; font-size:0.9rem; font-weight:700; cursor:pointer;">🖨️ Print Details</button>
          <a href="/user/dashboard" class="btn-primary" style="padding:0.7rem 1.2rem; border-radius:8px; font-size:0.9rem; text-decoration:none; background:var(--forest-green);">📊 My Bookings</a>
          <button onclick="closeBookingModal()" style="background:#e0e7e0; border:none; padding:0.7rem 1.2rem; border-radius:8px; font-size:0.9rem; font-weight:600; cursor:pointer; color:#444;">Close</button>
        </div>
      </div>

    </div>
  </div>

  <!-- Modal Styles -->
  <style>
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .modal-overlay.open {
      display: flex;
    }

    .modal-box {
      background: var(--white);
      border-radius: 20px;
      padding: 2.5rem;
      width: 100%;
      max-width: 680px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.2);
      animation: slideUp 0.3s ease;
