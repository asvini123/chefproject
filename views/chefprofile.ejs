        grid-template-columns: 1fr 1fr;
      }

      .type-options {
        flex-direction: column;
      }

      .guest-row {
        flex-direction: column;
        gap: 1rem;
      }
    }
  </style>

  <script>
    const chefRate = <%= chef.hourlyRate || 1500 %>;

    // ── District Mapping & Travel Distance Validation ──────────────────
    const districtCitiesMap = {
      "Colombo": ["colombo", "dehiwala", "mount lavinia", "moratuwa", "kotte", "kaduwela", "maharagama", "kesbewa", "kolonnawa", "homagama", "hanwella", "nugegoda", "rajagiriya", "battaramulla", "piliyandala"],
      "Gampaha": ["gampaha", "negombo", "kelaniya", "kadawatha", "kiribathgoda", "wattala", "ja-ela", "minuwangoda", "divulapitiya", "mirigama", "ragama", "biyagama"],
      "Kalutara": ["kalutara", "panadura", "horana", "beruwala", "aluthgama", "bandaragama", "wadduwa", "matugama"],
      "Kandy": ["kandy", "gampola", "peradeniya", "katugastota", "kundasale", "nawalapitiya", "akurana", "digana", "gelioya"],
      "Matale": ["matale", "dambulla", "sigiriya", "galewela", "ukuwela"],
      "Nuwara Eliya": ["nuwara eliya", "hatton", "ginigathena", "talawakele", "lindula", "ragala", "maskeliya"],
      "Galle": ["galle", "hikkaduwa", "karapitiya", "ambalangoda", "elpiitiya", "bentota", "unawatuna", "baddegama"],
      "Matara": ["matara", "weligama", "akuressa", "deniyaya", "dikwella", "kamburupitiya"],
      "Hambantota": ["hambantota", "tangalle", "beliatta", "tissamaharama", "ambalantota"],
      "Jaffna": ["jaffna", "chavakachcheri", "point pedro", "karainagar", "nallur", "valvettithurai", "chunnakam", "kopay", "manipay", "tellippalai"],
      "Kilinochchi": ["kilinochchi", "pooneryn", "pallai"],
      "Mannar": ["mannar", "murunkan", "madhu", "pesalai", "thalaimannar"],
      "Vavuniya": ["vavuniya", "nedunkeni", "cheddikulam"],
      "Mullaitivu": ["mullaitivu", "puthukudiyiruppu", "oddusuddan"],
      "Batticaloa": ["batticaloa", "kattankudy", "eravur", "valachchenai", "kaluwanchikudy"],
      "Ampara": ["ampara", "kalmunai", "sainthamaruthu", "akkaraipattu", "pottuvil", "samanthurai"],
      "Trincomalee": ["trincomalee", "mutur", "kinniya", "kuchchaveli", "kantale"],
      "Kurunegala": ["kurunegala", "kuliyapitiya", "narammala", "wariyapola", "pannala", "ibbagamuwa", "polgahawela", "alawwa"],
      "Puttalam": ["puttalam", "chilaw", "wennappuwa", "marawila", "dankotuwa", "kalpitiya", "nattandiya"],
      "Anuradhapura": ["anuradhapura", "mihintale", "kekirawa", "medawachchiya", "eppawala", "galgamuwa", "tambuttegama"],
      "Polonnaruwa": ["polonnaruwa", "kaduruwela", "hingurakgoda", "medirigiriya"],
      "Badulla": ["badulla", "bandarawela", "haputale", "ella", "welimada", "mahiyanganaya", "diyatalawa"],
      "Moneragala": ["moneragala", "wellawaya", "buttala", "kataragama", "bibile"],
      "Ratnapura": ["ratnapura", "balangoda", "embilipitiya", "pelmadulla", "eheliyagoda", "kuruwita"],
      "Kegalle": ["kegalle", "mawanella", "ruwanwella", "warakapola", "dehiowita", "yatiyantota"]
    };

    function resolveDistrict(text) {
      if (!text) return '';
      const clean = text.trim().toLowerCase();
      for (const d of Object.keys(districtCitiesMap)) {
        if (d.toLowerCase() === clean) return d;
      }
      for (const d of Object.keys(districtCitiesMap)) {
        const reg = new RegExp('\\b' + d.toLowerCase() + '\\b', 'i');
        if (reg.test(clean)) return d;
      }
      for (const [d, cities] of Object.entries(districtCitiesMap)) {
        for (const c of cities) {
          const reg = new RegExp('\\b' + c.toLowerCase() + '\\b', 'i');
          if (reg.test(clean)) return d;
        }
      }
      return '';
    }

    const CHEF_DISTRICT_RAW = "<%= chef.district || chef.city || '' %>";
    const CHEF_CITY_RAW = "<%= chef.city || '' %>";
    const CHEF_DISTRICT = resolveDistrict(CHEF_DISTRICT_RAW) || resolveDistrict(CHEF_CITY_RAW) || CHEF_DISTRICT_RAW || CHEF_CITY_RAW;
    const USER_PROFILE_DISTRICT_RAW = "<%= (typeof user !== 'undefined' && user) ? (user.district || user.city || '') : '' %>";
    const USER_PROFILE_DISTRICT = resolveDistrict(USER_PROFILE_DISTRICT_RAW) || USER_PROFILE_DISTRICT_RAW;

    function checkDistrictMatch() {
      const warnBox = document.getElementById('districtWarningBox');
      if (!warnBox) return { isMismatch: false };

      const locInput = document.getElementById('bookingLocationInput');
      const locVal = locInput ? locInput.value.trim() : '';

      const detectedUserDistrict = resolveDistrict(locVal) || USER_PROFILE_DISTRICT;

      if (detectedUserDistrict && CHEF_DISTRICT && detectedUserDistrict.toLowerCase() !== CHEF_DISTRICT.toLowerCase()) {
        warnBox.style.display = 'block';
        warnBox.innerHTML = `
          <div style="display:flex; gap:0.6rem; align-items:flex-start;">
            <span style="font-size:1.3rem; line-height:1.2;">⚠️</span>
            <div>
              <strong style="color:#d46b08; font-size:0.9rem; display:block; margin-bottom:0.25rem;">Different District Warning</strong>
              <div style="font-size:0.84rem; color:#612500; margin-bottom:0.3rem;">
                Chef <strong><%= chef.firstName %></strong> is located in <strong>${CHEF_DISTRICT} District</strong>, but your booking address is in <strong>${detectedUserDistrict} District</strong>.
              </div>
              <div style="font-size:0.79rem; color:#873800; line-height:1.4; background:rgba(255,255,255,0.7); padding:0.4rem 0.6rem; border-radius:6px; border:1px solid #ffd591;">
                ⚠️ <em>Notice: Due to significant travel distance across different districts, your booking is <strong>likely to be cancelled or declined</strong> by the chef. (Bookings within the same district are acceptable).</em>
              </div>
            </div>
          </div>
        `;
        return { isMismatch: true, userDist: detectedUserDistrict, chefDist: CHEF_DISTRICT };
      } else {
        warnBox.style.display = 'none';
        warnBox.innerHTML = '';
        return { isMismatch: false, userDist: detectedUserDistrict, chefDist: CHEF_DISTRICT };
      }
    }

    function toggleEventType() {
      const selectedType = document.querySelector('input[name="bookingType"]:checked') ? document.querySelector('input[name="bookingType"]:checked').value : 'Daily';
      const eventSection = document.getElementById('eventDetailsSection');
      if (eventSection) {
        eventSection.style.display = selectedType === 'Event' ? 'block' : 'none';
      }
    }

    function openBookingModal() {
      const isUserLoggedIn = <%= (typeof user !== 'undefined' && user && (user._id || user.id)) ? 'true' : 'false' %>;
      if (!isUserLoggedIn) {
        let returnUrl = window.location.pathname;
        const currentSearch = window.location.search;
        if (currentSearch) {
          returnUrl += currentSearch.includes('book=') ? currentSearch : currentSearch + '&book=1';
        } else {
          returnUrl += '?book=1';
        }
        window.location.href = '/login?redirect=' + encodeURIComponent(returnUrl);
        return;
      }
      document.getElementById('bookingModal').classList.add('open');
      document.body.style.overflow = 'hidden';
      setTimeout(checkDistrictMatch, 50);
    }
    function closeBookingModal() {
      document.getElementById('bookingModal').classList.remove('open');
      document.body.style.overflow = '';
      // Reset to step 1
      document.getElementById('modalStep1').style.display = '';
      document.getElementById('modalStep2').style.display = 'none';
    }
    function handleOverlayClick(e) {
      if (e.target === document.getElementById('bookingModal')) closeBookingModal();
    }

    function openChatWithChef() {
      const isUserLoggedIn = <%= (typeof user !== 'undefined' && user && (user._id || user.id)) ? 'true' : 'false' %>;
      if (!isUserLoggedIn) {
        window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
        return;
      }
      const chefId = '<%= chef._id %>';
      const chefName = encodeURIComponent('Chef <%= chef.firstName %> <%= chef.lastName %>');
      const chefInitial = '<%= chef.firstName.charAt(0).toUpperCase() %>';
      window.location.href = '/user/dashboard?chatWith=' + chefId + '&chatName=' + chefName + '&chatInitial=' + chefInitial + '#chat';
    }

    // DOM Content Loaded handled below.

    function changeCount(field, delta) {
      const input = document.getElementById(field);
      const val = parseInt(input.value) + delta;
      if (field === 'adults' && val < 1) return;
      if (field === 'children' && val < 0) return;
      input.value = val;
      updatePriceTotal();
    }

    // Set today as minimum date & check for auto-open
    document.addEventListener('DOMContentLoaded', () => {
      const dateInput = document.querySelector('input[name="date"]');
      if (dateInput) dateInput.min = new Date().toISOString().split('T')[0];

      // Auto-fill food from URL query
      const urlParams = new URLSearchParams(window.location.search);
      const foodParam = urlParams.get('food');
      if (foodParam) {
        const fi = document.getElementById('foodName');
        if (fi) { fi.value = decodeURIComponent(foodParam); fi.style.borderColor='#2c5f2d'; fi.style.background='#e8f5e9'; }
      }

      const dur = document.querySelector('select[name="duration"]');
      if (dur) dur.addEventListener('change', updatePriceTotal);

      // Auto open booking modal ONLY if book param is present AND user is logged in
      if (urlParams.get('book') === '1' || urlParams.get('book') === 'true') {
        const isUserLoggedIn = <%= (typeof user !== 'undefined' && user && (user._id || user.id)) ? 'true' : 'false' %>;
        if (isUserLoggedIn) {
          setTimeout(() => { openBookingModal(); }, 150);
        } else {
          window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname + window.location.search);
        }
      }
    });

    function toggleGroceryInput(show) {
      const typeGroup = document.getElementById('groceryTypeGroup');
      const itemsGroup = document.getElementById('groceryItemsGroup');
      const radioAll = document.getElementById('groceryTypeAll');
      const radioSpecific = document.getElementById('groceryTypeSpecific');
      const txt = document.getElementById('groceryItemsNeeded');

      if (show) {
        typeGroup.style.display = 'block';
      } else {
        typeGroup.style.display = 'none';
        itemsGroup.style.display = 'none';
        if (radioAll) radioAll.checked = false;
        if (radioSpecific) radioSpecific.checked = false;
        if (txt) txt.value = '';
      }
      updatePriceTotal();
    }

    function toggleSpecificGrocery(showSpecific) {
      const group = document.getElementById('groceryItemsGroup');
      if (group) group.style.display = showSpecific ? 'block' : 'none';
      if (!showSpecific) {
        const txt = document.getElementById('groceryItemsNeeded');
        if (txt) txt.value = 'All ingredients needed for the dish.';
      } else {
        const txt = document.getElementById('groceryItemsNeeded');
        if (txt && txt.value === 'All ingredients needed for the dish.') txt.value = '';
      }
    }

    function togglePaymentNote() {
      const pm = document.getElementById('paymentMethod').value;
      const note = document.getElementById('advancePaymentNote');
      if (pm === 'Bank') {
        note.style.display = 'block';
        note.innerHTML = '<strong>Note:</strong> A <strong>50% advance payment</strong> is required to confirm this booking. You will see the Chef\'s bank details in your dashboard after clicking confirm.';
      } else if (pm === 'PayHere') {
        note.style.display = 'block';
        note.innerHTML = '<strong>Note:</strong> You will be redirected to PayHere to securely complete your payment.';
      } else {
        note.style.display = 'block';
        note.innerHTML = '<strong>Note:</strong> You can pay the full amount in cash after the service is completed.';
      }
    }

    function updatePriceTotal() {
      const hrs = parseInt(document.querySelector('select[name="duration"]').value) || 2;
      const adults = parseInt(document.getElementById('adults').value) || 0;
      const children = parseInt(document.getElementById('children').value) || 0;
      const totalGuests = adults + children;

      const grocery = document.querySelector('input[name="grocerySupport"]:checked');
      const groceryFee = grocery && grocery.value === 'true' ? 500 : 0;
      
      let extraGuestFee = 0;
      if (totalGuests > 2) {
          extraGuestFee = (totalGuests - 2) * 500;
      }

      const base = chefRate * hrs;
      const adminFee = Math.round((base + groceryFee + extraGuestFee) * 0.10);
      const total = base + groceryFee + extraGuestFee + adminFee;
      
      document.getElementById('durationDisplay').textContent = hrs;
      document.getElementById('basePrice').textContent = 'Rs.' + base;
      document.getElementById('groceryFeeDisplay').textContent = 'Rs.' + groceryFee;
      
      const guestFeeRow = document.getElementById('guestFeeRow');
      if (extraGuestFee > 0) {
          guestFeeRow.style.display = 'flex';
          document.getElementById('guestFeeDisplay').textContent = 'Rs.' + extraGuestFee;
      } else {
          guestFeeRow.style.display = 'none';
      }

      document.getElementById('adminFee').textContent = 'Rs.' + adminFee;
      document.getElementById('totalPrice').textContent = 'Rs.' + total;
    }

    async function submitBooking() {
      const form = document.getElementById('inlineBookingForm');
      const btn = document.querySelector('.btn-submit-booking');
      const errDiv = document.getElementById('bookingError');

      const dateStr = form.querySelector('[name="date"]').value;
      const timeStr = form.querySelector('[name="time"]').value;
      const locationStr = form.querySelector('[name="location"]').value.trim();
      const foodStr = form.querySelector('[name="foodName"]').value.trim();

      if (!dateStr || !timeStr || !locationStr || !foodStr) {
        errDiv.textContent = '\u26A0\uFE0F Please fill in Date, Time, Home Address, and Dish to Cook.';
        errDiv.style.display = 'block';
        return;
      }

      // Past date check
      const sel = new Date(dateStr); const tod = new Date(); tod.setHours(0,0,0,0);
      if (sel < tod) { errDiv.textContent = '\u26A0\uFE0F Past dates not allowed.'; errDiv.style.display = 'block'; return; }

      // Time check 06:00 - 21:30
      const [h, m] = timeStr.split(':').map(Number);
      if (h * 60 + m < 360 || h * 60 + m > 1290) {
        errDiv.textContent = '\u26A0\uFE0F Booking time must be 06:00 AM \u2013 09:30 PM.';
        errDiv.style.display = 'block'; return;
      }

      // District Mismatch Confirmation Check
      const distCheck = checkDistrictMatch();
      if (distCheck.isMismatch) {
        const proceed = confirm(`⚠️ Different District Warning:\n\nChef <%= chef.firstName %> is located in ${distCheck.chefDist} District, but your booking location is in ${distCheck.userDist} District.\n\nDue to significant travel distance across districts, this booking is likely to be cancelled or declined by the chef.\n\nDo you still wish to proceed with this booking?`);
        if (!proceed) {
          return;
        }
      }

      errDiv.style.display = 'none';
      btn.disabled = true; btn.textContent = '\u23F3 Confirming...';

      const formData = new FormData(form);
      const body = new URLSearchParams();
      formData.forEach((value, key) => body.append(key, value));
      const meals = form.querySelectorAll('[name="meals"]:checked');
      body.delete('meals');
      meals.forEach(m => body.append('meals', m.value));

      try {
        const res = await fetch('/booking/create-ajax', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
          body: body.toString()
        });
        const data = await res.json();

        if (data.success) {
          // Redirect to success page — no modal complexity, no scroll bugs
          const bookingId = data.booking && data.booking._id ? data.booking._id : '';
          if (data.redirectUrl) {
            window.location.href = data.redirectUrl;
          } else {
            window.location.href = '/booking/success/' + bookingId;
          }
          return;
        } else {
          errDiv.textContent = '\u26A0\uFE0F  ' + (data.message || 'Something went wrong.');
          errDiv.style.display = 'block';
          btn.disabled = false; btn.textContent = 'Confirm Booking';
        }
      } catch (err) {
        errDiv.textContent = '\u26A0\uFE0F  Network error. Please try again.';
        errDiv.style.display = 'block';
        btn.disabled = false; btn.textContent = 'Confirm Booking';
      }
    }

    async function toggleSaveChef(chefId) {
      const isUserLoggedIn = <%= (typeof user !== 'undefined' && user && (user._id || user.id)) ? 'true' : 'false' %>;
      if (!isUserLoggedIn) {
        window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
        return;
      }
      try {
        const response = await fetch('/user/chef/save/' + chefId, { 
          method: 'POST',
          headers: { 'Accept': 'application/json' }
        });
        if (response.status === 401) {
          window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
          return;
        }
        const result = await response.json().catch(() => null);
        if (result && result.success) {
          const btn = document.querySelector('.btn-save');
          if (result.saved) {
            btn.classList.add('saved');
            btn.innerHTML = 'Saved ❤️';
          } else {
            btn.classList.remove('saved');
            btn.innerHTML = 'Save this chef';
          }
        } else {
          window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
        }
      } catch (err) {
        window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
      }
    }

    function printBookingDetails() {
      const box = document.getElementById('bookingConfirmBox').innerHTML;
      const win = window.open('', '_blank');
      win.document.write(`
        <html>
        <head>
