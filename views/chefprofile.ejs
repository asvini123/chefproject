    .modal-price-summary {
      background: var(--bg-light);
      border-radius: 12px;
      padding: 1.2rem 1.5rem;
      margin-bottom: 1.5rem;
    }

    .price-row {
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0;
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .price-row.total {
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--text-dark);
      border-top: 2px solid var(--border);
