    .btn-submit-booking {
      width: 100%;
      background: var(--forest-green);
      color: white;
      border: none;
      padding: 1.1rem;
      border-radius: 12px;
      font-size: 1.1rem;
      font-weight: 700;
      cursor: pointer;
