              <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-link-btn twitter" aria-label="Twitter">Twitter</a>
              <a href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" class="social-link-btn linkedin" aria-label="LinkedIn">LinkedIn</a>
