      </div>

    </div><!-- /.enroll-modal-box -->
  </div><!-- /#enrollModal -->

</main>

<!-- PayHere Sandbox SDK —— loaded BEFORE footer so payhere object is defined -->
<script async type="text/javascript" src="https://sandbox.payhere.lk/lib/payhere.js"></script>

<script>
// ═══════════════════════════════════════════════════════════════
// ChefNest Academy — Enrollment & Payment Flow
// ═══════════════════════════════════════════════════════════════

var COURSE_PRICES = {
  'Sri Lankan Cuisine':                                         'FREE',
  'South Indian Cuisine':                                       'LKR 100.00',
  'North Indian Cuisine':                                       'LKR 4,500.00',
  'Chinese Cuisine':                                            'LKR 3,800.00',
  'Continental Cuisine':                                        'LKR 5,200.00',
  'Italian Cuisine':                                            'LKR 4,800.00',
  'Mexican Cuisine':                                            'LKR 3,200.00',
  'French Cuisine':                                             'LKR 6,500.00',
  'Vegan & Plant-Based Cuisine':                                'FREE',
  'Beginner Essentials � Knife Skills & Rice/Curry':         'FREE',
  'Intermediate � Meal Planning & Spice Balancing':          'LKR 3,500.00',
  'Advanced � Hotel Plating & Bulk Event Cooking':           'LKR 7,800.00',
  'Diabetic-Friendly Cooking':                                  'LKR 4,000.00',
  'Allergy-Safe Cooking � Nut-Free & Gluten-Free':           'LKR 3,500.00',
  'Weight Management Meal Prep':                                'LKR 4,000.00',
  'Party & Event Catering Basics':                              'LKR 6,500.00',
  'Festival Special Cooking � Pongal, Deepavali & New Year':  'FREE',
  'Quick 30-Min Weeknight Meals':                               'FREE',
  '"Home Cook to Pro Chef" � Full Certification Course': 'LKR 18,500.00'
};

var currentEnrollment = null;
var generatedOtp      = null;

function getCoursePrice(title) {
  if (!title) return 'LKR 4,000.00';
  var t = title.trim();
  for (var k in COURSE_PRICES) { if (t === k.trim()) return COURSE_PRICES[k]; }
  return 'LKR 4,000.00';
}

function getPriceNumber(priceStr) {
  if (priceStr === 'FREE') return 0;
  var clean = priceStr.replace(/[^0-9.]/g, '');
  return parseFloat(clean) || 0;
}

function generatePaymentId() {
  var d = new Date();
  return 'CNE-' + d.getFullYear() +
    String(d.getMonth()+1).padStart(2,'0') +
    String(d.getDate()).padStart(2,'0') + '-' +
    String(Math.floor(1000 + Math.random() * 9000));
}

function generateOtp() {
  return String(Math.floor(100000 + Math.random() * 900000));
}

function validateSriLankanPhone(phone) {
  return /^(?:\+94|94|0)?7[0-9]{8}$/.test(phone.replace(/[\s\-()]/g,''));
}

function clearErrors() {
  ['errFullName','errEmail','errPhone','errExperience','errAgree',
   'errCardNumber','errCardMonth','errCardYear','errCardName','errCardCvv','errOtp'
  ].forEach(function(id){ var el=document.getElementById(id); if(el) el.textContent=''; });
}

function setStep(step) {
  var map = {
    enrollForm:        step === 1,
    enrollPaymentStep: step === 2,
    enrollCardStep:    step === 3,
    enrollOtpStep:     step === 4,
    enrollReceiptStep: step === 5
  };
  for (var id in map) {
    var el = document.getElementById(id);
    if (el) el.style.display = map[id] ? '' : 'none';
  }
  var s1 = document.getElementById('estep1');
  var s2 = document.getElementById('estep2');
  var s3 = document.getElementById('estep3');
  if (s1) s1.className = 'estep' + (step === 1 ? ' active' : (step >= 2 ? ' completed' : ''));
  if (s2) s2.className = 'estep' + ((step >= 2 && step <= 4) ? ' active' : (step === 5 ? ' completed' : ''));
  if (s3) s3.className = 'estep' + (step === 5 ? ' active' : '');
  var lines = document.querySelectorAll('.estep-line');
  if (lines.length >= 2) {
    if (step >= 2) lines[0].className = 'estep-line done'; else lines[0].className = 'estep-line';
    if (step === 5) lines[1].className = 'estep-line done'; else lines[1].className = 'estep-line';
  }
}
function openEnrollModal(courseTitle) {
  var isUserLoggedIn = <%= (typeof user !== 'undefined' && user) ? 'true' : 'false' %>;
  if (!isUserLoggedIn) {
    window.location.href = '/login?redirect=' + encodeURIComponent('/user/dashboard#courses');
    return;
  }
  window.location.href = '/user/dashboard#courses';
}

// Auto-open enroll modal if user just returned from login with ?course= param
(function autoOpenFromLogin() {
  var params = new URLSearchParams(window.location.search);
  var courseParam = params.get('course');
  if (courseParam) {
    // Clean the URL without reloading
    var cleanUrl = window.location.pathname;
    window.history.replaceState({}, document.title, cleanUrl);
    // Wait for DOM to be ready then open modal
    document.addEventListener('DOMContentLoaded', function() {
      openEnrollModal(decodeURIComponent(courseParam));
    });
    if (document.readyState !== 'loading') {
      openEnrollModal(decodeURIComponent(courseParam));
    }
  }
})();


function closeEnrollModal() {
  var modal = document.getElementById('enrollModal');
  modal.classList.remove('active');
  modal.setAttribute('aria-hidden','true');
  document.body.style.overflow = '';
}

function populateReceipt() {
  if (!currentEnrollment) return;
  var e = currentEnrollment;
  document.getElementById('rcptPaymentId').textContent = e.paymentId;
  document.getElementById('rcptDate').textContent      = e.date;
  document.getElementById('rcptName').textContent      = e.fullName;
  document.getElementById('rcptEmail').textContent     = e.email;
  document.getElementById('rcptPhone').textContent     = '+94 ' + e.phone;
  document.getElementById('rcptCourse').textContent    = e.courseName;
  document.getElementById('rcptAmount').textContent    = e.coursePrice;
}

function printReceipt() {
  if (!currentEnrollment) return;
  var e = currentEnrollment;
  var w = window.open('','_blank');
  if (!w) { alert('Please allow popups to download the receipt.'); return; }
  w.document.write('<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Receipt - ChefNest Academy</title>'
    + '<style>body{font-family:Segoe UI,sans-serif;padding:30px;background:#f9f9f9;color:#333}'
    + '.box{max-width:720px;margin:0 auto;background:#fff;padding:40px;border-radius:16px;box-shadow:0 4px 20px rgba(0,0,0,.1)}'
    + '.hdr{display:flex;justify-content:space-between;border-bottom:2px solid #2C5F2D;padding-bottom:18px;margin-bottom:24px}'
    + '.logo{font-size:20px;font-weight:800;color:#2C5F2D}.logo small{display:block;font-size:11px;color:#888;letter-spacing:2px;text-transform:uppercase}'
    + 'table{width:100%;border-collapse:collapse;margin:16px 0}'
    + 'td{padding:9px 8px;font-size:13.5px;border-bottom:1px solid #f0f0f0}.lbl{color:#666;width:150px}.val{font-weight:600}'
    + 'thead th{background:#2C5F2D;color:#fff;padding:12px;text-align:left;font-size:13px}'
    + '.total td{font-size:15px;font-weight:800;color:#2C5F2D;border-bottom:2px solid #2C5F2D}'
    + '.confirm{background:#f1f8f1;border:1px solid #c2e0c2;padding:12px 16px;border-radius:8px;margin-top:16px;font-size:13px}'
    + '.foot{text-align:center;margin-top:36px;font-size:11px;color:#999;line-height:1.7}'
    + '.btn{display:block;width:fit-content;margin:28px auto 0;background:#2C5F2D;color:#fff;border:none;padding:12px 32px;border-radius:30px;font-size:15px;font-weight:700;cursor:pointer}'
    + '@media print{body{background:#fff;padding:0}.box{box-shadow:none;padding:0}.btn{display:none}}'
    + '</style></head><body><div class="box">'
    + '<div class="hdr"><div class="logo">&#127869; ChefNest Academy<small>Culinary Excellence Center</small></div><div style="font-size:18px;font-weight:700">OFFICIAL PAYMENT RECEIPT</div></div>'
    + '<table><tr><td class="lbl">Payment ID</td><td class="val" style="font-family:monospace">' + e.paymentId + '</td>'
    + '<td class="lbl" style="text-align:right">Date</td><td class="val" style="text-align:right">' + e.date + '</td></tr>'
    + '<tr><td class="lbl">Student Name</td><td class="val">' + e.fullName + '</td>'
    + '<td class="lbl" style="text-align:right">Phone</td><td class="val" style="text-align:right">+94 ' + e.phone + '</td></tr>'
    + '<tr><td class="lbl">Email</td><td class="val">' + e.email + '</td>'
    + '<td class="lbl" style="text-align:right">City</td><td class="val" style="text-align:right">' + (e.city||'N/A') + '</td></tr>'
    + '</table>'
    + '<table><thead><tr><th>Course Description</th><th style="text-align:right">Amount</th></tr></thead><tbody>'
    + '<tr><td>' + e.courseName + '<br><small style="color:#888">Level: ' + e.experience + ' | Schedule: ' + e.schedule + '</small></td><td style="text-align:right;font-weight:600">' + e.coursePrice + '</td></tr>'
    + '<tr class="total"><td>Total Paid (LKR)</td><td style="text-align:right">' + e.coursePrice + '</td></tr>'
    + '</tbody></table>'
    + '<div class="confirm"><strong style="color:#1b5e20">Payment Method: BOC Secure Card Payment</strong><br>Transaction Status: <span style="color:#2e7d32;font-weight:700">Verified &amp; Approved &#10003;</span></div>'
    + '<div class="foot">This is a system-generated receipt. For inquiries, email support@chefnest.lk with your Payment ID.<br><strong>ChefNest Academy &mdash; Jaffna, Sri Lanka.</strong></div>'
    + '<button class="btn" onclick="window.print()">&#128424; Print / Save as PDF</button>'
    + '</div></body></html>');
  w.document.close();
}

// ── DOMContentLoaded ────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function () {

  // Filter tabs
  var tabs = document.querySelectorAll('.filter-tab');
  var cards = document.querySelectorAll('.course-card');
  var catHdrs = document.querySelectorAll('.courses-category-header');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function(t){ t.classList.remove('active'); });
      this.classList.add('active');
      var cat = this.dataset.cat;
      cards.forEach(function(c){ c.style.display=(cat==='all'||c.dataset.cat===cat)?'':'none'; });
      catHdrs.forEach(function(h){ h.style.display=(cat==='all'||h.dataset.cat===cat)?'':'none'; });
    });
  });

  // Certificate modal
  var certModal    = document.getElementById('certModal');
  var closeCertBtn = document.getElementById('btnCloseCertModal');
  var openCertBtn  = document.getElementById('btnOpenCertModal');
  var prevCard     = document.getElementById('certPreviewCard');
  function openCertModal()  { if(certModal){ certModal.classList.add('active'); certModal.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; }}
  function closeCertModal() { if(certModal){ certModal.classList.remove('active'); certModal.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }}
  if (openCertBtn)  openCertBtn.addEventListener('click', openCertModal);
  if (prevCard)     prevCard.addEventListener('click', openCertModal);
  if (closeCertBtn) closeCertBtn.addEventListener('click', closeCertModal);
  if (certModal)    certModal.addEventListener('click', function(e){ if(e.target===certModal) closeCertModal(); });

  // Enroll modal close
  var enrollModal     = document.getElementById('enrollModal');
  var closeEnrollBtn  = document.getElementById('btnCloseEnrollModal');
  var successCloseBtn = document.getElementById('btnSuccessClose');
  if (closeEnrollBtn)  closeEnrollBtn.addEventListener('click', closeEnrollModal);
  if (successCloseBtn) successCloseBtn.addEventListener('click', closeEnrollModal);
  if (enrollModal)     enrollModal.addEventListener('click', function(e){ if(e.target===enrollModal) closeEnrollModal(); });

  // ── STEP 1: Enrollment form submit ─────────────────────────────
  var enrollForm = document.getElementById('enrollForm');
  if (enrollForm) {
    enrollForm.addEventListener('submit', function(e) {
      e.preventDefault();
      clearErrors();
      var fullName = document.getElementById('enrollFullName').value.trim();
      var email    = document.getElementById('enrollEmail').value.trim();
      var phone    = document.getElementById('enrollPhone').value.trim();
      var exp      = document.getElementById('enrollExperience').value;
      var agree    = document.getElementById('enrollAgree').checked;
      var course   = document.getElementById('enrollCourseName').value;
      var price    = document.getElementById('enrollCoursePrice').value;
      var valid    = true;

      if (!fullName) { document.getElementById('errFullName').textContent='Please enter your full name.'; valid=false; }
      if (!email||!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { document.getElementById('errEmail').textContent='Please enter a valid email.'; valid=false; }
      if (!phone) { document.getElementById('errPhone').textContent='Please enter your phone number.'; valid=false; }
      else if (!validateSriLankanPhone(phone)) { document.getElementById('errPhone').textContent='Use 07XXXXXXXX format.'; valid=false; }
      if (!exp) { document.getElementById('errExperience').textContent='Please select your experience level.'; valid=false; }
      if (!agree) { document.getElementById('errAgree').textContent='You must agree to the terms.'; valid=false; }
      if (!valid) return;

      var payId = generatePaymentId();
      currentEnrollment = {
        paymentId:  payId,
        fullName:   fullName,
        email:      email,
        phone:      phone,
        city:       document.getElementById('enrollCity').value.trim()||'Not Provided',
        courseName: course,
        coursePrice:price,
        experience: exp,
        schedule:   document.getElementById('enrollSchedule').value||'Flexible',
        note:       document.getElementById('enrollMessage').value.trim()||'None',
        date:       new Date().toLocaleDateString('en-GB')
      };

      if (price === 'FREE') {
        populateReceipt();
        setStep(5);
      } else {
        document.getElementById('payDisplayId').textContent     = payId;
        document.getElementById('payDisplayName').textContent   = fullName;
        document.getElementById('payDisplayCourse').textContent = course;
        document.getElementById('payDisplayAmount').textContent = price;
        setStep(2);
      }
    });
  }

  // ── STEP 2: Proceed → PayHere Secure Checkout Gateway ──────────
  var btnGoToCard = document.getElementById('btnGoToCard');
  if (btnGoToCard) {
    btnGoToCard.addEventListener('click', function() {
      if (!currentEnrollment) {
        alert('Please fill in the enrollment form first.');
        return;
      }

      // Check if PayHere SDK loaded
      if (typeof payhere === 'undefined') {
        alert('Payment gateway loading... please try again in 2 seconds.');
        return;
      }
      
      var priceVal = getPriceNumber(currentEnrollment.coursePrice);
      
      // Get secure signature hash from backend
      fetch('/payment/hash', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          orderId: currentEnrollment.paymentId,
          amount: priceVal,
          currency: 'LKR'
        })
      })
      .then(function(res) {
        return res.text().then(function(text) {
          try { return JSON.parse(text); }
          catch(e) { throw new Error('Server returned: ' + text.substring(0, 200)); }
        });
      })
      .then(function(data) {
        if (!data.hash) {
          alert('Hash error: ' + JSON.stringify(data));
          return;
        }

        // Configure PayHere payment object
        var payment = {
          "sandbox": true,
          "merchant_id": "1236941",
          "return_url": window.location.href,
          "cancel_url": window.location.href,
          "notify_url": "http://localhost:3000/payment/notify",
          "order_id": currentEnrollment.paymentId,
          "items": currentEnrollment.courseName,
          "amount": priceVal.toFixed(2),
          "currency": "LKR",
          "hash": data.hash,
          "first_name": currentEnrollment.fullName.split(' ')[0] || 'Student',
          "last_name": currentEnrollment.fullName.split(' ').slice(1).join(' ') || 'Name',
          "email": currentEnrollment.email,
          "phone": currentEnrollment.phone,
          "address": currentEnrollment.city,
          "city": currentEnrollment.city,
          "country": "Sri Lanka"
        };

        // SDK Callbacks
        payhere.onCompleted = function(orderId) {
          console.log("PayHere: Payment success: " + orderId);
          populateReceipt();
          setStep(5);
        };

        payhere.onDismissed = function() {
          console.log("PayHere: Payment modal closed");
        };

        payhere.onError = function(error) {
          console.log("PayHere: Payment error: " + error);
          alert("Payment failed: " + error);
        };

        // Launch the secure popup PayHere checkout iframe
        payhere.startPayment(payment);
      })
      .catch(function(err) {
        console.error('PayHere fetch error:', err);
        var msg = 'ERROR DETAILS (copy this):\n' + (err.message || String(err));
        prompt('Payment service error — copy the text below:', msg);
      });
    });
  }
  var btnBackToForm = document.getElementById('btnBackToForm');
  if (btnBackToForm) btnBackToForm.addEventListener('click', function(){ setStep(1); });

  // ── STEP 3: Card form ──────────────────────────────────────────
  var cardNumInput = document.getElementById('cardNumber');
  if (cardNumInput) {
    cardNumInput.addEventListener('input', function() {
      var d = this.value.replace(/\D/g,'');
      this.value = d.replace(/(.{4})/g,'$1 ').trim().substring(0,19);
    });
  }
  var btnCloseCardStep = document.getElementById('btnCloseCardStep');
  var btnCardBack      = document.getElementById('btnCardBack');
  var btnCardCancel    = document.getElementById('btnCardCancel');
  if (btnCloseCardStep) btnCloseCardStep.addEventListener('click', closeEnrollModal);
  if (btnCardBack)      btnCardBack.addEventListener('click', function(){ setStep(2); });
  if (btnCardCancel)    btnCardCancel.addEventListener('click', closeEnrollModal);

  var cardPayForm = document.getElementById('cardPayForm');
  if (cardPayForm) {
    cardPayForm.addEventListener('submit', function(e) {
      e.preventDefault();
      clearErrors();
      var cardNum = document.getElementById('cardNumber').value.replace(/\s/g,'');
      var month   = document.getElementById('cardExpMonth').value;
      var year    = document.getElementById('cardExpYear').value;
      var name    = document.getElementById('cardName').value.trim();
      var cvv     = document.getElementById('cardCvv').value.trim();
      var valid   = true;
      if (!cardNum||cardNum.length<13) { document.getElementById('errCardNumber').textContent='Enter a valid card number.'; valid=false; }
      if (!month) { document.getElementById('errCardMonth').textContent='Select expiry month.'; valid=false; }
      if (!year)  { document.getElementById('errCardYear').textContent='Select expiry year.'; valid=false; }
      if (!name)  { document.getElementById('errCardName').textContent='Enter cardholder name.'; valid=false; }
      if (!cvv||cvv.length<3) { document.getElementById('errCardCvv').textContent='Enter valid security code.'; valid=false; }
      if (!valid) return;

      // Generate and show OTP (demo - in production this comes from bank/PayHere)
      generatedOtp = generateOtp();
      console.log('[DEV] OTP for testing:', generatedOtp, '— In production, OTP is sent by the bank to user\'s mobile.');
      document.getElementById('testOtpDisplay').textContent = generatedOtp;
      document.getElementById('otpAmountDisplay').textContent =
        '💳 ' + (currentEnrollment ? currentEnrollment.coursePrice : '');
      document.getElementById('otpInput').value = '';
      setStep(4);
    });
  }

  // ── STEP 4: OTP verify ─────────────────────────────────────────
  var btnOtpBack   = document.getElementById('btnOtpBack');
  var btnOtpVerify = document.getElementById('btnOtpVerify');
  var btnResendOtp = document.getElementById('btnResendOtp');
  if (btnOtpBack)   btnOtpBack.addEventListener('click', function(){ setStep(3); });
  if (btnResendOtp) {
    btnResendOtp.addEventListener('click', function() {
      generatedOtp = generateOtp();
      console.log('[DEV] Resent OTP:', generatedOtp);
      document.getElementById('testOtpDisplay').textContent = generatedOtp;
      this.textContent = 'OTP Resent ✓';
      var btn = this;
      setTimeout(function(){ btn.textContent = 'Resend OTP'; }, 3000);
    });
  }
  if (btnOtpVerify) {
    btnOtpVerify.addEventListener('click', function() {
      var entered = document.getElementById('otpInput').value.trim();
      document.getElementById('errOtp').textContent = '';
      if (!entered) { document.getElementById('errOtp').textContent='Please enter the OTP.'; return; }
      if (entered !== generatedOtp) { document.getElementById('errOtp').textContent='Incorrect OTP. Please try again.'; return; }
      populateReceipt();
      setStep(5);
    });
  }

  // ── STEP 5: Print ──────────────────────────────────────────────
  var btnViewReceipt = document.getElementById('btnViewReceipt');
  if (btnViewReceipt) btnViewReceipt.addEventListener('click', printReceipt);

  // ── Escape key ─────────────────────────────────────────────────
  document.addEventListener('keydown', function(e) {
    if (e.key==='Escape') {
      if (certModal   && certModal.classList.contains('active'))   closeCertModal();
      if (enrollModal && enrollModal.classList.contains('active')) closeEnrollModal();
    }
  });

});
</script>

