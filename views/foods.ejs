<%- include('partials/header', { title: `${cuisineName} Foods - ChefNest`, pageCss: 'foods.css' }) %>

<main class="cuisines-page">
  <!-- Top Hero Header -->
  <section class="cuisines-hero" style="min-height: 240px; padding: 3rem 1.5rem; text-align: center; background: linear-gradient(135deg, rgba(26,58,27,0.92), rgba(44,95,45,0.88)), url('/images/login_cooking_bg.jpg') center/cover; color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <div style="max-width: 800px; margin: 0 auto;">
      <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; color: #f4c28d; font-weight: 700; margin-bottom: 0.5rem;">
        <a href="/cuisines" style="color: #f4c28d; text-decoration: none;">&larr; All Cuisines</a> / <%= cuisineName %>
      </div>
      <h1 style="font-size: 2.6rem; font-family: serif; margin: 0.2rem 0 0.6rem; font-weight: 800;"><%= cuisineName %> Culinary Collection</h1>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.85); margin: 0;">Explore <%= foods.length %> authentic dishes and book verified private chefs to cook them fresh in your home.</p>
    </div>
  </section>

  <div class="cuisines-container" style="max-width: 1200px; margin: 2rem auto; padding: 0 1.5rem;">
    <!-- Filter and Search Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(44,95,45,0.12);">
      <div style="font-size: 0.95rem; color: var(--text-muted);">
        Showing <strong id="foodCount" style="color: var(--forest-green-dark);"><%= foods.length %></strong> authentic dishes
      </div>
      <div style="display: flex; gap: 0.8rem; align-items: center;">
        <input type="text" id="foodSearch" placeholder="Search dish by name..." oninput="filterFoodCards()"
               style="padding: 0.6rem 1.2rem; border-radius: 25px; border: 1.5px solid #d0e0d0; outline: none; font-size: 0.9rem; width: 260px; font-family: inherit;">
      </div>
    </div>

    <!-- Foods Grid -->
    <div class="cuisines-grid" id="foodsGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1.8rem; margin-top: 2rem;">
      <% if (foods && foods.length > 0) { %>
        <% foods.forEach(food => { %>
          <a href="/foods/<%= food._id %>" class="cuisine-card food-item-card" data-name="<%= food.name.toLowerCase() %>" style="border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 4px 16px rgba(0,0,0,0.06); text-decoration: none; display: flex; flex-direction: column; transition: transform 0.25s, box-shadow 0.25s; border: 1px solid rgba(44,95,45,0.08);">
            <div class="cuisine-image" style="position: relative; height: 210px; overflow: hidden; background: #f7f9f7;">
              <img src="<%= food.images && food.images.length > 0 ? food.images[0] : '/images/placeholder.jpg' %>" alt="<%= food.name %>" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
              
              <!-- Badges -->
              <% if (food.images && food.images.length > 1) { %>
                <span style="position: absolute; top: 12px; left: 12px; background: rgba(0,0,0,0.65); color: #fff; padding: 3px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; backdrop-filter: blur(4px);">
                  <%= food.images.length %> Photos
                </span>
              <% } %>
              
              <% if (food.calories) { %>
                <span style="position: absolute; top: 12px; right: 12px; background: rgba(217,122,43,0.92); color: #fff; padding: 3px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">
                  <%= food.calories %>
                </span>
              <% } %>

              <div class="overlay">
                <span class="view-btn">View Gallery &amp; Recipe</span>
              </div>
            </div>

            <div style="padding: 1.2rem 1.4rem; display: flex; flex-direction: column; flex: 1;">
              <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #b5601d; letter-spacing: 0.8px; margin-bottom: 0.3rem;">
                <%= food.category || 'Specialty Dish' %>
              </span>
              <h3 style="font-size: 1.15rem; font-family: serif; color: #1a3a1b; margin: 0 0 0.5rem; line-height: 1.3;">
                <%= food.name %>
              </h3>
              <p style="font-size: 0.85rem; color: #666; margin: 0 0 1rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= food.description %>
              </p>
              
              <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: center; padding-top: 0.8rem; border-top: 1px dashed #eee;">
                <span style="font-size: 0.8rem; color: #888; font-weight: 500;">
                  Serving: <%= food.servingSize || '1-2' %>
                </span>
                <span style="font-size: 0.85rem; font-weight: 700; color: #2C5F2D;">
                  Explore Dish &rarr;
                </span>
              </div>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div style="grid-column: 1/-1; text-align: center; padding: 4rem 1rem; background: #fff; border-radius: 12px;">
          <p style="font-size: 1.1rem; color: #777;">No dishes cataloged under this cuisine yet.</p>
          <a href="/cuisines" style="color: #2C5F2D; font-weight: 700; text-decoration: underline;">Browse other cuisines &rarr;</a>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script>
  function filterFoodCards() {
    const q = (document.getElementById('foodSearch')?.value || '').toLowerCase().trim();
    const cards = document.querySelectorAll('.food-item-card');
    let visible = 0;
    cards.forEach(c => {
      const name = c.getAttribute('data-name') || '';
      if (!q || name.includes(q)) {
        c.style.display = 'flex';
        visible++;
      } else {
        c.style.display = 'none';
      }
    });
    const countEl = document.getElementById('foodCount');
    if (countEl) countEl.textContent = visible;
  }
</script>

<%- include('partials/footer') %>
