<!-- Carousel Script -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slides = document.querySelectorAll('.carousel-slide');
    const indicators = document.querySelectorAll('.indicator');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    let currentIndex = 0;
    let autoSlideInterval;

    function showSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      
      slides.forEach(slide => slide.classList.remove('active'));
      indicators.forEach(ind => ind.classList.remove('active'));
      
      slides[index].classList.add('active');
      indicators[index].classList.add('active');
      currentIndex = index;
    }

    function nextSlide() {
      showSlide(currentIndex + 1);
    }

    function prevSlide() {
      showSlide(currentIndex - 1);
    }

    // Event listeners
    if (nextBtn) nextBtn.addEventListener('click', () => {
      nextSlide();
      resetAutoSlide();
    });
    if (prevBtn) prevBtn.addEventListener('click', () => {
      prevSlide();
      resetAutoSlide();
    });

    indicators.forEach(indicator => {
      indicator.addEventListener('click', (e) => {
        const index = parseInt(e.target.getAttribute('data-index'));
        showSlide(index);
        resetAutoSlide();
      });
    });

    // Auto-sliding
    function startAutoSlide() {
      autoSlideInterval = setInterval(nextSlide, 6000);
    }

    function resetAutoSlide() {
      clearInterval(autoSlideInterval);
      startAutoSlide();
    }

    startAutoSlide();
  });
</script>

<!-- District and City Custom Dropdowns Script & Styles -->
<style>
  /* Custom Dropdown Styling */
  .custom-dropdown-group {
    position: relative !important;
    display: flex;
    align-items: center;
    flex: 1;
    padding-left: 1.2rem;
    cursor: pointer;
  }
  .custom-dropdown-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 0;
    user-select: none;
    outline: none;
  }
  .custom-dropdown-trigger .trigger-label {
    font-size: 1.02rem;
    font-weight: 500;
    color: #1e3a1e;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-family-sans, sans-serif);
  }
  .custom-dropdown-trigger .chevron-icon {
    color: #2c5f2d;
    transition: transform 0.25s ease;
    margin-left: 0.5rem;
    flex-shrink: 0;
  }
  .custom-dropdown-group.is-open .chevron-icon {
    transform: rotate(180deg);
  }
  .custom-dropdown-group.is-disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .custom-dropdown-group.is-disabled .custom-dropdown-trigger {
    pointer-events: none;
  }
  .custom-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    width: 100%;
    min-width: 250px;
    max-height: 320px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22), 0 4px 12px rgba(44, 95, 45, 0.12);
    border: 1px solid rgba(44, 95, 45, 0.15);
    z-index: 99999;
    padding: 0.6rem;
    animation: dropdownFadeIn 0.2s ease forwards;
  }
  .custom-dropdown-group.is-open .custom-dropdown-menu {
    display: block;
  }
  @keyframes dropdownFadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .dropdown-search-box {
    padding: 0.2rem 0.2rem 0.5rem;
    border-bottom: 1px solid #edf2ed;
  }
  .dropdown-filter-input {
    width: 100%;
    padding: 0.5rem 0.8rem;
    border: 1.5px solid #cde0ce;
    border-radius: 10px;
    font-size: 0.9rem;
    outline: none;
    background: #fbfdfb;
    font-family: inherit;
    box-sizing: border-box;
  }
  .dropdown-filter-input:focus {
    border-color: #2c5f2d;
    background: #fff;
  }
  .dropdown-options-list {
    max-height: 230px;
    overflow-y: auto;
    padding: 0.4rem 0;
  }
  .dropdown-options-list::-webkit-scrollbar {
    width: 5px;
  }
  .dropdown-options-list::-webkit-scrollbar-thumb {
    background: #cbd8cb;
    border-radius: 4px;
  }
  .dropdown-option {
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #2d3748;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dropdown-option:hover {
    background: #eef7ee;
    color: #1a431b;
  }
  .dropdown-option.is-selected {
    background: #2c5f2d;
    color: #ffffff;
    font-weight: 600;
  }
  .dropdown-placeholder-msg {
    padding: 0.8rem;
    text-align: center;
    color: #8898aa;
    font-size: 0.88rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const districtCities = {
      "Colombo": ["Colombo", "Dehiwala-Mount Lavinia", "Moratuwa", "Sri Jayawardenepura Kotte", "Kaduwela", "Maharagama", "Kesbewa", "Kolonnawa", "Homagama", "Hanwella"],
      "Gampaha": ["Gampaha", "Negombo", "Kelaniya", "Kadawatha", "Kiribathgoda", "Wattala", "Ja-Ela", "Minuwangoda", "Divulapitiya", "Mirigama"],
      "Kalutara": ["Kalutara", "Panadura", "Horana", "Beruwala", "Aluthgama", "Bandaragama", "Wadduwa"],
      "Kandy": ["Kandy", "Gampola", "Peradeniya", "Katugastota", "Kundasale", "Nawalapitiya", "Akurana"],
      "Matale": ["Matale", "Dambulla", "Sigiriya", "Galewela", "Ukuwela"],
      "Nuwara Eliya": ["Nuwara Eliya", "Hatton", "Ginigathena", "Talawakele", "Lindula"],
      "Galle": ["Galle", "Hikkaduwa", "Karapitiya", "Ambalangoda", "Elpitiya", "Bentota", "Unawatuna"],
      "Matara": ["Matara", "Weligama", "Akuressa", "Deniyaya", "Dikwella"],
      "Hambantota": ["Hambantota", "Tangalle", "Beliatta", "Tissamaharama", "Ambalantota"],
      "Jaffna": ["Jaffna", "Chavakachcheri", "Point Pedro", "Karainagar", "Nallur", "Valvettithurai"],
      "Kilinochchi": ["Kilinochchi", "Pooneryn", "Pallai"],
      "Mannar": ["Mannar", "Murunkan", "Madhu"],
      "Vavuniya": ["Vavuniya", "Nedunkeni", "Cheddikulam"],
      "Mullaitivu": ["Mullaitivu", "Puthukudiyiruppu", "Oddusuddan"],
      "Batticaloa": ["Batticaloa", "Kattankudy", "Eravur", "Valachchenai", "Kaluwanchikudy"],
      "Ampara": ["Ampara", "Kalmunai", "Sainthamaruthu", "Akkaraipattu", "Pottuvil"],
      "Trincomalee": ["Trincomalee", "Mutur", "Kinniya", "Kuchchaveli"],
      "Kurunegala": ["Kurunegala", "Kuliyapitiya", "Narammala", "Wariyapola", "Pannala", "Ibbagamuwa"],
      "Puttalam": ["Puttalam", "Chilaw", "Wennappuwa", "Marawila", "Dankotuwa", "Kalpitiya"],
      "Anuradhapura": ["Anuradhapura", "Mihintale", "Kekirawa", "Medawachchiya", "Eppawala", "Galgamuwa"],
      "Polonnaruwa": ["Polonnaruwa", "Kaduruwela", "Hingurakgoda", "Medirigiriya"],
      "Badulla": ["Badulla", "Bandarawela", "Haputale", "Ella", "Welimada", "Mahiyanganaya"],
      "Moneragala": ["Moneragala", "Wellawaya", "Buttala", "Kataragama", "Bibile"],
      "Ratnapura": ["Ratnapura", "Balangoda", "Embilipitiya", "Pelmadulla", "Eheliyagoda"],
      "Kegalle": ["Kegalle", "Mawanella", "Ruwanwella", "Warakapola", "Dehiowita"]
    };

    const districtGroup = document.getElementById('districtGroup');
    const districtTrigger = document.getElementById('districtTrigger');
    const districtLabel = document.getElementById('districtLabel');
    const districtOptionsList = document.getElementById('districtOptionsList');
    const districtFilterInput = document.getElementById('districtFilterInput');
    const hiddenDistrict = document.getElementById('hiddenDistrict');

    const cityGroup = document.getElementById('cityGroup');
    const cityTrigger = document.getElementById('cityTrigger');
    const cityLabel = document.getElementById('cityLabel');
    const cityOptionsList = document.getElementById('cityOptionsList');
    const cityFilterInput = document.getElementById('cityFilterInput');
    const hiddenLocation = document.getElementById('hiddenLocation');
    const heroSearchForm = document.getElementById('heroSearchForm');

    // Toggle District
    if (districtTrigger) {
      districtTrigger.addEventListener('click', function(e) {
        e.stopPropagation();
        const isOpen = districtGroup.classList.contains('is-open');
        closeAllDropdowns();
        if (!isOpen) {
          districtGroup.classList.add('is-open');
          setTimeout(() => districtFilterInput && districtFilterInput.focus(), 50);
        }
      });
    }

    // Toggle City
    if (cityTrigger) {
      cityTrigger.addEventListener('click', function(e) {
        e.stopPropagation();
        if (cityGroup.classList.contains('is-disabled')) return;
        const isOpen = cityGroup.classList.contains('is-open');
        closeAllDropdowns();
        if (!isOpen) {
          cityGroup.classList.add('is-open');
          setTimeout(() => cityFilterInput && cityFilterInput.focus(), 50);
        }
      });
    }

    // District Option Selection
    if (districtOptionsList) {
      districtOptionsList.addEventListener('click', function(e) {
        const option = e.target.closest('.dropdown-option');
        if (!option) return;
        
        const selectedVal = option.getAttribute('data-value');
        hiddenDistrict.value = selectedVal;
        districtLabel.textContent = selectedVal;
        districtLabel.style.color = '#1b3b1c';

        // Update selected class
        districtOptionsList.querySelectorAll('.dropdown-option').forEach(el => el.classList.remove('is-selected'));
        option.classList.add('is-selected');

        // Populate Cities
        populateCities(selectedVal);

        closeAllDropdowns();
      });
    }

    function populateCities(district) {
      cityOptionsList.innerHTML = '';
      hiddenLocation.value = district;
      cityLabel.textContent = 'All in ' + district;
      cityLabel.style.color = '#1b3b1c';

      const cities = districtCities[district] || [];
      
      // Add "All in District" option
      const allOpt = document.createElement('div');
      allOpt.className = 'dropdown-option is-selected';
      allOpt.setAttribute('data-value', district);
      allOpt.textContent = 'All in ' + district;
      cityOptionsList.appendChild(allOpt);

      cities.forEach(city => {
        const opt = document.createElement('div');
        opt.className = 'dropdown-option';
        opt.setAttribute('data-value', city);
        opt.textContent = city;
        cityOptionsList.appendChild(opt);
      });

      cityGroup.classList.remove('is-disabled');
    }

    // City Option Selection
    if (cityOptionsList) {
      cityOptionsList.addEventListener('click', function(e) {
        const option = e.target.closest('.dropdown-option');
        if (!option) return;

        const selectedCity = option.getAttribute('data-value');
        hiddenLocation.value = selectedCity;
        cityLabel.textContent = option.textContent;
        cityLabel.style.color = '#1b3b1c';

        cityOptionsList.querySelectorAll('.dropdown-option').forEach(el => el.classList.remove('is-selected'));
        option.classList.add('is-selected');

        closeAllDropdowns();
      });
    }

    // Filter search inside District Dropdown
    if (districtFilterInput) {
      districtFilterInput.addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase().trim();
        districtOptionsList.querySelectorAll('.dropdown-option').forEach(opt => {
          const text = opt.textContent.toLowerCase();
          opt.style.display = text.includes(val) ? 'block' : 'none';
        });
      });
      districtFilterInput.addEventListener('click', e => e.stopPropagation());
    }

    // Filter search inside City Dropdown
    if (cityFilterInput) {
      cityFilterInput.addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase().trim();
        cityOptionsList.querySelectorAll('.dropdown-option').forEach(opt => {
          const text = opt.textContent.toLowerCase();
          opt.style.display = text.includes(val) ? 'block' : 'none';
        });
      });
      cityFilterInput.addEventListener('click', e => e.stopPropagation());
    }

    // Form Submit handling
    if (heroSearchForm) {
      heroSearchForm.addEventListener('submit', function(e) {
        if (!hiddenDistrict.value && !hiddenLocation.value) {
          e.preventDefault();
          districtTrigger.click();
        }
      });
    }

    // Close on click outside
    document.addEventListener('click', function() {
      closeAllDropdowns();
    });

    function closeAllDropdowns() {
      if (districtGroup) districtGroup.classList.remove('is-open');
      if (cityGroup) cityGroup.classList.remove('is-open');
    }
  });
</script>

