               let desc = `Explore authentic ${cuisine.name} dishes and highly rated chefs specializing in this cuisine.`;
               
               const nameLower = cuisine.name.toLowerCase();
               if (nameLower.includes('sri lankan') || nameLower.includes('indian')) {
                 if (nameLower.includes('sri lankan')) desc = 'Spicy crab curries, hoppers, and aromatic coconut sambols.';
                 else desc = 'Rich tandoori dishes, butter chicken, and fragrant biryanis.';
               } else if (nameLower.includes('italian')) {
                 desc = 'Wood-fired pizza, handmade ravioli, and creamy panna cotta.';
               } else if (nameLower.includes('chinese') || nameLower.includes('malaysian')) {
                 if (nameLower.includes('chinese')) desc = 'Hand-pulled noodles, traditional dim sum, and glazed roast duck.';
                 else desc = 'Fragrant Nasi Lemak, savory Laksa, and smoky Satay skewers.';
               } else if (nameLower.includes('mexican')) {
                 desc = 'Zesty tacos, fresh guacamole, and sizzling fajitas.';
               } else if (nameLower.includes('french')) {
                 desc = 'Artisanal cheeses, buttery croissants, and classic coq au vin.';
               } else if (nameLower.includes('vegan')) {
                 desc = 'Plant-based specialties, fresh organic bowls, and healthy delights.';
               }
          %>
