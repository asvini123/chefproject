      .footer-bottom p { font-size: 0.82rem; opacity: 0.7; margin: 0; }
      .footer-legal-links { display: flex; gap: 1.2rem; }
      .footer-legal-links a { color: rgba(255,248,231,0.6); text-decoration: none; font-size: 0.82rem; transition: 0.2s; }
