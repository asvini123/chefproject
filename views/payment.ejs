<%- include('partials/header', { title: 'PayHere Secure Checkout - ChefNest', pageCss: 'booking.css' }) %>

<style>
  .payment-page {
    min-height: 85vh;
    background: #f7faf7;
    padding: 3rem 5%;
    font-family: var(--font-family-sans);
  }
  .payment-wrapper {
    max-width: 1050px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  .payment-card {
    background: #ffffff;
    border-radius: 18px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.06);
    padding: 2.5rem;
    border: 1px solid #e2ece2;
  }
  .payhere-brand-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    margin-bottom: 1.8rem;
    border-bottom: 1.5px solid #edf4ed;
  }
  .payhere-badge {
    background: #e8f5e9;
    color: #1b5e20;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .payment-title {
    font-size: 1.7rem;
    color: #1a3a1b;
    margin-bottom: 0.3rem;
    font-weight: 800;
  }
  .payment-subtitle {
    color: #64748b;
    font-size: 0.95rem;
    margin-bottom: 1.8rem;
  }
  
  /* PayHere Method Tabs */
  .payhere-tabs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.8rem;
  }
  .pay-tab {
    flex: 1;
    background: #f8faf8;
    border: 2px solid #e0e8e0;
    border-radius: 12px;
    padding: 0.9rem 0.5rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    font-weight: 600;
    font-size: 0.88rem;
    color: #475569;
  }
  .pay-tab:hover, .pay-tab.active {
    border-color: #2C5F2D;
    color: #2C5F2D;
    background: #f0f8f0;
  }
  .pay-tab .tab-icon { font-size: 1.4rem; display: block; margin-bottom: 0.2rem; }

  /* Input fields */
  .pay-form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }
  .pay-form-group label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #334155;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .pay-input {
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    outline: none;
    transition: all 0.2s;
    font-family: inherit;
    background: #ffffff;
  }
  .pay-input:focus {
    border-color: #2C5F2D;
    box-shadow: 0 0 0 3px rgba(44, 95, 45, 0.12);
  }

  /* Summary Card */
  .summary-card {
    background: #ffffff;
    border-radius: 18px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.06);
    padding: 2rem;
    position: sticky;
    top: 2rem;
    border: 1px solid #e2ece2;
  }
  .summary-card h3 {
    font-size: 1.35rem;
    color: #1a3a1b;
    margin-bottom: 1.2rem;
    font-weight: 800;
  }
  
  .chef-mini {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid #edf4ed;
  }
  .chef-mini-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #2C5F2D;
    color: white;
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
    overflow: hidden;
  }
  .chef-mini-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .chef-mini-info .name { font-weight: 700; color: #1e293b; font-size: 1.05rem; }
  .chef-mini-info .type { color: #64748b; font-size: 0.85rem; }

  .summary-rows { margin-bottom: 1.2rem; }
  .summary-row {
    display: flex;
    justify-content: space-between;
    padding: 0.6rem 0;
    border-bottom: 1px dashed #e2e8f0;
    color: #64748b;
    font-size: 0.92rem;
  }
  .summary-row:last-child { border: none; }
  .summary-row strong { color: #1e293b; }
  .summary-total {
    display: flex;
    justify-content: space-between;
    padding: 1rem 1.2rem;
    background: linear-gradient(135deg, #1a3a1b 0%, #2C5F2D 100%);
    color: white;
    border-radius: 12px;
    font-weight: 800;
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 6px 18px rgba(44, 95, 45, 0.2);
  }

  .btn-payhere-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    background: linear-gradient(135deg, #D97A2B 0%, #b85c14 100%);
    color: white;
    border: none;
    padding: 1.1rem;
    border-radius: 12px;
    font-size: 1.05rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.25s;
    box-shadow: 0 6px 20px rgba(217, 122, 43, 0.35);
    font-family: inherit;
  }
  .btn-payhere-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(217, 122, 43, 0.45);
  }

  .btn-instant-dummy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.7rem;
    background: #e8f5e9;
    color: #1b5e20;
    border: 1.5px solid #a5d6a7;
    padding: 0.85rem;
    border-radius: 12px;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .btn-instant-dummy:hover {
    background: #c8e6c9;
  }

  /* Overlay simulation dialog */
  .payhere-sim-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(5px);
    z-index: 99999;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .payhere-sim-modal {
    background: #ffffff;
    border-radius: 20px;
    max-width: 480px;
    width: 100%;
    padding: 2.2rem;
    text-align: center;
    box-shadow: 0 25px 60px rgba(0,0,0,0.3);
    animation: modalPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes modalPop {
    from { transform: scale(0.85); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .payhere-spinner {
    width: 60px;
    height: 60px;
    border: 4px solid #e2e8f0;
    border-top-color: #0070ba;
    border-radius: 50%;
    margin: 1rem auto 1.5rem;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .sim-steps {
    text-align: left;
    margin: 1.5rem 0;
    background: #f8fafc;
    border-radius: 12px;
    padding: 1rem 1.2rem;
  }
  .sim-step {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem 0;
    font-size: 0.9rem;
    color: #64748b;
  }
  .sim-step.done { color: #16a34a; font-weight: 700; }
  .sim-step.active { color: #0070ba; font-weight: 700; }

  @media (max-width: 850px) {
    .payment-wrapper { grid-template-columns: 1fr; }
  }
</style>

<main class="payment-page">

  <!-- Breadcrumb / Header -->
  <div style="max-width: 1050px; margin: 0 auto 2rem; text-align: center;">
    <div class="payhere-badge" style="margin-bottom: 0.6rem;">
      <span>🔒 Official PayHere Sandbox Gateway</span>
    </div>
    <h1 style="font-size: 2.2rem; color: #1a3a1b; font-weight: 800;">Complete Your Booking Payment</h1>
    <p style="color: #64748b; font-size: 0.95rem;">Secure online checkout for ChefNest service.</p>
  </div>

  <div class="payment-wrapper">

    <!-- Left: PayHere Checkout Box -->
    <div class="payment-card">
      <div class="payhere-brand-header">
        <div style="display: flex; align-items: center; gap: 0.8rem;">
          <img src="https://www.payhere.lk/downloads/images/payhere_logo.png" alt="PayHere" style="height: 34px;" onerror="this.src='/images/logo2.png'">
          <span style="font-weight: 800; font-size: 1.1rem; color: #0070ba;">PayHere Sandbox</span>
        </div>
        <span class="payhere-badge">DEMO MODE</span>
      </div>

      <h2 class="payment-title">Select Payment Mode</h2>
      <p class="payment-subtitle">Choose your preferred Sri Lankan payment method below:</p>

      <!-- PayHere Method Selector Tabs -->
      <div class="payhere-tabs">
        <div class="pay-tab active" onclick="selectPayTab('card', this)">
          <span class="tab-icon">💳</span>
          <span>Cards</span>
        </div>
        <div class="pay-tab" onclick="selectPayTab('wallet', this)">
          <span class="tab-icon">📱</span>
          <span>eZ Cash / FriMi</span>
        </div>
        <div class="pay-tab" onclick="selectPayTab('bank', this)">
          <span class="tab-icon">🏦</span>
          <span>Internet Bank</span>
        </div>
      </div>

      <!-- Card Method Panel -->
      <div id="tab-card" class="pay-panel">
        <div class="pay-form-group">
          <label>Card Number (Sandbox Test)</label>
          <input type="text" class="pay-input" value="4111 2222 3333 4444" placeholder="Card Number" readonly style="letter-spacing: 2px; font-weight: 700; background: #f8fafc;">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="pay-form-group">
            <label>Expiry Date</label>
            <input type="text" class="pay-input" value="12/28" readonly style="font-weight: 700; background: #f8fafc;">
          </div>
          <div class="pay-form-group">
            <label>CVV / CVC</label>
            <input type="text" class="pay-input" value="789" readonly style="font-weight: 700; background: #f8fafc;">
          </div>
        </div>
        <div class="pay-form-group">
          <label>Cardholder Name</label>
          <input type="text" class="pay-input" value="<%= (typeof user !== 'undefined' && user) ? `${user.firstName} ${user.lastName}` : 'Valued Customer' %>" readonly style="font-weight: 600; background: #f8fafc;">
        </div>
      </div>

      <!-- Wallet Method Panel -->
      <div id="tab-wallet" class="pay-panel" style="display: none;">
        <div class="pay-form-group">
          <label>Mobile Number for eZ Cash / FriMi / Genie</label>
          <input type="text" class="pay-input" value="<%= (typeof user !== 'undefined' && user && user.phone) ? user.phone : '0771234567' %>" readonly style="font-weight: 700; background: #f8fafc;">
        </div>
        <p style="font-size: 0.85rem; color: #64748b; line-height: 1.5; margin-top: 0.5rem;">
          An instant approval request simulation will be approved in Sandbox mode.
        </p>
      </div>

      <!-- Bank Method Panel -->
      <div id="tab-bank" class="pay-panel" style="display: none;">
        <div class="pay-form-group">
          <label>Select Bank</label>
          <select class="pay-input" style="background: #f8fafc;">
            <option>Commercial Bank (ComBank Digital)</option>
            <option>Sampath Bank (Sampath Vishwa)</option>
            <option>Hatton National Bank (HNB)</option>
            <option>Bank of Ceylon (BOC)</option>
          </select>
        </div>
      </div>

      <!-- Security Guarantee Box -->
      <div style="background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: 12px; padding: 1rem 1.2rem; margin-top: 1.5rem; display: flex; align-items: center; gap: 0.8rem;">
        <span style="font-size: 1.6rem;">🛡️</span>
        <div>
          <strong style="color: #166534; font-size: 0.9rem; display: block;">PayHere Demo Simulation Ready</strong>
          <span style="color: #15803d; font-size: 0.82rem;">Click below to simulate an approved payment of LKR <%= booking.totalAmount.toLocaleString() %>.</span>
        </div>
      </div>

    </div>

    <!-- Right: Order Summary & Trigger -->
    <div class="summary-card">
      <h3>Order Summary</h3>

      <!-- Chef Mini Profile -->
      <div class="chef-mini">
        <div class="chef-mini-avatar">
          <% if (booking.chefId && booking.chefId.profilePhoto) { %>
            <img src="<%= booking.chefId.profilePhoto %>" alt="Chef">
          <% } else { %>
            👨‍🍳
          <% } %>
        </div>
        <div class="chef-mini-info">
          <div class="name">Chef <%= booking.chefId ? booking.chefId.firstName + ' ' + booking.chefId.lastName : 'N/A' %></div>
          <div class="type"><%= booking.chefId ? (booking.chefId.chefType || 'Personal Chef') : '' %> · ⭐ 5.0</div>
        </div>
      </div>

      <!-- Booking Details -->
      <div class="summary-rows">
        <div class="summary-row">
          <span>Booking ID</span>
          <span><strong>#<%= booking._id.toString().slice(-8).toUpperCase() %></strong></span>
        </div>
        <div class="summary-row">
          <span>Service Date</span>
          <span><strong><%= new Date(booking.date).toDateString() %></strong></span>
        </div>
        <div class="summary-row">
          <span>Time Slot</span>
          <span><strong><%= booking.time %></strong></span>
        </div>
        <div class="summary-row">
          <span>Duration</span>
          <span><strong><%= booking.duration %> hours</strong></span>
        </div>
        <div class="summary-row">
          <span>Location</span>
          <span><strong><%= booking.location %></strong></span>
        </div>
        <div class="summary-row">
          <span>Grocery Support</span>
          <span><strong><%= booking.grocerySupport ? 'Yes (+Rs.500)' : 'No' %></strong></span>
        </div>
      </div>

      <div class="summary-total">
        <span>Total Due</span>
        <span>LKR <%= booking.totalAmount.toLocaleString() %></span>
      </div>

      <!-- Pay Button that triggers simulation & confirmation -->
      <form id="paymentForm" action="/payment/<%= booking._id %>/confirm" method="POST">
        <input type="hidden" name="paymentMethod" value="PayHere">
        
        <button type="button" class="btn-payhere-submit" onclick="startPayHereSimulation()">
          <span>🔒</span> Pay LKR <%= booking.totalAmount.toLocaleString() %> via PayHere
        </button>

        <button type="button" class="btn-instant-dummy" onclick="instantDummyPay()">
          <span>⚡</span> Instant 1-Click Pay (Demo)
        </button>
      </form>

      <p style="text-align: center; color: #94a3b8; font-size: 0.8rem; margin-top: 1rem;">
        🔒 Encrypted 256-bit SSL Sandbox Payment Guarantee
      </p>
    </div>

  </div>
</main>

<!-- PayHere Simulation Processing Modal -->
<div class="payhere-sim-overlay" id="simOverlay">
  <div class="payhere-sim-modal">
    <div style="display: flex; align-items: center; justify-content: center; gap: 0.6rem; margin-bottom: 1rem;">
      <img src="https://www.payhere.lk/downloads/images/payhere_logo.png" alt="PayHere" style="height: 28px;" onerror="this.src='/images/logo2.png'">
      <span style="font-weight: 800; color: #0070ba; font-size: 1.1rem;">PayHere Gateway</span>
    </div>

    <div class="payhere-spinner" id="simSpinner"></div>

    <h3 id="simStatusTitle" style="font-size: 1.25rem; color: #1e293b; margin-bottom: 0.3rem;">Processing Payment...</h3>
    <p id="simStatusSub" style="color: #64748b; font-size: 0.88rem;">Please do not refresh or close this window.</p>

    <div class="sim-steps">
      <div class="sim-step" id="step1">
        <span class="step-icon">⏳</span>
        <span>Connecting to PayHere Secure Gateway...</span>
      </div>
      <div class="sim-step" id="step2">
        <span class="step-icon">⏳</span>
        <span>Authorizing LKR <%= booking.totalAmount.toLocaleString() %>...</span>
      </div>
      <div class="sim-step" id="step3">
        <span class="step-icon">⏳</span>
        <span>Payment Approved & Verified!</span>
      </div>
    </div>
  </div>
</div>

<script>
  function selectPayTab(tab, el) {
    document.querySelectorAll('.pay-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.pay-panel').forEach(p => p.style.display = 'none');
    el.classList.add('active');
    document.getElementById('tab-' + tab).style.display = 'block';
  }

  function startPayHereSimulation() {
    const overlay = document.getElementById('simOverlay');
    overlay.style.display = 'flex';

    const step1 = document.getElementById('step1');
    const step2 = document.getElementById('step2');
    const step3 = document.getElementById('step3');
    const title = document.getElementById('simStatusTitle');
    const sub = document.getElementById('simStatusSub');
    const spinner = document.getElementById('simSpinner');

    // Step 1
    step1.classList.add('active');
    step1.querySelector('.step-icon').textContent = '🔄';

    setTimeout(() => {
      step1.classList.remove('active');
      step1.classList.add('done');
      step1.querySelector('.step-icon').textContent = '✅';

      // Step 2
      step2.classList.add('active');
      step2.querySelector('.step-icon').textContent = '🔄';
    }, 800);

    setTimeout(() => {
      step2.classList.remove('active');
      step2.classList.add('done');
      step2.querySelector('.step-icon').textContent = '✅';

      // Step 3
      step3.classList.add('done');
      step3.querySelector('.step-icon').textContent = '✅';
      title.textContent = '🎉 Payment Approved!';
      title.style.color = '#16a34a';
      sub.textContent = 'Redirecting to your booking confirmation...';
      spinner.style.borderTopColor = '#16a34a';
      spinner.style.borderColor = '#bbf7d0';
    }, 1800);

    setTimeout(() => {
      // Redirect to return route
      window.location.href = '/payment/<%= booking._id %>/return';
    }, 2500);
  }

  function instantDummyPay() {
    const overlay = document.getElementById('simOverlay');
    overlay.style.display = 'flex';
    document.getElementById('simStatusTitle').textContent = '⚡ Instant Demo Payment Approved!';
    document.getElementById('simStatusTitle').style.color = '#16a34a';
    document.getElementById('step1').classList.add('done');
    document.getElementById('step1').querySelector('.step-icon').textContent = '✅';
    document.getElementById('step2').classList.add('done');
    document.getElementById('step2').querySelector('.step-icon').textContent = '✅';
    document.getElementById('step3').classList.add('done');
    document.getElementById('step3').querySelector('.step-icon').textContent = '✅';
    setTimeout(() => {
      window.location.href = '/payment/<%= booking._id %>/return';
    }, 600);
  }
</script>

<%- include('partials/footer') %>
