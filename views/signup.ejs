<!-- ── TERMS & CONDITIONS MODAL ────────────────── -->
<div class="terms-modal-overlay hidden" id="termsModalOverlay" onclick="if(event.target===this) closeTermsModal()">
  <div class="terms-modal-card">
    <div class="terms-modal-header">
      <div class="terms-modal-brand">
        <img src="/images/logo2.png" alt="ChefNest Logo" style="height:36px; width:auto; object-fit:contain;">
