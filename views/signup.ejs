      </div>
      <button type="button" class="modal-close-btn" onclick="closeTermsModal()" aria-label="Close modal">✕</button>
    </div>
    <div class="terms-modal-body">
      <iframe src="/terms" style="width:100%; height:100%; border:none;" id="termsIframe"></iframe>
    </div>
    <div class="terms-modal-footer">
      <a href="/terms" target="_blank" class="terms-full-link">Open full page in new tab ↗</a>
      <button type="button" class="btn-agree-modal" onclick="acceptTermsModal()">I Agree &amp; Accept ✓</button>
    </div>
  </div>
</div>

<script>
// ── Chef Purpose Toggle Radio ─────────────────────────────
function initPurposeCheckboxes() {
  const items = document.querySelectorAll('.purpose-check-item');
  items.forEach(item => {
    item.addEventListener('click', function(e) {
      e.preventDefault(); // prevent native radio double-toggle
      const radio = this.querySelector('.purpose-radio');
      if (!radio) return;
      const wasSelected = this.classList.contains('selected');
      // Deselect all
      items.forEach(i => {
        i.classList.remove('selected');
        i.querySelector('.purpose-radio').checked = false;
      });
      // Toggle: select only if it was NOT already selected
      if (!wasSelected) {
        this.classList.add('selected');
        radio.checked = true;
      }
    });
  });
}
// Call directly — DOM is already ready when scripts at bottom of page run
initPurposeCheckboxes();

// ── State ─────────────────────────────────────────────────
let signupRole = null;
let pwStrong   = false;
let pwMatch    = false;

// ── Role Selection ────────────────────────────────────────
function selectSignupRole(role) {
  signupRole = role;
  document.getElementById('roleInput').value = role;

  document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('signRole' + (role === 'user' ? 'User' : 'Chef')).classList.add('active');
  document.getElementById('signRoleError').classList.add('hidden');

  // Show progress + form
  document.getElementById('progressWrap').classList.remove('hidden');
  document.getElementById('step1').classList.add('active');

  // Set step 3 title
  document.getElementById('step3Title').textContent =
    role === 'chef' ? 'Chef Profile Details' : 'Health Preferences (Optional)';
}

// ── Step Navigation ───────────────────────────────────────
function goToStep(stepNum) {
  if (!signupRole) {
    document.getElementById('signRoleError').classList.remove('hidden');
    return;
  }

  // Validate before moving forward
  if (stepNum === 2 && !validateStep1()) return;
  if (stepNum === 3 && !validateStep2()) return;

  // Show role-specific fields on step 3
  if (stepNum === 3) {
    document.getElementById('userFields').classList.toggle('hidden', signupRole !== 'user');
    document.getElementById('chefFields').classList.toggle('hidden', signupRole !== 'chef');
    document.getElementById('termsWrap').classList.remove('hidden');
  }

  document.querySelectorAll('.form-step').forEach(s => s.classList.remove('active'));
  document.getElementById('step' + stepNum).classList.add('active');

  // Update progress steps
  for (let i = 1; i <= 3; i++) {
    const stepEl = document.getElementById('pstep' + i);
    stepEl.classList.toggle('active', i === stepNum);
    stepEl.classList.toggle('done', i < stepNum);
    if (i < 3) {
      const lineEl = document.getElementById('pline' + i);
      if (lineEl) lineEl.classList.toggle('done', i < stepNum);
    }
  }

  // Scroll to top of card
  document.querySelector('.signup-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── Step 1 Validation ─────────────────────────────────────
function validateStep1() {
  let ok = true;

  const firstName = document.getElementById('firstName').value.trim();
  setError('firstNameError', !firstName, 'First name is required.');
  if (!firstName) ok = false;

  const lastName = document.getElementById('lastName').value.trim();
  setError('lastNameError', !lastName, 'Last name is required.');
  if (!lastName) ok = false;

  const email = document.getElementById('signEmail').value.trim();
  const emailOk = isValidEmail(email);
  setError('signEmailError', !emailOk, 'Please enter a valid email address.');
  if (!emailOk) ok = false;

  const phone = document.getElementById('phone').value.trim();
  const phoneOk = isValidSLPhone(phone);
  setError('phoneError', !phoneOk, 'Please enter a valid Sri Lankan mobile number.');
  if (!phoneOk) ok = false;

  const address = document.getElementById('address').value.trim();
  setError('addressError', !address, 'Address is required.');
  if (!address) ok = false;

  const district = document.getElementById('signupDistrictSelect').value.trim();
  setError('districtError', !district, 'District is required.');
  if (!district) ok = false;

  const city = document.getElementById('city').value.trim();
  setError('cityError', !city, 'City/Town is required.');
  if (!city) ok = false;

  return ok;
}

// ── Step 2 Validation ─────────────────────────────────────
function validateStep2() {
  let ok = true;
  if (!pwStrong) {
    document.getElementById('signPasswordError').classList.remove('hidden');
    ok = false;
  } else {
    document.getElementById('signPasswordError').classList.add('hidden');
  }
  if (!pwMatch) {
    document.getElementById('confirmPasswordError').classList.remove('hidden');
    ok = false;
  } else {
    document.getElementById('confirmPasswordError').classList.add('hidden');
  }
  return ok;
}

// ── Email Validation ──────────────────────────────────────
function isValidEmail(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

// ── Sri Lankan Phone Validation ───────────────────────────
function isValidSLPhone(phone) {
  return /^0(70|71|72|74|75|76|77|78)\d{7}$/.test(phone);
}

// ── Password Strength Check ───────────────────────────────
function checkPassword() {
  const pw = document.getElementById('signPassword').value;
  const rules = {
    len:     pw.length >= 8,
    upper:   /[A-Z]/.test(pw),
    lower:   /[a-z]/.test(pw),
    num:     /[0-9]/.test(pw),
    special: /[!@#$%^&*(),.?":{}|<>_\-]/.test(pw)
  };

  let score = 0;
  for (const [key, passed] of Object.entries(rules)) {
    const el = document.getElementById('rule-' + key);
    if (el) {
      el.classList.toggle('passed', passed);
      el.textContent = (passed ? '✓ ' : '✗ ') + el.textContent.slice(2);
    }
    if (passed) score++;
  }

  pwStrong = score === 5;
  const fill = document.getElementById('pwStrengthFill');
  fill.style.width = (score / 5 * 100) + '%';
  fill.className = 'pw-strength-fill ' + ['','weak','weak','medium','good','strong'][score];

  if (document.getElementById('confirmPassword').value) checkConfirmPw();
  checkEnableSubmit();
}

// ── Confirm Password ──────────────────────────────────────
function checkConfirmPw() {
  const pw  = document.getElementById('signPassword').value;
  const cpw = document.getElementById('confirmPassword').value;
  pwMatch = pw === cpw && pw.length > 0;
  const status = document.getElementById('confirmStatus');
  const err    = document.getElementById('confirmPasswordError');
  status.textContent = pwMatch ? '✅' : (cpw ? '❌' : '');
  err.classList.toggle('hidden', pwMatch || !cpw);
  checkEnableSubmit();
}

// ── Terms Modal Controls ──────────────────────────────────
function openTermsModal(e) {
  if (e) e.preventDefault();
  document.getElementById('termsModalOverlay').classList.remove('hidden');
}

function closeTermsModal() {
  document.getElementById('termsModalOverlay').classList.add('hidden');
}

function acceptTermsModal() {
  document.getElementById('termsCheck').checked = true;
  document.getElementById('termsError').classList.add('hidden');
  checkTerms();
  closeTermsModal();
  saveSignupFormState();
}

// ── Form Draft Auto-Save & Restore ────────────────────────
function saveSignupFormState() {
  const data = {
    signupRole: signupRole,
    firstName: document.getElementById('firstName') ? document.getElementById('firstName').value : '',
    lastName: document.getElementById('lastName') ? document.getElementById('lastName').value : '',
    email: document.getElementById('signEmail') ? document.getElementById('signEmail').value : '',
    phone: document.getElementById('phone') ? document.getElementById('phone').value : '',
    address: document.getElementById('address') ? document.getElementById('address').value : '',
    district: document.getElementById('signupDistrictSelect') ? document.getElementById('signupDistrictSelect').value : '',
    city: document.getElementById('city') ? document.getElementById('city').value : '',
    healthCondition: document.getElementById('healthCondition') ? document.getElementById('healthCondition').value : '',
    allergies: document.getElementById('allergies') ? document.getElementById('allergies').value : '',
    chefType: document.getElementById('chefType') ? document.getElementById('chefType').value : '',
    experience: document.getElementById('experience') ? document.getElementById('experience').value : '',
    hourlyRate: document.getElementById('hourlyRate') ? document.getElementById('hourlyRate').value : '',
    bio: document.getElementById('bio') ? document.getElementById('bio').value : '',
    bankName: document.getElementById('bankName') ? document.getElementById('bankName').value : '',
    accountHolderName: document.getElementById('accountHolderName') ? document.getElementById('accountHolderName').value : '',
    accountNumber: document.getElementById('accountNumber') ? document.getElementById('accountNumber').value : '',
    termsChecked: document.getElementById('termsCheck') ? document.getElementById('termsCheck').checked : false
  };
  
  // Save purpose checkboxes
  const purposeChecked = [];
  document.querySelectorAll('input[name="chefPurpose"]:checked').forEach(cb => purposeChecked.push(cb.value));
  data.chefPurpose = purposeChecked;
  sessionStorage.setItem('chefnest_signup_draft', JSON.stringify(data));
}

function restoreSignupFormState() {
  const saved = sessionStorage.getItem('chefnest_signup_draft');
  if (!saved) return;
  try {
    const data = JSON.parse(saved);
    if (data.signupRole) selectSignupRole(data.signupRole);
    if (data.firstName) document.getElementById('firstName').value = data.firstName;
    if (data.lastName) document.getElementById('lastName').value = data.lastName;
    if (data.email) {
      document.getElementById('signEmail').value = data.email;
      const event = new Event('input');
      document.getElementById('signEmail').dispatchEvent(event);
    }
    if (data.phone) {
      document.getElementById('phone').value = data.phone;
      const event = new Event('input');
      document.getElementById('phone').dispatchEvent(event);
    }
    if (data.address) document.getElementById('address').value = data.address;
    if (data.district) {
      document.getElementById('signupDistrictSelect').value = data.district;
      const event = new Event('change');
      document.getElementById('signupDistrictSelect').dispatchEvent(event);
      if (data.city) document.getElementById('city').value = data.city;
    }
    if (data.healthCondition) document.getElementById('healthCondition').value = data.healthCondition;
    if (data.allergies) document.getElementById('allergies').value = data.allergies;
    if (data.chefType) document.getElementById('chefType').value = data.chefType;
    if (data.experience) document.getElementById('experience').value = data.experience;
    if (data.hourlyRate) document.getElementById('hourlyRate').value = data.hourlyRate;
    if (data.bio) document.getElementById('bio').value = data.bio;
    if (data.bankName) document.getElementById('bankName').value = data.bankName;
    if (data.accountHolderName) document.getElementById('accountHolderName').value = data.accountHolderName;
    if (data.accountNumber) document.getElementById('accountNumber').value = data.accountNumber;
    if (data.chefPurpose && Array.isArray(data.chefPurpose)) {
      data.chefPurpose.forEach(val => {
        const cb = document.querySelector(`input[name="chefPurpose"][value="${val}"]`);
        if (cb) cb.checked = true;
      });
    }
    if (data.termsChecked) {
      document.getElementById('termsCheck').checked = true;
      checkTerms();
    }
  } catch (e) { console.error('Error restoring form draft:', e); }
}

// ── Terms Check ───────────────────────────────────────────
function checkTerms() {
  saveSignupFormState();
  checkEnableSubmit();
}

// ── Enable Submit Button ──────────────────────────────────
function checkEnableSubmit() {
  const terms   = document.getElementById('termsCheck').checked;
  const enabled = pwStrong && pwMatch && terms;
  const btn     = document.getElementById('signupBtn');
  const hint    = document.getElementById('disabledHint');
  btn.disabled  = !enabled;
  hint.classList.toggle('hidden', enabled);
}

// ── Toggle Password ───────────────────────────────────────
function togglePassword(inputId, btnId) {
  const inp = document.getElementById(inputId);
  const btn = document.getElementById(btnId);
  inp.type = inp.type === 'password' ? 'text' : 'password';
  if (inp.type === 'text') {
    btn.innerHTML = '<svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>';
  } else {
    btn.innerHTML = '<svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>';
  }
}

// ── Handle Signup ─────────────────────────────────────────
function handleSignup(e) {
  e.preventDefault();
  if (!document.getElementById('termsCheck').checked) {
    document.getElementById('termsError').classList.remove('hidden');
    return;
  }

  // User-specific validation
  if (signupRole === 'user') {
    let ok = true;
    const userPurposeVal = document.getElementById('userPurpose').value;
    if (!userPurposeVal) {
      document.getElementById('userPurposeError').classList.remove('hidden');
      ok = false;
    } else {
      document.getElementById('userPurposeError').classList.add('hidden');
    }
    if (!ok) return;
  }

  // Chef-specific validation
  if (signupRole === 'chef') {
    let ok = true;
    if (!document.getElementById('chefType').value) {
      document.getElementById('chefTypeError').classList.remove('hidden'); ok = false;
    } else document.getElementById('chefTypeError').classList.add('hidden');

    if (!document.getElementById('experience').value) {
      document.getElementById('experienceError').classList.remove('hidden'); ok = false;
    } else document.getElementById('experienceError').classList.add('hidden');

    const checkedCuisines = document.querySelectorAll('input[name="cuisines"]:checked');
    if (checkedCuisines.length === 0) {
      document.getElementById('cuisineError').classList.remove('hidden'); ok = false;
    } else document.getElementById('cuisineError').classList.add('hidden');

    if (!document.getElementById('hourlyRate').value) {
      document.getElementById('hourlyRateError').classList.remove('hidden'); ok = false;
    } else document.getElementById('hourlyRateError').classList.add('hidden');

    if (!document.getElementById('bio').value.trim()) {
      document.getElementById('bioError').classList.remove('hidden'); ok = false;
    } else document.getElementById('bioError').classList.add('hidden');

    const checkedPurpose = document.querySelectorAll('input[name="chefPurpose"]:checked');
    if (checkedPurpose.length === 0) {
      document.getElementById('purposeError').classList.remove('hidden'); ok = false;
    } else document.getElementById('purposeError').classList.add('hidden');

    if (!document.getElementById('bankName').value.trim()) {
      document.getElementById('bankNameError').classList.remove('hidden'); ok = false;
    } else document.getElementById('bankNameError').classList.add('hidden');

    if (!document.getElementById('accountHolderName').value.trim()) {
      document.getElementById('accountHolderNameError').classList.remove('hidden'); ok = false;
    } else document.getElementById('accountHolderNameError').classList.add('hidden');

    if (!document.getElementById('accountNumber').value.trim()) {
      document.getElementById('accountNumberError').classList.remove('hidden'); ok = false;
    } else document.getElementById('accountNumberError').classList.add('hidden');

    if (!document.getElementById('nicFrontUpload').files.length) {
      document.getElementById('nicFrontError').classList.remove('hidden'); ok = false;
    } else document.getElementById('nicFrontError').classList.add('hidden');

    if (!document.getElementById('nicBackUpload').files.length) {
      document.getElementById('nicBackError').classList.remove('hidden'); ok = false;
    } else document.getElementById('nicBackError').classList.add('hidden');

    if (!document.getElementById('policeUpload').files.length) {
      document.getElementById('policeError').classList.remove('hidden'); ok = false;
    } else document.getElementById('policeError').classList.add('hidden');

    if (!ok) return;
  }

  // Animate button
  const btn = document.getElementById('signupBtn');
  btn.innerHTML = '<span class="spinner"></span> Creating account...';
  btn.disabled  = true;

  // Send request to server using Fetch API with FormData
  const formElement = document.getElementById('signupForm');
  const formData = new FormData(formElement);

  fetch('/signup', {
    method: 'POST',
    body: formData
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      document.getElementById('successOverlay').classList.remove('hidden');
      const msg = document.getElementById('successMsg');
      if (signupRole === 'chef') {
        msg.innerHTML = '<strong>Your account has been submitted for admin verification.</strong><br>You can login only after your account is approved by the administrator.';
      } else {
        msg.innerHTML = 'Your account has been created successfully.<br>You can now login to book chef services.';
      }
    } else {
      alert('Error during registration: ' + (data.message || 'Unknown error'));
      btn.innerHTML = '<span class="btn-text">Create Account</span><span class="btn-arrow">→</span>';
      btn.disabled = false;
    }
  })
  .catch(err => {
    console.error('Signup Error:', err);
    alert('Server error. Please try again.');
    btn.innerHTML = '<span class="btn-text">Create Account</span><span class="btn-arrow">→</span>';
    btn.disabled = false;
  });
}

// ── Helpers ───────────────────────────────────────────────
function setError(id, show, msg) {
  const el = document.getElementById(id);
  if (!el) return;
  el.classList.toggle('hidden', !show);
  if (msg) el.textContent = msg;
}

function previewPhoto(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById('photoPreviewArea').innerHTML =
        `<img src="${e.target.result}" alt="Preview" style="width:80px;height:80px;border-radius:50%;object-fit:cover;">
         <p style="margin-top:0.4rem;font-size:0.8rem;">${input.files[0].name}</p>`;
    };
    reader.readAsDataURL(input.files[0]);
  }
}

function updateFileLabel(input, labelId) {
  const label = document.getElementById(labelId);
  if (input.files.length > 1) {
    label.textContent = input.files.length + ' files selected';
  } else if (input.files.length === 1) {
    label.textContent = input.files[0].name;
  }
}

// ── Live Validations ──────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  // Handle URL role parameter (e.g. /signup?role=chef)
  const urlParams = new URLSearchParams(window.location.search);
  const roleParam = urlParams.get('role');
  if (roleParam === 'chef' || roleParam === 'user') {
    selectSignupRole(roleParam);
  } else {
    // Restore form draft if saved in sessionStorage
    restoreSignupFormState();
  }

  // Attach live auto-save on input changes
  document.querySelectorAll('#signupForm input, #signupForm select, #signupForm textarea').forEach(input => {
    input.addEventListener('input', saveSignupFormState);
    input.addEventListener('change', saveSignupFormState);
  });

  // Email live
  document.getElementById('signEmail').addEventListener('input', function () {
    const ok = isValidEmail(this.value);
    document.getElementById('emailStatus').textContent = this.value ? (ok ? '✅' : '❌') : '';
    setError('signEmailError', this.value && !ok);
  });

  // Phone live
  document.getElementById('phone').addEventListener('input', function () {
    const ok = isValidSLPhone(this.value);
    document.getElementById('phoneStatus').textContent = this.value.length >= 10 ? (ok ? '✅' : '❌') : '';
    setError('phoneError', this.value.length >= 10 && !ok);
  });

  // Bio char counter
  document.getElementById('bio').addEventListener('input', function () {
    document.getElementById('bioCount').textContent = this.value.length;
  });

  // Cuisine checkbox style update
  document.querySelectorAll('.multi-chip input').forEach(cb => {
    cb.addEventListener('change', function () {
      this.closest('.multi-chip').classList.toggle('selected', this.checked);
    });
  });

  // District and City Dropdowns Logic
  const districtCities = {
    "Colombo": ["Colombo", "Dehiwala-Mount Lavinia", "Moratuwa", "Sri Jayawardenepura Kotte", "Kaduwela", "Maharagama", "Kesbewa", "Kolonnawa", "Homagama", "Hanwella"],
    "Gampaha": ["Gampaha", "Negombo", "Kelaniya", "Kadawatha", "Kiribathgoda", "Wattala", "Ja-Ela", "Minuwangoda", "Divulapitiya", "Mirigama"],
    "Kalutara": ["Kalutara", "Panadura", "Horana", "Beruwala", "Aluthgama", "Bandaragama", "Wadduwa"],
    "Kandy": ["Kandy", "Gampola", "Peradeniya", "Katugastota", "Kundasale", "Nawalapitiya", "Akurana"],
    "Matale": ["Matale", "Dambulla", "Sigiriya", "Galewela", "Ukuwela"],
    "Nuwara Eliya": ["Nuwara Eliya", "Hatton", "Ginigathena", "Talawakele", "Lindula"],
    "Galle": ["Galle", "Hikkaduwa", "Karapitiya", "Ambalangoda", "Elpitiya", "Bentota", "Unawatuna"],
    "Matara": ["Matara", "Weligama", "Akuressa", "Deniyaya", "Dikwella"],
    "Hambantota": ["Hambantota", "Tangalle", "Beliatta", "Tissamaharama", "Ambalantota"],
    "Jaffna": ["Jaffna", "Chavakachcheri", "Point Pedro", "Karainagar", "Nallur", "Valvettithurai"],
    "Kilinochchi": ["Kilinochchi", "Pooneryn", "Pallai"],
    "Mannar": ["Mannar", "Murunkan", "Madhu"],
    "Vavuniya": ["Vavuniya", "Nedunkeni", "Cheddikulam"],
    "Mullaitivu": ["Mullaitivu", "Puthukudiyiruppu", "Oddusuddan"],
    "Batticaloa": ["Batticaloa", "Kattankudy", "Eravur", "Valachchenai", "Kaluwanchikudy"],
    "Ampara": ["Ampara", "Kalmunai", "Sainthamaruthu", "Akkaraipattu", "Pottuvil"],
    "Trincomalee": ["Trincomalee", "Mutur", "Kinniya", "Kuchchaveli"],
    "Kurunegala": ["Kurunegala", "Kuliyapitiya", "Narammala", "Wariyapola", "Pannala", "Ibbagamuwa"],
    "Puttalam": ["Puttalam", "Chilaw", "Wennappuwa", "Marawila", "Dankotuwa", "Kalpitiya"],
    "Anuradhapura": ["Anuradhapura", "Mihintale", "Kekirawa", "Medawachchiya", "Eppawala", "Galgamuwa"],
    "Polonnaruwa": ["Polonnaruwa", "Kaduruwela", "Hingurakgoda", "Medirigiriya"],
    "Badulla": ["Badulla", "Bandarawela", "Haputale", "Ella", "Welimada", "Mahiyanganaya"],
    "Moneragala": ["Moneragala", "Wellawaya", "Buttala", "Kataragama", "Bibile"],
    "Ratnapura": ["Ratnapura", "Balangoda", "Embilipitiya", "Pelmadulla", "Eheliyagoda"],
    "Kegalle": ["Kegalle", "Mawanella", "Ruwanwella", "Warakapola", "Dehiowita"]
  };

  const districtSelect = document.getElementById('signupDistrictSelect');
  const citySelect = document.getElementById('city');

  if (districtSelect && citySelect) {
    districtSelect.addEventListener('change', function() {
      const selectedDistrict = this.value;
      
      // Reset and clear city select
      citySelect.innerHTML = '<option value="" disabled selected>Select City/Town</option>';
      
      if (selectedDistrict && districtCities[selectedDistrict]) {
        const cities = districtCities[selectedDistrict];
        cities.forEach(function(city) {
          const option = document.createElement('option');
          option.value = city;
          option.textContent = city;
          citySelect.appendChild(option);
        });
        citySelect.disabled = false;
      } else {
        citySelect.disabled = true;
      }
    });
  }
  // ── Address Location Mismatch Validation ────────────────
  const addressInput = document.getElementById('address');
  const districtSelectEl = document.getElementById('signupDistrictSelect');
  const citySelectEl = document.getElementById('city');

  function validateAddressLocation() {
    const addressVal = addressInput.value.trim().toLowerCase();
    const selectedDistrict = districtSelectEl.value;
    const selectedCity = citySelectEl.value;
    const warningEl = document.getElementById('addressLocationWarning');

    // Only check if address has been typed AND a district is selected
    if (!addressVal || !selectedDistrict) {
      warningEl.classList.add('hidden');
      return;
    }

    // Build a list of all other district/city names (not selected)
    const allOtherLocations = [];
    for (const [dist, cities] of Object.entries(districtCities)) {
      if (dist.toLowerCase() !== selectedDistrict.toLowerCase()) {
        allOtherLocations.push(dist.toLowerCase());
        cities.forEach(c => allOtherLocations.push(c.toLowerCase()));
      } else {
        // From the selected district, exclude selected city — add other cities in same district
        cities.forEach(c => {
          if (selectedCity && c.toLowerCase() !== selectedCity.toLowerCase()) {
            // Cities in same district are still valid — don't block
          }
        });
      }
    }

    // Check if address contains any name from a different district
    const mismatch = allOtherLocations.some(loc => {
      // Match whole word only to avoid false positives (e.g. "ella" in "hello")
      const regex = new RegExp('\\b' + loc.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b', 'i');
      return regex.test(addressVal);
    });

    warningEl.classList.toggle('hidden', !mismatch);
  }

  if (addressInput) {
    addressInput.addEventListener('input', validateAddressLocation);
  }
  if (districtSelectEl) {
    districtSelectEl.addEventListener('change', validateAddressLocation);
  }
  if (citySelectEl) {
    citySelectEl.addEventListener('change', validateAddressLocation);
  }
});
</script>
