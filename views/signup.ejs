<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up — ChefNest</title>
  <meta name="description" content="Create your ChefNest account to start booking chefs or provide cooking services.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/signup.css">
</head>
<body>

<div class="bg-blob blob-1"></div>
<div class="bg-blob blob-2"></div>

<div class="signup-wrapper">

  <!-- ── TOP HEADER ────────────────────────────────── -->
  <div class="signup-top">
    <a href="/" class="back-home">← Back to Home</a>
    <div class="signup-brand">
      <span class="brand-name">ChefNest</span>
    </div>
  </div>

  <!-- ── MAIN CARD ──────────────────────────────────── -->
  <div class="signup-card">

    <div class="card-header">
      <h1 class="card-title">Create Account</h1>
      <p class="card-subtitle">Create your account to start booking chefs or provide cooking services.</p>
    </div>

    <!-- ROLE SELECTION (User / Chef only — No Admin) -->
    <div class="field-group">
      <label class="field-label required">I want to join as</label>
      <div class="role-selector">
        <button type="button" class="role-btn" id="signRoleUser" onclick="selectSignupRole('user')">
          <span class="role-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></span>
          <div>
            <strong>User</strong>
            <small>Book chef services</small>
          </div>
        </button>
        <button type="button" class="role-btn" id="signRoleChef" onclick="selectSignupRole('chef')">
          <span class="role-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2C8 2 5.5 4 5.5 7c0 1.25.7 2.45 1.5 3.25V13c0 2 1.5 3.5 3 4 0 1-1 2-1 2H5c-1.1 0-2 .9-2 2v1h18v-1c0-1.1-.9-2-2-2h-4s-1-1-1-2c1.5-.5 3-2 3-4v-2.75c.8-.8 1.5-2 1.5-3.25 0-3-2.5-5-6.5-5zm-2 13h4v1h-4v-1z"/></svg></span>
          <div>
            <strong>Chef</strong>
            <small>Provide cooking services</small>
          </div>
        </button>
      </div>
      <span class="field-error hidden" id="signRoleError">Please select a role.</span>
    </div>

    <!-- ADMIN REGISTER BLOCKED NOTICE -->
    <div class="admin-block-notice hidden" id="adminBlockNotice">
      <span><svg class="svg-icon" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg></span>
      <p><strong>Admin accounts cannot self-register.</strong> Contact your system administrator to create an admin account.</p>
    </div>

    <!-- ─── SIGNUP FORM ────────────────────────────── -->
    <form id="signupForm" novalidate enctype="multipart/form-data">
      <input type="hidden" name="role" id="roleInput">

      <!-- PROGRESS BAR -->
      <div class="progress-bar-wrap hidden" id="progressWrap">
        <div class="progress-steps">
          <div class="progress-step active" id="pstep1">
            <div class="step-dot">1</div>
            <span>Personal Info</span>
          </div>
          <div class="progress-line" id="pline1"></div>
          <div class="progress-step" id="pstep2">
            <div class="step-dot">2</div>
            <span>Account</span>
          </div>
          <div class="progress-line" id="pline2"></div>
          <div class="progress-step" id="pstep3">
            <div class="step-dot">3</div>
            <span>Details</span>
          </div>
        </div>
      </div>

      <!-- ═══ STEP 1: Personal Info ═════════════════ -->
      <div class="form-step active" id="step1">
        <h3 class="step-title">Personal Information</h3>

        <div class="form-grid-2">
          <!-- First Name -->
          <div class="field-group">
            <label class="field-label required" for="firstName">First Name</label>
            <div class="input-wrap">
              <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></span>
              <input type="text" id="firstName" name="firstName" placeholder="Amal" required>
            </div>
            <span class="field-error hidden" id="firstNameError">First name is required.</span>
          </div>

          <!-- Last Name -->
          <div class="field-group">
            <label class="field-label required" for="lastName">Last Name</label>
            <div class="input-wrap">
              <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></span>
              <input type="text" id="lastName" name="lastName" placeholder="Fernando" required>
            </div>
            <span class="field-error hidden" id="lastNameError">Last name is required.</span>
          </div>
        </div>

        <!-- Email -->
        <div class="field-group">
          <label class="field-label required" for="signEmail">Email Address</label>
          <div class="input-wrap">
            <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg></span>
            <input type="email" id="signEmail" name="email" placeholder="you@gmail.com" required>
            <span class="input-status" id="emailStatus"></span>
          </div>
          <span class="field-error hidden" id="signEmailError">Please enter a valid email address.</span>
          <span class="field-hint">e.g. user@gmail.com, chef@yahoo.com</span>
        </div>

        <!-- Sri Lankan Phone -->
        <div class="field-group">
          <label class="field-label required" for="phone">Mobile Number</label>
          <div class="input-wrap phone-wrap">
            <div class="country-code">🇱🇰 +94</div>
            <input type="tel" id="phone" name="phone" placeholder="0771234567" maxlength="10" required>
            <span class="input-status" id="phoneStatus"></span>
          </div>
          <span class="field-error hidden" id="phoneError">Please enter a valid Sri Lankan mobile number (e.g. 0771234567).</span>
          <span class="field-hint">Accepted: 070, 071, 072, 074, 075, 076, 077, 078 — exactly 10 digits</span>
        </div>

        <!-- Address -->
        <div class="field-group">
          <label class="field-label required" for="address">Address</label>
          <div class="input-wrap">
            <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg></span>
            <input type="text" id="address" name="address" placeholder="123 Main Street" required>
          </div>
          <span class="field-error hidden" id="addressError">Address is required.</span>
          <span class="field-warning hidden" id="addressLocationWarning">⚠️ Please enter an address within your selected district / city. The location you typed doesn't match your selected area.</span>
        </div>

        <!-- District + City -->
        <div class="form-grid-2">
          <div class="field-group">
            <label class="field-label required" for="signupDistrictSelect">District</label>
            <div class="input-wrap">
              <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg></span>
              <select id="signupDistrictSelect" required>
                <option value="" disabled selected>Select District</option>
                <option value="Colombo">Colombo</option>
                <option value="Gampaha">Gampaha</option>
                <option value="Kalutara">Kalutara</option>
                <option value="Kandy">Kandy</option>
                <option value="Matale">Matale</option>
                <option value="Nuwara Eliya">Nuwara Eliya</option>
                <option value="Galle">Galle</option>
                <option value="Matara">Matara</option>
                <option value="Hambantota">Hambantota</option>
                <option value="Jaffna">Jaffna</option>
                <option value="Kilinochchi">Kilinochchi</option>
                <option value="Mannar">Mannar</option>
                <option value="Vavuniya">Vavuniya</option>
                <option value="Mullaitivu">Mullaitivu</option>
                <option value="Batticaloa">Batticaloa</option>
                <option value="Ampara">Ampara</option>
                <option value="Trincomalee">Trincomalee</option>
                <option value="Kurunegala">Kurunegala</option>
                <option value="Puttalam">Puttalam</option>
                <option value="Anuradhapura">Anuradhapura</option>
                <option value="Polonnaruwa">Polonnaruwa</option>
                <option value="Badulla">Badulla</option>
                <option value="Moneragala">Moneragala</option>
                <option value="Ratnapura">Ratnapura</option>
                <option value="Kegalle">Kegalle</option>
              </select>
            </div>
            <span class="field-error hidden" id="districtError">District is required.</span>
          </div>
          <div class="field-group">
            <label class="field-label required" for="city">City / Town</label>
            <div class="input-wrap">
              <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M15 11V5l-3-3-3 3v2H3v14h18V11h-6zm-8 8H5v-2h2v2zm0-4H5v-2h2v2zm0-4H5V9h2v2zm6 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V9h2v2zm0-4h-2V5h2v2zm6 12h-2v-2h2v2zm0-4h-2v-2h2v2z"/></svg></span>
              <select id="city" name="city" required disabled>
                <option value="" disabled selected>Select City/Town</option>
              </select>
            </div>
            <span class="field-error hidden" id="cityError">City/Town is required.</span>
          </div>
        </div>

        <!-- Profile Photo -->
        <div class="field-group">
          <label class="field-label" for="profilePhoto">Profile Photo <span class="optional-badge">Optional</span></label>
          <div class="file-upload-area" id="photoUploadArea" onclick="document.getElementById('profilePhoto').click()">
            <div class="file-upload-inner" id="photoPreviewArea">
              <span class="upload-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.65 0-3 1.35-3 3s1.35 3 3 3 3-1.35 3-3-1.35-3-3-3z"/></svg></span>
              <p>Click to upload profile photo</p>
              <small>JPG, PNG — Max 5MB</small>
            </div>
            <input type="file" id="profilePhoto" name="profilePhoto" accept="image/*" class="hidden-file" onchange="previewPhoto(this)">
          </div>
        </div>

        <div class="step-actions">
          <button type="button" class="btn-next" onclick="goToStep(2)">Continue <span>→</span></button>
        </div>
      </div>

      <!-- ═══ STEP 2: Account Security ══════════════ -->
      <div class="form-step" id="step2">
        <h3 class="step-title">Account Security</h3>

        <!-- Password -->
        <div class="field-group">
          <label class="field-label required" for="signPassword">Password</label>
          <div class="input-wrap">
            <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg></span>
            <input type="password" id="signPassword" name="password" placeholder="Min. 8 characters" oninput="checkPassword()" required>
            <button type="button" class="toggle-pw" onclick="togglePassword('signPassword', 'toggleSignPw')" id="toggleSignPw" aria-label="Toggle password"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg></button>
          </div>
          <!-- Password Strength Meter -->
          <div class="pw-strength-bar">
            <div class="pw-strength-fill" id="pwStrengthFill"></div>
          </div>
          <div class="pw-rules" id="pwRules">
            <div class="pw-rule" id="rule-len">✗ At least 8 characters</div>
            <div class="pw-rule" id="rule-upper">✗ At least one uppercase letter</div>
            <div class="pw-rule" id="rule-lower">✗ At least one lowercase letter</div>
            <div class="pw-rule" id="rule-num">✗ At least one number</div>
            <div class="pw-rule" id="rule-special">✗ At least one special character (!@#$%...)</div>
          </div>
          <span class="field-error hidden" id="signPasswordError">Password does not meet requirements.</span>
        </div>

        <!-- Confirm Password -->
        <div class="field-group">
          <label class="field-label required" for="confirmPassword">Confirm Password</label>
          <div class="input-wrap">
            <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg></span>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter your password" oninput="checkConfirmPw()" required>
            <button type="button" class="toggle-pw" onclick="togglePassword('confirmPassword', 'toggleConfirmPw')" id="toggleConfirmPw" aria-label="Toggle password"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg></button>
            <span class="input-status" id="confirmStatus"></span>
          </div>
          <span class="field-error hidden" id="confirmPasswordError">Passwords do not match.</span>
        </div>

        <div class="step-actions two-btn">
          <button type="button" class="btn-back" onclick="goToStep(1)">← Back</button>
          <button type="button" class="btn-next" onclick="goToStep(3)">Continue <span>→</span></button>
        </div>
      </div>

      <!-- ═══ STEP 3: Role-Specific Details ════════ -->
      <div class="form-step" id="step3">
        <h3 class="step-title" id="step3Title">Additional Details</h3>

        <!-- ─ USER FIELDS ─ -->
        <div id="userFields" class="hidden">
          <div class="role-info-banner user-banner">
            <span><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></span>
            <p>These fields are optional and help chefs understand your dietary needs.</p>
          </div>

          <div class="field-group">
            <label class="field-label" for="healthCondition">Health Condition <span class="optional-badge">Optional</span></label>
            <div class="input-wrap">
              <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 11h-4v4h-4v-4H6v-4h4V6h4v4h4v4z"/></svg></span>
              <input type="text" id="healthCondition" name="healthCondition" placeholder="e.g. Diabetes, Hypertension">
            </div>
          </div>

          <div class="field-group">
            <label class="field-label" for="allergies">Food Allergies <span class="optional-badge">Optional</span></label>
            <div class="input-wrap">
              <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg></span>
              <input type="text" id="allergies" name="allergies" placeholder="e.g. Nuts, Gluten, Dairy">
            </div>
            <span class="field-hint">Separate multiple allergies with commas</span>
          </div>

          <!-- User Joining Purpose -->
          <div class="field-group">
            <label class="field-label required" for="userPurpose">Purpose of Joining</label>
            <div class="input-wrap">
              <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg></span>
              <select id="userPurpose" name="userPurpose" required>
                <option value="" disabled selected>Select your primary purpose</option>
                <option value="Booking Chef">Booking Chef</option>
                <option value="Enroll Course">Enroll Course</option>
                <option value="Both">Both (Booking Chef & Enroll Course)</option>
              </select>
            </div>
            <span class="field-error hidden" id="userPurposeError">Please select your purpose of joining.</span>
          </div>
        </div>

        <!-- ─ CHEF FIELDS ─ -->
        <div id="chefFields" class="hidden">
          <div class="role-info-banner chef-banner">
            <span><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2C8 2 5.5 4 5.5 7c0 1.25.7 2.45 1.5 3.25V13c0 2 1.5 3.5 3 4 0 1-1 2-1 2H5c-1.1 0-2 .9-2 2v1h18v-1c0-1.1-.9-2-2-2h-4s-1-1-1-2c1.5-.5 3-2 3-4v-2.75c.8-.8 1.5-2 1.5-3.25 0-3-2.5-5-6.5-5zm-2 13h4v1h-4v-1z"/></svg></span>
            <p>Complete your chef profile. Your application will be reviewed by admin before approval.</p>
          </div>

          <!-- Chef Type -->
          <div class="field-group">
            <label class="field-label required" for="chefType">Chef Type</label>
            <div class="input-wrap">
              <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/></svg></span>
              <select id="chefType" name="chefType">
                <option value="">Select chef type...</option>
                <option value="home_cook">Home Cook</option>
                <option value="professional">Professional Chef</option>
              </select>
            </div>
            <span class="field-error hidden" id="chefTypeError">Please select chef type.</span>
          </div>

          <!-- Experience -->
          <div class="field-group">
            <label class="field-label required" for="experience">Years of Experience</label>
            <div class="input-wrap">
              <span class="input-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/></svg></span>
              <input type="number" id="experience" name="experience" placeholder="e.g. 5" min="0" max="50">
            </div>
            <span class="field-error hidden" id="experienceError">Please enter years of experience.</span>
          </div>

          <!-- Cuisine Specialization (Multi-select) -->
          <div class="field-group">
            <label class="field-label required">Cuisine Specialization</label>
            <p class="field-hint" style="margin-bottom:0.5rem;">Select all that apply</p>
            <div class="multi-select-grid" id="cuisineGrid">
              <label class="multi-chip"><input type="checkbox" name="cuisines" value="sri_lankan"><span>🇱🇰 Sri Lankan</span></label>
              <label class="multi-chip"><input type="checkbox" name="cuisines" value="italian"><span>🇮🇹 Italian</span></label>
              <label class="multi-chip"><input type="checkbox" name="cuisines" value="indian"><span>🇮🇳 Indian</span></label>
              <label class="multi-chip"><input type="checkbox" name="cuisines" value="chinese"><span>🇨🇳 Chinese</span></label>
              <label class="multi-chip"><input type="checkbox" name="cuisines" value="malaysian"><span>🇲🇾 Malaysian</span></label>
              <label class="multi-chip"><input type="checkbox" name="cuisines" value="japanese"><span>🇯🇵 Japanese</span></label>
              <label class="multi-chip"><input type="checkbox" name="cuisines" value="french"><span>🇫🇷 French</span></label>
              <label class="multi-chip"><input type="checkbox" name="cuisines" value="mexican"><span>🇲🇽 Mexican</span></label>
              <label class="multi-chip"><input type="checkbox" name="cuisines" value="portuguese"><span>🇵🇹 Portuguese</span></label>
            </div>
            <span class="field-error hidden" id="cuisineError">Please select at least one cuisine.</span>
          </div>

          <!-- Hourly Rate -->
          <div class="field-group">
            <label class="field-label required" for="hourlyRate">Hourly Rate (LKR)</label>
            <div class="input-wrap">
