  <!-- Interactive Scripts -->
  <script>
    // ── Scroll Progress & Floating Button ─────────────────────────
    window.onscroll = function() {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      document.getElementById("scrollProgressBar").style.width = scrolled + "%";

      const topBtn = document.getElementById("backToTopBtn");
      if (winScroll > 300) {
        topBtn.classList.add("visible");
      } else {
        topBtn.classList.remove("visible");
      }

      // Scroll spy highlight active TOC item
      const sections = document.querySelectorAll(".term-section");
      sections.forEach(sec => {
        const top = sec.offsetTop - 120;
        const bottom = top + sec.offsetHeight;
        if (winScroll >= top && winScroll < bottom) {
          const secId = sec.getAttribute("id");
          document.querySelectorAll(".toc-item").forEach(item => {
            item.classList.toggle("active", item.getAttribute("data-sec") === secId);
          });
        }
      });
    };

    // ── Search & Filter Terms ─────────────────────────────────────
    function filterTerms() {
      const query = document.getElementById("termsSearchInput").value.toLowerCase();
      const sections = document.querySelectorAll(".term-section");

      sections.forEach(sec => {
        const text = sec.textContent.toLowerCase();
        if (text.includes(query)) {
          sec.style.display = "block";
        } else {
          sec.style.display = "none";
        }
      });
    }
  </script>

