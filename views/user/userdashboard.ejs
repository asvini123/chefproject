async function submitBankSlip(e) {
  e.preventDefault();
  const bookingId = document.getElementById('slipBookingId').value;
  const fileInput = document.getElementById('slipFileInput');
  const refInput = document.getElementById('slipRefInput');
  const btn = document.getElementById('slipSubmitBtn');

  if (!fileInput.files || fileInput.files.length === 0) {
    showToast('⚠️ Please choose a bank slip file to upload.');
    alert('Please choose a bank slip file to upload.');
    return;
  }

  const formData = new FormData();
  formData.append('receiptFile', fileInput.files[0]);
  formData.append('reference', refInput.value.trim());
  if (bookingId) formData.append('bookingId', bookingId);

  btn.disabled = true;
  btn.textContent = 'Uploading...';

  try {
    const uploadUrl = bookingId ? `/booking/${bookingId}/upload-half-receipt` : `/user/payment/upload-receipt`;
    const res = await fetch(uploadUrl, {
      method: 'POST',
      body: formData
    });
    const data = await res.json();
    if (data.success) {
      closeUploadSlipModal();
      showToast('✅ 50% Advance Bank Slip uploaded! Admin & Chef notified.');
      // Open Official Receipt & Invoice Download Modal
      openPaySuccessModal(
        data.transactionId || 'SLIP-' + Date.now().toString().slice(-6),
        data.amount || 0,
        data.bookingId || bookingId,
        '✅ 50% Advance Bank Slip has been recorded! Chef and Admin have been notified.'
      );
    } else {
      showToast('❌ ' + (data.message || 'Upload failed.'));
      alert('Upload failed: ' + (data.message || 'Please check the file and try again.'));
      btn.disabled = false;
      btn.textContent = 'Upload & Confirm Slip';
    }
  } catch (err) {
    console.error('Error in submitBankSlip:', err);
    showToast('❌ Network error during upload.');
    alert('Network error uploading slip: ' + err.message);
    btn.disabled = false;
    btn.textContent = 'Upload & Confirm Slip';
  }
}

