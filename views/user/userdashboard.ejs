            <% } else { %>
              <button class="btn-primary" onclick="openPaymentModal('Premium', 5000)" style="width:100%; background:#e67e22; border-color:#e67e22;">Upgrade to Premium</button>
            <% } %>
          </div>
        </div>

        <!-- 3. Elite Tier -->
        <div class="content-card" style="border-radius:14px; padding:1.6rem; display:flex; flex-direction:column; justify-content:space-between; position:relative; border:<%= userData.subscriptionTier === 'Elite' ? '2px solid var(--forest-green)' : '1px solid #cbe4cb' %>; background:#f7faf7;">
          <span style="position:absolute; top:12px; right:12px; background:var(--forest-green); color:#fff; font-size:0.7rem; font-weight:700; padding:0.2rem 0.6rem; border-radius:12px;">ULTIMATE</span>
