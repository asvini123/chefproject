              <label for="customFoodGeminiInput" style="font-size:0.86rem; font-weight:700; color:#1a3a1b; margin:0;">
                Option 2: Search Any Custom Food
              </label>
              <span style="font-size:0.68rem; background:#e67e22; color:#fff; padding:0.15rem 0.55rem; border-radius:10px; font-weight:700;">Gemini AI</span>
