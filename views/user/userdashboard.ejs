<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Dashboard — ChefNest</title>
  <meta name="description" content="Manage your chef bookings, profile, payments, and more on ChefNest User Dashboard.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/userdashboard.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="user-body">

<div class="user-layout">

<!-- ============================================================ -->
<!--  SIDEBAR                                                       -->
<!-- ============================================================ -->
<aside class="user-sidebar" id="userSidebar">
  <div class="sidebar-brand">
    <img src="/images/logo2.png" alt="ChefNest Logo" style="height:32px; width:auto; margin-right:8px;">
    <div class="brand-text">
      <span class="brand-name">ChefNest</span>
      <span class="brand-sub">My Dashboard</span>
    </div>
    <button class="sidebar-close" id="sidebarClose" aria-label="Close sidebar">✕</button>
  </div>

  <nav class="sidebar-nav" aria-label="User Navigation">
    <ul class="nav-list">
      <li class="nav-item active" data-section="dashboard">
        <a href="#" class="nav-link" onclick="return showSection('dashboard',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg></span>
          <span class="nav-label">Dashboard</span>
        </a>
      </li>
      <li class="nav-item" data-section="profile">
        <a href="#" class="nav-link" onclick="return showSection('profile',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></span>
          <span class="nav-label">My Profile</span>
        </a>
      </li>
      <li class="nav-item" data-section="bookings">
        <a href="#" class="nav-link" onclick="return showSection('bookings',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg></span>
          <span class="nav-label">My Bookings</span>
          <% const _userPendingDeposit = bookings.filter(b => b.status === 'Accepted' && !b.halfPaymentPaid).length; %>
          <span class="nav-badge <%= _userPendingDeposit > 0 ? 'warn' : '' %>" title="<%= _userPendingDeposit %> booking(s) require 50% deposit">
            <%= bookings.length %>
          </span>
        </a>
      </li>
      <li class="nav-item" data-section="book-chef">
        <a href="#" class="nav-link" onclick="return showSection('book-chef',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7zm0 12c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm-3 8h6v-2H9v2zm8.5-9.5c-.32.48-.68.91-1.08 1.28L17 14h-2v-1.17c-1.57.86-3.4.86-4.98 0V14H8l.58-.22c-.4-.37-.76-.8-1.08-1.28L6 13c1.37 2.02 3.65 3.3 6 3.3s4.63-1.28 6-3.3l-1.5-.5z"/></svg></span>
          <span class="nav-label">Book New Chef</span>
        </a>
      </li>
      <li class="nav-item" data-section="saved">
        <a href="#" class="nav-link" onclick="return showSection('saved',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></span>
          <span class="nav-label">Saved Chefs</span>
          <span class="nav-badge"><%= typeof savedChefs !== 'undefined' ? savedChefs.length : 0 %></span>
        </a>
      </li>
      <li class="nav-item" data-section="subscriptions">
        <a href="#" class="nav-link" onclick="return showSection('subscriptions',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2L2 9l10 13 10-13L12 2zm0 18.52L4.04 9.5l7.96-5.54 7.96 5.54L12 20.52z"/></svg></span>
          <span class="nav-label">Subscriptions</span>
        </a>
      </li>
      <li class="nav-item" data-section="courses">
        <a href="#" class="nav-link" onclick="return showSection('courses',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72l5 2.73 5-2.73v3.72z"/></svg></span>
          <span class="nav-label">Cooking Courses</span>
          <span class="nav-badge"><%= typeof courses !== 'undefined' ? courses.length : 0 %></span>
        </a>
      </li>
      <li class="nav-item" data-section="ingredients">
        <a href="#" class="nav-link" onclick="return showSection('ingredients',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2c-5.52 0-10 4.48-10 10s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-2-11c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm4 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6H10v-2h4v2z"/></svg></span>
          <span class="nav-label">Ingredient Suggestion</span>
        </a>
      </li>
      <li class="nav-item" data-section="diet-classifier">
        <a href="#" class="nav-link" onclick="return showSection('diet-classifier',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg></span>
          <span class="nav-label">AI Diet Classifier</span>
          <span class="nav-badge" style="background:#2C5F2D; color:#fff; font-size:0.65rem; padding:0.15rem 0.45rem; border-radius:10px; font-weight:800; letter-spacing:0.5px;">ML AI</span>
        </a>
      </li>
      <li class="nav-item" data-section="payments">
        <a href="#" class="nav-link" onclick="return showSection('payments',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg></span>
          <span class="nav-label">Payments</span>
          <span class="nav-badge"><%= typeof receipts !== 'undefined' ? receipts.length : 0 %></span>
        </a>
      </li>
      <li class="nav-item" data-section="discounts">
        <a href="#" class="nav-link" onclick="return showSection('discounts',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg></span>
          <span class="nav-label">Discounts &amp; Offers</span>
          <span class="nav-badge" style="background:#D97A2B; color:#fff; font-size:0.65rem; padding:0.15rem 0.45rem; border-radius:10px; font-weight:800;">PROMO</span>
        </a>
      </li>
      <li class="nav-item" data-section="reviews">
        <a href="#" class="nav-link" onclick="return showSection('reviews',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></span>
          <span class="nav-label">Reviews</span>
          <span class="nav-badge"><%= typeof reviews !== 'undefined' ? reviews.length : 0 %></span>
        </a>
      </li>
      <li class="nav-item" data-section="notifications">
        <a href="#" class="nav-link" onclick="return showSection('notifications',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/></svg></span>
          <span class="nav-label">Notifications</span>
          <% const _unreadUserNotifs = (typeof notifications !== 'undefined' ? notifications.filter(n => !n.isRead).length : 0); %>
          <span class="nav-badge <%= _unreadUserNotifs > 0 ? 'warn' : '' %>"><%= _unreadUserNotifs %></span>
        </a>
      </li>
      <li class="nav-item" data-section="chat">
        <a href="#" class="nav-link" onclick="return showSection('chat',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg></span>
          <span class="nav-label">Chat</span>
          <span class="nav-badge" id="userChatNavBadge" style="display:none; background:#e74c3c; color:#fff; font-weight:800; border-radius:10px; padding:0.15rem 0.5rem; font-size:0.75rem; margin-left:auto;">0</span>
        </a>
      </li>
      <li class="nav-item" data-section="settings">
        <a href="#" class="nav-link" onclick="return showSection('settings',this)">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg></span>
          <span class="nav-label">Settings</span>
        </a>
      </li>
      <li class="nav-divider"></li>
      <li class="nav-item">
        <a href="/" class="nav-link" style="color:var(--accent-gold); font-weight:700;">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg></span>
          <span class="nav-label">Back to Home</span>
        </a>
      </li>
      <li class="nav-item logout-item">
        <a href="#" class="nav-link" onclick="openLogoutModal(); return false;">
          <span class="nav-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg></span>
          <span class="nav-label">Logout</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Sidebar Footer -->
  <div class="sidebar-footer">
    <div class="sidebar-user-mini">
      <div class="mini-avatar">
        <% if (userData.profilePhoto) { %>
          <img src="<%= userData.profilePhoto %>" alt="avatar">
        <% } else { %>
          <%= userData.firstName.charAt(0).toUpperCase() + userData.lastName.charAt(0).toUpperCase() %>
        <% } %>
      </div>
      <div class="mini-info">
        <span class="mini-name" style="color: #D97A2B !important; font-weight: 800; font-size: 0.95rem;"><%= userData.firstName %> <%= userData.lastName %></span>
        <span class="mini-role" style="color: #c8e6c9 !important; font-size: 0.75rem;">Member</span>
      </div>
    </div>
  </div>
</aside>

<!-- ============================================================ -->
<!--  MAIN CONTENT                                                 -->
<!-- ============================================================ -->
<main class="user-main">

  <!-- TOP BAR -->
  <header class="user-topbar">
    <button class="hamburger" id="hamburgerBtn" aria-label="Toggle Sidebar">
      <span></span><span></span><span></span>
    </button>
    <div class="topbar-breadcrumb">
      <span class="breadcrumb-root">ChefNest</span>
      <span class="breadcrumb-sep">›</span>
      <span class="breadcrumb-current" id="breadcrumbCurrent">Dashboard</span>
    </div>
    <div class="topbar-search">
      <span class="search-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg></span>
      <input type="text" id="globalSearch" placeholder="Search chefs, cuisines, bookings..." aria-label="Global search">
    </div>
    <div class="topbar-right">
      <a href="/" style="display:inline-flex; align-items:center; gap:0.35rem; font-size:0.78rem; font-weight:700; padding:0.35rem 0.75rem; border-radius:20px; background:#edf5ed; color:#2C5F2D; text-decoration:none; border:1px solid #c8e2c8; transition:all 0.2s;" title="Back to ChefNest Home">
        <svg style="width:14px; height:14px; fill:#2C5F2D;" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        <span>Home</span>
      </a>
      <button class="topbar-notif" aria-label="Notifications" onclick="showSection('notifications',document.querySelector('[data-section=notifications] a'))">
        <svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/></svg><span class="notif-dot"></span>
      </button>
      <div class="topbar-avatar" title="<%= userData.firstName %> <%= userData.lastName %>">
        <% if (userData.profilePhoto) { %>
          <img src="<%= userData.profilePhoto %>" alt="avatar">
        <% } else { %>
          <%= userData.firstName.charAt(0).toUpperCase() + userData.lastName.charAt(0).toUpperCase() %>
        <% } %>
      </div>
    </div>
  </header>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <div class="user-content">

    <!-- ============================================================ -->
    <!--  SECTION 1: DASHBOARD                                         -->
    <!-- ============================================================ -->
    <section class="user-section active" id="section-dashboard">

      <!-- Welcome Banner -->
      <div class="welcome-banner">
        <div>
          <p class="welcome-greeting" id="dynamicGreeting">👋 Welcome back!</p>
          <h1 class="welcome-name"><%= userData.firstName %> <%= userData.lastName %>! <span class="emoji-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2h-2V2h-2v2H9V2H7v2H6c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/></svg></span></h1>
          <div style="display:inline-flex; align-items:center; gap:0.5rem; background:rgba(255,255,255,0.22); padding:0.3rem 0.85rem; border-radius:20px; font-size:0.88rem; font-weight:700; color:#fff; margin-top:0.4rem; backdrop-filter:blur(4px); border:1px solid rgba(255,255,255,0.3);">
            <span>🆔 Member ID:</span>
            <span style="letter-spacing:1px; background:#fff; color:#1a3a1b; padding:0.15rem 0.6rem; border-radius:6px; font-weight:800;"><%= userData.memberId || ('CN-USR-' + userData._id.toString().slice(-4).toUpperCase()) %></span>
          </div>
          <p class="welcome-sub" style="margin-top:0.6rem;">We're happy to see you again. Let's book your favourite chef today!</p>
        </div>
        <div class="welcome-date">
          <div class="welcome-date-day" id="dateDay">—</div>
          <div class="welcome-date-num" id="dateNum">—</div>
          <div class="welcome-date-month" id="dateMonth">—</div>
        </div>
      </div>

      <!-- Quote of the Day -->
      <div class="quote-bar">
        🍽️ &nbsp;<em id="quoteText">"Good food is the foundation of genuine happiness."</em>
      </div>

      <!-- Active Discounts & Promotional Offers -->
      <% if (typeof discounts !== 'undefined' && discounts && discounts.length > 0) { %>
        <div style="background:linear-gradient(135deg, #f7faf7, #edf5ed); border:1.5px solid #cce2cc; border-radius:16px; padding:1.2rem 1.4rem; margin-bottom:1.5rem; box-shadow:0 4px 14px rgba(44,95,45,0.06);">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.8rem;">
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span style="font-size:1.3rem;">🏷️</span>
              <h3 style="margin:0; font-size:1.05rem; font-weight:800; color:#1E2E1E;">Special Offers &amp; Promo Discounts</h3>
            </div>
            <span style="font-size:0.75rem; background:#2C5F2D; color:#fff; font-weight:700; padding:0.2rem 0.6rem; border-radius:20px;">Active Deals</span>
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem;">
            <% discounts.forEach(d => { %>
              <div style="background:#fff; border:1px solid #d8ebd8; border-radius:12px; padding:0.9rem 1.1rem; display:flex; flex-direction:column; justify-content:space-between; position:relative; overflow:hidden;">
                <div style="position:absolute; top:0; left:0; width:4px; height:100%; background:#2C5F2D;"></div>
                <div>
                  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.3rem;">
                    <strong style="color:#1E2E1E; font-size:0.92rem;"><%= d.title %></strong>
                    <span style="background:#fff3e6; color:#D97A2B; font-weight:800; font-size:0.8rem; padding:0.15rem 0.45rem; border-radius:6px;"><%= d.discountPercentage %>% OFF</span>
                  </div>
                  <p style="margin:0 0 0.6rem; font-size:0.78rem; color:#666;"><%= d.description || 'Valid on all chef bookings' %></p>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px dashed #e8eee8; padding-top:0.5rem; font-size:0.75rem;">
                  <span style="color:#888;">Code: <strong style="color:#2C5F2D; font-size:0.85rem; letter-spacing:0.5px;"><%= d.code %></strong></span>
                  <span style="color:#999;">Expires <%= new Date(d.validTill).toLocaleDateString() %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- KPI Cards -->
      <% 
        const activeBookingsList = (typeof bookings !== 'undefined' && bookings) ? bookings.filter(b => b.status !== 'Cancelled' && b.status !== 'Completed') : [];
        const upcomingEvent = activeBookingsList.length > 0 ? activeBookingsList[0] : null;
      %>
      <div class="kpi-grid">
        <div class="kpi-card" onclick="showSection('bookings', document.querySelector('[data-section=bookings] a'))" style="cursor:pointer;">
          <div class="kpi-icon green"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg></div>
          <div class="kpi-body">
            <span class="kpi-label">Total Bookings</span>
            <span class="kpi-value"><%= typeof bookings !== 'undefined' ? bookings.length : 0 %></span>
            <span class="kpi-sub">All time</span>
          </div>
        </div>
        <div class="kpi-card" onclick="showSection('bookings', document.querySelector('[data-section=bookings] a'))" style="cursor:pointer; border: 2px solid <%= upcomingEvent ? '#2C5F2D' : '#e0ead0' %>;">
          <div class="kpi-icon gold">🍳</div>
          <div class="kpi-body">
            <span class="kpi-label">Upcoming Booking</span>
            <% if (upcomingEvent) { %>
              <span class="kpi-value" style="font-size:1.15rem; font-weight:900; color:#1a3a1b;"><strong><%= new Date(upcomingEvent.date).toLocaleDateString(undefined, { month:'short', day:'numeric' }) %></strong></span>
              <span class="kpi-sub" style="font-weight:700; color:#2C5F2D;"><%= upcomingEvent.time %> · <strong>Chef <%= upcomingEvent.chefId ? upcomingEvent.chefId.firstName : 'Chef' %></strong></span>
            <% } else { %>
              <span class="kpi-value" style="font-size:1rem; color:#888;">None</span>
              <span class="kpi-sub">No active bookings</span>
            <% } %>
          </div>
        </div>
        <div class="kpi-card" onclick="showSection('subscriptions', document.querySelector('[data-section=subscriptions] a'))" style="cursor:pointer;">
          <div class="kpi-icon blue"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2L2 9l10 13 10-13L12 2zm0 18.52L4.04 9.5l7.96-5.54 7.96 5.54L12 20.52z"/></svg></div>
          <div class="kpi-body">
            <span class="kpi-label">Active Subscription</span>
            <span class="kpi-value" style="font-size:1rem;"><%= userData.subscriptionTier || 'Free' %></span>
            <span class="kpi-sub"><%= userData.subscriptionTier === 'Free' ? 'Free Tier' : 'Active Plan' %></span>
          </div>
        </div>
        <div class="kpi-card" onclick="showSection('notifications', document.querySelector('[data-section=notifications] a'))" style="cursor:pointer;">
          <div class="kpi-icon red"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/></svg></div>
          <div class="kpi-body">
            <span class="kpi-label">Notifications</span>
            <span class="kpi-value" id="kpiUnreadCount"><%= (typeof notifications !== 'undefined' && notifications) ? notifications.filter(n => !n.isRead).length : 0 %></span>
            <span class="kpi-sub">Unread</span>
          </div>
        </div>
      </div>

      <!-- Widgets Row -->
      <div class="widgets-grid">
        <!-- Recent Activity -->
        <div class="widget-card">
          <div class="widget-header">
            <h3>📋 Recent Activity</h3>
            <span style="font-size:0.75rem;color:var(--text-muted);">Latest Updates</span>
          </div>
          <div class="widget-body">
            <div class="activity-list">
              <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
                <% notifications.slice(0, 5).forEach(n => { %>
                  <div class="activity-item" onclick="showSection('notifications', document.querySelector('[data-section=notifications] a'))" style="cursor:pointer;">
                    <div class="activity-dot <%= n.type === 'booking' ? 'green' : (n.type === 'payment' ? 'gold' : 'blue') %>"></div>
                    <span class="activity-text"><%= n.title %>: <%= n.message.slice(0, 55) %>...</span>
                    <span class="activity-time"><%= new Date(n.createdAt).toLocaleDateString() %></span>
                  </div>
                <% }) %>
              <% } else { %>
                <div style="text-align:center; padding:1.5rem; color:var(--text-muted); font-size:0.85rem;">
                  No recent activity yet.
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="widget-card">
          <div class="widget-header"><h3>⚡ Quick Actions</h3></div>
          <div class="quick-actions-row">
            <button class="quick-action-btn" onclick="showSection('book-chef',document.querySelector('[data-section=book-chef] a'))">
              <span class="qa-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7zm0 12c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm-3 8h6v-2H9v2zm8.5-9.5c-.32.48-.68.91-1.08 1.28L17 14h-2v-1.17c-1.57.86-3.4.86-4.98 0V14H8l.58-.22c-.4-.37-.76-.8-1.08-1.28L6 13c1.37 2.02 3.65 3.3 6 3.3s4.63-1.28 6-3.3l-1.5-.5z"/></svg></span><span>Book Chef</span>
            </button>
            <button class="quick-action-btn" onclick="showSection('courses',document.querySelector('[data-section=courses] a'))">
              <span class="qa-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72l5 2.73 5-2.73v3.72z"/></svg></span><span>Browse Courses</span>
            </button>
            <button class="quick-action-btn" onclick="showSection('ingredients',document.querySelector('[data-section=ingredients] a'))">
              <span class="qa-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2c-5.52 0-10 4.48-10 10s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-2-11c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm4 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6H10v-2h4v2z"/></svg></span><span>Ingredient Suggestion</span>
            </button>
            <button class="quick-action-btn" onclick="showSection('diet-classifier',document.querySelector('[data-section=diet-classifier] a'))">
              <span class="qa-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg></span><span>Diet Classifier</span>
            </button>
            <button class="quick-action-btn" onclick="showSection('bookings',document.querySelector('[data-section=bookings] a'))">
              <span class="qa-icon"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg></span><span>View Bookings</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Recommended Chefs -->
      <div class="widget-card">
        <div class="widget-header">
          <h3><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> Recommended Chefs</h3>
          <button class="btn-outline" style="font-size:0.75rem; padding:0.3rem 0.75rem;" onclick="showSection('book-chef',document.querySelector('[data-section=book-chef] a'))">View All</button>
        </div>
        <div class="widget-body">
          <div class="chef-cards-grid">
            <% if (typeof recommendedChefs !== 'undefined' && recommendedChefs.length > 0) { %>
              <% recommendedChefs.forEach(chef => { %>
                <div class="chef-card" onclick="window.location.href='/chefs/<%= chef._id %>'">
                  <div class="chef-card-img">
                    <% if (chef.profilePhoto) { %>
                      <img src="<%= chef.profilePhoto %>" alt="<%= chef.firstName %>" style="width:100%; height:100%; object-fit:cover;">
                    <% } else { %>
                      <div style="font-size:3rem; color:var(--text-muted);"><%= chef.firstName.charAt(0) %></div>
                    <% } %>
                  </div>
                  <div class="chef-card-body">
                    <div class="chef-card-name"><%= chef.firstName %> <%= chef.lastName %></div>
                    <div class="chef-card-cuisine">🍛 <%= chef.cuisines ? chef.cuisines.join(', ') : 'Specialty Chef' %></div>
                    <div class="chef-card-rating">
                      <svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      4.9 (120 reviews)
                    </div>
                    <div class="chef-card-price">
                      LKR <%= chef.hourlyRate ? chef.hourlyRate.toLocaleString() : '3,500' %>/hr
                    </div>
                  </div>
                  <div class="chef-card-footer">
                    <button class="btn-book-chef" onclick="event.stopPropagation(); window.location.href='/booking/<%= chef._id %>'">Book Now</button>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div style="color:var(--text-muted); font-size:0.9rem;">No recommended chefs available at the moment.</div>
            <% } %>
          </div>
        </div>
      </div>

    </section>

    <!-- ============================================================ -->
    <!--  SECTION 2: MY PROFILE                                        -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-profile">
      <div class="section-header">
        <h1 class="section-title"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg> My Profile &amp; Settings</h1>
        <p class="section-subtitle">Manage your verified client profile, home dining addresses, dietary notes, and account security.</p>
      </div>

      <!-- Modern Profile Header Banner Card -->
      <div class="content-card" style="background: linear-gradient(135deg, #f8faf8 0%, #ffffff 100%); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 1.6rem; margin-bottom: 1.5rem; box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.2rem;">
          <div style="display: flex; align-items: center; gap: 1.2rem;">
            <div class="profile-avatar-lg" id="profileAvatarContainer" style="width: 80px; height: 80px; border-radius: 50%; border: 3px solid var(--accent-green); box-shadow: 0 4px 12px rgba(44,95,45,0.2); overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--accent-green); color: #fff; font-size: 1.8rem; font-weight: 800; flex-shrink: 0;">
              <% if (userData.profilePhoto) { %>
                <img src="<%= userData.profilePhoto %>" alt="Profile Photo" id="profileAvatarImage" style="width:100%; height:100%; object-fit:cover;">
              <% } else { %>
                <span id="profileAvatarInitials"><%= userData.firstName.charAt(0).toUpperCase() + userData.lastName.charAt(0).toUpperCase() %></span>
              <% } %>
            </div>
            <div>
              <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--text-primary); margin: 0;"><%= userData.firstName %> <%= userData.lastName %></h2>
                <span style="font-size: 0.72rem; font-weight: 800; background: rgba(44,95,45,0.12); color: var(--accent-green); padding: 0.2rem 0.6rem; border-radius: 20px; border: 1px solid rgba(44,95,45,0.25);">✓ Verified Client</span>
              </div>
              <div style="font-size: 0.84rem; color: var(--text-muted); margin-top: 0.25rem;"><%= userData.email %> &middot; <%= userData.phone || 'Phone not set' %></div>
              <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <span style="font-size: 0.75rem; background: var(--bg-surface); border: 1px solid var(--border); padding: 0.2rem 0.6rem; border-radius: 6px; color: var(--text-secondary); font-weight: 700;">
                  🆔 <%= userData.memberId || ('CN-USR-' + (userData.id || userData._id || '').toString().slice(-4).toUpperCase()) %>
                </span>
                <span style="font-size: 0.75rem; background: #fff3e0; border: 1px solid #ffe0b2; color: #e65100; padding: 0.2rem 0.6rem; border-radius: 6px; font-weight: 700;">
                  ⭐ <%= userData.subscriptionTier || 'Standard' %> Member
                </span>
              </div>
            </div>
          </div>
          <div>
            <button type="button" class="btn-outline" style="font-size:0.82rem; padding: 0.55rem 1.1rem; border-radius: 8px; font-weight: 700;" onclick="document.getElementById('profilePhotoInput').click()">
              📷 Change Photo
            </button>
          </div>
        </div>
      </div>

      <!-- Main Profile Form -->
      <form id="userProfileForm" onsubmit="updateUserProfile(event)">
        <input type="file" id="profilePhotoInput" name="profilePhoto" style="display:none" onchange="previewProfilePhoto(event)">

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
          <!-- Card 1: Personal Details -->
          <div class="content-card" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem;">
            <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
              👤 Personal Information
            </h3>
            <div class="form-grid-2">
              <div class="field-group">
                <label class="field-label">First Name</label>
                <input class="form-input" type="text" name="firstName" value="<%= userData.firstName %>" required>
              </div>
              <div class="field-group">
                <label class="field-label">Last Name</label>
                <input class="form-input" type="text" name="lastName" value="<%= userData.lastName %>" required>
              </div>
              <div class="field-group">
                <label class="field-label">Email Address</label>
                <input class="form-input" type="email" value="<%= userData.email %>" disabled style="background: var(--bg-surface); opacity: 0.8;">
              </div>
              <div class="field-group">
                <label class="field-label">Phone Number</label>
                <input class="form-input" type="tel" name="phone" value="<%= userData.phone %>" required>
              </div>
            </div>
          </div>

          <!-- Card 2: Location & Address -->
          <div class="content-card" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem;">
            <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
              📍 Home &amp; Dining Address
            </h3>
            <div class="form-grid-2">
              <div class="field-group" style="grid-column: 1 / -1;">
                <label class="field-label">Street Address</label>
                <input class="form-input" type="text" name="address" value="<%= userData.address %>" required placeholder="e.g. 42, Main Street">
              </div>
              <div class="field-group">
                <label class="field-label">City / Town</label>
                <input class="form-input" type="text" name="city" value="<%= userData.city %>" required placeholder="e.g. Colombo">
              </div>
              <div class="field-group">
                <label class="field-label">District</label>
                <input class="form-input" type="text" name="district" value="<%= userData.district || '' %>" placeholder="e.g. Jaffna, Colombo">
              </div>
              <div class="field-group">
                <label class="field-label">Province</label>
                <select class="form-select" name="province">
                  <option value="">-- Select Province --</option>
                  <% const provinces = ['Northern', 'Eastern', 'Western', 'Southern', 'Central', 'North Western', 'North Central', 'Uva', 'Sabaragamuwa']; %>
                  <% provinces.forEach(prov => { %>
                    <option value="<%= prov %>" <%= userData.province === prov ? 'selected' : '' %>><%= prov %></option>
                  <% }); %>
                </select>
              </div>
              <div class="field-group">
                <label class="field-label">Postal Code</label>
                <input class="form-input" type="text" name="postalCode" value="<%= userData.postalCode || '' %>" placeholder="40000">
              </div>
            </div>
          </div>
        </div>

        <!-- Card 3: Health & Allergies -->
        <div class="content-card" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; margin-top: 1.5rem;">
          <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            💊 Health Conditions &amp; Dietary Allergies
          </h3>
          <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.2rem;">
            This information helps private chefs prepare safe, customized meals tailored to your health requirements.
          </p>
          <div class="form-grid-2">
            <div class="field-group">
              <label class="field-label">Health Conditions</label>
              <textarea class="form-textarea" name="healthCondition" rows="3" placeholder="e.g. Diabetes (low sugar), Hypertension (low sodium)"><%= userData.healthCondition || '' %></textarea>
            </div>
            <div class="field-group">
              <label class="field-label">Food Allergies</label>
              <textarea class="form-textarea" name="allergies" rows="3" placeholder="e.g. Peanuts, Shellfish, Lactose, Gluten"><%= userData.allergies || '' %></textarea>
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end; margin-top: 1.2rem;">
            <button type="submit" class="btn-primary" style="padding: 0.75rem 1.8rem; font-weight: 800; font-size: 0.92rem; border-radius: 8px;">
              💾 Save Profile Details
            </button>
          </div>
        </div>
      </form>

      <!-- Security Card -->
      <div class="content-card" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; margin-top: 1.5rem;">
        <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
          🔒 Security — Change Password
        </h3>
        <form id="userPasswordForm" onsubmit="changeUserPassword(event)" autocomplete="off">
          <div class="form-grid-2">
            <div class="field-group">
              <label class="field-label">Current Password</label>
              <div style="position: relative; display: flex; align-items: center;">
                <input class="form-input" type="password" name="currentPassword" autocomplete="current-password" placeholder="Enter current password" required style="padding-right: 2.5rem;">
                <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: var(--text-secondary); font-size: 1.1rem;">👁️</button>
              </div>
            </div>
            <div class="field-group">
              <label class="field-label">New Password</label>
              <div style="position: relative; display: flex; align-items: center;">
                <input class="form-input" type="password" name="newPassword" autocomplete="new-password" placeholder="Enter new password" required style="padding-right: 2.5rem;">
                <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: var(--text-secondary); font-size: 1.1rem;">👁️</button>
              </div>
            </div>
            <div class="field-group">
              <label class="field-label">Confirm New Password</label>
              <div style="position: relative; display: flex; align-items: center;">
                <input class="form-input" type="password" name="confirmPassword" autocomplete="new-password" placeholder="Confirm new password" required style="padding-right: 2.5rem;">
                <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: var(--text-secondary); font-size: 1.1rem;">👁️</button>
              </div>
            </div>
          </div>
          <div style="display: flex; justify-content: flex-end; margin-top: 1.2rem;">
            <button type="submit" class="btn-primary" style="padding: 0.65rem 1.4rem; font-weight: 700; border-radius: 8px;">
              🔑 Update Password
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- ============================================================ -->
    <!--  SECTION 3: MY BOOKINGS                                       -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-bookings">
      <div class="section-header">
        <h1 class="section-title"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg> My Bookings</h1>
        <p class="section-subtitle">Track, manage and review all your chef bookings.</p>
      </div>

      <div class="tab-row">
        <button class="tab-btn active" onclick="switchTab(this,'upcoming')">Upcoming</button>
        <button class="tab-btn" onclick="switchTab(this,'completed')">Completed</button>
        <button class="tab-btn" onclick="switchTab(this,'cancelled')">Cancelled</button>
      </div>

      <!-- Bookings Filter Bar -->
      <div class="search-filter-bar" style="margin-bottom: 1.25rem; padding: 0.75rem 1.25rem; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <select class="filter-select" id="bookingTypeFilter" onchange="filterBookings()" style="flex: 1; min-width: 120px; padding: 0.5rem 0.8rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-surface); color: var(--text-primary);">
          <option value="">All Booking Types</option>
          <option value="Daily">Daily</option>
          <option value="Urgent">Urgent</option>
          <option value="Event">Event</option>
          <option value="Subscription">Subscription</option>
        </select>
        <input type="date" class="form-input" id="bookingDateFilter" onchange="filterBookings()" style="flex: 1; min-width: 150px; padding: 0.5rem 0.8rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-surface); color: var(--text-primary);" placeholder="Filter by date">
        <button class="btn-outline" onclick="resetBookingsFilter()" style="padding: 0.5rem 1rem; font-size: 0.8rem;">Clear Filters</button>
      </div>

      <!-- Upcoming -->
      <div class="tab-panel active" id="tab-upcoming">
        <% const upcoming = bookings.filter(b => b.status === 'Pending' || b.status === 'Accepted' || b.status === 'Deposit Paid' || b.status === 'On the way' || b.status === 'Cooking'); %>
        <% if (upcoming.length === 0) { %>
          <div style="text-align:center;padding:3rem 2rem;color:var(--text-muted);background:#fff;border-radius:12px;border:1.5px dashed #cbe4cb;">
            <div style="font-size:2.5rem;margin-bottom:0.5rem;">📅</div>
            <p style="font-weight:600;margin:0;">No upcoming chef bookings found.</p>
            <p style="font-size:0.85rem;color:#888;margin:0.3rem 0 1rem;">Book your private dining chef today!</p>
            <a href="/chefs" class="btn-primary" style="text-decoration:none;display:inline-block;padding:0.5rem 1.2rem;font-size:0.85rem;">👨‍🍳 Book a Chef</a>
          </div>
        <% } else { %>
          <% upcoming.forEach(b => { %>
            <% const halfAmount = Math.round(b.totalAmount * 0.5); %>
            <% const chefNameStr = b.chefId ? `${b.chefId.firstName} ${b.chefId.lastName}` : 'Private Chef'; %>
            <div class="booking-card" data-type="<%= b.bookingType %>" data-date="<%= new Date(b.date).toISOString().split('T')[0] %>" style="border-left: 4px solid <%= b.halfPaymentPaid ? '#2C5F2D' : '#f59e0b' %>;">
              <div>
                <div class="booking-id">#<%= b._id.toString().slice(-6).toUpperCase() %></div>
              </div>
              <div class="booking-info">
                <div class="booking-chef" style="font-size:1.05rem; font-weight:800; color:#1a3a1b;">
                  <%= b.chefId ? `Chef ${b.chefId.firstName} ${b.chefId.lastName}` : 'Private Chef' %>
                </div>
                <div class="booking-detail">
                  <%= b.cuisine ? `${b.cuisine} Cuisine · ` : '' %> 📅 <strong><%= new Date(b.date).toDateString() %></strong> · 🕖 <strong><%= b.time %></strong> · 📍 <%= b.location %>
                </div>
                <div style="font-size:0.82rem; margin-top:0.3rem; color:#444;">
                  <strong>Total Amount:</strong> LKR <%= b.totalAmount.toLocaleString() %> &nbsp;|&nbsp; <strong>50% Advance:</strong> LKR <%= halfAmount.toLocaleString() %>
                </div>
                <% if (b.cookingTimeEstimate) { %>
                  <div style="font-size:0.78rem; color:#2C5F2D; margin-top:0.3rem;">⏱️ <strong>Chef Estimate:</strong> <%= b.cookingTimeEstimate %></div>
                <% } %>
                <% if (b.extraIngredients) { %>
                  <div style="font-size:0.78rem; color:#e67e22; margin-top:0.2rem;">🛒 <strong>Extra ingredients:</strong> <%= b.extraIngredients %></div>
                <% } %>
                <% if (b.paymentStatus === 'Completed' || b.paymentStatus === 'Paid') { %>
                  <div style="font-size:0.78rem; color:#15803d; margin-top:0.25rem; font-weight:700;">
                    ✓ 100% Full Payment Settle Completed (<%= b.paymentMethod || 'Paid' %>)
                  </div>
                <% } else if (b.bankReceiptUrl) { %>
                  <div style="font-size:0.78rem; color:#166534; margin-top:0.25rem; font-weight:600;">
                    ✓ 50% Bank Slip Uploaded (<%= b.bankReceiptReference || 'Verified' %>)
                  </div>
                <% } %>

                <% if (b.status === 'Accepted' && !b.halfPaymentPaid && b.paymentStatus !== 'Completed' && b.paymentStatus !== 'Paid') { %>
                  <div style="background:#fffbeb; border:1.5px solid #fde68a; border-radius:8px; padding:0.6rem 0.85rem; margin-top:0.6rem; font-size:0.82rem; color:#92400e; line-height:1.45;">
                    <div style="font-weight:800; color:#b45309; display:flex; align-items:center; gap:0.35rem; margin-bottom:0.2rem;">
                      <span>💳</span> 50% Advance Deposit Due: LKR <%= halfAmount.toLocaleString() %>
                    </div>
                    <span>Please upload your 50% bank deposit receipt to confirm this chef booking.</span>
                    <div style="margin-top:0.3rem; font-size:0.77rem; color:#78350f; background:#fef3c7; padding:0.35rem 0.6rem; border-radius:6px;">
                      💵 <strong>Balance Payment Note:</strong> You can pay the remaining 50% balance via <strong>Bank Transfer, Cash on Delivery (Cash in hand to Chef on arrival), or Credit/Debit Card</strong>.
                    </div>
                  </div>
                <% } %>
              </div>

              <!-- Status Badge -->
              <div>
                <% if (b.paymentStatus === 'Completed' || b.paymentStatus === 'Paid') { %>
                  <span class="badge" style="font-weight:800; font-size:0.78rem; padding:0.35rem 0.75rem; background:#dcfce7; color:#15803d; border:1.5px solid #86efac; border-radius:12px;">
                    ● 100% Fully Paid ✅
                  </span>
                <% } else if (b.status === 'Accepted' && !b.halfPaymentPaid) { %>
                  <span class="badge" style="background:#fff3e0; color:#c2410c; border:1px solid #fed7aa; font-weight:700; font-size:0.78rem; padding:0.3rem 0.7rem;">
                    ⚠️ Accepted · 50% Slip Required
                  </span>
                <% } else if (b.halfPaymentPaid || b.status === 'Deposit Paid') { %>
                  <span class="badge badge-green" style="font-weight:700; font-size:0.78rem; padding:0.3rem 0.7rem;">
                    ✓ 50% Advance Paid
                  </span>
                <% } else if (b.status === 'On the way') { %>
                  <span class="badge badge-blue" style="font-weight:700;">🚗 Chef On The Way</span>
                <% } else if (b.status === 'Cooking') { %>
                  <span class="badge badge-green" style="font-weight:700;">🍳 Cooking In Progress</span>
                <% } else if (b.status === 'Completed') { %>
                  <span class="badge badge-green" style="font-weight:700;">✅ Completed</span>
                <% } else { %>
                  <span class="badge badge-amber" style="font-weight:700;">⏳ Awaiting Chef Acceptance</span>
                <% } %>
              </div>

              <!-- Actions -->
              <div class="booking-actions" style="display:flex; flex-wrap:wrap; gap:0.4rem; align-items:center;">
                <% if (b.status === 'Accepted' && !b.halfPaymentPaid) { %>
                  <button type="button" onclick="openUploadSlipModal('<%= b._id %>', '<%= b._id.toString().slice(-6).toUpperCase() %>', '<%= chefNameStr %>', '<%= halfAmount %>', '<%= b.totalAmount %>')" style="background:#2C5F2D; color:white; border:none; padding:0.45rem 0.85rem; border-radius:6px; font-weight:700; font-size:0.8rem; cursor:pointer; display:inline-flex; align-items:center; gap:0.3rem;">
                    📤 Upload 50% Bank Slip (LKR <%= halfAmount.toLocaleString() %>)
                  </button>
                <% } %>

                <% if (b.bankReceiptUrl) { %>
                  <a href="<%= b.bankReceiptUrl %>" target="_blank" class="action-btn" style="text-decoration:none; background:#e8f5e9; color:#1a5c2a; border-color:#86efac; font-weight:700;">
                    🧾 View Slip
                  </a>
                <% } %>

                <a href="/booking/receipt/<%= b._id %>" target="_blank" class="action-btn" style="text-decoration:none;">📄 Invoice</a>

                <!-- Cancel Booking Option -->
                <button type="button" onclick="openCancelBookingModal('<%= b._id %>', '<%= (chefNameStr || 'Chef').replace(/'/g, "\\'") %>', <%= b.halfPaymentPaid ? 'true' : 'false' %>)" style="background:#fff1f2; color:#e11d48; border:1px solid #fecdd3; padding:0.4rem 0.75rem; border-radius:6px; font-weight:700; font-size:0.78rem; cursor:pointer;">
                  ✕ Cancel Booking
                </button>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <!-- Completed -->
      <div class="tab-panel" id="tab-completed">
        <% const completed = bookings.filter(b => b.status === 'Completed'); %>
        <% if (completed.length === 0) { %>
          <div style="text-align:center;padding:2rem;color:var(--text-muted);">No completed bookings.</div>
        <% } else { %>
          <% completed.forEach(b => { %>
            <div class="booking-card" data-type="<%= b.bookingType %>" data-date="<%= new Date(b.date).toISOString().split('T')[0] %>">
              <div><div class="booking-id">#<%= b._id.toString().slice(-6).toUpperCase() %></div></div>
              <div class="booking-info">
                <div class="booking-chef">
                  <%= b.chefId ? `Chef ${b.chefId.firstName} ${b.chefId.lastName}` : 'Private Chef' %>
                </div>
                <div class="booking-detail">
                  <%= b.cuisine ? `${b.cuisine} Cuisine · ` : '' %> 📅 <%= new Date(b.date).toDateString() %>
                </div>
              </div>
              <span class="badge badge-green">Completed</span>
              <div class="booking-actions">
                <a href="/booking/receipt/<%= b._id %>" target="_blank" class="action-btn" style="text-decoration:none; margin-right: 0.5rem;">📄 Invoice</a>
                <button class="btn-primary" style="font-size:0.75rem; padding:0.35rem 0.8rem;" onclick="openReviewModal('<%= b._id %>', '<%= b.chefId ? b.chefId._id : '' %>', '<%= b.chefId ? b.chefId.firstName + ' ' + b.chefId.lastName : 'Private Chef' %>')">⭐ Leave Review</button>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <!-- Cancelled -->
      <div class="tab-panel" id="tab-cancelled">
        <% const cancelled = bookings.filter(b => b.status === 'Cancelled' || b.status === 'Declined'); %>
        <% if (cancelled.length === 0) { %>
          <div style="text-align:center;padding:2rem;color:var(--text-muted);">No cancelled bookings.</div>
        <% } else { %>
          <% cancelled.forEach(b => { %>
            <div class="booking-card" style="opacity:0.7;" data-type="<%= b.bookingType %>" data-date="<%= new Date(b.date).toISOString().split('T')[0] %>">
              <div><div class="booking-id">#<%= b._id.toString().slice(-6).toUpperCase() %></div></div>
              <div class="booking-info">
                <div class="booking-chef">
                  <%= b.chefId ? `Chef ${b.chefId.firstName} ${b.chefId.lastName}` : 'Private Chef' %>
                </div>
                <div class="booking-detail">
                  📅 <%= new Date(b.date).toDateString() %>
                </div>
              </div>
              <span class="badge badge-red">Cancelled</span>
            </div>
          <% }) %>
        <% } %>
      </div>
    </section>

    <!-- ============================================================ -->
    <!--  SECTION 4: BOOK NEW CHEF                                     -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-book-chef">
      <div class="section-header">
        <h1 class="section-title" style="color: #1b3815;"><svg class="svg-icon" viewBox="0 0 24 24" style="fill: #1b3815;"><path d="M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7zm0 12c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm-3 8h6v-2H9v2zm8.5-9.5c-.32.48-.68.91-1.08 1.28L17 14h-2v-1.17c-1.57.86-3.4.86-4.98 0V14H8l.58-.22c-.4-.37-.76-.8-1.08-1.28L6 13c1.37 2.02 3.65 3.3 6 3.3s4.63-1.28 6-3.3l-1.5-.5z"/></svg> Book New Chef</h1>
        <p class="section-subtitle" style="color: #444;">Search, filter, and book the perfect chef for your occasion.</p>
      </div>

      <div class="search-filter-bar">
        <div class="search-input-wrap">
          <span class="search-icon-inside"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg></span>
          <input type="text" id="chefSearch" placeholder="Search chefs by name or cuisine..." onkeyup="filterChefs()">
        </div>
        <select class="filter-select" id="chefCuisineFilter" onchange="filterChefs()">
          <option value="">All Cuisines</option>
          <option value="Sri Lankan">Sri Lankan</option>
          <option value="Italian">Italian</option>
          <option value="Chinese">Chinese</option>
          <option value="Indian">Indian</option>
          <option value="Vegan">Vegan</option>
        </select>
        <select class="filter-select" id="chefPriceFilter" onchange="filterChefs()">
          <option value="">Any Price</option>
          <option value="2000">Under LKR 2000</option>
          <option value="5000">LKR 2000–5000</option>
          <option value="5001">Above LKR 5000</option>
        </select>
        <select class="filter-select" id="chefLocationFilter" onchange="filterChefs()">
          <option value="">Any District</option>
          <option value="Colombo">Colombo</option>
          <option value="Gampaha">Gampaha</option>
          <option value="Kalutara">Kalutara</option>
          <option value="Kandy">Kandy</option>
          <option value="Matale">Matale</option>
          <option value="Nuwara Eliya">Nuwara Eliya</option>
          <option value="Galle">Galle</option>
          <option value="Matara">Matara</option>
          <option value="Hambantota">Hambantota</option>
          <option value="Jaffna">Jaffna</option>
          <option value="Kilinochchi">Kilinochchi</option>
          <option value="Mannar">Mannar</option>
          <option value="Vavuniya">Vavuniya</option>
          <option value="Mullaitivu">Mullaitivu</option>
          <option value="Batticaloa">Batticaloa</option>
          <option value="Ampara">Ampara</option>
          <option value="Trincomalee">Trincomalee</option>
          <option value="Kurunegala">Kurunegala</option>
          <option value="Puttalam">Puttalam</option>
          <option value="Anuradhapura">Anuradhapura</option>
          <option value="Polonnaruwa">Polonnaruwa</option>
          <option value="Badulla">Badulla</option>
          <option value="Moneragala">Moneragala</option>
          <option value="Ratnapura">Ratnapura</option>
          <option value="Kegalle">Kegalle</option>
        </select>
        <button class="btn-primary" onclick="filterChefs()"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg> Search</button>
      </div>

      <div class="chef-cards-grid" id="chefSearchResults" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
        <% if (typeof allChefs !== 'undefined' && allChefs.length > 0) { %>
          <% allChefs.forEach((chef, index) => { 
               const initials = (chef.firstName.charAt(0) + chef.lastName.charAt(0)).toUpperCase();
               const isPro = chef.chefType === 'professional';
               const typeText = isPro ? 'PROFESSIONAL' : 'HOME COOK';
               const chefCity = chef.city || chef.location || 'Colombo';
               const chefCuisinesClean = (chef.cuisines && chef.cuisines.length > 0) ? chef.cuisines.map(c => c.replace(/[_-]/g, ' ')).join(' ') : 'Sri Lankan';
               const chefRate = chef.hourlyRate || 3000;
          %>
            <div class="chef-card" 
                 data-name="Chef <%= chef.firstName %> <%= chef.lastName %>"
                 data-cuisine="<%= chefCuisinesClean %>"
                 data-city="<%= chefCity %>"
                 data-price="<%= chefRate %>"
                 style="border: 1px solid #eee; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.3s ease; display: flex; flex-direction: column;">
              <div class="chef-card-header" style="background: var(--forest-green); padding: 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative;">
                <span style="position: absolute; top: 10px; left: 10px; background: rgba(255,255,255,0.2); color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 600;"><%= typeText %></span>
                <% if (chef.profilePhoto) { %>
                  <img src="<%= chef.profilePhoto %>" alt="<%= chef.firstName %>" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid #fff;">
                <% } else { %>
                  <div style="width: 80px; height: 80px; border-radius: 50%; background: #fff; color: var(--forest-green); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 700; font-family: 'Playfair Display', serif;"><%= initials %></div>
                <% } %>
              </div>
              <div class="chef-card-body" style="padding: 1.5rem; text-align: center; flex: 1;">
                <h3 style="margin: 0 0 0.5rem 0; font-family: 'Playfair Display', serif; font-size: 1.3rem; color: #222;">Chef <%= chef.firstName %> <%= chef.lastName %></h3>
                <div style="color: #666; font-size: 0.9rem; margin-bottom: 1rem;"><svg class="svg-icon" viewBox="0 0 24 24" style="width:14px;height:14px;fill:#d32f2f;margin-right:4px;"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg><%= chefCity %></div>
                
                <% if (chef.cuisines && chef.cuisines.length > 0) { %>
                  <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1rem;">
                    <% chef.cuisines.slice(0,2).forEach(spec => { %>
                      <span style="background: #f0f7f2; color: var(--forest-green); border: 1px solid #d4ebd9; padding: 3px 8px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;"><%= spec.replace(/[_-]/g, ' ') %></span>
                    <% }) %>
                  </div>
                <% } %>
                
                <div style="font-weight: 700; font-size: 1.1rem; color: #333; margin-top: auto;">LKR <%= chefRate.toLocaleString() %>/hr</div>
              </div>
              <div class="chef-card-footer" style="padding: 1rem 1.5rem; border-top: 1px solid #f0f0f0;">
                <a href="/chefs/<%= chef._id %>" class="btn-book-chef" style="display: block; text-align: center; text-decoration: none; width: 100%; padding: 0.7rem; background: #e67e22; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.3s; box-shadow: 0 4px 10px rgba(230,126,34,0.3);">View Profile & Book</a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 2rem; background: #fff; border-radius: 12px; border: 1px dashed #ddd;">
            <div style="font-size: 3rem; margin-bottom: 1rem;">👨‍🍳</div>
            <h3 style="font-family: 'Playfair Display', serif; color: #333; margin-bottom: 0.5rem;">No Chefs Available Yet</h3>
            <p style="color: #666;">We are currently verifying our talented chefs. Check back soon!</p>
          </div>
        <% } %>
      </div>

      <!-- Pagination Controls -->
      <div class="pagination-controls" id="paginationControls" style="display:flex; justify-content:center; align-items:center; gap:0.5rem; margin-top:2rem;"></div>
    </section>

    <!-- ============================================================ -->
    <!--  SECTION 5: SAVED CHEFS                                       -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-saved">
      <div class="section-header">
        <h1 class="section-title"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg> Saved Chefs</h1>
        <p class="section-subtitle">Your favourite chefs, all in one place.</p>
      </div>
      <div class="chef-cards-grid" id="savedChefsGrid" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap:1.4rem;">
        <% if (userData.savedChefs && userData.savedChefs.length > 0) { %>
          <% userData.savedChefs.forEach(chef => { 
               const initials = (chef.firstName.charAt(0) + chef.lastName.charAt(0)).toUpperCase();
               const chefRate = chef.hourlyRate || 3000;
               const chefCity = chef.city || 'Colombo';
          %>
            <div class="chef-card" id="savedChefCard-<%= chef._id %>" style="border:1px solid #eee; border-radius:14px; overflow:hidden; background:#fff; box-shadow:0 3px 12px rgba(0,0,0,0.04); display:flex; flex-direction:column;">
              <div style="height:210px; width:100%; overflow:hidden; background:#f4f7f4; position:relative;">
                <% if (chef.profilePhoto) { %>
                  <img src="<%= chef.profilePhoto %>" alt="<%= chef.firstName %>" style="width:100%; height:100%; object-fit:cover; object-position:top center;">
                <% } else { %>
                  <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:2.5rem; font-weight:700; color:var(--forest-green); font-family:'Playfair Display', serif;"><%= initials %></div>
                <% } %>
              </div>
              <div class="chef-card-body" style="padding:1.2rem 1.2rem 0.8rem; flex:1; display:flex; flex-direction:column;">
                <div style="font-weight:700; font-size:1.1rem; color:var(--text-primary); margin-bottom:0.35rem; font-family:'Playfair Display', serif;"><%= chef.firstName %> <%= chef.lastName %></div>
                <div style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.5rem; display:flex; align-items:center; gap:0.3rem;">
