                  </option>
                  <option value="custom_pasta" data-title="Italian Fresh Pasta & Sauces Masterclass" data-category="Cuisine" data-price="6500" data-duration="2.5 hours">
                    Italian Fresh Pasta &amp; Sauces — LKR 6,500 (2.5 hrs)
                  </option>
                  <option value="custom_indian" data-title="Authentic North & South Indian Spices" data-category="Cuisine" data-price="4500" data-duration="3 hours">
                    North &amp; South Indian Flavours — LKR 4,500 (3 hrs)
                  </option>
                  <option value="custom_asian" data-title="Asian Fusion & Wok Techniques" data-category="Cuisine" data-price="5500" data-duration="3 hours">
                    Asian Fusion &amp; Wok Masterclass — LKR 5,500 (3 hrs)
                  </option>
                </optgroup>

                <optgroup label="Skill-Level & Technique Tracks">
                  <option value="custom_knife" data-title="Professional Knife Skills & Butchery" data-category="Skill" data-price="4000" data-duration="2 hours">
                    Professional Knife Skills &amp; Prep — LKR 4,000 (2 hrs)
                  </option>
                  <option value="custom_plating" data-title="Gourmet Plating & Presentation" data-category="Skill" data-price="6000" data-duration="2.5 hours">
                    Fine Dining Plating &amp; Aesthetics — LKR 6,000 (2.5 hrs)
                  </option>
                  <option value="custom_baking" data-title="Artisan Bread & French Pastry Craft" data-category="Skill" data-price="7500" data-duration="4 hours">
                    Artisan Bread &amp; French Pastry — LKR 7,500 (4 hrs)
                  </option>
                </optgroup>

                <optgroup label="Health, Diet & Occasion Tracks">
                  <option value="custom_vegan" data-title="Plant-Based & Vegan Gourmet Cooking" data-category="Health" data-price="4500" data-duration="2.5 hours">
                    Plant-Based &amp; Vegan Gourmet — LKR 4,500 (2.5 hrs)
                  </option>
                  <option value="custom_ayurvedic" data-title="Traditional Ayurvedic Cooking & Healing Herbs" data-category="Health" data-price="5000" data-duration="3 hours">
                    Traditional Ayurvedic Cooking — LKR 5,000 (3 hrs)
                  </option>
                  <option value="custom_bbq" data-title="BBQ & Grill Masterclass for Occasions" data-category="Occasion" data-price="6500" data-duration="3.5 hours">
                    Outdoor BBQ &amp; Grill Masterclass — LKR 6,500 (3.5 hrs)
                  </option>
                </optgroup>

                <!-- Live database courses if any exist -->
                <% if (typeof courses !== 'undefined' && courses.length > 0) { %>
                  <optgroup label="Live ChefNest Courses">
                    <% courses.forEach(c => { %>
                      <option value="<%= c._id %>" data-title="<%= c.title %>" data-category="<%= c.category || 'Cuisine' %>" data-price="<%= c.price || 0 %>" data-duration="<%= c.duration || '2 hours' %>" data-chef-id="<%= c.chefId ? c.chefId._id : '' %>">
                        <%= c.title %> — <%= c.price === 0 ? 'FREE' : 'LKR ' + c.price.toLocaleString() %> (<%= c.duration %>)
                      </option>
                    <% }) %>
                  </optgroup>
                <% } %>
              </select>
            </div>

            <!-- 2. Select Real Registered Chef Dropdown (Dynamically filtered by Course Teaching Preferences) -->
            <div class="field-group">
              <label class="field-label" style="font-weight:700; color:var(--text-primary); margin-bottom:0.4rem; display:block;">
                Select Instructor Chef <span style="color:var(--accent-red);">*</span>
              </label>
              <select name="chefId" id="enrollChefSelect" class="form-select" style="width:100%; border:1.5px solid var(--border); padding:0.7rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit; font-size:0.9rem;" required disabled>
                <option value="">-- Select a Course First --</option>
              </select>
              <div id="chefFilterHint" style="font-size:0.75rem; color:var(--text-muted); margin-top:0.35rem;">
                Select a course above to see registered instructor chefs.
              </div>
            </div>

          </div>

          <!-- Second Row: Learning Mode & Preferred Date/Time -->
          <div class="form-grid-2" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:1.2rem; margin-bottom:1.2rem;">
            
            <!-- Learning Mode -->
            <div class="field-group">
              <label class="field-label" style="font-weight:700; color:var(--text-primary); margin-bottom:0.4rem; display:block;">
                Learning Mode
              </label>
              <select name="learningMode" id="enrollLearningMode" class="form-select" style="width:100%; border:1.5px solid var(--border); padding:0.7rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit; font-size:0.9rem;">
                <option value="In-Person Kitchen Class">In-Person Kitchen Class (Private Session with Chef)</option>
                <option value="Online Live Masterclass">Online Live Masterclass (Interactive Video &amp; Cooking)</option>
                <option value="Weekend Workshop">Weekend Hands-On Workshop</option>
                <option value="Self-Paced">Self-Paced with Chef Feedback</option>
              </select>
            </div>

            <!-- Preferred Time Slot -->
            <div class="field-group">
              <label class="field-label" style="font-weight:700; color:var(--text-primary); margin-bottom:0.4rem; display:block;">
                Preferred Time Slot
              </label>
              <select name="preferredTime" id="enrollPreferredTime" class="form-select" style="width:100%; border:1.5px solid var(--border); padding:0.7rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit; font-size:0.9rem;">
                <option value="Morning (09:00 AM - 12:00 PM)">Morning (09:00 AM - 12:00 PM)</option>
                <option value="Afternoon (02:00 PM - 05:00 PM)">Afternoon (02:00 PM - 05:00 PM)</option>
                <option value="Evening (06:00 PM - 09:00 PM)">Evening (06:00 PM - 09:00 PM)</option>
                <option value="Flexible / Weekends">Flexible / Weekends</option>
              </select>
            </div>

          </div>

          <!-- Third Row: Date & Dietary Preference -->
          <div class="form-grid-2" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:1.2rem; margin-bottom:1.2rem;">
            
            <!-- Preferred Date -->
            <div class="field-group">
              <label class="field-label" style="font-weight:700; color:var(--text-primary); margin-bottom:0.4rem; display:block;">
                Preferred Start Date (Optional)
              </label>
              <input type="date" name="preferredDate" id="enrollPreferredDate" min="<%= new Date().toISOString().split('T')[0] %>" class="form-input" style="width:100%; border:1.5px solid var(--border); padding:0.7rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit; font-size:0.9rem;">
            </div>

            <!-- Dietary Preference / Focus -->
            <div class="field-group">
              <label class="field-label" style="font-weight:700; color:var(--text-primary); margin-bottom:0.4rem; display:block;">
                Dietary Focus / Allergies
              </label>
              <select name="dietaryPreference" id="enrollDietary" class="form-select" style="width:100%; border:1.5px solid var(--border); padding:0.7rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit; font-size:0.9rem;">
                <option value="None">No specific preference (All ingredients)</option>
                <option value="Vegetarian">Vegetarian Only</option>
                <option value="Vegan">100% Vegan / Plant-Based</option>
                <option value="Gluten-Free">Gluten-Free Focus</option>
                <option value="Halal">Halal Certified Ingredients</option>
                <option value="Dairy-Free">Dairy-Free</option>
              </select>
            </div>

          </div>

          <!-- Contact Phone Number for Masterclass -->
          <div class="field-group" style="margin-bottom:1.2rem;">
            <label class="field-label" style="font-weight:700; color:var(--text-primary); margin-bottom:0.4rem; display:block;">
              📞 Contact Phone Number <span style="color:var(--accent-red);">*</span>
            </label>
            <input type="tel" name="phone" id="enrollPhone" placeholder="e.g. 077 123 4567" value="<%= userData ? (userData.phone || '') : '' %>" required class="form-input" style="width:100%; border:1.5px solid var(--border); padding:0.7rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit; font-size:0.9rem;">
          </div>

          <!-- Special Notes -->
          <div class="field-group" style="margin-bottom:1.4rem;">
            <label class="field-label" style="font-weight:700; color:var(--text-primary); margin-bottom:0.4rem; display:block;">
              Special Requests / Learning Goals
            </label>
            <textarea name="specialNotes" id="enrollSpecialNotes" rows="2" placeholder="Tell the chef what specific skills or recipes you want to master (e.g. perfecting spice balance, knife speed, vegan pastry substitutes)..." class="form-textarea" style="width:100%; border:1.5px solid var(--border); padding:0.7rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit; font-size:0.88rem; resize:vertical;"></textarea>
          </div>

          <!-- Payment / Fee Summary Box -->
          <div style="background:linear-gradient(135deg, #f0f7f0, #e8f3e8); border:1.5px solid #c8dec8; border-radius:var(--radius-md); padding:1.2rem; margin-bottom:1.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
            <div>
              <div style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--accent-green);">Enrollment Fee</div>
              <div id="enrollDisplayPrice" style="font-size:1.4rem; font-weight:800; color:var(--accent-green); margin-top:2px;">
                Select Course
              </div>
              <div id="enrollDisplayDetail" style="font-size:0.78rem; color:var(--text-muted);">Includes chef instruction, course materials &amp; certificate</div>
            </div>

            <!-- Payment Method Select -->
            <div style="min-width:200px;">
              <label style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-primary); display:block; margin-bottom:0.3rem;">Payment Method</label>
              <select name="paymentMethod" id="enrollPaymentMethod" class="form-select" style="border:1px solid #b2cfb2; padding:0.55rem; border-radius:8px; font-size:0.85rem; background:#fff; color:var(--text-primary); outline:none; width:100%;">
                <option value="Card / Online">Card / PayHere Online Payment</option>
                <option value="Cash on Session">Cash at First Class / Session</option>
                <option value="Bank Transfer">Bank Transfer / Deposit</option>
                <% if (userData.subscriptionTier === 'Elite' && userData.hasFreeCourseEnrollment) { %>
                  <option value="Free Credit / Subscription">Use Elite Subscription Free Credit</option>
                <% } %>
              </select>
            </div>
          </div>

          <!-- Hidden fields for submission -->
          <input type="hidden" name="courseTitle" id="enrollSelectedCourseTitle">
          <input type="hidden" name="category" id="enrollSelectedCategory">
          <input type="hidden" name="price" id="enrollSelectedPrice">

          <!-- Submit Button -->
          <div style="display:flex; justify-content:flex-end; gap:0.8rem;">
            <button type="reset" class="btn-outline" style="padding:0.75rem 1.4rem; font-size:0.9rem;" onclick="resetCourseEnrollForm()">
              Clear
            </button>
            <button type="submit" id="enrollSubmitBtn" class="btn-primary" style="padding:0.75rem 2rem; font-size:0.95rem; font-weight:700; display:inline-flex; align-items:center; gap:0.5rem; background:linear-gradient(135deg, var(--accent-green), var(--accent-light)); box-shadow:0 4px 14px rgba(44,95,45,0.25);">
              <span>Confirm &amp; Save Enrollment</span>
            </button>
          </div>

        </form>
      </div>

      <!-- ============================================================ -->
      <!-- MY ENROLLED COURSES TABLE / LIST                             -->
      <!-- ============================================================ -->
      <div class="content-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem; border-bottom:1px solid var(--border); padding-bottom:0.8rem; flex-wrap:wrap; gap:0.5rem;">
          <div>
            <h3 style="margin:0; font-size:1.1rem; color:var(--text-primary);">
              My Enrolled Courses
            </h3>
            <p style="font-size:0.8rem; color:var(--text-muted); margin:0.2rem 0 0 0;">All courses saved in the database under your account.</p>
          </div>
          <span style="font-size:0.82rem; font-weight:700; color:var(--accent-green);">
            Total Enrolled: <%= (typeof myEnrollments !== 'undefined') ? myEnrollments.length : 0 %>
          </span>
        </div>

        <% if (typeof myEnrollments !== 'undefined' && myEnrollments.length > 0) { %>
          <div style="overflow-x:auto;">
            <table class="data-table" style="width:100%; border-collapse:collapse; text-align:left; font-size:0.88rem;">
              <thead>
                <tr style="background:var(--bg-surface); border-bottom:2px solid var(--border);">
                  <th style="padding:0.8rem 1rem; color:var(--text-secondary); font-weight:700;">Course Title</th>
                  <th style="padding:0.8rem 1rem; color:var(--text-secondary); font-weight:700;">Assigned Chef</th>
                  <th style="padding:0.8rem 1rem; color:var(--text-secondary); font-weight:700;">Learning Mode</th>
                  <th style="padding:0.8rem 1rem; color:var(--text-secondary); font-weight:700;">Schedule / Date</th>
                  <th style="padding:0.8rem 1rem; color:var(--text-secondary); font-weight:700;">Fee &amp; Status</th>
                  <th style="padding:0.8rem 1rem; color:var(--text-secondary); font-weight:700; text-align:center;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% myEnrollments.forEach(en => { 
                  const chefObj = en.chefId;
                  const chefName = chefObj ? `Chef ${chefObj.firstName} ${chefObj.lastName}` : 'Assigned Pro Chef';
                  const chefInit = chefObj ? (chefObj.firstName.charAt(0) + chefObj.lastName.charAt(0)).toUpperCase() : 'CP';
                  const dateStr = en.preferredDate ? new Date(en.preferredDate).toLocaleDateString() : 'Flexible';
                  const enrolledDateStr = new Date(en.createdAt).toLocaleDateString();
                %>
                  <tr style="border-bottom:1px solid var(--border); transition:background 0.2s;" onmouseover="this.style.background='var(--bg-surface)'" onmouseout="this.style.background='transparent'">
                    <td style="padding:0.9rem 1rem;">
                      <div style="font-weight:700; color:var(--text-primary);"><%= en.courseTitle %></div>
                      <span class="badge" style="font-size:0.68rem; padding:0.15rem 0.5rem; background:rgba(44,95,45,0.08); color:var(--accent-green); margin-top:3px; display:inline-block;">
                        <%= en.category || 'Culinary' %>
                      </span>
                    </td>
                    <td style="padding:0.9rem 1rem;">
                      <div style="display:flex; align-items:center; gap:0.6rem;">
                        <div style="width:30px; height:30px; border-radius:50%; background:var(--accent-green); color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:700; flex-shrink:0;">
                          <%= chefInit %>
                        </div>
                        <div>
                          <div style="font-weight:600; color:var(--text-primary); font-size:0.85rem;"><%= chefName %></div>
                          <div style="font-size:0.72rem; color:var(--text-muted);"><%= chefObj ? chefObj.city : 'Verified Chef' %></div>
                        </div>
                      </div>
                    </td>
                    <td style="padding:0.9rem 1rem;">
                      <span style="font-size:0.83rem; color:var(--text-primary);"><%= en.learningMode %></span>
                      <div style="font-size:0.72rem; color:var(--text-muted);"><%= en.preferredTime || '' %></div>
                    </td>
                    <td style="padding:0.9rem 1rem;">
                      <div style="font-weight:600; color:var(--text-primary);"><%= dateStr %></div>
                      <div style="font-size:0.72rem; color:var(--text-muted);">Enrolled: <%= enrolledDateStr %></div>
                    </td>
                    <td style="padding:0.9rem 1rem;">
                      <div style="font-weight:700; color:var(--text-primary);">
                        <%= (en.price === 0 || en.paymentStatus === 'Free') ? 'FREE' : 'LKR ' + (en.price || 0).toLocaleString() %>
                      </div>
                      <% if (en.price === 0 || en.paymentStatus === 'Free') { %>
                        <span class="badge badge-green" style="font-size:0.7rem; padding:0.2rem 0.55rem; margin-top:2px; display:inline-block;">● VIP Free Credit</span>
                      <% } else if (en.paymentStatus === 'Paid') { %>
                        <span class="badge badge-green" style="font-size:0.7rem; padding:0.2rem 0.55rem; margin-top:2px; display:inline-block;">● Paid &amp; Enrolled</span>
                      <% } else { %>
                        <span class="badge" style="background:#fff3cd; color:#856404; border:1px solid #ffeeba; font-size:0.7rem; padding:0.2rem 0.55rem; margin-top:2px; display:inline-block; border-radius:12px; font-weight:700;">⏳ Payment Pending</span>
                      <% } %>
                    </td>
                    <td style="padding:0.9rem 1rem; text-align:center;">
                      <% if (en.paymentStatus === 'Paid' || en.price === 0 || en.paymentStatus === 'Free') { %>
                        <button class="btn-outline" style="font-size:0.75rem; padding:0.35rem 0.75rem;" onclick="showToast('✅ Enrollment verified &amp; confirmed!')">
                          View Details
                        </button>
                      <% } else { %>
                        <div style="display:flex; gap:0.4rem; justify-content:center; align-items:center;">
                          <button class="btn-primary" style="font-size:0.75rem; padding:0.35rem 0.75rem; background:#2C5F2D; border:none; border-radius:6px; color:#fff; cursor:pointer; font-weight:700;"
                            data-id="<%= en._id %>"
                            data-title="<%= en.courseTitle %>"
                            data-price="<%= en.price || 100 %>"
                            data-chef="<%= en.chefId ? (en.chefId.firstName + ' ' + en.chefId.lastName) : 'Chef Instructor' %>"
                            onclick="handleCoursePayClick(this)">
                            💳 Pay Now
                          </button>
                          <button class="btn-outline" style="font-size:0.75rem; padding:0.35rem 0.75rem;" onclick="showToast('ℹ️ Please complete payment to unlock full materials.')">
                            Details
                          </button>
                        </div>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div style="text-align:center; padding:3rem 1.5rem; color:var(--text-muted);">
            <div style="font-size:2.8rem; margin-bottom:0.6rem;">🎓</div>
            <h4 style="color:var(--text-primary); font-size:1.05rem; margin-bottom:0.3rem;">No Course Enrollments Yet</h4>
            <p style="font-size:0.85rem; max-width:420px; margin:0 auto 1.2rem;">Choose a course and your preferred instructor chef from the form above to enroll!</p>
          </div>
        <% } %>
      </div>

    </section>





    <!-- ============================================================ -->
    <!--  SECTION 8: INGREDIENT SUGGESTION                             -->
    <!-- ============================================================ -->
    <!-- ============================================================ -->
    <!--  SECTION 8: INGREDIENT SUGGESTION                             -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-ingredients">
      <div class="section-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
        <div>
          <div style="display:inline-flex; align-items:center; gap:0.5rem; background:#fef3e9; color:#e67e22; padding:0.25rem 0.75rem; border-radius:16px; font-size:0.75rem; font-weight:700; margin-bottom:0.4rem; border:1px solid #fbd38d;">
            <span>Gemini AI Culinary Intelligence</span>
            <span>·</span>
            <span>Recipe Generation</span>
          </div>
          <h1 class="section-title"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 2c-5.52 0-10 4.48-10 10s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-2-11c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm4 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6H10v-2h4v2z"/></svg> Ingredient Recipe Assistant</h1>
          <p class="section-subtitle">Enter ingredients available in your pantry or kitchen to get AI-curated gourmet recipes and instructions.</p>
        </div>
      </div>

      <div class="content-card" style="padding:1.6rem; border-radius:16px; border:1px solid #e0ead0; margin-bottom:1.5rem;">
        <h3 style="font-size:1.05rem; color:var(--text-primary); margin:0 0 0.4rem;">Pantry Ingredients</h3>
        <p style="font-size:0.82rem; color:var(--text-muted); margin:0 0 1rem;">Type an ingredient and press Enter, or click the quick-add suggestions below:</p>
        
        <!-- Quick-add suggestion chips -->
        <div style="display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom:1rem;">
          <span style="font-size:0.75rem; font-weight:700; color:#666; align-self:center; margin-right:0.3rem;">Popular:</span>
          <% ['Chicken', 'Eggs', 'Rice', 'Tomato', 'Onion', 'Garlic', 'Coconut Milk', 'Paneer', 'Potatoes', 'Pasta', 'Cheese', 'Curry Leaves'].forEach(item => { %>
            <button type="button" onclick="quickAddIngredient('<%= item %>')" style="background:#f0f7f0; border:1px solid #cbe4cb; color:#2C5F2D; font-size:0.75rem; font-weight:600; padding:0.25rem 0.65rem; border-radius:16px; cursor:pointer; transition:all 0.15s;">
              + <%= item %>
            </button>
          <% }) %>
        </div>

        <div class="ingredient-area">
          <div class="ingredient-tags" id="ingredientTags" style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.8rem; min-height:28px;"></div>
          
          <div class="ingredient-input-row" style="display:flex; gap:0.5rem; margin-bottom:1rem;">
            <input class="ingredient-input form-input" id="ingredientInput" type="text" placeholder="Type ingredient name (e.g. Chicken, Spinach, Soy Sauce, Mushrooms)..." style="flex:1; padding:0.65rem 0.9rem; border:1.5px solid #cbe4cb; border-radius:8px; font-size:0.88rem; outline:none;">
            <button class="btn-outline" onclick="addIngredient()" style="padding:0.65rem 1.2rem; font-weight:700; border-radius:8px;">+ Add</button>
          </div>

          <div style="display:flex; gap:0.8rem; flex-wrap:wrap; align-items:center;">
            <button class="btn-primary" id="btnSuggestRecipes" onclick="suggestRecipesWithGemini()" style="background:#e67e22; border-color:#e67e22; padding:0.75rem 1.6rem; font-weight:700; font-size:0.92rem; border-radius:10px; display:inline-flex; align-items:center; gap:0.5rem; box-shadow:0 3px 10px rgba(230,126,34,0.25);">
              <span>Generate Recipes with AI</span>
            </button>
            <button class="btn-outline" onclick="clearIngredients()" style="font-size:0.82rem; padding:0.65rem 1rem; border-radius:8px;">Clear List</button>
          </div>
        </div>
      </div>

      <!-- Loading State for Recipe Suggestions -->
      <div id="recipeLoadingState" style="display:none; text-align:center; padding:3.5rem 1.5rem; background:#fff; border-radius:16px; border:1px solid #e0ead0; margin-bottom:1.5rem;">
        <div style="display:inline-block; width:44px; height:44px; border:3px solid #f0f7f0; border-top-color:#e67e22; border-radius:50%; animation:spin 0.8s linear infinite; margin-bottom:1rem;"></div>
        <h4 style="color:#1a3a1b; font-size:1.1rem; font-weight:700; margin:0 0 0.3rem;">Curating Recipes with Gemini AI...</h4>
        <p style="font-size:0.82rem; color:#666; margin:0;">Crafting flavor pairings, cooking techniques, and step-by-step instructions for your ingredients.</p>
      </div>

      <!-- Suggested Recipes Cards Output -->
      <div class="content-card" id="recipeResultsCard" style="display:none; padding:1.6rem; border-radius:16px; border:1px solid #e0ead0;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem; border-bottom:1px solid #eef2ee; padding-bottom:0.8rem;">
          <div>
            <h3 style="margin:0; font-size:1.15rem; color:var(--text-primary);">Suggested Gourmet Recipes</h3>
            <p id="recipeResultsSub" style="font-size:0.8rem; color:var(--text-muted); margin:0.2rem 0 0;"></p>
          </div>
          <span style="background:#f0f7f0; color:#2C5F2D; font-size:0.75rem; font-weight:700; padding:0.25rem 0.7rem; border-radius:12px; border:1px solid #cbe4cb;">
            Gemini AI Curated
          </span>
        </div>
        <div class="recipe-results" id="recipeResults" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:1.4rem;"></div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!--  SECTION: AI DIET CLASSIFIER (MACHINE LEARNING POWERED)       -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-diet-classifier">
      <div class="section-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
        <div>
          <div style="display:inline-flex; align-items:center; gap:0.5rem; background:#edf5ed; color:#2C5F2D; padding:0.25rem 0.75rem; border-radius:16px; font-size:0.75rem; font-weight:700; margin-bottom:0.4rem; border:1px solid #d4e7d4; letter-spacing:0.3px;">
