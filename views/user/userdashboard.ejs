// ── Chat Engine (Real-Time Socket + API) ──────────────────────
function openChat(withId, displayName, initial, color) {
  const select = document.getElementById('chatContactDropdown');
  if (select && select.value !== withId) {
    select.value = withId;
  }

  // Update header
  document.getElementById('chatHeaderName').innerHTML =
    `<div style="width:32px;height:32px;border-radius:50%;background:${color};display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.9rem;margin-right:0.5rem;">${initial}</div>${displayName}`;

  // Enable input
  document.getElementById('chatInput').disabled = false;
  document.getElementById('chatSendBtn').disabled = false;
  document.getElementById('chatInput').placeholder = `Message ${displayName}...`;
  document.getElementById('chatInput').focus();

  // Highlight active contact
  document.querySelectorAll('.chat-list-item').forEach(el => el.classList.remove('active'));
  const contactEl = document.getElementById('contact-' + withId);
  if (contactEl) {
    contactEl.classList.add('active');
    contactEl.style.fontWeight = 'normal';
  }

  activeChatWith = withId;
  lastMessageCount = 0;

  loadMessages();
}

async function loadMessages() {
  if (!activeChatWith) return;
  const container = document.getElementById('chatMessages');
  try {
    const res = await fetch('/api/chat/messages/' + activeChatWith);
    const data = await res.json();
    if (!data.success) return;

    const msgs = data.messages || [];
    lastMessageCount = msgs.length;

    const myId = currentUserId;

    if (msgs.length === 0) {
      container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted);"><div style="font-size:2rem;margin-bottom:0.4rem;">👋</div>No messages yet. Send a message to start chatting!</div>';
      return;
    }

    container.innerHTML = msgs.map(m => {
      const sId = (m.senderId && (m.senderId._id || m.senderId.id || m.senderId)).toString();
      const isMine = sId === myId.toString();
      const time = new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      return `<div class="msg-item ${isMine ? 'sent' : 'received'}">
        <p>${escapeHtml(m.content)}</p>
        <div class="msg-time">${time}${isMine ? (m.isRead ? ' · Seen ✓✓' : ' · Sent ✓') : ''}</div>
      </div>`;
    }).join('');

    // Auto-scroll to bottom
    container.scrollTop = container.scrollHeight;
  } catch (err) {
    console.error('Chat load error:', err);
  }
}

async function sendMessage(e) {
  e.preventDefault();
  const input = document.getElementById('chatInput');
  const content = input.value.trim();
  if (!content || !activeChatWith) return;

  input.value = '';

  // 1. Instant optimistic bubble in UI (0ms latency)
  const container = document.getElementById('chatMessages');
  if (container) {
    if (container.innerHTML.includes('No messages yet')) {
      container.innerHTML = '';
    }
    const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const bubble = document.createElement('div');
    bubble.className = 'msg-item sent';
    bubble.innerHTML = `<p>${escapeHtml(content)}</p><div class="msg-time">${time} · Sent ✓</div>`;
    container.appendChild(bubble);
    container.scrollTop = container.scrollHeight;
  }

  // 2. Persist via API (which also broadcasts to receiver's socket room)
  try {
    const res = await fetch('/api/chat/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ receiverId: activeChatWith, content })
    });
    const data = await res.json();
    if (!data.success) {
      showToast('❌ ' + (data.message || 'Failed to send message.'));
    }
  } catch (err) {
    console.error('Send message error:', err);
    showToast('❌ Failed to send message. Please try again.');
  }
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.appendChild(document.createTextNode(text));
  return div.innerHTML;
}

// ── Notification Management ──────────────────────────────────
function filterNotifications(type, btn) {
  document.querySelectorAll('.notif-tab').forEach(b => {
    b.classList.remove('active');
    b.style.background = '#f0f7f0';
    b.style.color = '#1e3d20';
    b.style.border = '1.5px solid #bce2bc';
    b.style.boxShadow = 'none';
    b.style.fontWeight = '700';
  });
  if (btn) {
    btn.classList.add('active');
    btn.style.background = '#2C5F2D';
    btn.style.color = '#ffffff';
    btn.style.border = 'none';
    btn.style.boxShadow = '0 3px 8px rgba(44,95,45,0.25)';
    btn.style.fontWeight = '800';
  }

  const cards = document.querySelectorAll('.notif-item-card');
  cards.forEach(card => {
    if (type === 'all') {
      card.style.display = 'flex';
    } else if (type === 'unread') {
      card.style.display = card.getAttribute('data-read') === 'false' ? 'flex' : 'none';
    } else if (type === 'booking') {
      const cardType = card.getAttribute('data-type');
      card.style.display = (cardType === 'booking' || cardType === 'grocery') ? 'flex' : 'none';
    }
  });
}

async function markNotificationRead(id) {
  try {
    const res = await fetch('/notifications/' + id + '/read', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      const card = document.getElementById('notif-' + id);
      if (card) {
        card.classList.remove('unread');
        card.classList.add('read');
        card.setAttribute('data-read', 'true');
        card.style.borderColor = '#eef2ee';
        const dot = card.querySelector('h4 span');
        if (dot) dot.remove();
        const markBtn = card.querySelector('button[onclick^="markNotificationRead"]');
        if (markBtn) markBtn.remove();
      }
      updateNotificationCounts(-1);
    }
  } catch (err) {
    console.error('Error marking notification as read:', err);
  }
}

async function markAllNotificationsRead() {
  try {
    const res = await fetch('/notifications/read-all', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      document.querySelectorAll('.notif-item-card').forEach(card => {
        card.classList.remove('unread');
        card.classList.add('read');
        card.setAttribute('data-read', 'true');
        card.style.borderColor = '#eef2ee';
        const dot = card.querySelector('h4 span');
        if (dot) dot.remove();
        const markBtn = card.querySelector('button[onclick^="markNotificationRead"]');
        if (markBtn) markBtn.remove();
      });
      const kpi = document.getElementById('kpiUnreadCount');
      if (kpi) kpi.textContent = '0';
      const tab = document.getElementById('tabUnreadCount');
      if (tab) tab.textContent = '0';
      showToast('✅ All notifications marked as read.');
    }
  } catch (err) {
    showToast('❌ Error updating notifications.');
  }
}

function updateNotificationCounts(delta) {
  const kpi = document.getElementById('kpiUnreadCount');
  const tab = document.getElementById('tabUnreadCount');
  if (kpi) {
    const current = Math.max(0, parseInt(kpi.textContent || '0') + delta);
    kpi.textContent = current;
  }
  if (tab) {
    const current = Math.max(0, parseInt(tab.textContent || '0') + delta);
    tab.textContent = current;
  }
}

