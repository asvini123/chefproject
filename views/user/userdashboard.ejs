<!-- TOAST -->
<div class="toast" id="toastMsg" role="alert" aria-live="assertive"></div>

<script>
// ── Global Dashboard & Chat State ─────────────────────────────
const currentUserId = "<%= userData ? userData._id : '' %>";
let activeChatWith = null;
let lastMessageCount = 0;

// ── Dynamic Date & Greeting ───────────────────────────────────
(function() {
  const now = new Date();
  const days   = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const h = now.getHours();

  document.getElementById('dateDay').textContent   = days[now.getDay()];
  document.getElementById('dateNum').textContent   = now.getDate();
  document.getElementById('dateMonth').textContent = months[now.getMonth()] + ' ' + now.getFullYear();

  let greeting;
  if (h < 12)      greeting = '☀️ Good Morning, <%= userData.firstName %>!';
  else if (h < 17) greeting = '🌤️ Good Afternoon, <%= userData.firstName %>!';
  else if (h < 21) greeting = '🌆 Good Evening, <%= userData.firstName %>!';
  else             greeting = '🌙 Good Night, <%= userData.firstName %>!';
  document.getElementById('dynamicGreeting').textContent = greeting;
})();

// ── Quote of the Day ─────────────────────────────────────────
const quotes = [
  '"Good food is the foundation of genuine happiness." — Auguste Escoffier',
  '"Cooking is love made visible." — Unknown',
  '"One cannot think well, love well, sleep well, if one has not dined well." — Virginia Woolf',
  '"The secret ingredient is always love." — Unknown',
  '"Life is too short for bad food." — Unknown',
];
document.getElementById('quoteText').textContent = quotes[new Date().getDay() % quotes.length];

// ── Section Switcher ──────────────────────────────────────────
function showSection(id, link) {
  document.querySelectorAll('.user-section').forEach(s => s.classList.remove('active'));
  const target = document.getElementById('section-' + id);
  if (target) target.classList.add('active');

  document.querySelectorAll('.nav-item').forEach(li => li.classList.remove('active'));
  const parentLi = link?.closest('.nav-item') || document.querySelector(`[data-section="${id}"]`);
  if (parentLi) parentLi.classList.add('active');

  const label = parentLi?.querySelector('.nav-label')?.textContent || id;
  document.getElementById('breadcrumbCurrent').textContent = label;

  window.location.hash = id;

  if (id === 'chat' && !activeChatWith) {
    setTimeout(() => {
      openChat('admin', 'Admin Support', 'A', 'var(--forest-green)');
    }, 150);
  }

  if (window.innerWidth < 900) closeSidebar();
  return false;
}

window.addEventListener('DOMContentLoaded', () => {
  const hash = window.location.hash.replace('#', '');
  const urlParams = new URLSearchParams(window.location.search);
  const chatWithId = urlParams.get('chatWith');
  const chatName = urlParams.get('chatName') || 'Chef';
  const chatInitial = urlParams.get('chatInitial') || 'C';

  if (chatWithId) {
    // Navigate to chat section first
    showSection('chat');
    // Wait a tick for DOM to be ready, then open the specific chef chat
    setTimeout(() => {
      openChat(chatWithId, chatName, chatInitial, 'var(--accent-gold)');
    }, 300);
  } else if (hash) {
    showSection(hash);
    if (hash === 'chat' && !activeChatWith) {
      setTimeout(() => {
        openChat('admin', 'Admin Support', 'A', 'var(--forest-green)');
      }, 200);
    }
  }

  // Pre-calculate and display live diet scores immediately
  if (typeof classifyDietWithAI === 'function') {
    classifyDietWithAI();
  }

  // Initialize 6-cards per page pagination for Book New Chef
  if (typeof filterChefs === 'function') {
    filterChefs(1);
  }
});

// ── Sidebar ───────────────────────────────────────────────────
const sidebar  = document.getElementById('userSidebar');
const overlay  = document.getElementById('sidebarOverlay');
const hamburger = document.getElementById('hamburgerBtn');
const sidebarClose = document.getElementById('sidebarClose');
hamburger.addEventListener('click', () => { sidebar.classList.add('open'); overlay.classList.add('active'); });
overlay.addEventListener('click', closeSidebar);
sidebarClose.addEventListener('click', closeSidebar);
function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('active'); }

// ── Tab Switcher (Bookings) ──────────────────────────────────
function switchTab(btn, panelId) {
  btn.closest('.user-section').querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  btn.closest('.user-section').querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  const panel = document.getElementById('tab-' + panelId);
  if (panel) panel.classList.add('active');
  if (panelId === 'upcoming' || panelId === 'completed' || panelId === 'cancelled') {
    filterBookings();
  }
}

function filterBookings() {
  const type = document.getElementById('bookingTypeFilter').value;
  const date = document.getElementById('bookingDateFilter').value;
  
  const cards = document.querySelectorAll('.tab-panel.active .booking-card');
  cards.forEach(card => {
    let show = true;
    if (type && card.getAttribute('data-type') !== type) show = false;
    if (date && card.getAttribute('data-date') !== date) show = false;
    card.style.display = show ? 'flex' : 'none';
  });
}

function resetBookingsFilter() {
  document.getElementById('bookingTypeFilter').value = '';
  document.getElementById('bookingDateFilter').value = '';
  const cards = document.querySelectorAll('.booking-card');
  cards.forEach(card => card.style.display = 'flex');
}

// ── Chef Search, Filter & 6-Cards Pagination ──────────────────
let currentChefPage = 1;
const CHEFS_PER_PAGE = 6;

function filterChefs(targetPage = 1) {
  currentChefPage = targetPage;
  const normalize = (s) => (s || '').toString().toLowerCase().replace(/[_-]/g, ' ').trim();

  const search = normalize(document.getElementById('chefSearch')?.value);
  const cuisine = normalize(document.getElementById('chefCuisineFilter')?.value);
  const price = parseFloat(document.getElementById('chefPriceFilter')?.value) || 0;
  const location = normalize(document.getElementById('chefLocationFilter')?.value);

  const cards = Array.from(document.querySelectorAll('#chefSearchResults .chef-card'));
  const visibleCards = [];

  cards.forEach(card => {
    const cName = normalize(card.getAttribute('data-name'));
    const cCuisine = normalize(card.getAttribute('data-cuisine')) + ' ' + normalize(card.textContent);
    const cCity = normalize(card.getAttribute('data-city')) + ' ' + normalize(card.textContent);
    const cPrice = parseFloat(card.getAttribute('data-price')) || 0;

    let match = true;
    if (search && !cName.includes(search) && !cCuisine.includes(search) && !cCity.includes(search)) match = false;
    if (cuisine && !cCuisine.includes(cuisine)) match = false;
    if (location && !cCity.includes(location)) match = false;
    if (price === 2000 && cPrice > 2000) match = false;
    if (price === 5000 && (cPrice < 2000 || cPrice > 5000)) match = false;
    if (price === 5001 && cPrice <= 5000) match = false;

    if (match) {
      visibleCards.push(card);
    } else {
      card.style.display = 'none';
    }
  });

  const noResults = document.getElementById('noResultsMsg');
  if (visibleCards.length === 0 && cards.length > 0) {
    if (!noResults) {
      document.getElementById('chefSearchResults')?.insertAdjacentHTML('beforeend', '<div id="noResultsMsg" style="grid-column: 1 / -1; text-align: center; padding: 3rem; color: #888; font-size: 1rem;">No chefs found matching your criteria.</div>');
    } else {
      noResults.style.display = 'block';
    }
  } else if (noResults) {
    noResults.style.display = 'none';
  }

  const totalPages = Math.ceil(visibleCards.length / CHEFS_PER_PAGE) || 1;
  if (currentChefPage > totalPages) currentChefPage = totalPages;
  if (currentChefPage < 1) currentChefPage = 1;

  const startIdx = (currentChefPage - 1) * CHEFS_PER_PAGE;
  const endIdx = startIdx + CHEFS_PER_PAGE;

  visibleCards.forEach((card, idx) => {
    if (idx >= startIdx && idx < endIdx) {
      card.style.display = 'flex';
    } else {
      card.style.display = 'none';
    }
  });

  renderChefPagination(totalPages);
}

function renderChefPagination(totalPages) {
  const container = document.getElementById('paginationControls');
  if (!container) return;

  if (totalPages <= 1) {
    container.innerHTML = '';
    return;
  }

  let html = `<button type="button" onclick="filterChefs(${currentChefPage - 1})" class="btn-outline" style="padding:0.45rem 0.9rem; border-radius:8px; font-weight:700; cursor:pointer; background:#fff; border:1px solid #cbe4cb; color:#1a3a1b;" ${currentChefPage === 1 ? 'disabled style="opacity:0.5; cursor:not-allowed;"' : ''}>&larr; Prev</button>`;
  
  for (let i = 1; i <= totalPages; i++) {
    const activeStyle = i === currentChefPage 
      ? 'background: #2C5F2D; color: white; border-color: #2C5F2D;' 
      : 'background: white; color: #1a3a1b; border-color: #cbe4cb;';
    html += `<button type="button" onclick="filterChefs(${i})" style="padding:0.45rem 0.85rem; border-radius:8px; font-weight:700; cursor:pointer; border:1.5px solid; ${activeStyle}">${i}</button>`;
  }

  html += `<button type="button" onclick="filterChefs(${currentChefPage + 1})" class="btn-outline" style="padding:0.45rem 0.9rem; border-radius:8px; font-weight:700; cursor:pointer; background:#fff; border:1px solid #cbe4cb; color:#1a3a1b;" ${currentChefPage === totalPages ? 'disabled style="opacity:0.5; cursor:not-allowed;"' : ''}>Next &rarr;</button>`;
  container.innerHTML = html;
}

// ── Ingredient Suggestion with Gemini AI ─────────────────────
const userIngredients = [];

function addIngredient() {
  const input = document.getElementById('ingredientInput');
  if (!input) return;
  const val = input.value.trim();
  if (!val) return;
  if (!userIngredients.some(i => i.toLowerCase() === val.toLowerCase())) {
    userIngredients.push(val);
    renderIngredientTags();
  }
  input.value = '';
}

function quickAddIngredient(name) {
  if (!userIngredients.some(i => i.toLowerCase() === name.toLowerCase())) {
    userIngredients.push(name);
    renderIngredientTags();
    showToast(`Added ${name} to pantry list.`);
  }
}

function removeIngredient(idx) {
  userIngredients.splice(idx, 1);
  renderIngredientTags();
}

function clearIngredients() {
  userIngredients.length = 0;
  renderIngredientTags();
  const card = document.getElementById('recipeResultsCard');
  if (card) card.style.display = 'none';
  showToast('Pantry ingredient list cleared.');
}

function renderIngredientTags() {
  const container = document.getElementById('ingredientTags');
  if (!container) return;
  if (userIngredients.length === 0) {
    container.innerHTML = '<span style="font-size:0.8rem; color:#999; font-style:italic;">No ingredients added yet. Add ingredients above.</span>';
    return;
  }
  container.innerHTML = userIngredients.map((ing, i) =>
    `<div style="display:inline-flex; align-items:center; gap:0.4rem; background:#f0f7f0; color:#2C5F2D; border:1px solid #cbe4cb; font-size:0.82rem; font-weight:700; padding:0.25rem 0.65rem; border-radius:16px;">
      <span>${ing}</span>
      <span onclick="removeIngredient(${i})" style="cursor:pointer; color:#dc2626; font-size:0.9rem; font-weight:800; line-height:1; margin-left:2px;">✕</span>
    </div>`
  ).join('');
}

document.addEventListener('DOMContentLoaded', () => {
  const ingInput = document.getElementById('ingredientInput');
  if (ingInput) {
    ingInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        e.preventDefault();
        addIngredient();
      }
    });
  }
  renderIngredientTags();
});

