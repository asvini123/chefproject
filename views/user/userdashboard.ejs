                  <input type="number" id="dietFatNum" value="" placeholder="—" readonly class="form-input" style="width:65px; text-align:center; font-weight:800; font-size:0.95rem; padding:0.35rem; border-radius:8px; border:1.5px solid #cbe4cb; background:#ffffff; color:#2C5F2D; cursor:not-allowed;">
