  // Card number formatter — adds single space every 4 digits (max 16 digits)
  function formatCardNumber(input) {
    let val = input.value.replace(/\D/g, '').substring(0, 16);
    input.value = val.replace(/(\d{4})(?=\d)/g, '$1 ');
    // Detect card type icon
    const icon = document.getElementById('pmCardIcon');
    if (val.startsWith('4')) icon.textContent = '💳'; // Visa
    else if (/^5[1-5]/.test(val)) icon.textContent = '💳'; // Mastercard
    else if (/^3[47]/.test(val)) icon.textContent = '💳'; // Amex
    else icon.textContent = '💳';
  }

  // Expiry formatter — adds " / " after MM
  function formatExpiry(input) {
    let val = input.value.replace(/\D/g, '').substring(0, 4);
    if (val.length >= 3) val = val.substring(0, 2) + ' / ' + val.substring(2);
    input.value = val;
  }

  async function processPayment(e) {
    e.preventDefault();
    const tier   = document.getElementById('pmTier').value;
    const amount = document.getElementById('pmAmount').value;
    const name   = document.getElementById('pmName').value.trim();
    const card   = document.getElementById('pmCardNum').value.replace(/\s/g,'');
    const expiry = document.getElementById('pmExpiry').value.trim();
    const cvv    = document.getElementById('pmCVV').value.trim();
    const errEl  = document.getElementById('pmError');
    const btn    = document.getElementById('pmSubmitBtn');

    // ── Strict Card & Payment Validation ──
    errEl.style.display = 'none';
    if (name.length < 3) {
      errEl.textContent = '❌ Please enter the full cardholder name.';
      errEl.style.display = 'block';
      document.getElementById('pmName').focus();
      return;
    }
    if (!/^\d{16}$/.test(card)) {
      errEl.textContent = `❌ Card number must be exactly 16 digits (You typed ${card.length} digits).`;
      errEl.style.display = 'block';
      document.getElementById('pmCardNum').focus();
      return;
    }
    if (!/^(0[1-9]|1[0-2])\s*\/\s*\d{2}$/.test(expiry)) {
      errEl.textContent = '❌ Enter a valid expiry date (MM / YY).';
