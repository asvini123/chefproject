async function submitCourseEnrollment(e) {
  e.preventDefault();
  const form = document.getElementById('courseEnrollmentForm');
  const courseSelect = document.getElementById('enrollCourseSelect');
  const courseId = courseSelect.value;
  const courseTitle = document.getElementById('enrollSelectedCourseTitle').value || (courseSelect.selectedOptions[0] ? courseSelect.selectedOptions[0].text.split('—')[0].trim() : '');
  const category = document.getElementById('enrollSelectedCategory').value || 'Cuisine';
  const price = courseSelect.selectedOptions[0] ? (parseInt(courseSelect.selectedOptions[0].getAttribute('data-price')) || 0) : 0;
  const chefId = document.getElementById('enrollChefSelect').value;
  const phone = document.getElementById('enrollPhone') ? document.getElementById('enrollPhone').value.trim() : '';
  const learningMode = document.getElementById('enrollLearningMode').value;
  const preferredTime = document.getElementById('enrollPreferredTime').value;
  const preferredDate = document.getElementById('enrollPreferredDate').value;
  const dietaryPreference = document.getElementById('enrollDietary').value;
  const specialNotes = document.getElementById('enrollSpecialNotes').value;
  const paymentMethod = document.getElementById('enrollPaymentMethod').value;

  if (!courseId || !courseTitle) {
    showToast('⚠️ Please select a course to enroll in.');
    document.getElementById('enrollCourseSelect').focus();
    return;
  }

  if (!chefId) {
    showToast('⚠️ Please choose a real instructor chef from the dropdown.');
    document.getElementById('enrollChefSelect').focus();
    return;
  }

  if (!phone) {
    showToast('⚠️ Please enter your contact phone number.');
    document.getElementById('enrollPhone')?.focus();
    return;
  }

  const btn = document.getElementById('enrollSubmitBtn');
  const origText = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span>⏳ Saving Enrollment...</span>';

  try {
    const res = await fetch('/user/course/enroll', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        courseId,
        courseTitle,
        category,
        price,
        phone,
        chefId,
        learningMode,
        preferredDate,
        preferredTime,
        dietaryPreference,
        specialNotes,
        paymentMethod
      })
    });

    const data = await res.json();

    if (data.success) {
      btn.innerHTML = '<span>✅ Enrollment Saved!</span>';
      btn.style.background = '#27ae60';
      showToast(data.message || '🎉 Enrollment saved in database successfully!');
      setTimeout(() => {
        location.reload();
      }, 1600);
    } else {
      btn.disabled = false;
      btn.innerHTML = origText;
      showToast('❌ ' + (data.message || 'Error enrolling in course.'));
    }
  } catch (err) {
    console.error('Enrollment error:', err);
    btn.disabled = false;
    btn.innerHTML = origText;
    showToast('❌ Server error while saving enrollment.');
  }
}



