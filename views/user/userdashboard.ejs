let lastGeneratedRecipes = [];

function saveGeneratedRecipe(index, btn) {
  const r = lastGeneratedRecipes[index];
  if (!r) {
    showToast('⚠️ Could not find recipe details to save.');
    return;
  }
  let saved = [];
  try { saved = JSON.parse(localStorage.getItem('savedAiRecipes') || '[]'); } catch(e){}
  
  const alreadyExists = saved.some(item => item.title === r.title);
  if (!alreadyExists) {
    saved.unshift(r);
    localStorage.setItem('savedAiRecipes', JSON.stringify(saved));
  }

  if (btn) {
    btn.innerHTML = '❤️ Saved!';
    btn.style.background = '#e8f5e9';
    btn.style.color = '#2e7d32';
    btn.style.borderColor = '#81c784';
  }
  showToast('✅ Recipe saved to your Saved Chefs & Recipes collection!');
  renderSavedRecipes();
}

