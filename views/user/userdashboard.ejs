            </div>
            <% if (userData.subscriptionTier === 'Elite' && userData.hasFreeCourseEnrollment) { %>
              <div style="background:#FFF8E7; border:1px solid var(--accent-gold); padding:0.3rem 0.7rem; border-radius:20px; font-size:0.75rem; font-weight:700; color:var(--accent-gold);">
