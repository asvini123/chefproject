      <!-- Main Dual-Column Grid -->
      <div style="display:grid; grid-template-columns: 1.1fr 1fr; gap:1.4rem; margin-bottom:2rem; align-items:start; width:100%; max-width:100%; box-sizing:border-box;" class="diet-classifier-grid">
        
        <!-- Left Column: Input Form & Modes -->
