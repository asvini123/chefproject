                    <svg style="width:14px;height:14px;fill:#f59e0b;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> 4.9
                  </div>
                  <div style="font-weight:800; font-size:1rem; color:var(--text-primary);">LKR <%= chefRate.toLocaleString() %>/hr</div>
                </div>
              </div>
              <div class="chef-card-footer" style="display:flex; gap:0.5rem; padding:0 1.2rem 1.2rem; align-items:center;">
                <button class="btn-primary" onclick="window.location.href='/chefs/<%= chef._id %>'" style="flex:1; padding:0.65rem 1rem; font-size:0.86rem; border-radius:8px; display:flex; align-items:center; justify-content:center; gap:0.4rem; height:38px;">
                  <svg style="width:14px;height:14px;fill:#fff;" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
                  Book
                </button>
                <button onclick="toggleSaveChef('<%= chef._id %>', true)" style="background:#fee2e2; border:1px solid #fca5a5; color:#dc2626; border-radius:8px; width:38px; height:38px; display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;" title="Remove from Saved">
                  <svg style="width:16px;height:16px;fill:#dc2626;" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                </button>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 3.5rem 2rem; color: var(--text-muted); background:#fff; border-radius:14px; border:1px dashed #d4ebd4;">
