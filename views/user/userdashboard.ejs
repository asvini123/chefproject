            <select id="classifierDishSelect" class="form-select" onchange="onDishSelectForClassifier(this)" style="width:100%; box-sizing:border-box; border:1.5px solid #2C5F2D; padding:0.6rem 0.85rem; border-radius:9px; font-size:0.86rem; outline:none; background:#ffffff; font-family:inherit; color:#1a3a1b; font-weight:600; cursor:pointer; box-shadow:0 2px 6px rgba(44,95,45,0.05);">
              <option value="">-- Choose Food from Catalog (9,000+ Items) --</option>
