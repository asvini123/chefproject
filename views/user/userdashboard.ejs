              <li style="display:flex; align-items:center; gap:0.5rem;"><svg style="width:14px;height:14px;fill:var(--accent-green);" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> <strong>2 Free</strong> Urgent Bookings / mo</li>
              <li style="display:flex; align-items:center; gap:0.5rem;"><svg style="width:14px;height:14px;fill:var(--accent-green);" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Priority Customer Concierge</li>
              <li style="display:flex; align-items:center; gap:0.5rem;"><svg style="width:14px;height:14px;fill:var(--accent-green);" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Unlimited Booking Requests</li>
            </ul>
