                </div>
                <div style="display:flex; align-items:center; gap:0.3rem;">
                  <input type="number" id="dietSugarNum" value="" placeholder="—" readonly class="form-input" style="width:65px; text-align:center; font-weight:800; font-size:0.95rem; padding:0.35rem; border-radius:8px; border:1.5px solid #cbe4cb; background:#ffffff; color:#2C5F2D; cursor:not-allowed;">
                  <span style="font-size:0.8rem; color:#555; font-weight:700;">g</span>
                </div>
