      <div class="section-header">
        <h1 class="section-title"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg> Payments</h1>
        <p class="section-subtitle">View payment history, pay pending bills, and download invoices.</p>
      </div>
      <% 
        let totalSpent = 0;
        if (typeof receipts !== 'undefined') {
          totalSpent = receipts.reduce((acc, curr) => acc + (curr.amountPaid || 0), 0);
        }
        let transactionsCount = typeof receipts !== 'undefined' ? receipts.length : 0;
        let pendingBookingsAmt = bookings.filter(b => b.paymentStatus !== 'Paid' && b.paymentStatus !== 'Completed').reduce((acc, curr) => acc + (curr.totalAmount || 0), 0);
        const allUserEnrollments = typeof myEnrollments !== 'undefined' ? myEnrollments : (typeof enrollments !== 'undefined' ? enrollments : []);
        let pendingCoursesAmt = allUserEnrollments.filter(e => e.price > 0 && e.paymentStatus !== 'Paid' && e.paymentStatus !== 'Free').reduce((acc, curr) => acc + (curr.price || 0), 0);
        let pendingPayments = pendingBookingsAmt + pendingCoursesAmt;
        let invoicesCount = transactionsCount;
      %>
      <div class="payment-summary-row">
        <div class="payment-stat"><div class="pval">LKR <%= totalSpent.toLocaleString() %></div><div class="plbl">Total Spent</div></div>
        <div class="payment-stat"><div class="pval"><%= transactionsCount %></div><div class="plbl">Transactions</div></div>
        <div class="payment-stat"><div class="pval">LKR <%= pendingPayments.toLocaleString() %></div><div class="plbl">Pending</div></div>
        <div class="payment-stat"><div class="pval"><%= invoicesCount %></div><div class="plbl">Invoices</div></div>
      </div>
      <!-- Interactive PayHere & Booking Settlement Card -->
      <div class="content-card" style="margin-bottom: 1.8rem; border-left: 4px solid #2C5F2D;">
        <h3 style="display:flex; align-items:center; gap:0.5rem; color:#1a3a1b; margin-bottom:0.4rem;">
          <span>💳</span> Pay &amp; Settle Booking Payment
        </h3>
        <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1.2rem;">Choose your active booking and select your preferred payment method (PayHere, Cash on Delivery, or Bank Transfer).</p>

        <% const payableBookings = bookings.filter(b => b.status === 'Accepted' || b.paymentStatus !== 'Completed'); %>
        <% if (payableBookings.length > 0) { %>
          <div style="background:#f4fbf4; border:1.5px solid #c8e6c9; border-radius:12px; padding:1.2rem; margin-bottom:1.2rem;">
            <div class="field-group" style="margin-bottom:1rem;">
              <label class="field-label" style="font-weight:800; color:#1a3a1b; display:block; margin-bottom:0.35rem;">1. Select Booking to Pay:</label>
              <select id="payBookingSelect" class="form-input" onchange="onBookingSelectChange(this)" style="font-weight:700; color:#1a3a1b; width:100%; padding:0.65rem 0.9rem;">
                <% payableBookings.forEach((b, idx) => { %>
                  <% const hAmt = Math.round(b.totalAmount * 0.5); %>
                  <% const cName = b.chefId ? `Chef ${b.chefId.firstName} ${b.chefId.lastName}` : 'Chef'; %>
                  <option value="<%= b._id %>" data-total="<%= b.totalAmount %>" data-half="<%= hAmt %>" data-chef="<%= cName %>" data-dish="<%= b.foodName || (b.menu && b.menu[0]) || 'Chef Dish' %>" data-halfpaid="<%= b.halfPaymentPaid ? 'true' : 'false' %>">
                    #<%= b._id.toString().slice(-6).toUpperCase() %> — <%= cName %> | <%= b.foodName || 'Chef Dish' %> (Total: LKR <%= b.totalAmount.toLocaleString() %> <%= b.halfPaymentPaid ? '· 50% Paid' : ('· 50% Due: LKR ' + hAmt.toLocaleString()) %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Booking Summary Box -->
            <div id="bookingSummaryBox" style="background:#fff; border:1px solid #ddecdd; border-radius:8px; padding:0.85rem 1rem; margin-bottom:1.2rem; display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.6rem; font-size:0.86rem;">
              <div><strong>👨‍🍳 Chef:</strong> <span id="summaryChefName">—</span></div>
              <div><strong>🍽️ Dish:</strong> <span id="summaryDishName">—</span></div>
              <div><strong>💰 Total Bill:</strong> <strong id="summaryTotalAmount" style="color:#2C5F2D;">LKR 0</strong></div>
              <div><strong>💳 50% Deposit:</strong> <strong id="summaryHalfAmount" style="color:#c2410c;">LKR 0</strong></div>
            </div>

            <!-- Payment Method Selector -->
            <div class="field-group" style="margin-bottom:1.2rem;">
              <label class="field-label" style="font-weight:800; color:#1a3a1b; margin-bottom:0.45rem; display:block;">2. Choose Payment Method:</label>
              <select id="payMethodSelect" class="form-input" onchange="onPaymentMethodSelect(this.value)" style="font-weight:700; color:#2C5F2D; font-size:0.95rem; width:100%; padding:0.65rem 0.9rem;">
                <option value="Credit / Debit (PayHere)">💳 Credit / Debit Card (Instant PayHere)</option>
                <option value="Cash on Delivery">💵 Cash on Delivery (Cash in hand to Chef on arrival)</option>
                <option value="Bank Transfer">🏦 Bank Transfer (Transfer to Escrow on/before booking date)</option>
              </select>
            </div>

            <!-- Method Info Callouts -->
            <div id="infoPayHere" style="background:#e8f5e9; border:1px solid #a5d6a7; border-radius:8px; padding:0.8rem 1rem; margin-bottom:1rem; font-size:0.84rem; color:#1b5e20;">
              ✨ <strong>PayHere Instant Payment:</strong> Pay securely using your Credit or Debit Card. Your payment is processed instantly and receipt generated.
            </div>

            <div id="infoCash" style="display:none; background:#fff8e1; border:1px solid #ffe082; border-radius:8px; padding:0.8rem 1rem; margin-bottom:1rem; font-size:0.84rem; color:#b45309;">
              💵 <strong>Cash on Delivery:</strong> You can pay directly in cash to the Chef when they arrive at your location. Please keep the exact cash ready.
            </div>

            <div id="infoBank" style="display:none; background:#f0f9ff; border:1px solid #bae6fd; border-radius:8px; padding:0.8rem 1rem; margin-bottom:1rem; font-size:0.84rem; color:#0369a1;">
              🏦 <strong>Bank Transfer:</strong> Please transfer the 50% advance deposit to ChefNest Escrow on/before your booking date. Use the upload form below to submit your slip.
            </div>

            <!-- Action Buttons Row -->
            <div style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center; justify-content:space-between; margin-top:1rem;">
              <button type="button" id="btnExecutePayment" onclick="executeSelectedPayment()" class="btn-primary" style="padding:0.75rem 1.6rem; font-size:0.95rem; font-weight:800; border-radius:8px; cursor:pointer;">
                🚀 Pay via PayHere
              </button>
              <a id="btnDownloadSelectedInvoice" href="#" target="_blank" class="action-btn" style="background:#fff; border:1.5px solid #2C5F2D; color:#2C5F2D; font-weight:700; text-decoration:none; padding:0.65rem 1.2rem; border-radius:8px; display:inline-flex; align-items:center; gap:0.4rem;">
                📄 Download Official PDF Invoice
              </a>
            </div>
          </div>
        <% } else { %>
          <div style="padding:1.5rem; text-align:center; color:var(--text-muted); background:#f9faf9; border-radius:10px; border:1px dashed #d0ddd0;">
            ✓ All your bookings are currently paid and settled.
          </div>
        <% } %>

        <!-- MANDATORY WARNING FOR ALL CLIENTS -->
        <div style="background:#fffbeb; border:1.5px solid #fde68a; border-left:4.5px solid #f59e0b; border-radius:10px; padding:1rem 1.2rem; margin-top:1.2rem; font-size:0.86rem; color:#92400e; line-height:1.55;">
          <strong style="color:#b45309; font-size:0.92rem; display:flex; align-items:center; gap:0.4rem; margin-bottom:0.3rem;">
            <span>⚠️</span> MANDATORY: Show Booking Invoice to Chef on Arrival
          </strong>
          Please download your official Booking Invoice/Confirmation (PDF) and keep it on your phone or print a physical copy. <strong>You MUST show this booking invoice to the Chef when they arrive at your location before cooking begins.</strong>
        </div>

      </div>

      <!-- ============================================================ -->
      <!-- Interactive Cooking Masterclass Course Settlement Card       -->
      <!-- ============================================================ -->
      <div class="content-card" style="margin-bottom: 1.8rem; border-left: 4px solid #1976d2;">
        <h3 style="display:flex; align-items:center; gap:0.5rem; color:#0d47a1; margin-bottom:0.4rem;">
          <span>🎓</span> Pay &amp; Settle Cooking Masterclass Course Fee
        </h3>
        <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1.2rem;">Choose your enrolled masterclass and select your preferred payment method (PayHere or Bank Transfer).</p>

        <% const allCoursesList = (typeof myEnrollments !== 'undefined' ? myEnrollments : (typeof enrollments !== 'undefined' ? enrollments : [])); %>
        <% const payableCourses = allCoursesList.filter(e => e.price > 0 && e.paymentStatus !== 'Free'); %>
        <% if (payableCourses.length > 0) { %>
          <div style="background:#f0f7fc; border:1.5px solid #bbdefb; border-radius:12px; padding:1.2rem; margin-bottom:1.2rem;">
            <div class="field-group" style="margin-bottom:1rem;">
              <label class="field-label" style="font-weight:800; color:#0d47a1; display:block; margin-bottom:0.35rem;">1. Select Masterclass Course to Pay:</label>
              <select id="payCourseSelect" class="form-input" onchange="onCourseSelectChange(this)" style="font-weight:700; color:#0d47a1; width:100%; padding:0.65rem 0.9rem;">
                <% payableCourses.forEach((c, idx) => { %>
                  <% const cChef = c.chefId ? `Chef ${c.chefId.firstName} ${c.chefId.lastName}` : 'Instructor Chef'; %>
                  <option value="<%= c._id %>" data-title="<%= c.courseTitle %>" data-price="<%= c.price || 100 %>" data-chef="<%= cChef %>" data-mode="<%= c.learningMode %>" data-status="<%= c.paymentStatus || 'Pending' %>">
                    #<%= c._id.toString().slice(-6).toUpperCase() %> — <%= c.courseTitle %> (<%= cChef %> · LKR <%= (c.price || 100).toLocaleString() %> · <%= c.paymentStatus === 'Paid' ? 'PAID ✅' : 'PENDING ⏳' %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Course Summary Box -->
            <div id="courseSummaryBox" style="background:#fff; border:1px solid #cce3f5; border-radius:8px; padding:0.85rem 1rem; margin-bottom:1.2rem; display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.6rem; font-size:0.86rem;">
              <div><strong>👨‍🍳 Instructor:</strong> <span id="summaryCourseChef">—</span></div>
              <div><strong>🎓 Learning Mode:</strong> <span id="summaryCourseMode">—</span></div>
              <div><strong>💰 Course Fee:</strong> <strong id="summaryCourseFee" style="color:#0d47a1;">LKR 0</strong></div>
              <div><strong>💳 Payment Status:</strong> <span id="summaryCourseStatus" class="badge" style="font-size:0.75rem; padding:0.2rem 0.55rem; background:#fff3cd; color:#856404; font-weight:700;">⏳ Payment Pending</span></div>
            </div>

            <!-- Course Payment Method Selector -->
            <div class="field-group" style="margin-bottom:1.2rem;">
              <label class="field-label" style="font-weight:800; color:#0d47a1; margin-bottom:0.45rem; display:block;">2. Choose Payment Method:</label>
              <select id="payCourseMethodSelect" class="form-input" onchange="onCoursePaymentMethodSelect(this.value)" style="font-weight:700; color:#0d47a1; font-size:0.95rem; width:100%; padding:0.65rem 0.9rem;">
                <option value="PayHere">💳 Credit / Debit Card (Instant PayHere)</option>
                <option value="Bank Transfer">🏦 Bank Transfer (Upload Receipt Slip)</option>
              </select>
            </div>

            <!-- Method Info Callouts -->
            <div id="infoCoursePayHere" style="background:#e8f5e9; border:1px solid #a5d6a7; border-radius:8px; padding:0.8rem 1rem; margin-bottom:1rem; font-size:0.84rem; color:#1b5e20;">
              ✨ <strong>PayHere Instant Payment:</strong> Pay securely using your Credit or Debit Card. Course access is unlocked instantly and receipt generated.
            </div>

            <div id="infoCourseBank" style="display:none; background:#FFF8E7; border:1px solid #ffeeba; border-radius:8px; padding:0.9rem 1rem; margin-bottom:1rem; font-size:0.84rem; color:#856404;">
              <strong>🏦 ChefNest Bank Account Details:</strong> Bank: Commercial Bank PLC · Account: 1000847291 · Branch: Colombo City
              <div style="margin-top:0.8rem; display:grid; grid-template-columns:1fr 1fr; gap:0.8rem;">
                <div>
                  <label style="font-size:0.75rem; font-weight:700; display:block; margin-bottom:0.3rem; color:#4a5a4a;">Slip Reference No *</label>
                  <input type="text" id="sectionCourseBankRef" placeholder="e.g. SLIP-984210" style="width:100%; padding:0.55rem 0.8rem; border:1px solid #ddd; border-radius:6px; font-size:0.85rem; outline:none;">
                </div>
                <div>
                  <label style="font-size:0.75rem; font-weight:700; display:block; margin-bottom:0.3rem; color:#4a5a4a;">Upload Slip (Image/PDF) *</label>
                  <input type="file" id="sectionCourseBankFile" accept="image/*,application/pdf" style="width:100%; padding:0.45rem; border:1px dashed #0d47a1; border-radius:6px; font-size:0.78rem; background:#fff;">
                </div>
              </div>
            </div>

            <!-- Action Buttons Row -->
            <div style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center; justify-content:space-between; margin-top:1rem;">
              <button type="button" id="btnExecuteCoursePayment" onclick="executeSelectedCoursePayment()" class="btn-primary" style="padding:0.75rem 1.6rem; font-size:0.95rem; font-weight:800; border-radius:8px; cursor:pointer; background:#0d47a1; border-color:#0d47a1;">
                🚀 Pay via PayHere
              </button>
              <button type="button" onclick="showToast('ℹ️ Course syllabus & instructions sent to your registered email.')" class="action-btn" style="background:#fff; border:1.5px solid #0d47a1; color:#0d47a1; font-weight:700; padding:0.65rem 1.2rem; border-radius:8px; display:inline-flex; align-items:center; gap:0.4rem; cursor:pointer;">
                📄 Course Curriculum &amp; Syllabus
              </button>
            </div>
          </div>
        <% } else { %>
          <div style="padding:1.5rem; text-align:center; color:var(--text-muted); background:#f9faf9; border-radius:10px; border:1px dashed #d0ddd0;">
            ✓ No masterclass course payments due at this time.
          </div>
        <% } %>
      </div>

      <div class="content-card">
        <h3>Payment History &amp; Receipts</h3>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th>ID</th><th>Booking / Service</th><th>Amount</th><th>Method</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
              <% if (typeof receipts !== 'undefined' && receipts.length > 0) { %>
                <% receipts.forEach(r => { %>
                  <tr>
                    <td><strong style="font-family:monospace; color:#2C5F2D;">#<%= r.transactionId %></strong></td>
                    <td>
                      <% if (r.bookingId) { %>
                        <div style="font-weight:700; color:var(--text-primary);">
                          <%= r.bookingId.chefId ? `Chef ${r.bookingId.chefId.firstName} ${r.bookingId.chefId.lastName}` : (r.chefName || 'Private Chef Booking') %>
                          <%= r.bookingId.cuisine ? ` · ${r.bookingId.cuisine}` : '' %>
                        </div>
                        <span class="badge" style="background:#eef7ee; color:#2C5F2D; font-size:0.7rem; padding:0.15rem 0.5rem; border-radius:10px;">Chef Booking</span>
                      <% } else if (r.chefName && (r.chefName.startsWith('Course:') || r.transactionId.startsWith('TXN-CRS-'))) { %>
                        <div style="font-weight:700; color:var(--text-primary);"><%= r.chefName %></div>
                        <span class="badge" style="background:#e8f4fd; color:#1976d2; font-size:0.7rem; padding:0.15rem 0.5rem; border-radius:10px;">Cooking Masterclass</span>
                      <% } else { %>
                        <div style="font-weight:700; color:var(--text-primary);"><%= r.chefName || 'ChefNest Membership Subscription' %></div>
                        <span class="badge" style="background:#fef3e9; color:#e67e22; font-size:0.7rem; padding:0.15rem 0.5rem; border-radius:10px;">Membership Plan</span>
                      <% } %>
                    </td>
                    <td><strong style="font-size:0.95rem; color:#1a3a1b;">LKR <%= (r.amountPaid || 0).toLocaleString() %></strong></td>
                    <td><span style="font-size:0.84rem; color:#555;"><%= (r.paymentMethod === 'Credit/Debit Card' || r.paymentMethod === 'PayHere (Credit/Debit Card)' || r.paymentMethod === 'PayHere') ? 'PayHere Gateway' : r.paymentMethod %></span></td>
                    <td><span style="font-size:0.84rem;"><%= new Date(r.createdAt).toDateString() %></span></td>
                    <td><span class="badge badge-green" style="font-size:0.75rem; padding:0.25rem 0.6rem;">● <%= r.status || 'Paid' %></span></td>
                    <td>
                      <% if (r.bookingId) { %>
                        <a href="/booking/receipt/<%= r.bookingId._id %>" target="_blank" class="action-btn" style="text-decoration:none; padding:0.35rem 0.75rem; font-size:0.78rem;">📄 Invoice</a>
                      <% } else if (r.receiptUrl) { %>
                        <a href="<%= r.receiptUrl %>" target="_blank" class="action-btn" style="text-decoration:none; padding:0.35rem 0.75rem; font-size:0.78rem; background:#eef7ee; color:#2C5F2D; font-weight:700;">📄 View Slip</a>
                      <% } else { %>
                        <button class="action-btn" onclick="showToast('✅ Receipt #<%= r.transactionId %> is active &amp; verified.')" style="text-decoration:none; padding:0.35rem 0.75rem; font-size:0.78rem; cursor:pointer;">📄 Receipt</button>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="7" style="text-align:center;color:var(--text-muted); padding:2rem;">No payment transactions found.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Official Bank Transfer Account Details -->
      <div class="content-card" style="background:linear-gradient(135deg, #f0fdf4, #e8f5e9); border:1.5px solid #86efac; border-radius:12px; margin-bottom:1.5rem;">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.8rem;">
          <h3 style="margin:0; font-size:1.05rem; color:#166534; display:flex; align-items:center; gap:0.4rem;">
            🏛️ Official Bank Transfer Account Details
          </h3>
          <span class="badge" style="background:#166534; color:#fff; font-size:0.72rem; padding:0.25rem 0.65rem;">Direct Bank Deposit / Online Banking</span>
        </div>
        <p style="font-size:0.82rem; color:#14532d; margin-bottom:1rem; line-height:1.45;">
          For 50% advance booking deposits or course fees via Bank Transfer, please deposit or transfer directly to the official beneficiary account below and upload your deposit slip.
        </p>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; background:#fff; padding:1rem 1.2rem; border-radius:10px; border:1px solid #bbf7d0;">
          <div>
            <div style="font-size:0.72rem; font-weight:700; color:#475569; text-transform:uppercase;">Account Holder</div>
            <div style="font-size:0.95rem; font-weight:800; color:#0f172a; margin-top:2px;">MISS S ASVINI</div>
          </div>
          <div>
            <div style="font-size:0.72rem; font-weight:700; color:#475569; text-transform:uppercase;">Account Number</div>
            <div style="font-size:1.05rem; font-weight:800; color:#166534; font-family:monospace; margin-top:2px;">0089022891</div>
          </div>
          <div>
            <div style="font-size:0.72rem; font-weight:700; color:#475569; text-transform:uppercase;">Bank Name</div>
            <div style="font-size:0.95rem; font-weight:800; color:#0f172a; margin-top:2px;">Bank of Ceylon (BOC)</div>
          </div>
          <div>
            <div style="font-size:0.72rem; font-weight:700; color:#475569; text-transform:uppercase;">Branch</div>
            <div style="font-size:0.95rem; font-weight:800; color:#0f172a; margin-top:2px;">Punnalaikadduwan Branch (347)</div>
          </div>
        </div>
      </div>

      <div class="content-card">
        <h3>📤 Upload Bank Transfer Receipt</h3>
        <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem;">Upload your bank transfer slip — Admin will verify and confirm your booking payment.</p>
        <div class="form-grid-2">
          <div class="field-group">
            <label class="field-label">Booking Reference</label>
            <input class="form-input" type="text" placeholder="#245 or transaction reference" id="receiptRef">
          </div>
          <div class="field-group">
            <label class="field-label">Receipt File (JPG/PDF)</label>
            <input class="form-input" type="file" id="receiptFile" accept="image/*,.pdf" style="padding:0.45rem;">
          </div>
        </div>
        <div class="btn-row"><button class="btn-primary" onclick="uploadBankReceipt()">📤 Upload Receipt</button></div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!--  SECTION 10: REVIEWS                                          -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-reviews">
      <div class="section-header">
        <h1 class="section-title">My Reviews</h1>
        <p class="section-subtitle">Rate and review your chef experiences on ChefNest.</p>
      </div>

      <!-- NEW: Submit Review Form with Chef Dropdown -->
      <div class="content-card" style="margin-bottom: 2rem;">
        <h3>Submit Feedback for a Chef</h3>
        <p style="font-size:0.82rem; color:var(--text-secondary); margin-bottom:1rem;">Select any chef to submit your ratings and feedback.</p>
        <form onsubmit="submitDropdownReview(event)" id="dropdownReviewForm">
          <div class="form-grid-2">
            <div class="field-group">
              <label class="field-label">Select Chef *</label>
              <select name="chefId" id="reviewSelectChef" class="form-select" style="width:100%; border:1.5px solid var(--border); padding:0.65rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit;" required onchange="updateBookingIdForReview()">
                <option value="">-- Choose Chef to Review --</option>
                <% if (typeof allChefs !== 'undefined' && allChefs && allChefs.length > 0) { %>
                  <% allChefs.forEach(c => { %>
                    <% const matchingBooking = bookings.find(b => b.chefId && String(b.chefId._id) === String(c._id)); %>
                    <option value="<%= c._id %>" data-booking-id="<%= matchingBooking ? matchingBooking._id : '' %>">
                      Chef <%= c.firstName %> <%= c.lastName %> (<%= c.city || 'Verified' %>)
                    </option>
                  <% }) %>
                <% } else if (typeof bookings !== 'undefined' && bookings.length > 0) { %>
                  <% const uniqueChefs = []; %>
                  <% bookings.forEach(b => { %>
                    <% if (b.chefId && !uniqueChefs.find(c => String(c._id) === String(b.chefId._id))) { %>
                      <% uniqueChefs.push(b.chefId); %>
                      <option value="<%= b.chefId._id %>" data-booking-id="<%= b._id %>">
                        Chef <%= b.chefId.firstName %> <%= b.chefId.lastName %>
                      </option>
                    <% } %>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="field-group">
              <label class="field-label">Rating (1 to 5 Stars) *</label>
              <select name="rating" id="reviewSelectRating" class="form-select" style="width:100%; border:1.5px solid var(--border); padding:0.65rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit;" required>
                <option value="5">⭐⭐⭐⭐⭐ - Excellent (5/5)</option>
                <option value="4">⭐⭐⭐⭐☆ - Very Good (4/5)</option>
                <option value="3">⭐⭐⭐☆☆ - Average (3/5)</option>
                <option value="2">⭐⭐☆☆☆ - Below Average (2/5)</option>
                <option value="1">⭐☆☆☆☆ - Poor (1/5)</option>
              </select>
            </div>
          </div>
          <div class="field-group" style="margin-top:1rem;">
            <label class="field-label">Feedback / Comment *</label>
            <textarea name="comment" id="reviewCommentText" class="form-textarea" rows="3" placeholder="Share your experience cooking with this chef..." required style="width:100%; border:1.5px solid var(--border); padding:0.65rem; border-radius:8px; outline:none; background:var(--bg-card); color:var(--text-primary); font-family:inherit; box-sizing:border-box;"></textarea>
          </div>
          <!-- Hidden: booking ID mapped from selected chef -->
          <input type="hidden" name="bookingId" id="reviewSelectBookingId">
          <div class="btn-row" style="margin-top: 1rem;"><button type="submit" class="btn-primary" style="padding:0.65rem 1.4rem;">Submit Review</button></div>
        </form>
      </div>
      <% if (typeof userReviews !== 'undefined' && userReviews.length > 0) { %>
        <% userReviews.forEach(rev => {
          const chefInitial = rev.chefId ? rev.chefId.firstName.charAt(0).toUpperCase() : '?';
          const chefFullName = rev.chefId ? `Chef ${rev.chefId.firstName} ${rev.chefId.lastName}` : 'Chef';
          const reviewDate = new Date(rev.createdAt).toDateString();
          const bookingDateStr = rev.bookingId ? new Date(rev.bookingId.date).toDateString() : 'N/A';
          const stars = Array(rev.rating).fill('⭐').join('');
        %>
        <div class="review-card" id="reviewCard-<%= rev._id %>">
          <div class="review-avatar"><%= chefInitial %></div>
          <div style="flex:1;">
            <div style="font-weight:600; color:var(--text-primary); font-size:0.9rem;"><%= chefFullName %></div>
            <div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.25rem; flex-wrap:wrap;">
              <div class="review-stars"><%= stars %></div>
              <% if (rev.sentiment === 'Negative') { %>
                <span style="background:#ffebee; color:#c62828; border:1px solid #ffcdd2; padding:1px 7px; border-radius:10px; font-size:0.72rem; font-weight:700; display:inline-flex; align-items:center; gap:3px;">😞 Negative Sentiment</span>
              <% } else if (rev.sentiment === 'Neutral') { %>
                <span style="background:#fff3e0; color:#e65100; border:1px solid #ffe0b2; padding:1px 7px; border-radius:10px; font-size:0.72rem; font-weight:700; display:inline-flex; align-items:center; gap:3px;">😐 Neutral Sentiment</span>
              <% } else { %>
                <span style="background:#e8f5e9; color:#2e7d32; border:1px solid #c8e6c9; padding:1px 7px; border-radius:10px; font-size:0.72rem; font-weight:700; display:inline-flex; align-items:center; gap:3px;">😊 Positive Sentiment</span>
              <% } %>
            </div>
            <div class="review-text">"<%= rev.comment %>"</div>
            <div class="review-meta"><%= reviewDate %> · Booking date: <%= bookingDateStr %></div>
            <% if (rev.foodQualityScore) { %>
              <div style="font-size:0.78rem; color:var(--text-muted); margin-top:0.3rem;">Food Quality: <%= rev.foodQualityScore %>/5 &nbsp;·&nbsp; Punctuality: <%= rev.punctualityScore %>/5</div>
            <% } %>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <div style="text-align:center; padding:3rem; color:var(--text-muted);">
          <div style="font-size:2.5rem; margin-bottom:0.5rem;">⭐</div>
          <p>You haven't submitted any reviews yet. Select a chef above to share your experience!</p>
        </div>
      <% } %>
    </section>

    <!-- ============================================================ -->
    <!--  SECTION: DISCOUNTS & SPECIAL OFFERS                         -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-discounts">
      <div class="section-header" style="margin-bottom:1.5rem;">
        <h1 class="section-title">🎟️ Exclusive Promo Discounts &amp; Deals</h1>
        <p class="section-subtitle">Apply these verified promo codes during checkout to enjoy discounts on chef bookings and courses.</p>
      </div>

      <% if (typeof discounts !== 'undefined' && discounts && discounts.length > 0) { %>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:1.2rem;">
          <% discounts.forEach(d => { %>
            <div style="background:#fff; border:1.5px solid #d4e8d4; border-radius:16px; padding:1.4rem; display:flex; flex-direction:column; justify-content:space-between; position:relative; box-shadow:0 4px 14px rgba(44,95,45,0.06); overflow:hidden;">
              <div style="position:absolute; top:0; left:0; width:6px; height:100%; background:linear-gradient(180deg, #2C5F2D, #D97A2B);"></div>
              <div>
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.6rem;">
                  <span style="font-size:0.75rem; font-weight:800; text-transform:uppercase; color:#D97A2B; background:#fff3e6; padding:0.2rem 0.6rem; border-radius:12px;"><%= d.type || 'Special' %></span>
                  <span style="font-size:1.15rem; font-weight:900; color:#2C5F2D;"><%= d.discountPercentage %>% OFF</span>
                </div>
                <h3 style="margin:0 0 0.4rem; font-size:1.1rem; font-weight:800; color:#1E2E1E;"><%= d.title %></h3>
                <p style="margin:0 0 1rem; font-size:0.84rem; color:#666; line-height:1.4;"><%= d.description || `Special discount available across eligible platform services.` %></p>
              </div>

              <div>
                <div style="background:#f8faf8; border:1px dashed #b8dbb8; border-radius:10px; padding:0.8rem; display:flex; justify-content:space-between; align-items:center; margin-bottom:0.8rem;">
                  <div>
                    <small style="display:block; font-size:0.7rem; color:#888; text-transform:uppercase; font-weight:700;">Promo Code</small>
                    <code style="font-size:1rem; font-weight:900; color:#2C5F2D; letter-spacing:1px;"><%= d.code %></code>
                  </div>
                  <button type="button" onclick="navigator.clipboard.writeText('<%= d.code %>'); showToast('Copied code: <%= d.code %>');" style="background:#2C5F2D; color:#fff; border:none; padding:0.4rem 0.8rem; border-radius:6px; font-size:0.78rem; font-weight:700; cursor:pointer;">Copy</button>
                </div>

                <div style="font-size:0.75rem; color:#777; display:flex; justify-content:space-between; border-top:1px solid #edf2ed; padding-top:0.6rem;">
                  <span>Min Order: LKR <%= (d.minOrderAmount || 0).toLocaleString() %></span>
                  <span>Expires: <%= new Date(d.validTill).toLocaleDateString() %></span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div style="padding:3.5rem; text-align:center; background:#fff; border-radius:16px; border:1px solid #e0ede0;">
          <div style="font-size:3rem; margin-bottom:0.5rem;">🏷️</div>
          <h3 style="margin:0 0 0.5rem; color:#1E2E1E;">No Active Discounts Currently</h3>
          <p style="color:#666; font-size:0.9rem; margin:0;">Platform administrators periodically publish festive and seasonal vouchers. Check back soon!</p>
        </div>
      <% } %>
    </section>

    <!-- ============================================================ -->
    <!--  SECTION 12: CHAT                                             -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-chat">
      <div class="section-header">
        <h1 class="section-title">💬 Chat &amp; Support</h1>
        <p class="section-subtitle">Private direct messaging with all your chefs and 24/7 admin support.</p>
      </div>

      <!-- Quick Contact Selector Dropdown Bar -->
      <div style="background:#fff; border-radius:12px; padding:0.8rem 1.2rem; margin-bottom:1.2rem; display:flex; align-items:center; gap:1rem; border:1.5px solid #ddecdd; box-shadow:0 2px 8px rgba(0,0,0,0.03);">
        <label for="chatContactDropdown" style="font-weight:700; color:#2C5F2D; font-size:0.9rem; white-space:nowrap;">💬 Choose Contact to Message:</label>
        <select id="chatContactDropdown" onchange="handleChatDropdownChange(this.value)" style="flex:1; padding:0.6rem 1rem; border-radius:8px; border:1.5px solid #cbe4cb; font-size:0.92rem; outline:none; background:#fff; font-family:inherit; color:#1a3a1b; font-weight:600;">
          <option value="">-- Select Contact from Dropdown --</option>
          <option value="admin" data-name="Admin Support" data-initial="A" data-bg="var(--forest-green)">🛡️ Admin Support</option>
          <optgroup label="Verified Chefs">
            <% if (typeof allChefs !== 'undefined' && allChefs && allChefs.length > 0) { %>
              <% allChefs.forEach(c => { %>
                <option value="<%= c._id %>" data-name="Chef <%= c.firstName %> <%= c.lastName %>" data-initial="<%= c.firstName.charAt(0).toUpperCase() %>" data-bg="var(--accent-gold)">
                  👨‍🍳 Chef <%= c.firstName %> <%= c.lastName %> (<%= c.city || 'Verified' %>)
                </option>
              <% }) %>
            <% } else if (typeof bookings !== 'undefined' && bookings.length > 0) { %>
              <% const seenChefs = new Set(); %>
              <% bookings.forEach(b => { if (b.chefId && !seenChefs.has(String(b.chefId._id))) { seenChefs.add(String(b.chefId._id)); %>
                <option value="<%= b.chefId._id %>" data-name="Chef <%= b.chefId.firstName %> <%= b.chefId.lastName %>" data-initial="<%= b.chefId.firstName.charAt(0).toUpperCase() %>" data-bg="var(--accent-gold)">
                  👨‍🍳 Chef <%= b.chefId.firstName %> <%= b.chefId.lastName %>
                </option>
              <% } }); %>
            <% } %>
          </optgroup>
        </select>
      </div>

      <div class="chat-layout">
        <!-- LEFT: Contact List -->
        <div class="chat-list" id="chatContactList">
          <!-- Admin Support always first -->
          <div class="chat-list-item" id="contact-admin" onclick="openChat('admin','Admin Support','A','var(--forest-green)')">
            <div class="chat-avatar" style="background:var(--forest-green);">A</div>
            <div>
              <div class="chat-list-name">Admin Support</div>
              <div class="chat-list-last">24/7 Platform Assistance</div>
            </div>
          </div>
          <!-- All Registered Real Chefs -->
          <% if (typeof allChefs !== 'undefined' && allChefs && allChefs.length > 0) { %>
            <% allChefs.forEach(c => { %>
              <div class="chat-list-item" id="contact-<%= c._id %>"
                onclick="openChat('<%= c._id %>','Chef <%= c.firstName %> <%= c.lastName %>','<%= c.firstName.charAt(0).toUpperCase() %>','var(--accent-gold)')">
                <div class="chat-avatar" style="background:var(--accent-gold);"><%= c.firstName.charAt(0).toUpperCase() %></div>
                <div>
                  <div class="chat-list-name">Chef <%= c.firstName %> <%= c.lastName %></div>
                  <div class="chat-list-last"><%= c.city || 'Verified Chef' %></div>
                </div>
              </div>
            <% }) %>
          <% } else if (typeof bookings !== 'undefined') { %>
            <% const seenChefIds = new Set(); %>
            <% bookings.forEach(b => { if (b.chefId && !seenChefIds.has(String(b.chefId._id))) { seenChefIds.add(String(b.chefId._id)); %>
              <div class="chat-list-item" id="contact-<%= b.chefId._id %>"
                onclick="openChat('<%= b.chefId._id %>','Chef <%= b.chefId.firstName %> <%= b.chefId.lastName %>','<%= b.chefId.firstName.charAt(0).toUpperCase() %>','var(--accent-gold)')">
                <div class="chat-avatar" style="background:var(--accent-gold);"><%= b.chefId.firstName.charAt(0).toUpperCase() %></div>
                <div>
                  <div class="chat-list-name">Chef <%= b.chefId.firstName %> <%= b.chefId.lastName %></div>
                  <div class="chat-list-last">Tap to open chat</div>
                </div>
              </div>
            <% } }); %>
          <% } %>
        </div>

        <!-- RIGHT: Chat Window -->
        <div class="chat-window">
          <!-- Header -->
          <div class="chat-header" id="chatHeaderName">
            Select a chef or admin from dropdown or list to start chatting
          </div>

          <!-- Messages Area -->
          <div class="chat-messages" id="chatMessages">
            <div style="text-align:center; padding:3rem; color:var(--text-muted);">
              <div style="font-size:2.5rem; margin-bottom:0.5rem;">💬</div>
              <p>Choose a contact from the dropdown or click a contact on the left to start a conversation.</p>
            </div>
          </div>

          <!-- Input -->
          <form class="chat-input-row" onsubmit="sendMessage(event)" id="chatForm">
            <input class="chat-input" id="chatInput" placeholder="Type a message..." autocomplete="off" disabled>
            <button type="submit" class="chat-send" id="chatSendBtn" disabled>Send 📤</button>
          </form>
        </div>
      </div>

      <!-- Hidden: store current user ID for bubble direction -->
      <span id="currentUserId" style="display:none;"><%= userData._id %></span>
    </section>


    <!-- ============================================================ -->
    <!--  SECTION 13: SETTINGS                                         -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-settings">
      <div class="section-header">
        <h1 class="section-title"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg> Settings</h1>
        <p class="section-subtitle">Customize your experience on ChefNest.</p>
      </div>
      <div class="settings-grid">

        <!-- Language -->
        <div class="settings-card">
          <h3>🌐 Language</h3>
          <div class="field-group">
            <label class="field-label">Select Language</label>
            <select class="lang-select" id="langSelect" onchange="applyLanguage(this.value)">
              <option value="en">🇬🇧 English</option>
              <option value="ta">🇱🇰 தமிழ் (Tamil)</option>
              <option value="si">🇱🇰 සිංහල (Sinhala)</option>
            </select>
          </div>
          <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.5rem;" id="langNote">Key labels are translated in real-time.</p>
        </div>

        <!-- Change Password -->
        <div class="settings-card">
          <h3>🔒 Change Password</h3>
          <form id="settingsPasswordForm" onsubmit="changePasswordGeneric(event, 'settingsPasswordForm')" autocomplete="off">
            <div class="field-group" style="margin-bottom:0.75rem;">
              <label class="field-label">Current Password</label>
              <div style="position: relative; display: flex; align-items: center;">
                <input class="form-input" type="password" name="currentPassword" autocomplete="current-password" placeholder="Enter your current password" required style="padding-right: 2.5rem;">
                <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: var(--text-secondary); display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">👁️</button>
              </div>
            </div>
            <div class="field-group" style="margin-bottom:0.75rem;">
              <label class="field-label">New Password</label>
              <div style="position: relative; display: flex; align-items: center;">
                <input class="form-input" type="password" name="newPassword" autocomplete="new-password" placeholder="Enter new password" required style="padding-right: 2.5rem;">
                <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: var(--text-secondary); display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">👁️</button>
              </div>
            </div>
            <div class="field-group" style="margin-bottom:0.75rem;">
              <label class="field-label">Confirm New Password</label>
              <div style="position: relative; display: flex; align-items: center;">
                <input class="form-input" type="password" name="confirmPassword" autocomplete="new-password" placeholder="Confirm new password" required style="padding-right: 2.5rem;">
                <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: var(--text-secondary); display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">👁️</button>
              </div>
            </div>
            <button type="submit" class="btn-primary" style="margin-top:0.5rem;">Update Password</button>
          </form>
        </div>

      </div>
    </section>

    <!-- ============================================================ -->
    <!--  SECTION 14: NOTIFICATIONS                                    -->
    <!-- ============================================================ -->
    <section class="user-section" id="section-notifications">
      <div class="section-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
        <div>
          <h1 class="section-title">🔔 Notifications &amp; Alerts</h1>
          <p class="section-subtitle">Real-time status updates for all your chef bookings, grocery approvals, and payments.</p>
        </div>
        <div style="display:flex; gap:0.6rem; align-items:center;">
          <button onclick="markAllNotificationsRead()" class="btn-outline" style="font-size:0.85rem; padding:0.5rem 1rem; border-radius:8px; cursor:pointer; background:#fff;">
            ✓ Mark All as Read
          </button>
        </div>
      </div>

      <!-- Notification Filter Tabs -->
      <div style="display:flex; gap:0.6rem; margin-bottom:1.5rem; border-bottom:1.5px solid #e0ead0; padding-bottom:0.85rem; align-items:center;">
        <button class="notif-tab active" onclick="filterNotifications('all', this)" style="background:#2C5F2D; color:#ffffff !important; border:none; padding:0.5rem 1.1rem; border-radius:20px; font-weight:800; font-size:0.85rem; cursor:pointer; box-shadow:0 3px 8px rgba(44,95,45,0.25); transition:all 0.2s;">
          All (<%= typeof notifications !== 'undefined' ? notifications.length : 0 %>)
        </button>
        <button class="notif-tab" onclick="filterNotifications('booking', this)" style="background:#f0f7f0; color:#1e3d20 !important; border:1.5px solid #bce2bc; padding:0.5rem 1.1rem; border-radius:20px; font-weight:700; font-size:0.85rem; cursor:pointer; transition:all 0.2s;">
          📅 Bookings &amp; Chefs
        </button>
        <button class="notif-tab" onclick="filterNotifications('unread', this)" style="background:#f0f7f0; color:#1e3d20 !important; border:1.5px solid #bce2bc; padding:0.5rem 1.1rem; border-radius:20px; font-weight:700; font-size:0.85rem; cursor:pointer; transition:all 0.2s;">
          🔴 Unread (<span id="tabUnreadCount"><%= typeof notifications !== 'undefined' ? notifications.filter(n => !n.isRead).length : 0 %></span>)
        </button>
      </div>

      <!-- Notifications Container -->
      <div id="notificationsContainer" style="display:flex; flex-direction:column; gap:1rem;">
        <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
          <% notifications.forEach(n => { %>
            <div class="notif-item-card <%= n.isRead ? 'read' : 'unread' %>" data-type="<%= n.type %>" data-read="<%= n.isRead %>" id="notif-<%= n._id %>" style="background:#fff; border-radius:14px; padding:1.2rem 1.4rem; border:1.5px solid <%= n.isRead ? '#eef2ee' : '#2C5F2D' %>; box-shadow:0 2px 8px rgba(0,0,0,0.04); display:flex; gap:1rem; align-items:flex-start; position:relative; transition:all 0.2s ease;">
              <div style="width:44px; height:44px; border-radius:12px; background:<%= n.type === 'booking' ? '#e8f5e9' : (n.type === 'payment' ? '#fff3e0' : '#e3f2fd') %>; display:flex; align-items:center; justify-content:center; font-size:1.4rem; flex-shrink:0;">
                <%= n.type === 'booking' ? '👨‍🍳' : (n.type === 'payment' ? '💳' : (n.type === 'grocery' ? '🛒' : '🔔')) %>
              </div>
              <div style="flex:1;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem; flex-wrap:wrap; gap:0.5rem;">
                  <h4 style="margin:0; font-size:1rem; font-weight:800; color:#1a3a1b; display:flex; align-items:center; gap:0.5rem;">
                    <%= n.title %>
                    <% if (!n.isRead) { %>
                      <span style="display:inline-block; width:8px; height:8px; background:#dc2626; border-radius:50%;"></span>
                    <% } %>
                  </h4>
                  <span style="font-size:0.78rem; color:#888; font-weight:600;"><%= new Date(n.createdAt).toLocaleDateString() %> at <%= new Date(n.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                </div>
                <p style="margin:0 0 0.8rem; font-size:0.9rem; color:#444; line-height:1.5;"><%= n.message %></p>
                <div style="display:flex; gap:0.8rem; align-items:center; flex-wrap:wrap;">
                  <% if (n.type === 'chat' || (n.title && n.title.includes('Message from')) || (n.message && n.message.toLowerCase().includes('chat'))) { %>
                    <% const senderClean = n.title ? n.title.replace(/^💬 Message from\s+/i, '').trim() : ''; %>
                    <button onclick="openUserChatFromNotification('<%= senderClean %>')" style="background:#1b5e20; color:#fff; border:none; padding:0.35rem 0.85rem; border-radius:6px; font-size:0.8rem; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:0.3rem;">
                      💬 Open Chat →
                    </button>
                  <% } else if (n.type === 'booking' || n.message.toLowerCase().includes('booking') || n.message.toLowerCase().includes('pay')) { %>
                    <button onclick="showSection('bookings', document.querySelector('[data-section=bookings] a'))" style="background:#2C5F2D; color:#fff; border:none; padding:0.35rem 0.85rem; border-radius:6px; font-size:0.8rem; font-weight:700; cursor:pointer;">
                      View Bookings &amp; Pay →
                    </button>
                  <% } %>
                  <% if (!n.isRead) { %>
                    <button onclick="markNotificationRead('<%= n._id %>')" style="background:none; border:1px solid #cbe4cb; color:#2C5F2D; padding:0.35rem 0.8rem; border-radius:6px; font-size:0.8rem; font-weight:600; cursor:pointer;">
                      Mark as read
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div style="text-align:center; padding:4rem 2rem; background:#fff; border-radius:16px; border:1.5px dashed #cbe4cb;">
            <div style="font-size:3rem; margin-bottom:0.8rem;">🔔</div>
            <h3 style="color:#1a3a1b; margin:0 0 0.4rem;">No Notifications Yet</h3>
            <p style="color:#666; font-size:0.9rem; margin:0;">When chefs accept your bookings, admin approves requests, or payments complete, you will see notifications here.</p>
          </div>
        <% } %>
      </div>
    </section>

  </div><!-- /user-content -->
</main>
</div><!-- /user-layout -->

