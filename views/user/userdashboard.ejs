              <input type="text" id="customFoodGeminiInput" placeholder="e.g. Chicken Kottu Roti, Paneer Butter Masala, Fish Ambul Thiyal..." class="form-input" style="flex:1; padding:0.6rem 0.8rem; font-size:0.85rem; border:1.5px solid #e67e22; border-radius:8px; outline:none; background:#fff; font-family:inherit; color:#1a3a1b;">
              <button type="button" id="btnGeminiExtract" onclick="extractNutritionWithGemini()" style="padding:0.6rem 0.95rem; background:#e67e22; color:#fff; border:none; border-radius:8px; font-size:0.82rem; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:0.35rem; white-space:nowrap; transition:all 0.2s; box-shadow:0 2px 8px rgba(230,126,34,0.25);">
