// ── AI Diet Classifier Handlers ─────────────────────────────
function syncDietMacroSlider(field, val) {
  const range = document.getElementById(field + 'Range');
  if (range) range.value = val;
}

function syncDietMacroInput(field, val) {
  const num = document.getElementById(field + 'Num');
  if (num) num.value = val;
}

function filterDishDropdown(query) {
  const select = document.getElementById('classifierDishSelect');
  if (!select) return;
  const q = query.toLowerCase().trim();
  const options = select.options;
  for (let i = 1; i < options.length; i++) {
    const text = options[i].text.toLowerCase();
    if (!q || text.includes(q)) {
      options[i].hidden = false;
    } else {
      options[i].hidden = true;
    }
  }
}

function onDishSelectForClassifier(selectEl) {
  const opt = selectEl.options[selectEl.selectedIndex];
  if (!opt || !opt.value) return;

  const parseVal = (val) => {
    if (val === null || val === undefined || val === '') return 0;
    const num = parseFloat(val);
    return isNaN(num) ? 0 : num;
  };

  const cal = parseVal(opt.getAttribute('data-calories')) || 0;
  const pro = parseVal(opt.getAttribute('data-protein')) || 0;
  const crb = parseVal(opt.getAttribute('data-carbs')) || 0;
  const fat = parseVal(opt.getAttribute('data-fat')) || 0;
  const fib = parseVal(opt.getAttribute('data-fiber')) || 0;
  const sug = parseVal(opt.getAttribute('data-sugar')) || 0;
  const sod = parseVal(opt.getAttribute('data-sodium')) || 0;
  const cat = opt.getAttribute('data-category') || 'Other';

  // Populate locked nutrient metric boxes
  const calEl = document.getElementById('dietCaloriesNum');
  const proEl = document.getElementById('dietProteinNum');
  const crbEl = document.getElementById('dietCarbsNum');
  const fatEl = document.getElementById('dietFatNum');
  const fibEl = document.getElementById('dietFiberNum');
  const sugEl = document.getElementById('dietSugarNum');
  const sodEl = document.getElementById('dietSodiumNum');

  if (calEl) calEl.value = cal;
  if (proEl) proEl.value = pro;
  if (crbEl) crbEl.value = crb;
  if (fatEl) fatEl.value = fat;
  if (fibEl) fibEl.value = fib;
  if (sugEl) sugEl.value = sug;
  if (sodEl) sodEl.value = sod;

  // Map category to display & code
  const foodTypeDisplay = document.getElementById('dietFoodTypeDisplay');
  const foodTypeHidden = document.getElementById('dietFoodType');
  if (foodTypeDisplay) foodTypeDisplay.value = cat;
  if (foodTypeHidden) foodTypeHidden.value = cat;

  showToast(`✅ Loaded metrics for: ${opt.getAttribute('data-name') || 'Selected Dish'}. Click 'Run Nutritional Classification' to evaluate.`);
}

async function extractNutritionWithGemini() {
  const inputEl = document.getElementById('customFoodGeminiInput');
  const dishName = inputEl ? inputEl.value.trim() : '';

  if (!dishName) {
    showToast('⚠️ Please enter a dish name to analyze with AI!');
    return;
  }

  const btn = document.getElementById('btnGeminiExtract');
  const origText = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span>⏳ Estimating...</span>';

  try {
    const res = await fetch('/user/diet/extract-gemini', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dishName })
    });
    const data = await res.json();

    btn.disabled = false;
    btn.innerHTML = origText;

    if (data.success && data.nutrition) {
      const n = data.nutrition;
      
      // Populate nutrient input boxes
      document.getElementById('dietCaloriesNum').value = n.calories || 300;
      document.getElementById('dietProteinNum').value = n.protein_g || 15;
      document.getElementById('dietCarbsNum').value = n.carbs_g || 30;
      document.getElementById('dietFatNum').value = n.fat_g || 10;
      document.getElementById('dietFiberNum').value = n.fiber_g || 3;
      document.getElementById('dietSugarNum').value = n.sugar_g || 2;
      document.getElementById('dietSodiumNum').value = n.sodium_mg || 350;

      const cat = n.food_type || 'Other';
      document.getElementById('dietFoodTypeDisplay').value = `${dishName} (${cat})`;
      document.getElementById('dietFoodType').value = cat;

      // Reset dropdown selection
      const dishSelect = document.getElementById('classifierDishSelect');
      if (dishSelect) dishSelect.selectedIndex = 0;

      showToast(`✨ Gemini AI extracted nutrition for "${dishName}"! Click 'Run Nutritional Classification' to predict.`);
    } else {
      showToast(data.message || '⚠️ Unable to estimate nutrition for this dish.');
    }
  } catch (err) {
    btn.disabled = false;
    btn.innerHTML = origText;
    showToast('⚠️ AI request failed. Please try again.');
  }
}

function resetDietClassifier() {
  const dishSelect = document.getElementById('classifierDishSelect');
  if (dishSelect) dishSelect.selectedIndex = 0;

  const foodTypeDisplay = document.getElementById('dietFoodTypeDisplay');
  const foodTypeHidden = document.getElementById('dietFoodType');
  if (foodTypeDisplay) foodTypeDisplay.value = 'Poultry & Meat';
  if (foodTypeHidden) foodTypeHidden.value = 'Meat';

  document.getElementById('dietCaloriesNum').value = 350;
  document.getElementById('dietProteinNum').value = 25;
  document.getElementById('dietCarbsNum').value = 35;
  document.getElementById('dietFatNum').value = 12;
  document.getElementById('dietFiberNum').value = 5;
  document.getElementById('dietSugarNum').value = 3;
  document.getElementById('dietSodiumNum').value = 350;

  showToast('Diet Classifier metrics reset to default.');
}

async function classifyDietWithAI(e) {
  if (e) e.preventDefault();

  const calories = parseFloat(document.getElementById('dietCaloriesNum').value) || 0;
  const foodTypeDisplay = document.getElementById('dietFoodTypeDisplay') ? document.getElementById('dietFoodTypeDisplay').value : '';

  if (!calories || !foodTypeDisplay || foodTypeDisplay.includes('Select a dish')) {
    showToast('⚠️ Please select a food from the dataset or analyze a custom dish with AI first!');
    return;
  }

  const dishSelect = document.getElementById('classifierDishSelect');
  const customFoodInput = document.getElementById('customFoodGeminiInput');
  const selectedFoodId = (dishSelect && dishSelect.value && !dishSelect.value.startsWith('demo-')) ? dishSelect.value : null;

  let displayName = 'Custom Food Profile';
  if (dishSelect && dishSelect.value && !dishSelect.value.startsWith('demo-')) {
    const dishOpt = dishSelect.selectedOptions[0];
    displayName = (dishOpt && dishOpt.value) ? (dishOpt.getAttribute('data-name') || dishOpt.text) : 'Selected Dish';
  } else if (customFoodInput && customFoodInput.value.trim()) {
    displayName = customFoodInput.value.trim();
  } else if (foodTypeDisplay) {
    displayName = foodTypeDisplay;
  }

  const protein_g = parseFloat(document.getElementById('dietProteinNum').value) || 0;
  const carbs_g = parseFloat(document.getElementById('dietCarbsNum').value) || 0;
  const fat_g = parseFloat(document.getElementById('dietFatNum').value) || 0;
  const fiber_g = parseFloat(document.getElementById('dietFiberNum').value) || 0;
  const sugar_g = parseFloat(document.getElementById('dietSugarNum').value) || 0;
  const sodium_mg = parseFloat(document.getElementById('dietSodiumNum').value) || 0;
  const food_type = document.getElementById('dietFoodType').value || 'Other';

  const btn = document.getElementById('classifyDietBtn');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span>Processing Model Inference...</span>';

  // Toggle state to loading
  document.getElementById('dietPlaceholderState').style.display = 'none';
  document.getElementById('dietResultContent').style.display = 'none';
  document.getElementById('dietLoadingState').style.display = 'block';

  try {
    const res = await fetch('/user/diet/predict', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        foodId: selectedFoodId,
        calories,
        protein_g,
        fat_g,
        carbs_g,
        fiber_g,
        sugar_g,
        sodium_mg,
        food_type
      })
    });

    const data = await res.json();

    btn.disabled = false;
    btn.innerHTML = originalHtml;
    document.getElementById('dietLoadingState').style.display = 'none';

    if (data.success) {
      document.getElementById('dietResultContent').style.display = 'block';

      // Set Dish Name / Header
      document.getElementById('resDishName').textContent = displayName;
      document.getElementById('resGradeTitle').textContent = (data.prediction || 'Good') + ' Profile';

      // Set Health Grade Badge
      const gradeBadge = document.getElementById('resHealthGradeBadge');
      gradeBadge.textContent = data.prediction || 'Good';
      gradeBadge.style.background = data.gradeColor || '#15803d';

      // Set Diet Badges
      const badgesContainer = document.getElementById('resDietBadges');
      if (data.dietBadges && data.dietBadges.length > 0) {
        badgesContainer.innerHTML = data.dietBadges.map(b => `
          <span style="background:${b.color}10; color:${b.color}; border:1px solid ${b.color}30; font-weight:600; font-size:0.78rem; padding:0.25rem 0.65rem; border-radius:6px;">
            ${b.label}
          </span>
        `).join('');
      } else {
        badgesContainer.innerHTML = '<span style="background:#f0f7f0; color:#2C5F2D; padding:0.25rem 0.65rem; border-radius:6px; font-weight:600; font-size:0.78rem;">Balanced Dietary Profile</span>';
      }

      // Update Probability Breakdown Bars
      const probs = data.probabilities || {};
      const setBar = (key, valElId, barElId) => {
        const raw = probs[key] !== undefined ? probs[key] : 0;
        const pct = Math.round(raw * 100);
        const valEl = document.getElementById(valElId);
        const barEl = document.getElementById(barElId);
        if (valEl) valEl.textContent = pct + '%';
        if (barEl) barEl.style.width = pct + '%';
      };

      setBar('Excellent', 'probExcellentVal', 'probExcellentBar');
      setBar('Best', 'probBestVal', 'probBestBar');
      setBar('Good', 'probGoodVal', 'probGoodBar');
      setBar('Poor', 'probPoorVal', 'probPoorBar');

      // Set Model Status
      const statusBadge = document.getElementById('resModelStatusBadge');
      if (statusBadge) {
        if (data.mlServiceOnline) {
          statusBadge.textContent = 'Flask ML Microservice Live';
          statusBadge.style.background = '#15803d';
        } else {
          statusBadge.textContent = 'ML Inference Engine';
          statusBadge.style.background = '#2C5F2D';
        }
      }

      // Health Tip
      document.getElementById('resHealthTip').textContent = data.healthTip || 'Maintain balanced portions and fresh ingredients.';

      showToast(`Analysis Complete: Grade ${data.healthGrade} (${data.prediction})`);
    } else {
      document.getElementById('dietPlaceholderState').style.display = 'block';
      showToast('Error: ' + (data.message || 'Could not complete classification.'));
    }
  } catch (err) {
    console.error('Diet classification error:', err);
    btn.disabled = false;
    btn.innerHTML = originalHtml;
    document.getElementById('dietLoadingState').style.display = 'none';
    document.getElementById('dietPlaceholderState').style.display = 'block';
    showToast('Server error while predicting diet.');
  }
}

