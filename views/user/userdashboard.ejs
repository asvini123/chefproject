const ALL_REGISTERED_CHEFS = <%- JSON.stringify((typeof allChefs !== 'undefined' ? allChefs : []).map(c => ({
  id: c._id.toString(),
  name: `Chef ${c.firstName} ${c.lastName}`,
  city: c.city || c.address || 'Colombo',
  cuisines: (c.cuisines && c.cuisines.length > 0) ? c.cuisines.join(', ') : 'Multi-Cuisine',
  teachingCourses: c.teachingCourses || []
}))) %>;

function handleCourseSelectionChange(selectEl) {
  const selectedOption = selectEl.options[selectEl.selectedIndex];
  const chefSelect = document.getElementById('enrollChefSelect');
  const chefHint = document.getElementById('chefFilterHint');

  if (!selectedOption || !selectedOption.value) {
    document.getElementById('enrollDisplayPrice').textContent = 'Select Course';
    document.getElementById('enrollDisplayDetail').textContent = 'Includes chef instruction, course materials & certificate';
    document.getElementById('enrollSelectedCourseTitle').value = '';
    document.getElementById('enrollSelectedCategory').value = '';
    if (chefSelect) {
      chefSelect.innerHTML = '<option value="">-- Select a Course First --</option>';
      chefSelect.disabled = true;
    }
    if (chefHint) {
      chefHint.innerHTML = 'Select a course above to see registered instructor chefs.';
      chefHint.style.color = 'var(--text-muted)';
    }
    return;
  }

  const courseId = selectedOption.value;
  const title = selectedOption.getAttribute('data-title') || selectedOption.text.split('—')[0].trim();
  const category = selectedOption.getAttribute('data-category') || 'Cuisine';
  const price = parseInt(selectedOption.getAttribute('data-price')) || 0;
  const duration = selectedOption.getAttribute('data-duration') || '2 hours';
  const preChefId = selectedOption.getAttribute('data-chef-id');

  document.getElementById('enrollSelectedCourseTitle').value = title;
  document.getElementById('enrollSelectedCategory').value = category;

  if (price === 0) {
    document.getElementById('enrollDisplayPrice').innerHTML = '<span style="color:#27ae60;">FREE</span>';
    document.getElementById('enrollDisplayDetail').textContent = `Full access included · ${duration} · Free Certificate`;
  } else {
    document.getElementById('enrollDisplayPrice').textContent = 'LKR ' + price.toLocaleString();
    document.getElementById('enrollDisplayDetail').textContent = `Duration: ${duration} · Category: ${category} · Includes Ingredients Guide`;
  }

  // Strictly filter chefs who opted-in / selected this course in their dashboard
  if (chefSelect) {
    const matchedChefs = ALL_REGISTERED_CHEFS.filter(c => {
      if (preChefId && c.id === preChefId) return true;
      if (courseId.startsWith('custom_demo_')) return true;
      return Array.isArray(c.teachingCourses) && c.teachingCourses.includes(courseId);
    });

    if (matchedChefs.length > 0) {
      chefSelect.disabled = false;
      let optionsHtml = `<option value="">-- Choose from ${matchedChefs.length} Available Chef(s) --</option>`;
      matchedChefs.forEach(c => {
        const isSelected = (preChefId && c.id === preChefId) ? 'selected' : '';
        optionsHtml += `<option value="${c.id}" ${isSelected}>${c.name} — ${c.city} (${c.cuisines})</option>`;
      });
      chefSelect.innerHTML = optionsHtml;
      if (chefHint) {
        chefHint.innerHTML = `✅ <strong>${matchedChefs.length}</strong> verified instructor(s) available for this course.`;
        chefHint.style.color = 'var(--primary, #2C5F2D)';
      }
    } else {
      chefSelect.disabled = true;
      chefSelect.innerHTML = '<option value="">⚠️ No chefs currently teaching this course</option>';
      if (chefHint) {
        chefHint.innerHTML = '⚠️ No chefs have chosen to teach this course yet. Please choose another course.';
        chefHint.style.color = '#e17055';
      }
    }
  }
}

