                  <% const shortName = (f.name && f.name.length > 38) ? (f.name.substring(0, 36) + '...') : f.name; %>
                  <option value="<%= f._id %>"
                    data-name="<%= f.name %>"
                    data-calories="<%= f.caloriesNum !== undefined ? f.caloriesNum : (parseFloat(f.calories) || 0) %>"
                    data-protein="<%= (f.proteinNum !== undefined) ? f.proteinNum : ((f.nutrition && f.nutrition.protein) ? parseFloat(f.nutrition.protein) : 0) %>"
                    data-carbs="<%= (f.carbsNum !== undefined) ? f.carbsNum : ((f.nutrition && f.nutrition.carbs) ? parseFloat(f.nutrition.carbs) : 0) %>"
                    data-fat="<%= (f.fatNum !== undefined) ? f.fatNum : ((f.nutrition && f.nutrition.fat) ? parseFloat(f.nutrition.fat) : 0) %>"
                    data-fiber="<%= (f.fiberNum !== undefined) ? f.fiberNum : ((f.nutrition && f.nutrition.fiber) ? parseFloat(f.nutrition.fiber) : 0) %>"
                    data-sugar="<%= (f.sugarNum !== undefined) ? f.sugarNum : ((f.nutrition && f.nutrition.sugar) ? parseFloat(f.nutrition.sugar) : 0) %>"
                    data-sodium="<%= (f.sodiumNum !== undefined) ? f.sodiumNum : ((f.nutrition && f.nutrition.sodium) ? parseFloat(f.nutrition.sodium) : 0) %>"
                    data-category="<%= f.category || f.cuisine || 'Other' %>">
                    <%= shortName %> — <%= f.category || 'Food' %> (<%= f.calories || (f.caloriesNum + ' kcal') %>)
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <!-- Option 2: Search & Enter Any Custom Food (Gemini AI Integration) -->
