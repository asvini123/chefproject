    formData.append('referenceNumber', refInput.value.trim());
    formData.append('receiptFile', fileInput.files[0]);

    btn.disabled = true;
    btn.textContent = 'Uploading & Verifying...';

    try {
      const res = await fetch('/user/course/pay', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (data && data.success) {
        btn.textContent = '✅ Slip Uploaded Successfully!';
        btn.style.background = '#27ae60';
        btn.style.borderColor = '#27ae60';
        showToast(data.message || '🎉 Bank slip uploaded and verified!');
        setTimeout(() => location.reload(), 1500);
      } else {
        btn.disabled = false;
        btn.textContent = '📤 Upload Slip & Confirm Payment';
        showToast('❌ ' + ((data && data.message) ? data.message : 'Upload failed.'));
      }
    } catch (err) {
      btn.disabled = false;
      btn.textContent = '📤 Upload Slip & Confirm Payment';
      showToast('❌ Network error uploading bank slip: ' + err.message);
    }
  }
}

let currentPayBookingData = null;

function executeSelectedPayment() {
  const select = document.getElementById('payBookingSelect');
  if (!select || !select.value) {
    showToast('⚠️ No active booking selected.');
    return;
  }
  const opt = select.selectedOptions[0];
  const method = document.getElementById('payMethodSelect').value;
  const bookingId = select.value;
  const total = parseInt(opt.getAttribute('data-total') || '0');
  const half = parseInt(opt.getAttribute('data-half') || '0');
  const chef = opt.getAttribute('data-chef') || 'Chef';
  const dish = opt.getAttribute('data-dish') || 'Special Dish';
  const halfPaid = opt.getAttribute('data-halfpaid') === 'true';

  currentPayBookingData = {
    bookingId,
    total,
    half,
    chef,
    dish,
    halfPaid,
    method
  };

  if (method.includes('PayHere') || method.includes('Credit')) {
    // Open PayHere Modal
    document.getElementById('phModalBookingRef').textContent = '#' + bookingId.slice(-6).toUpperCase();
    document.getElementById('phModalChefName').textContent = chef;
    document.getElementById('phModalDishName').textContent = dish;
    
    // Clear and prepare clean inputs
    const cardInp = document.getElementById('phCardNumber');
    if (cardInp) cardInp.value = '';
    const expInp = document.getElementById('phCardExpiry');
    if (expInp) expInp.value = '';
    const cvvInp = document.getElementById('phCardCvv');
    if (cvvInp) cvvInp.value = '';

    updatePayHereModalAmount();
    document.getElementById('payhereCheckoutModal').style.display = 'flex';
  } else {
    // Direct server confirmation for Cash or Bank
    processServerPayment(bookingId, method, halfPaid ? total : half, !halfPaid);
  }
}

function formatPayHereCardInput(input) {
  let val = input.value.replace(/\D/g, '').substring(0, 16);
  input.value = val.replace(/(\d{4})(?=\d)/g, '$1 ');
}

function formatExpiryInput(input) {
  let val = input.value.replace(/\D/g, '').substring(0, 4);
  if (val.length >= 3) {
    input.value = val.substring(0, 2) + '/' + val.substring(2);
  } else {
    input.value = val;
  }
}

function updatePayHereModalAmount() {
  if (!currentPayBookingData) return;
  const payType = document.querySelector('input[name="phPayType"]:checked')?.value || 'half';
  const amt = payType === 'half' ? currentPayBookingData.half : currentPayBookingData.total;
  document.getElementById('phModalAmount').textContent = 'LKR ' + amt.toLocaleString();
}

function closePayhereModal() {
  document.getElementById('payhereCheckoutModal').style.display = 'none';
}

async function processPayHereModalPayment() {
  if (!currentPayBookingData) return;
  
  const cardVal = (document.getElementById('phCardNumber')?.value || '').replace(/\s+/g, '');
  const expVal = (document.getElementById('phCardExpiry')?.value || '').trim();
  const cvvVal = (document.getElementById('phCardCvv')?.value || '').trim();

  if (cardVal.length !== 16 || !/^\d{16}$/.test(cardVal)) {
    showToast('⚠️ Please enter a valid 16-digit card number.');
    document.getElementById('phCardNumber')?.focus();
    return;
  }
  if (!/^\d{2}\/\d{2}$/.test(expVal)) {
    showToast('⚠️ Please enter a valid expiry date (MM/YY).');
    document.getElementById('phCardExpiry')?.focus();
    return;
  }
  if (cvvVal.length < 3 || cvvVal.length > 4) {
    showToast('⚠️ Please enter a valid 3-4 digit CVV.');
    document.getElementById('phCardCvv')?.focus();
    return;
  }

  const btn = document.getElementById('btnConfirmPayHereCheckout');
  btn.disabled = true;
  btn.textContent = '⏳ Processing Payment...';

  const payType = document.querySelector('input[name="phPayType"]:checked')?.value || 'half';
  const isHalf = payType === 'half';
  const amount = isHalf ? currentPayBookingData.half : currentPayBookingData.total;

  try {
    const res = await fetch('/user/payment/process-checkout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        bookingId: currentPayBookingData.bookingId,
        paymentMethod: 'PayHere (Credit/Debit Card)',
        amountPaid: amount,
        isHalfPayment: isHalf
      })
    });
    const data = await res.json();
    if (data.success) {
      closePayhereModal();
      openPaySuccessModal(data.transactionId, amount, currentPayBookingData.bookingId, data.message);
    } else {
      showToast('❌ ' + (data.message || 'Payment failed'));
      btn.disabled = false;
      btn.textContent = '🔒 Pay with PayHere';
    }
  } catch (err) {
    showToast('❌ Network error processing payment');
    btn.disabled = false;
    btn.textContent = '🔒 Confirm Card Payment';
  }
}

async function launchPayHereSdkGateway() {
  if (!currentPayBookingData) return;
  const payType = document.querySelector('input[name="phPayType"]:checked')?.value || 'half';
  const isHalf = payType === 'half';
  const amount = isHalf ? currentPayBookingData.half : currentPayBookingData.total;
  const btn = document.getElementById('btnPayHereHostedGateway');
  btn.disabled = true;
  btn.textContent = '⏳ Initializing PayHere Gateway...';

  try {
    const res = await fetch('/user/payment/payhere-initiate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        bookingId: currentPayBookingData.bookingId,
        amount: amount,
        isHalfPayment: isHalf
      })
    });
    const data = await res.json();
    btn.disabled = false;
    btn.textContent = '⚡ Open Official PayHere Hosted Gateway Popup';

    if (!data.success) {
      showToast('❌ ' + (data.message || 'Could not initiate PayHere gateway.'));
      return;
    }

    // Configure PayHere JS SDK Payment Object
    const payment = {
      sandbox: data.sandbox,
      merchant_id: data.merchant_id,
      return_url: data.return_url,
      cancel_url: data.cancel_url,
      notify_url: data.notify_url,
      order_id: data.order_id,
      items: data.items,
      amount: data.amount,
      currency: data.currency,
      hash: data.hash,
      first_name: data.first_name,
      last_name: data.last_name,
      email: data.email,
      phone: data.phone,
      address: data.address,
      city: data.city,
      country: data.country
    };

    if (typeof payhere !== 'undefined') {
      payhere.onCompleted = function onCompleted(orderId) {
        closePayhereModal();
        openPaySuccessModal('PH-SDK-' + orderId, amount, currentPayBookingData.bookingId, 'Payment verified via PayHere Gateway!');
      };

      payhere.onDismissed = function onDismissed() {
        showToast('⚠️ PayHere payment window dismissed.');
      };

      payhere.onError = function onError(error) {
        showToast('❌ PayHere Error: ' + error);
      };

      // Launch official PayHere popup
      payhere.startPayment(payment);
    } else {
      // Fallback if network blocked payhere.js external script
      processPayHereModalPayment();
    }

  } catch (err) {
    console.error('PayHere SDK Error:', err);
    btn.disabled = false;
    btn.textContent = '⚡ Open Official PayHere Hosted Gateway Popup';
    showToast('❌ Failed to launch PayHere SDK window.');
  }
}

async function processServerPayment(bookingId, method, amount, isHalf) {
  try {
    const res = await fetch('/user/payment/process-checkout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        bookingId,
        paymentMethod: method,
        amountPaid: amount,
        isHalfPayment: isHalf
      })
    });
    const data = await res.json();
    if (data.success) {
      showToast(data.message);
      setTimeout(() => location.reload(), 1800);
    } else {
      showToast('❌ ' + (data.message || 'Action failed'));
    }
  } catch (err) {
    showToast('❌ Server error processing selection.');
  }
}

function openPaySuccessModal(txnId, amount, bookingId, message) {
  document.getElementById('successModalTxnId').textContent = '#' + (txnId || 'PH-98421');
  document.getElementById('successModalAmount').textContent = 'LKR ' + parseInt(amount).toLocaleString();
  document.getElementById('successModalMessage').textContent = message || 'Your payment has been received and verified successfully!';
  document.getElementById('successModalInvoiceBtn').href = '/booking/receipt/' + bookingId;
  document.getElementById('paymentSuccessReceiptModal').style.display = 'flex';
}

function closePaySuccessModal() {
  document.getElementById('paymentSuccessReceiptModal').style.display = 'none';
  location.reload();
}

// Initialize booking & course summary on load
window.addEventListener('DOMContentLoaded', () => {
  const paySelect = document.getElementById('payBookingSelect');
  if (paySelect) onBookingSelectChange(paySelect);
  const payCourseSelect = document.getElementById('payCourseSelect');
  if (payCourseSelect) onCourseSelectChange(payCourseSelect);
});

// ── Cancel Booking Modal Handlers ────────────────────────────
function openCancelBookingModal(bookingId, chefName, hasHalfPayment) {
  document.getElementById('cancelBookingId').value = bookingId;
  document.getElementById('cancelChefName').textContent = chefName;
  document.getElementById('cancelDepositWarning').style.display = hasHalfPayment ? 'block' : 'none';
  document.getElementById('cancelReasonInput').value = '';
  document.getElementById('cancelBookingModal').style.display = 'flex';
}

function closeCancelBookingModal() {
  document.getElementById('cancelBookingModal').style.display = 'none';
}

async function submitCancelBooking() {
  const bookingId = document.getElementById('cancelBookingId').value;
  const reason = document.getElementById('cancelReasonInput').value.trim();
  const btn = document.getElementById('confirmCancelBtn');

  if (!bookingId) {
    alert('Booking ID is missing. Please refresh and try again.');
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Cancelling...';

  try {
    const res = await fetch('/booking/' + bookingId + '/cancel', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cancellationReason: reason })
    });
    
    let data;
    try {
      data = await res.json();
    } catch (parseErr) {
      data = { success: res.ok, message: 'Server responded with status ' + res.status };
    }

    if (data && data.success) {
      closeCancelBookingModal();
      window.location.reload();
    } else {
      alert((data && data.message) ? data.message : 'Cancellation could not be completed.');
      btn.disabled = false;
      btn.textContent = 'Yes, Cancel Booking';
    }
  } catch (err) {
    console.error('Error cancelling booking:', err);
    alert('Cancellation request failed. Please check your connection and try again.');
    btn.disabled = false;
    btn.textContent = 'Yes, Cancel Booking';
  }
}

// ── Socket.IO Real-Time Chat & Notifications ──────────────
let userSocket = null;

if (typeof io !== 'undefined') {
  userSocket = io();

  if (currentUserId) {
    userSocket.emit('join-user', currentUserId);
  }

  userSocket.on('messages-read', (data) => {
    if (activeChatWith && activeChatWith.toString() === data.readerId.toString()) {
      document.querySelectorAll('#chatMessages .msg-item.sent .msg-time').forEach(el => {
        const timePart = el.innerText.split('·')[0].trim();
        el.innerHTML = `${timePart} <span style="color:#25D366; font-weight:800;"> · Seen ✓✓</span>`;
      });
    }
  });

  userSocket.on('new-notification', (data) => {
    if (!data.userId || data.userId === currentUserId) {
      showToast(data.message || '🔔 New Notification Received!');
      updateNotificationCounts(1);
    }
  });

  userSocket.on('new-private-message', (msg) => {
    if (!msg || !currentUserId) return;
    const sId = (msg.senderId && msg.senderId._id ? msg.senderId._id : msg.senderId).toString();
    const rId = (msg.receiverId && msg.receiverId._id ? msg.receiverId._id : msg.receiverId).toString();
    const myId = currentUserId.toString();
    const otherId = (sId === myId) ? rId : sId;

    // 1. Move contact card to the top of list
    const item = document.getElementById('contact-' + otherId);
    const list = document.querySelector('.chat-list');
    if (item && list) {
      list.prepend(item);
    }

    // 2. Bold text and snippet update
    if (item) {
      const nameEl = item.querySelector('.chat-list-name');
      if (nameEl) nameEl.style.fontWeight = '800';
      const lastEl = item.querySelector('.chat-list-last');
      if (lastEl) {
        lastEl.textContent = msg.content;
        lastEl.style.fontWeight = '700';
        lastEl.style.color = '#111';
      }
    }

    // 3. Update Chat badge count
    const badge = document.getElementById('userChatNavBadge');
    if (badge && (!activeChatWith || activeChatWith.toString() !== otherId)) {
      const current = parseInt(badge.textContent || '0') + 1;
      badge.textContent = current;
      badge.style.display = 'inline-block';
    }

    if (activeChatWith && activeChatWith.toString() === otherId && sId !== myId) {
      loadMessages();
    }
  });
}

// Initial unread count fetch on load
async function initUserChatBadge() {
  try {
    const res = await fetch('/api/chat/contacts');
    const data = await res.json();
    if (data.success && data.totalUnread > 0) {
      const badge = document.getElementById('userChatNavBadge');
      if (badge) {
        badge.textContent = data.totalUnread;
        badge.style.display = 'inline-block';
      }
    }
  } catch (e) {
    console.warn('Error fetching unread chat count:', e);
  }
}

window.addEventListener('DOMContentLoaded', () => {
  initUserChatBadge();
});
